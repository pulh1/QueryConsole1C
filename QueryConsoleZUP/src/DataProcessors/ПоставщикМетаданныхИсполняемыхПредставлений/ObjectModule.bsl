#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Функция Инициализировать() Экспорт
	Возврат ЭтотОбъект;
КонецФункции

Функция ИмяПоставщика() Экспорт
	Возврат "ИсполняемыеПредставления";
КонецФункции

Функция ПредставлениеПоставщика() Экспорт
	Возврат "Исполняемые представления";
КонецФункции

Функция Сегменты() Экспорт
	СегментыПоставщика = Новый Массив();
	СегментыПоставщика.Добавить("ИсполняемоеПредставление");
	Возврат СегментыПоставщика;
КонецФункции

Функция Контекстный() Экспорт
	Возврат Ложь;
КонецФункции

Функция ТаблицаСуществует(ИмяТаблицы) Экспорт
	Возврат ПоставщикИсполняемыхПредставлений.ОписаниеПредставленияПоИмениТаблицы(ИмяТаблицы) <> Неопределено;
КонецФункции

Функция ОписаниеТаблицы(ИмяТаблицы) Экспорт
	ОписаниеПредставления = ПоставщикИсполняемыхПредставлений.ОписаниеПредставленияПоИмениТаблицы(ИмяТаблицы);
	Если ОписаниеПредставления = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Описание = НовыйОписаниеТаблицы(ИмяТаблицы);
	Описание.Представление = ОписаниеПредставления.Имя;
	Описание.Поля = КопияПолейИсполняемогоПредставления(ОписаниеПредставления.Поля);
	Описание.Параметры = КопияПараметровИсполняемогоПредставления(ОписаниеПредставления.ОписаниеПараметров);
	Описание.ИсходноеОписание = ОписаниеПредставления;
	
	Возврат Описание;
КонецФункции

Функция ПоляТаблицы(ИмяТаблицы) Экспорт
	Описание = ОписаниеТаблицы(ИмяТаблицы);
	Если Описание = Неопределено Тогда
		Возврат Новый Массив();
	КонецЕсли;
	
	Возврат Описание.Поля;
КонецФункции

Функция ПараметрыТаблицы(ИмяТаблицы) Экспорт
	Описание = ОписаниеТаблицы(ИмяТаблицы);
	Если Описание = Неопределено Тогда
		Возврат Новый Массив();
	КонецЕсли;
	
	Возврат Описание.Параметры;
КонецФункции

Функция ДочерниеЭлементы(ИдентификаторРодителя = Неопределено) Экспорт
	Элементы = Новый Массив();
	Если ИдентификаторРодителя = Неопределено Тогда
		ИменаГрупп = ПоставщикИсполняемыхПредставлений.ГруппыИсполняемыхПредставлений();
		Для Каждого ИмяГруппы Из ИменаГрупп Цикл
			Элементы.Добавить(НовыйЭлементИерархии(ИмяГруппы, ИмяГруппы, Истина));
		КонецЦикла;
	ИначеЕсли ТаблицаСуществует(ИдентификаторРодителя) Тогда
		Возврат ПоляТаблицы(ИдентификаторРодителя);
	Иначе
		ИменаГрупп = ПоставщикИсполняемыхПредставлений.ИменаДочернихГрупп(ИдентификаторРодителя);
		Для Каждого ИмяГруппы Из ИменаГрупп Цикл
			Элементы.Добавить(НовыйЭлементИерархии(ИмяГруппы, ПоследнийСегмент(ИмяГруппы), Истина));
		КонецЦикла;
		
		ИменаТаблиц = ПоставщикИсполняемыхПредставлений.ИменаТаблицПредставленийВходящихВГруппу(ИдентификаторРодителя);
		Для Каждого ИмяТаблицы Из ИменаТаблиц Цикл
			Элемент = НовыйЭлементИерархии(ИмяТаблицы, ПоследнийСегмент(ИмяТаблицы), Ложь);
			Элемент.ТипЗначения = "ИсполняемоеПредставление";
			Элементы.Добавить(Элемент);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Элементы;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыйОписаниеТаблицы(ИмяТаблицы = "")
	Описание = Новый Структура;
	Описание.Вставить("Тип", "ОписаниеТаблицыПоставщикаМетаданных");
	Описание.Вставить("ИмяТаблицы", ИмяТаблицы);
	Описание.Вставить("ПервыйСегмент", ПервыйСегментИмениТаблицы(ИмяТаблицы));
	Описание.Вставить("ВидПоставщика", ИмяПоставщика());
	Описание.Вставить("Представление", ИмяТаблицы);
	Описание.Вставить("Поля", Новый Массив());
	Описание.Вставить("Параметры", Новый Массив());
	Описание.Вставить("ДочерниеЭлементы", Новый Массив());
	Описание.Вставить("ИсходноеОписание", Неопределено);
	
	Возврат Описание;
КонецФункции

Функция НовыйПолеТаблицы(Имя = "", ТипЗначения = Неопределено)
	Поле = Новый Структура;
	Поле.Вставить("Тип", "ПолеТаблицыПоставщикаМетаданных");
	Поле.Вставить("Имя", Имя);
	Поле.Вставить("Представление", Имя);
	Поле.Вставить("ТипЗначения", ТипЗначения);
	Поле.Вставить("ВидПоставщика", ИмяПоставщика());
	Поле.Вставить("Поля", Новый Массив());
	Поле.Вставить("Роль", Неопределено);
	Поле.Вставить("ИсходноеОписание", Неопределено);
	
	Возврат Поле;
КонецФункции

Функция НовыйПараметрТаблицы(Имя = "", ТипЗначения = Неопределено, Обязательный = Ложь)
	Параметр = Новый Структура;
	Параметр.Вставить("Тип", "ПараметрТаблицыПоставщикаМетаданных");
	Параметр.Вставить("Имя", Имя);
	Параметр.Вставить("ТипЗначения", ТипЗначения);
	Параметр.Вставить("Обязательный", Обязательный);
	Параметр.Вставить("ИсходноеОписание", Неопределено);
	
	Возврат Параметр;
КонецФункции

Функция НовыйЭлементИерархии(Идентификатор = "", Наименование = "", ЭтоГруппа = Ложь)
	Элемент = Новый Структура;
	Элемент.Вставить("Тип", "ЭлементИерархииПоставщикаМетаданных");
	Элемент.Вставить("Идентификатор", Идентификатор);
	Элемент.Вставить("Имя", Идентификатор);
	Элемент.Вставить("Наименование", Наименование);
	Элемент.Вставить("Представление", Наименование);
	Элемент.Вставить("ЭтоГруппа", ЭтоГруппа);
	Элемент.Вставить("ВидПоставщика", ИмяПоставщика());
	Элемент.Вставить("ТипЗначения", "ЭлементИерархииИсполняемыхПредставлений");
	Элемент.Вставить("ЕстьДочерниеЭлементы", Истина);
	Элемент.Вставить("ИсходноеОписание", Неопределено);
	
	Возврат Элемент;
КонецФункции

Функция КопияПолейИсполняемогоПредставления(ПоляПредставления)
	КопияПолей = Новый Массив();
	Если ПоляПредставления = Неопределено Тогда
		Возврат КопияПолей;
	КонецЕсли;
	
	Для Каждого ПолеПредставления Из ПоляПредставления Цикл
		КопияПоля = НовыйПолеТаблицы(ПолеПредставления.Имя, ПолеПредставления.ТипЗначения);
		КопияПоля.ИсходноеОписание = ПолеПредставления;
		Если ТипЗнч(ПолеПредставления) = Тип("Структура") И ПолеПредставления.Свойство("Поля") Тогда
			КопияПоля.Поля = КопияПолейИсполняемогоПредставления(ПолеПредставления.Поля);
		КонецЕсли;
		КопияПолей.Добавить(КопияПоля);
	КонецЦикла;
	
	Возврат КопияПолей;
КонецФункции

Функция КопияПараметровИсполняемогоПредставления(ПараметрыПредставления)
	КопияПараметров = Новый Массив();
	Если ПараметрыПредставления = Неопределено Тогда
		Возврат КопияПараметров;
	КонецЕсли;
	
	Для Каждого ПараметрПредставления Из ПараметрыПредставления Цикл
		КопияПараметра = НовыйПараметрТаблицы(ПараметрПредставления.Имя, Неопределено, ПараметрПредставления.Обязательный);
		КопияПараметра.ИсходноеОписание = ПараметрПредставления;
		КопияПараметров.Добавить(КопияПараметра);
	КонецЦикла;
	
	Возврат КопияПараметров;
КонецФункции

Функция ПервыйСегментИмениТаблицы(ИмяТаблицы)
	ЧастиИмени = СтрРазделить(ИмяТаблицы, ".");
	Если ЧастиИмени.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат ЧастиИмени[0];
КонецФункции

Функция ПоследнийСегмент(Имя)
	ЧастиИмени = СтрРазделить(Имя, ".");
	Если ЧастиИмени.Количество() = 0 Тогда
		Возврат Имя;
	КонецЕсли;
	
	Возврат ЧастиИмени[ЧастиИмени.ВГраница()];
КонецФункции

#КонецОбласти

#КонецЕсли
