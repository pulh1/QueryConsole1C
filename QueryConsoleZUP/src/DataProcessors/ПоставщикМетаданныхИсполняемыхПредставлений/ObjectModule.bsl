#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОписаниеПеременных

Перем ОписанияТаблицПоИменам;
Перем КраткиеОписанияТаблицПоИменам;
Перем ОписанияПолейПоИменам;
Перем СегментыПоставщика;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Инициализирует принадлежащий экземпляру положительный кэш нейтральных описаний.
//
// Возвращаемое значение:
//  ОбработкаОбъект.ПоставщикМетаданныхИсполняемыхПредставлений - Этот поставщик.
Функция Инициализировать() Экспорт

	Если ОписанияТаблицПоИменам <> Неопределено Тогда
		Возврат ЭтотОбъект;
	КонецЕсли;

	ОписанияТаблицПоИменам = Новый Соответствие;
	КраткиеОписанияТаблицПоИменам = Новый Соответствие;
	ОписанияПолейПоИменам = Новый Соответствие;
	СегментыПоставщика = Новый Массив;
	СегментыПоставщика.Добавить("ИсполняемоеПредставление");

	Возврат ЭтотОбъект;

КонецФункции

// Возвращает стабильное имя поставщика.
//
// Возвращаемое значение:
//  Строка - Имя поставщика.
Функция ИмяПоставщика() Экспорт

	Возврат "ИсполняемыеПредставления";

КонецФункции

// Возвращает сегмент имен исполняемых представлений.
//
// Возвращаемое значение:
//  Массив из Строка - Единственный сегмент исполняемых представлений.
Функция Сегменты() Экспорт

	Возврат СегментыПоставщика;

КонецФункции

// Возвращает дочерние элементы ленивого каталога исполняемых представлений.
//
// Параметры:
//  ИдентификаторРодителя - Строка, Неопределено - Идентификатор раскрываемой группы.
//
// Возвращаемое значение:
//  Массив из Структура - Transport-safe элементы каталога.
Функция ДочерниеЭлементы(ИдентификаторРодителя = Неопределено) Экспорт

	Элементы = Новый Массив;
	Если ИдентификаторРодителя = Неопределено Тогда
		Элементы.Добавить(МетаданныеТаблицЗапроса.НовыйЭлементКаталога(
			"Представления",
			Неопределено,
			Неопределено,
			"Представления",
			Истина,
			Истина,
			"ИсполняемаяГруппа"));
		Возврат Элементы;
	КонецЕсли;

	Если ИдентификаторРодителя = "Представления" Тогда
		ИменаГрупп = ПоставщикИсполняемыхПредставлений.ГруппыИсполняемыхПредставлений();
		Для Каждого ИмяГруппы Из ИменаГрупп Цикл
			Элементы.Добавить(НовыйЭлементГруппы(ИмяГруппы, "Представления"));
		КонецЦикла;
		Возврат Элементы;
	КонецЕсли;

	ИменаГрупп = ПоставщикИсполняемыхПредставлений.ИменаДочернихГрупп(
		ИдентификаторРодителя);
	Для Каждого ИмяГруппы Из ИменаГрупп Цикл
		Элементы.Добавить(НовыйЭлементГруппы(ИмяГруппы, ИдентификаторРодителя));
	КонецЦикла;

	ИменаТаблиц =
		ПоставщикИсполняемыхПредставлений.ИменаТаблицПредставленийВходящихВГруппу(
			ИдентификаторРодителя);
	Для Каждого ИмяТаблицы Из ИменаТаблиц Цикл
		Элементы.Добавить(МетаданныеТаблицЗапроса.НовыйЭлементКаталога(
			ИмяТаблицы,
			ИдентификаторРодителя,
			ИмяТаблицы,
			ПоследнийСегмент(ИмяТаблицы),
			Ложь,
			Истина,
			"ИсполняемоеПредставление"));
	КонецЦикла;

	Возврат Элементы;

КонецФункции

// Проверяет наличие исполняемого представления.
//
// Параметры:
//  ИмяТаблицы - Строка - Полное имя таблицы.
//
// Возвращаемое значение:
//  Булево - Истина, если исполняемое представление найдено.
Функция ТаблицаСуществует(ИмяТаблицы) Экспорт

	Если ОписанияТаблицПоИменам.Получить(ВРег(ИмяТаблицы)) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат ПоставщикИсполняемыхПредставлений.ОписаниеПредставленияПоИмениТаблицы(
		ИмяТаблицы) <> Неопределено;

КонецФункции

// Возвращает краткое описание исполняемого представления без полей и параметров.
//
// Параметры:
//  ИмяТаблицы - Строка - Полное имя таблицы.
//
// Возвращаемое значение:
//  Неопределено - Исполняемое представление с указанным именем не найдено.
//  Структура - Краткое описание найденного представления:
// * ИмяТаблицы - Строка
// * ИмяПоставщика - Строка
// * ВидИсточника - Строка
// * Представление - Строка
// * ДанныеПоставщика - Произвольный
Функция НайтиТаблицу(ИмяТаблицы) Экспорт

	КлючКэша = ВРег(ИмяТаблицы);
	Описание = КраткиеОписанияТаблицПоИменам.Получить(КлючКэша);
	Если Описание <> Неопределено Тогда
		Возврат Описание;
	КонецЕсли;

	СыроеОписание = ПоставщикИсполняемыхПредставлений.ОписаниеПредставленияПоИмениТаблицы(
		ИмяТаблицы);
	Если СыроеОписание = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ИмяТаблицыОписания = ПолучитьСвойство(СыроеОписание, "ИмяТаблицы", ИмяТаблицы);
	Представление = ПолучитьСвойство(СыроеОписание, "Имя", ИмяТаблицыОписания);
	Описание = МетаданныеТаблицЗапроса.НовоеКраткоеОписаниеТаблицы(
		ИмяТаблицыОписания,
		ИмяПоставщика(),
		"ИсполняемоеПредставление",
		Представление);
	Описание.ДанныеПоставщика = СыроеОписание;
	КраткиеОписанияТаблицПоИменам.Вставить(КлючКэша, Описание);
	Возврат Описание;

КонецФункции

// Возвращает описание только запрошенного поля исполняемого представления.
//
// Параметры:
//  ИмяТаблицы - Строка - Полное имя таблицы.
//  ИмяПоля - Строка - Имя поля.
//
// Возвращаемое значение:
//  Неопределено - Поле с указанным именем не найдено.
//  Структура - Описание найденного поля:
// * Имя - Строка
// * Представление - Строка
// * ВидПоля - Строка
// * ТипЗначения - Произвольный
// * Роль - Строка
// * Поля - Массив из Структура
// * ДанныеПоставщика - Произвольный
Функция НайтиПоле(ИмяТаблицы, ИмяПоля) Экспорт

	КлючКэша = ВРег(ИмяТаблицы) + Символы.ПС + ВРег(ИмяПоля);
	Описание = ОписанияПолейПоИменам.Получить(КлючКэша);
	Если Описание <> Неопределено Тогда
		Возврат Описание;
	КонецЕсли;

	СыроеОписание = ПоставщикИсполняемыхПредставлений.ОписаниеПредставленияПоИмениТаблицы(
		ИмяТаблицы);
	Если СыроеОписание = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПоляПоИменам = ПолучитьСвойство(СыроеОписание, "ПоляПоИменам", Неопределено);
	Если ПоляПоИменам = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	СыроеПоле = ПоляПоИменам.Получить(ВРег(ИмяПоля));
	Если СыроеПоле = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Описание = ПреобразоватьПоле(СыроеПоле);
	ОписанияПолейПоИменам.Вставить(КлючКэша, Описание);
	Возврат Описание;

КонецФункции

// Возвращает нейтральное описание исполняемого представления.
//
// Параметры:
//  ИмяТаблицы - Строка - Полное имя таблицы.
//
// Возвращаемое значение:
//  Неопределено - Исполняемое представление с указанным именем не найдено.
//  Структура - Нейтральное описание найденного представления.
Функция ОписаниеТаблицы(ИмяТаблицы) Экспорт

	КлючКэша = ВРег(ИмяТаблицы);
	Описание = ОписанияТаблицПоИменам.Получить(КлючКэша);
	Если Описание <> Неопределено Тогда
		Возврат Описание;
	КонецЕсли;

	СыроеОписание = ПоставщикИсполняемыхПредставлений.ОписаниеПредставленияПоИмениТаблицы(
		ИмяТаблицы);
	Если СыроеОписание = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Описание = ПреобразоватьТаблицу(СыроеОписание);
	ОписанияТаблицПоИменам.Вставить(КлючКэша, Описание);
	Возврат Описание;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыйЭлементГруппы(Идентификатор, ИдентификаторРодителя)

	Возврат МетаданныеТаблицЗапроса.НовыйЭлементКаталога(
		Идентификатор,
		ИдентификаторРодителя,
		Неопределено,
		ПоследнийСегмент(Идентификатор),
		Истина,
		Истина,
		"ИсполняемаяГруппа");

КонецФункции

Функция ПоследнийСегмент(Имя)

	ЧастиИмени = СтрРазделить(Имя, ".");
	Если ЧастиИмени.Количество() = 0 Тогда
		Возврат Имя;
	КонецЕсли;

	Возврат ЧастиИмени[ЧастиИмени.ВГраница()];

КонецФункции

Функция ПреобразоватьТаблицу(СыроеОписание)

	ИмяТаблицы = ПолучитьСвойство(СыроеОписание, "ИмяТаблицы", "");
	Представление = ПолучитьСвойство(СыроеОписание, "Имя", ИмяТаблицы);
	Описание = МетаданныеТаблицЗапроса.НовыйОписаниеТаблицы(
		ИмяТаблицы,
		ИмяПоставщика(),
		"ИсполняемоеПредставление",
		Представление);
	Описание.ДанныеПоставщика = СыроеОписание;

	СырыеПоля = ПолучитьСвойство(СыроеОписание, "Поля", Неопределено);
	Если СырыеПоля <> Неопределено Тогда
		Для Каждого СыроеПоле Из СырыеПоля Цикл
			Описание.Поля.Добавить(ПреобразоватьПоле(СыроеПоле));
		КонецЦикла;
	КонецЕсли;

	СырыеПараметры = ПолучитьСвойство(
		СыроеОписание, "ОписаниеПараметров", Неопределено);
	Если СырыеПараметры <> Неопределено Тогда
		Для Каждого СыройПараметр Из СырыеПараметры Цикл
			Описание.Параметры.Добавить(ПреобразоватьПараметр(СыройПараметр));
		КонецЦикла;
	КонецЕсли;

	ОписаниеВТФильтра = ПолучитьСвойство(
		СыроеОписание, "ОписаниеВТФильтр", Неопределено);
	Если ОписаниеВТФильтра <> Неопределено Тогда
		Описание.Параметры.Добавить(ПреобразоватьПараметр(
			ОписаниеВТФильтра, "ВТФильтр", "ОписаниеВТФильтра"));
	КонецЕсли;

	ОписаниеОтбора = ПолучитьСвойство(СыроеОписание, "ОписаниеОтбора", Неопределено);
	Если ОписаниеОтбора <> Неопределено
		И ПолучитьСвойство(ОписаниеОтбора, "ДоступенВПараметрах", Ложь) Тогда

		Описание.Параметры.Добавить(ПреобразоватьПараметр(
			ОписаниеОтбора, "Отбор", "ОписаниеОтбора"));
	КонецЕсли;

	Возврат Описание;

КонецФункции

Функция ПреобразоватьПоле(СыроеПоле)

	Если ТипЗнч(СыроеПоле) = Тип("Строка") Тогда
		ИмяПоля = СыроеПоле;
		ТипЗначения = Неопределено;
		Роль = "";
	Иначе
		ИмяПоля = ПолучитьСвойство(СыроеПоле, "Имя", "");
		ТипЗначения = ПолучитьСвойство(СыроеПоле, "ТипЗначения", Неопределено);
		Роль = ПолучитьСвойство(СыроеПоле, "Роль", "");
	КонецЕсли;

	Описание = МетаданныеТаблицЗапроса.НовыйОписаниеПоля(
		ИмяПоля,
		ИмяПоля,
		МетаданныеТаблицЗапроса.ВидПоляОбычное(),
		ТипЗначения,
		Роль);
	Описание.ДанныеПоставщика = СыроеПоле;
	Возврат Описание;

КонецФункции

Функция ПреобразоватьПараметр(
	СыройПараметр, ИмяПоУмолчанию = "", ТипПоУмолчанию = "")

	ИмяПараметра = ПолучитьСвойство(СыройПараметр, "Имя", ИмяПоУмолчанию);
	ТипПараметра = ПолучитьСвойство(СыройПараметр, "Тип", ТипПоУмолчанию);
	ТипЗначения = Неопределено;
	Обязательный = Ложь;
	СырыеВарианты = Неопределено;
	СырыеПоля = Неопределено;
	СырыеДопустимыеТипы = ПолучитьСвойство(
		СыройПараметр, "ДопустимыеТипы", Неопределено);
	ДопустимПараметрЗапроса = ПолучитьСвойство(
		СыройПараметр, "ДопустимПараметрЗапроса", Ложь);
	ЗначениеПоУмолчанию = ПолучитьСвойство(
		СыройПараметр, "ЗначениеПоУмолчанию", Неопределено);

	Если ТипПараметра = "ОписаниеПараметраКонстанта" Тогда
		ТипЗначения = ПолучитьСвойство(
			СыройПараметр, "ТипКонстанты", Неопределено);
		Обязательный = ПолучитьСвойство(
			СыройПараметр, "Обязательный", Ложь);
		СырыеВарианты = ПолучитьСвойство(
			СыройПараметр, "ДоступныеЗначения", Неопределено);
	ИначеЕсли ТипПараметра = "ОписаниеВТФильтра" Тогда
		Обязательный = ПолучитьСвойство(
			СыройПараметр, "Обязательный", Ложь);
		СырыеПоля = ПолучитьСвойство(
			СыройПараметр, "ПоляФильтра", Неопределено);
	ИначеЕсли ТипПараметра = "ОписаниеОтбора" Тогда
		СырыеПоля = ПолучитьСвойство(
			СыройПараметр, "ДоступныеПоля", Неопределено);
	КонецЕсли;

	Описание = МетаданныеТаблицЗапроса.НовыйОписаниеПараметра(
		ИмяПараметра,
		ТипПараметра,
		ТипЗначения,
		Обязательный);
	Описание.ДопустимПараметрЗапроса = ДопустимПараметрЗапроса;
	Описание.ЗначениеПоУмолчанию = ЗначениеПоУмолчанию;
	Описание.ДанныеПоставщика = СыройПараметр;

	Если СырыеДопустимыеТипы <> Неопределено Тогда
		Для Каждого ДопустимыйТип Из СырыеДопустимыеТипы Цикл
			Описание.ДопустимыеТипы.Добавить(ДопустимыйТип);
		КонецЦикла;
	КонецЕсли;

	Если СырыеВарианты <> Неопределено Тогда
		Для Каждого СыройВариант Из СырыеВарианты Цикл
			Описание.Варианты.Добавить(СыройВариант);
		КонецЦикла;
	КонецЕсли;

	Если СырыеПоля <> Неопределено Тогда
		Для Каждого СыроеПоле Из СырыеПоля Цикл
			Описание.Поля.Добавить(ПреобразоватьПолеПараметра(СыроеПоле));
		КонецЦикла;
	КонецЕсли;

	Возврат Описание;

КонецФункции

Функция ПреобразоватьПолеПараметра(СыроеПоле)

	Если ТипЗнч(СыроеПоле) = Тип("Строка") Тогда
		Возврат МетаданныеТаблицЗапроса.НовыйОписаниеПоляПараметра(СыроеПоле);
	КонецЕсли;

	Возврат МетаданныеТаблицЗапроса.НовыйОписаниеПоляПараметра(
		ПолучитьСвойство(СыроеПоле, "Имя", ""),
		ПолучитьСвойство(СыроеПоле, "Обязательный", Ложь),
		ПолучитьСвойство(СыроеПоле, "Устарело", Ложь));

КонецФункции

Функция ПолучитьСвойство(Источник, ИмяСвойства, ЗначениеПоУмолчанию)

	ЗначениеСвойства = Неопределено;
	Если Источник.Свойство(ИмяСвойства, ЗначениеСвойства) Тогда
		Возврат ЗначениеСвойства;
	КонецЕсли;

	Возврат ЗначениеПоУмолчанию;

КонецФункции

#КонецОбласти

#КонецЕсли
