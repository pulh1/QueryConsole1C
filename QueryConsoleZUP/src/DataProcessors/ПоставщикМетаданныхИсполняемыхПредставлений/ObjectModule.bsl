#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОписаниеПеременных

Перем ОписанияТаблицПоИменам;
Перем СегментыПоставщика;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Инициализирует принадлежащий экземпляру положительный кэш нейтральных описаний.
//
// Возвращаемое значение:
//  ОбработкаОбъект.ПоставщикМетаданныхИсполняемыхПредставлений - Этот поставщик.
Функция Инициализировать() Экспорт

	Если ОписанияТаблицПоИменам <> Неопределено Тогда
		Возврат ЭтотОбъект;
	КонецЕсли;

	ОписанияТаблицПоИменам = Новый Соответствие;
	СегментыПоставщика = Новый Массив;
	СегментыПоставщика.Добавить("ИсполняемоеПредставление");

	Возврат ЭтотОбъект;

КонецФункции

// Возвращает стабильное имя поставщика.
//
// Возвращаемое значение:
//  Строка - Имя поставщика.
Функция ИмяПоставщика() Экспорт

	Возврат "ИсполняемыеПредставления";

КонецФункции

// Возвращает сегмент имен исполняемых представлений.
//
// Возвращаемое значение:
//  Массив из Строка - Единственный сегмент исполняемых представлений.
Функция Сегменты() Экспорт

	Возврат СегментыПоставщика;

КонецФункции

// Проверяет наличие исполняемого представления.
//
// Параметры:
//  ИмяТаблицы - Строка - Полное имя таблицы.
//
// Возвращаемое значение:
//  Булево - Истина, если исполняемое представление найдено.
Функция ТаблицаСуществует(ИмяТаблицы) Экспорт

	Если ОписанияТаблицПоИменам.Получить(ВРег(ИмяТаблицы)) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат ПоставщикИсполняемыхПредставлений.ОписаниеПредставленияПоИмениТаблицы(
		ИмяТаблицы) <> Неопределено;

КонецФункции

// Возвращает нейтральное описание исполняемого представления.
//
// Параметры:
//  ИмяТаблицы - Строка - Полное имя таблицы.
//
// Возвращаемое значение:
//  Неопределено - Исполняемое представление с указанным именем не найдено.
//  Структура - Нейтральное описание найденного представления.
Функция ОписаниеТаблицы(ИмяТаблицы) Экспорт

	КлючКэша = ВРег(ИмяТаблицы);
	Описание = ОписанияТаблицПоИменам.Получить(КлючКэша);
	Если Описание <> Неопределено Тогда
		Возврат Описание;
	КонецЕсли;

	СыроеОписание = ПоставщикИсполняемыхПредставлений.ОписаниеПредставленияПоИмениТаблицы(
		ИмяТаблицы);
	Если СыроеОписание = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Описание = ПреобразоватьТаблицу(СыроеОписание);
	ОписанияТаблицПоИменам.Вставить(КлючКэша, Описание);
	Возврат Описание;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПреобразоватьТаблицу(СыроеОписание)

	ИмяТаблицы = ПолучитьСвойство(СыроеОписание, "ИмяТаблицы", "");
	Представление = ПолучитьСвойство(СыроеОписание, "Имя", ИмяТаблицы);
	Описание = МетаданныеТаблицЗапроса.НовыйОписаниеТаблицы(
		ИмяТаблицы,
		ИмяПоставщика(),
		"ИсполняемоеПредставление",
		Представление);
	Описание.ДанныеПоставщика = СыроеОписание;

	СырыеПоля = ПолучитьСвойство(СыроеОписание, "Поля", Неопределено);
	Если СырыеПоля <> Неопределено Тогда
		Для Каждого СыроеПоле Из СырыеПоля Цикл
			Описание.Поля.Добавить(ПреобразоватьПоле(СыроеПоле));
		КонецЦикла;
	КонецЕсли;

	СырыеПараметры = ПолучитьСвойство(
		СыроеОписание, "ОписаниеПараметров", Неопределено);
	Если СырыеПараметры <> Неопределено Тогда
		Для Каждого СыройПараметр Из СырыеПараметры Цикл
			Описание.Параметры.Добавить(ПреобразоватьПараметр(СыройПараметр));
		КонецЦикла;
	КонецЕсли;

	ОписаниеВТФильтра = ПолучитьСвойство(
		СыроеОписание, "ОписаниеВТФильтр", Неопределено);
	Если ОписаниеВТФильтра <> Неопределено Тогда
		Описание.Параметры.Добавить(ПреобразоватьПараметр(
			ОписаниеВТФильтра, "ВТФильтр", "ОписаниеВТФильтра"));
	КонецЕсли;

	ОписаниеОтбора = ПолучитьСвойство(СыроеОписание, "ОписаниеОтбора", Неопределено);
	Если ОписаниеОтбора <> Неопределено
		И ПолучитьСвойство(ОписаниеОтбора, "ДоступенВПараметрах", Ложь) Тогда

		Описание.Параметры.Добавить(ПреобразоватьПараметр(
			ОписаниеОтбора, "Отбор", "ОписаниеОтбора"));
	КонецЕсли;

	Возврат Описание;

КонецФункции

Функция ПреобразоватьПоле(СыроеПоле)

	Если ТипЗнч(СыроеПоле) = Тип("Строка") Тогда
		ИмяПоля = СыроеПоле;
		ТипЗначения = Неопределено;
		Роль = "";
	Иначе
		ИмяПоля = ПолучитьСвойство(СыроеПоле, "Имя", "");
		ТипЗначения = ПолучитьСвойство(СыроеПоле, "ТипЗначения", Неопределено);
		Роль = ПолучитьСвойство(СыроеПоле, "Роль", "");
	КонецЕсли;

	Описание = МетаданныеТаблицЗапроса.НовыйОписаниеПоля(
		ИмяПоля,
		ИмяПоля,
		МетаданныеТаблицЗапроса.ВидПоляОбычное(),
		ТипЗначения,
		Роль);
	Описание.ДанныеПоставщика = СыроеПоле;
	Возврат Описание;

КонецФункции

Функция ПреобразоватьПараметр(
	СыройПараметр, ИмяПоУмолчанию = "", ТипПоУмолчанию = "")

	ИмяПараметра = ПолучитьСвойство(СыройПараметр, "Имя", ИмяПоУмолчанию);
	ТипПараметра = ПолучитьСвойство(СыройПараметр, "Тип", ТипПоУмолчанию);
	ТипЗначения = Неопределено;
	Обязательный = Ложь;
	СырыеВарианты = Неопределено;
	СырыеПоля = Неопределено;

	Если ТипПараметра = "ОписаниеПараметраКонстанта" Тогда
		ТипЗначения = ПолучитьСвойство(
			СыройПараметр, "ТипКонстанты", Неопределено);
		Обязательный = ПолучитьСвойство(
			СыройПараметр, "Обязательный", Ложь);
		СырыеВарианты = ПолучитьСвойство(
			СыройПараметр, "ДоступныеЗначения", Неопределено);
	ИначеЕсли ТипПараметра = "ОписаниеВТФильтра" Тогда
		Обязательный = ПолучитьСвойство(
			СыройПараметр, "Обязательный", Ложь);
		СырыеПоля = ПолучитьСвойство(
			СыройПараметр, "ПоляФильтра", Неопределено);
	ИначеЕсли ТипПараметра = "ОписаниеОтбора" Тогда
		СырыеПоля = ПолучитьСвойство(
			СыройПараметр, "ДоступныеПоля", Неопределено);
	КонецЕсли;

	Описание = МетаданныеТаблицЗапроса.НовыйОписаниеПараметра(
		ИмяПараметра,
		ТипПараметра,
		ТипЗначения,
		Обязательный);
	Описание.ДанныеПоставщика = СыройПараметр;

	Если СырыеВарианты <> Неопределено Тогда
		Для Каждого СыройВариант Из СырыеВарианты Цикл
			Описание.Варианты.Добавить(СыройВариант);
		КонецЦикла;
	КонецЕсли;

	Если СырыеПоля <> Неопределено Тогда
		Для Каждого СыроеПоле Из СырыеПоля Цикл
			Описание.Поля.Добавить(ПреобразоватьПоле(СыроеПоле));
		КонецЦикла;
	КонецЕсли;

	Возврат Описание;

КонецФункции

Функция ПолучитьСвойство(Источник, ИмяСвойства, ЗначениеПоУмолчанию)

	ЗначениеСвойства = Неопределено;
	Если Источник.Свойство(ИмяСвойства, ЗначениеСвойства) Тогда
		Возврат ЗначениеСвойства;
	КонецЕсли;

	Возврат ЗначениеПоУмолчанию;

КонецФункции

#КонецОбласти

#КонецЕсли
