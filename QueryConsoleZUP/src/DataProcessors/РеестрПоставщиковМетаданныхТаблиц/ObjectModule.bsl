#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОписаниеПеременных

Перем Поставщики;
Перем ПоставщикиПоСегментам;
Перем КонтекстныеПоставщики;
Перем РежимЖизненногоЦикла;
Перем ОписанияВременныхТаблиц;
Перем ИндексЗапросаПакета;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Инициализирует реестр поставщиков метаданных таблиц.
//
// Параметры:
//  Режим - Строка - режим жизненного цикла реестра.
//  ОписанияВТПараметр - Массив, Неопределено - доступные временные таблицы.
//  ИндексЗапросаПакетаПараметр - Число - индекс текущего запроса пакета.
//
// Возвращаемое значение:
//  ОбработкаОбъект.РеестрПоставщиковМетаданныхТаблиц - инициализированный реестр.
Функция Инициализировать(Режим = "ОбработкаЗапроса", ОписанияВТПараметр = Неопределено, ИндексЗапросаПакетаПараметр = -1) Экспорт
	Поставщики = Новый Массив();
	ПоставщикиПоСегментам = Новый Соответствие();
	КонтекстныеПоставщики = Новый Массив();
	РежимЖизненногоЦикла = Режим;
	ИндексЗапросаПакета = ИндексЗапросаПакетаПараметр;
	
	Если ОписанияВТПараметр = Неопределено Тогда
		ОписанияВременныхТаблиц = Новый Массив();
	Иначе
		ОписанияВременныхТаблиц = ОписанияВТПараметр;
	КонецЕсли;
	
	ЗарегистрироватьВстроенныеПоставщики();
	
	Возврат ЭтотОбъект;
КонецФункции

Функция Режим() Экспорт
	Возврат РежимЖизненногоЦикла;
КонецФункции

Функция ПервыйСегментИмениТаблицы(ИмяТаблицы) Экспорт
	ЧастиИмени = СтрРазделить(ИмяТаблицы, ".");
	Если ЧастиИмени.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат ЧастиИмени[0];
КонецФункции

Функция РазрешитьПоставщика(ИмяТаблицы) Экспорт
	ПервыйСегмент = ПервыйСегментИмениТаблицы(ИмяТаблицы);
	Поставщик = ПоставщикиПоСегментам.Получить(ВРег(ПервыйСегмент));
	Если Поставщик <> Неопределено Тогда
		Возврат Поставщик;
	КонецЕсли;
	
	Если СтрНайти(ИмяТаблицы, ".") > 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Для Каждого КонтекстныйПоставщик Из КонтекстныеПоставщики Цикл
		Если ПоставщикТаблицаСуществует(КонтекстныйПоставщик, ИмяТаблицы) Тогда
			Возврат КонтекстныйПоставщик;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
КонецФункции

Функция ТаблицаСуществует(ИмяТаблицы) Экспорт
	Поставщик = РазрешитьПоставщика(ИмяТаблицы);
	Возврат Поставщик <> Неопределено И ПоставщикТаблицаСуществует(Поставщик, ИмяТаблицы);
КонецФункции

Функция ОписаниеТаблицы(ИмяТаблицы) Экспорт
	Поставщик = РазрешитьПоставщика(ИмяТаблицы);
	Если Поставщик = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ПоставщикОписаниеТаблицы(Поставщик, ИмяТаблицы);
КонецФункции

Функция ПоляТаблицы(ИмяТаблицы) Экспорт
	ОписаниеТаблицыПоставщика = ОписаниеТаблицы(ИмяТаблицы);
	Если ОписаниеТаблицыПоставщика = Неопределено Тогда
		Возврат Новый Массив();
	КонецЕсли;

	Возврат ОписаниеТаблицыПоставщика.Поля;
КонецФункции

Функция ПараметрыТаблицы(ИмяТаблицы) Экспорт
	ОписаниеТаблицыПоставщика = ОписаниеТаблицы(ИмяТаблицы);
	Если ОписаниеТаблицыПоставщика = Неопределено Тогда
		Возврат Новый Массив();
	КонецЕсли;

	Возврат ОписаниеТаблицыПоставщика.Параметры;
КонецФункции

Функция ДочерниеЭлементы(ИдентификаторРодителя = Неопределено, ИмяПоставщика = Неопределено) Экспорт
	Если ИмяПоставщика = Неопределено Тогда
		Возврат КорневыеЭлементыПоставщиков();
	КонецЕсли;
	
	Поставщик = ПоставщикПоИмени(ИмяПоставщика);
	Если Поставщик = Неопределено Тогда
		Возврат Новый Массив();
	КонецЕсли;
	
	Возврат ПоставщикДочерниеЭлементы(Поставщик, ИдентификаторРодителя);
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Функция НовыйОписаниеТаблицы(ИмяТаблицы = "", ВидПоставщика = "") Экспорт
	Описание = Новый Структура;
	Описание.Вставить("Тип", "ОписаниеТаблицыПоставщикаМетаданных");
	Описание.Вставить("ИмяТаблицы", ИмяТаблицы);
	Описание.Вставить("ПервыйСегмент", ПервыйСегментИмениТаблицы(ИмяТаблицы));
	Описание.Вставить("ВидПоставщика", ВидПоставщика);
	Описание.Вставить("Представление", ИмяТаблицы);
	Описание.Вставить("Поля", Новый Массив());
	Описание.Вставить("Параметры", Новый Массив());
	Описание.Вставить("ДочерниеЭлементы", Новый Массив());
	Описание.Вставить("ИсходноеОписание", Неопределено);
	
	Возврат Описание;
КонецФункции

Функция НовыйПолеТаблицы(Имя = "", ТипЗначения = Неопределено, ВидПоставщика = "") Экспорт
	Поле = Новый Структура;
	Поле.Вставить("Тип", "ПолеТаблицыПоставщикаМетаданных");
	Поле.Вставить("Имя", Имя);
	Поле.Вставить("Представление", Имя);
	Поле.Вставить("ТипЗначения", ТипЗначения);
	Поле.Вставить("ВидПоставщика", ВидПоставщика);
	Поле.Вставить("Поля", Новый Массив());
	Поле.Вставить("Роль", Неопределено);
	Поле.Вставить("ИсходноеОписание", Неопределено);
	
	Возврат Поле;
КонецФункции

Функция НовыйПараметрТаблицы(Имя = "", ТипЗначения = Неопределено, Обязательный = Ложь) Экспорт
	Параметр = Новый Структура;
	Параметр.Вставить("Тип", "ПараметрТаблицыПоставщикаМетаданных");
	Параметр.Вставить("Имя", Имя);
	Параметр.Вставить("ТипЗначения", ТипЗначения);
	Параметр.Вставить("Обязательный", Обязательный);
	Параметр.Вставить("ИсходноеОписание", Неопределено);
	
	Возврат Параметр;
КонецФункции

Функция НовыйЭлементИерархии(Идентификатор = "", Наименование = "", ЭтоГруппа = Ложь, ВидПоставщика = "") Экспорт
	Элемент = Новый Структура;
	Элемент.Вставить("Тип", "ЭлементИерархииПоставщикаМетаданных");
	Элемент.Вставить("Идентификатор", Идентификатор);
	Элемент.Вставить("Имя", Идентификатор);
	Элемент.Вставить("Наименование", Наименование);
	Элемент.Вставить("Представление", Наименование);
	Элемент.Вставить("ЭтоГруппа", ЭтоГруппа);
	Элемент.Вставить("ВидПоставщика", ВидПоставщика);
	Элемент.Вставить("ТипЗначения", "");
	Элемент.Вставить("ЕстьДочерниеЭлементы", Истина);
	Элемент.Вставить("ИсходноеОписание", Неопределено);
	
	Возврат Элемент;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗарегистрироватьВстроенныеПоставщики()
	ЗарегистрироватьПоставщика(НовыйПоставщикСтандартныхТаблиц());
	ЗарегистрироватьПоставщика(НовыйПоставщикИсполняемыхПредставлений());
	ЗарегистрироватьПоставщика(НовыйПоставщикВременныхТаблиц());
КонецПроцедуры

Процедура ЗарегистрироватьПоставщика(Поставщик)
	Поставщики.Добавить(Поставщик);
	
	Если Поставщик.Контекстный() Тогда
		КонтекстныеПоставщики.Добавить(Поставщик);
		Возврат;
	КонецЕсли;
	
	Для Каждого Сегмент Из Поставщик.Сегменты() Цикл
		ПоставщикиПоСегментам.Вставить(ВРег(Сегмент), Поставщик);
	КонецЦикла;
КонецПроцедуры

Функция НовыйПоставщикСтандартныхТаблиц()
	Поставщик = Обработки.ПоставщикМетаданныхСтандартныхТаблиц.Создать();
	Возврат Поставщик.Инициализировать();
КонецФункции

Функция НовыйПоставщикИсполняемыхПредставлений()
	Поставщик = Обработки.ПоставщикМетаданныхИсполняемыхПредставлений.Создать();
	Возврат Поставщик.Инициализировать();
КонецФункции

Функция НовыйПоставщикВременныхТаблиц()
	Поставщик = Обработки.ПоставщикМетаданныхВременныхТаблиц.Создать();
	Возврат Поставщик.Инициализировать(ОписанияВременныхТаблиц, ИндексЗапросаПакета);
КонецФункции

Функция ПоставщикПоИмени(ИмяПоставщика)
	Для Каждого Поставщик Из Поставщики Цикл
		Если Поставщик.ИмяПоставщика() = ИмяПоставщика Тогда
			Возврат Поставщик;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
КонецФункции

Функция ПоставщикТаблицаСуществует(Поставщик, ИмяТаблицы)
	Возврат Поставщик.ТаблицаСуществует(ИмяТаблицы);
КонецФункции

Функция ПоставщикОписаниеТаблицы(Поставщик, ИмяТаблицы)
	Возврат Поставщик.ОписаниеТаблицы(ИмяТаблицы);
КонецФункции

Функция ПоставщикДочерниеЭлементы(Поставщик, ИдентификаторРодителя)
	Возврат Поставщик.ДочерниеЭлементы(ИдентификаторРодителя);
КонецФункции

Функция КорневыеЭлементыПоставщиков()
	Элементы = Новый Массив();
	Для Каждого Поставщик Из Поставщики Цикл
		Если Поставщик.Контекстный() И Поставщик.ДочерниеЭлементы().Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Элемент = НовыйЭлементИерархии(Поставщик.ИмяПоставщика(), Поставщик.ПредставлениеПоставщика(), Истина, Поставщик.ИмяПоставщика());
		Элемент.ТипЗначения = "ГруппаПоставщикаМетаданных";
		Элементы.Добавить(Элемент);
	КонецЦикла;
	
	Возврат Элементы;
КонецФункции
#КонецОбласти

#КонецЕсли
