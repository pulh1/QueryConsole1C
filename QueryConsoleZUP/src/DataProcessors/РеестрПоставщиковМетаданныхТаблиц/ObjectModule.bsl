#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОписаниеПеременных

Перем ИндексПоставщиковПоСегментам;
Перем ИнициализированныеПоставщики;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Инициализирует поставщиков и атомарно заменяет индекс сегментов.
//
// Параметры:
//  Поставщики - Массив из Произвольный, Неопределено - Поставщики для регистрации.
//
// Возвращаемое значение:
//  ОбработкаОбъект.РеестрПоставщиковМетаданныхТаблиц - Этот реестр.
Функция Инициализировать(Поставщики) Экспорт

	Если Поставщики = Неопределено Тогда
		Поставщики = Новый Массив;
	КонецЕсли;

	НовыеПоставщики = Новый Массив;
	Для Каждого Поставщик Из Поставщики Цикл
		НовыеПоставщики.Добавить(Поставщик.Инициализировать());
	КонецЦикла;

	НовыйИндекс = Новый Соответствие;
	Для Каждого Поставщик Из НовыеПоставщики Цикл
		Для Каждого Сегмент Из Поставщик.Сегменты() Цикл
			НормализованныйСегмент = ВРег(Сегмент);
			ЗарегистрированныйПоставщик = НовыйИндекс.Получить(НормализованныйСегмент);
			Если ЗарегистрированныйПоставщик <> Неопределено Тогда
				ВызватьИсключение СтрШаблон(
					"Коллизия сегмента ""%1"": поставщики ""%2"" и ""%3"".",
					Сегмент,
					ЗарегистрированныйПоставщик.ИмяПоставщика(),
					Поставщик.ИмяПоставщика());
			КонецЕсли;
			НовыйИндекс.Вставить(НормализованныйСегмент, Поставщик);
		КонецЦикла;
	КонецЦикла;

	ИндексПоставщиковПоСегментам = НовыйИндекс;
	ИнициализированныеПоставщики = НовыеПоставщики;
	Возврат ЭтотОбъект;

КонецФункции

// Возвращает признак существования таблицы у поставщика ее сегмента.
//
// Параметры:
//  ИмяТаблицы - Строка - Полное имя таблицы.
//
// Возвращаемое значение:
//  Булево - Истина, если поставщик подтверждает существование таблицы.
Функция ТаблицаСуществует(ИмяТаблицы) Экспорт

	Поставщик = ПоставщикТаблицы(ИмяТаблицы);
	Если Поставщик = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Поставщик.ТаблицаСуществует(ИмяТаблицы);

КонецФункции

// Возвращает краткое описание таблицы напрямую от поставщика ее сегмента.
//
// Параметры:
//  ИмяТаблицы - Строка - Полное имя таблицы.
//
// Возвращаемое значение:
//  Структура, Неопределено - Краткое описание или Неопределено.
Функция НайтиТаблицу(ИмяТаблицы) Экспорт

	Поставщик = ПоставщикТаблицы(ИмяТаблицы);
	Если Поставщик = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Поставщик.НайтиТаблицу(ИмяТаблицы);

КонецФункции

// Возвращает точечное описание поля напрямую от поставщика сегмента.
//
// Параметры:
//  ИмяТаблицы - Строка - Полное имя таблицы.
//  ИмяПоля - Строка - Имя поля.
//
// Возвращаемое значение:
//  Структура, Неопределено - Описание поля или Неопределено.
Функция НайтиПоле(ИмяТаблицы, ИмяПоля) Экспорт

	Поставщик = ПоставщикТаблицы(ИмяТаблицы);
	Если Поставщик = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Поставщик.НайтиПоле(ИмяТаблицы, ИмяПоля);

КонецФункции

// Возвращает описание таблицы напрямую от поставщика ее сегмента.
//
// Параметры:
//  ИмяТаблицы - Строка - Полное имя таблицы.
//
// Возвращаемое значение:
//  Структура, Неопределено - Описание таблицы или Неопределено для неизвестного сегмента.
Функция ОписаниеТаблицы(ИмяТаблицы) Экспорт

	Поставщик = ПоставщикТаблицы(ИмяТаблицы);
	Если Поставщик = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Поставщик.ОписаниеТаблицы(ИмяТаблицы);

КонецФункции

// Возвращает корневые элементы каталогов в порядке регистрации поставщиков.
//
// Возвращаемое значение:
//  Массив из Структура - Транспортные элементы с маршрутами реестра.
Функция КорневыеЭлементыКаталога() Экспорт

	Результат = Новый Массив;
	Для Каждого Поставщик Из ИнициализированныеПоставщики Цикл
		Сегменты = Поставщик.Сегменты();
		Если Сегменты.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		ДобавитьМаршрутизированныеЭлементы(
			Результат, Сегменты[0], Поставщик.ДочерниеЭлементы());
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает дочерние элементы по непрозрачному маршруту каталога.
//
// Параметры:
//  МаршрутКаталога - Строка - Маршрут вида "Сегмент|Идентификатор".
//
// Возвращаемое значение:
//  Массив из Структура - Транспортные элементы или пустой массив для неизвестного маршрута.
Функция ДочерниеЭлементыКаталога(МаршрутКаталога) Экспорт

	Если ТипЗнч(МаршрутКаталога) <> Тип("Строка") Тогда
		Возврат Новый Массив;
	КонецЕсли;

	ПозицияРазделителя = СтрНайти(МаршрутКаталога, "|");
	Если ПозицияРазделителя <= 1 Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Сегмент = Лев(МаршрутКаталога, ПозицияРазделителя - 1);
	Идентификатор = Сред(МаршрутКаталога, ПозицияРазделителя + 1);
	Если ПустаяСтрока(Идентификатор) Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Поставщик = ИндексПоставщиковПоСегментам.Получить(ВРег(Сегмент));
	Если Поставщик = Неопределено Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Результат = Новый Массив;
	ДобавитьМаршрутизированныеЭлементы(
		Результат, Сегмент, Поставщик.ДочерниеЭлементы(Идентификатор));
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПоставщикТаблицы(ИмяТаблицы)

	СегментыИмени = СтрРазделить(ИмяТаблицы, ".", Ложь);
	Если СегментыИмени.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ИндексПоставщиковПоСегментам.Получить(ВРег(СегментыИмени[0]));

КонецФункции

Процедура ДобавитьМаршрутизированныеЭлементы(Результат, Сегмент, Элементы)

	Для Каждого Элемент Из Элементы Цикл
		Результат.Добавить(МетаданныеТаблицЗапроса.НовыйЭлементКаталога(
			Элемент.Идентификатор,
			Элемент.ИдентификаторРодителя,
			Элемент.ИмяТаблицы,
			Элемент.Представление,
			Элемент.ЭтоГруппа,
			Элемент.ЕстьДочерние,
			Элемент.ВидИсточника,
			Сегмент + "|" + Элемент.Идентификатор));
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#КонецЕсли
