#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОписаниеПеременных

Перем ОписанияВременныхТаблиц;
Перем ИндексЗапросаПакета;

#КонецОбласти

#Область ПрограммныйИнтерфейс

Функция Инициализировать(ОписанияВТПараметр = Неопределено, ИндексЗапросаПакетаПараметр = -1) Экспорт
	Если ОписанияВТПараметр = Неопределено Тогда
		ОписанияВременныхТаблиц = Новый Массив();
	Иначе
		ОписанияВременныхТаблиц = ОписанияВТПараметр;
	КонецЕсли;
	ИндексЗапросаПакета = ИндексЗапросаПакетаПараметр;
	
	Возврат ЭтотОбъект;
КонецФункции

Функция ИмяПоставщика() Экспорт
	Возврат "ВременныеТаблицы";
КонецФункции

Функция ПредставлениеПоставщика() Экспорт
	Возврат "Временные таблицы";
КонецФункции

Функция Сегменты() Экспорт
	Возврат Новый Массив();
КонецФункции

Функция Контекстный() Экспорт
	Возврат Истина;
КонецФункции

Функция ТаблицаСуществует(ИмяТаблицы) Экспорт
	Если СтрНайти(ИмяТаблицы, ".") > 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат ОписаниеВременнойТаблицы(ИмяТаблицы) <> Неопределено;
КонецФункции

Функция ОписаниеТаблицы(ИмяТаблицы) Экспорт
	ОписаниеВТ = ОписаниеВременнойТаблицы(ИмяТаблицы);
	Если ОписаниеВТ = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Описание = НовыйОписаниеТаблицы(ИмяТаблицы);
	Описание.Представление = ОписаниеВТ.Имя;
	Описание.Поля = ПоляВременнойТаблицы(ОписаниеВТ);
	Описание.ИсходноеОписание = ОписаниеВТ;
	
	Возврат Описание;
КонецФункции

Функция ПоляТаблицы(ИмяТаблицы) Экспорт
	Описание = ОписаниеТаблицы(ИмяТаблицы);
	Если Описание = Неопределено Тогда
		Возврат Новый Массив();
	КонецЕсли;
	
	Возврат Описание.Поля;
КонецФункции

Функция ПараметрыТаблицы(ИмяТаблицы) Экспорт
	Возврат Новый Массив();
КонецФункции

Функция ДочерниеЭлементы(ИдентификаторРодителя = Неопределено) Экспорт
	Если ИдентификаторРодителя <> Неопределено Тогда
		Возврат ПоляТаблицы(ИдентификаторРодителя);
	КонецЕсли;
	
	Элементы = Новый Массив();
	Если ТипЗнч(ОписанияВременныхТаблиц) = Тип("Соответствие") Тогда
		Для Каждого КлючЗначение Из ОписанияВременныхТаблиц Цикл
			ДобавитьЭлементИерархииВременнойТаблицы(Элементы, КлючЗначение.Значение);
		КонецЦикла;
		
		Возврат Элементы;
	КонецЕсли;

	Для Каждого ОписаниеВТ Из ОписанияВременныхТаблиц Цикл
		ДобавитьЭлементИерархииВременнойТаблицы(Элементы, ОписаниеВТ);
	КонецЦикла;

	Возврат Элементы;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыйОписаниеТаблицы(ИмяТаблицы = "")
	Описание = Новый Структура;
	Описание.Вставить("Тип", "ОписаниеТаблицыПоставщикаМетаданных");
	Описание.Вставить("ИмяТаблицы", ИмяТаблицы);
	Описание.Вставить("ПервыйСегмент", ПервыйСегментИмениТаблицы(ИмяТаблицы));
	Описание.Вставить("ВидПоставщика", ИмяПоставщика());
	Описание.Вставить("Представление", ИмяТаблицы);
	Описание.Вставить("Поля", Новый Массив());
	Описание.Вставить("Параметры", Новый Массив());
	Описание.Вставить("ДочерниеЭлементы", Новый Массив());
	Описание.Вставить("ИсходноеОписание", Неопределено);
	
	Возврат Описание;
КонецФункции

Функция НовыйПолеТаблицы(Имя = "", ТипЗначения = Неопределено)
	Поле = Новый Структура;
	Поле.Вставить("Тип", "ПолеТаблицыПоставщикаМетаданных");
	Поле.Вставить("Имя", Имя);
	Поле.Вставить("Представление", Имя);
	Поле.Вставить("ТипЗначения", ТипЗначения);
	Поле.Вставить("ВидПоставщика", ИмяПоставщика());
	Поле.Вставить("Поля", Новый Массив());
	Поле.Вставить("Роль", Неопределено);
	Поле.Вставить("ИсходноеОписание", Неопределено);
	
	Возврат Поле;
КонецФункции

Функция НовыйЭлементИерархии(Идентификатор = "", Наименование = "", ЭтоГруппа = Ложь)
	Элемент = Новый Структура;
	Элемент.Вставить("Тип", "ЭлементИерархииПоставщикаМетаданных");
	Элемент.Вставить("Идентификатор", Идентификатор);
	Элемент.Вставить("Имя", Идентификатор);
	Элемент.Вставить("Наименование", Наименование);
	Элемент.Вставить("Представление", Наименование);
	Элемент.Вставить("ЭтоГруппа", ЭтоГруппа);
	Элемент.Вставить("ВидПоставщика", ИмяПоставщика());
	Элемент.Вставить("ТипЗначения", "ИсточникДанныхВременнаяТаблица");
	Элемент.Вставить("ЕстьДочерниеЭлементы", Истина);
	Элемент.Вставить("ИсходноеОписание", Неопределено);
	
	Возврат Элемент;
КонецФункции

Функция ОписаниеВременнойТаблицы(ИмяТаблицы)
	Если ТипЗнч(ОписанияВременныхТаблиц) = Тип("Соответствие") Тогда
		ОписаниеВТ = ОписанияВременныхТаблиц.Получить(ВРег(ИмяТаблицы));
		Если ОписаниеВТ <> Неопределено
			И МодельЗапросаУтилиты.ВременнаяТаблицаДоступнаВЗапросе(ОписаниеВТ, ИндексЗапросаПакета) Тогда
			
			Возврат ОписаниеВТ;
		КонецЕсли;
		
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат МодельЗапросаУтилиты.НайтиОписаниеДоступнойВТ(ОписанияВременныхТаблиц, ИмяТаблицы, ИндексЗапросаПакета);
КонецФункции

Функция ПоляВременнойТаблицы(ОписаниеВТ)
	Поля = Новый Массив();
	Если ОписаниеВТ = Неопределено Тогда
		Возврат Поля;
	КонецЕсли;
	
	Для Каждого ИмяКолонки Из ОписаниеВТ.ПорядокКолонок Цикл
		Поле = НовыйПолеТаблицы(ИмяКолонки, ОписаниеВТ.Колонки[ИмяКолонки]);
		Поля.Добавить(Поле);
	КонецЦикла;
	
	Возврат Поля;
КонецФункции

Процедура ДобавитьЭлементИерархииВременнойТаблицы(Элементы, ОписаниеВТ)
	Если ОписаниеВТ <> Неопределено И МодельЗапросаУтилиты.ВременнаяТаблицаДоступнаВЗапросе(ОписаниеВТ, ИндексЗапросаПакета) Тогда
		Элементы.Добавить(НовыйЭлементИерархии(ОписаниеВТ.Имя, ОписаниеВТ.Имя, Ложь));
	КонецЕсли;
КонецПроцедуры

Функция ПервыйСегментИмениТаблицы(ИмяТаблицы)
	ЧастиИмени = СтрРазделить(ИмяТаблицы, ".");
	Если ЧастиИмени.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат ЧастиИмени[0];
КонецФункции

#КонецОбласти

#КонецЕсли
