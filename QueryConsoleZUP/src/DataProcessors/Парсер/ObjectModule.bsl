				ЭтотУзел.КоличествоПолучаемыхЗаписей = Значение5;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Значение6 = НеТерминалРасширениеСКД();
	Если Значение6 <> Неопределено Тогда
		Для Каждого ЭлементКоллекции Из Значение6 Цикл
			ЭтотУзел.ОтборыСКД.Добавить(ЭлементКоллекции);
		КонецЦикла;
	КонецЕсли;
	Значение7 = НеТерминалПолеВыборки();
	ЭтотУзел.ВыбираемыеПоля.Добавить(Значение7);
	Значение8 = НеТерминалРасширениеСКД();
	Если Значение8 <> Неопределено Тогда
		Для Каждого ЭлементКоллекции Из Значение8 Цикл
