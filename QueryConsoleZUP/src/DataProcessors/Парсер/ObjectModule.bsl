#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОписаниеПеременных

Перем ТекущийТокен;
Перем ЛексическийАнализатор;
Перем ОпределенияИдентификаторов;
Перем БуферТокенов;
Перем КоличествоПросматриваемыхСимволов;

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Функция Разобрать(Текст) Экспорт
	ЛексическийАнализатор.УстановитьОбрабатываемыйТекст(Текст);
	УстановитьБуферТокенов();
	Возврат РезультатРазбора();
КонецФункции

Функция РазобратьВыражение(Текст) Экспорт
	ЛексическийАнализатор.УстановитьОбрабатываемыйТекст(Текст);
	УстановитьБуферТокенов();
	Возврат РезультатРазбораВыражения();
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Инициализировать()
	ЛексическийАнализатор = Обработки.ЛексическийАнализатор.Создать();
	ЛексическийАнализатор.Инициализировать();
	ОпределенияИдентификаторов = ЗначениеИзСтрокиВнутр(ПолучитьМакет("ОпределенияИдентификаторов").ПолучитьТекст());
	ОпределенияИдентификаторов.Индексы.Добавить("Тип, Идентификатор");
КонецПроцедуры

Функция НовыйБуферТокенов()
	Буфер = Новый Структура("ИндексТекущегоЭлемента, Токены");
	Буфер.ИндексТекущегоЭлемента = -1;
	Буфер.Токены = Новый Массив(КоличествоПросматриваемыхСимволов);
	Возврат Буфер;
КонецФункции

Процедура УстановитьБуферТокенов()
	БуферТокенов = НовыйБуферТокенов();
КонецПроцедуры

Процедура ЗаполнитьБуферТокенов()
	МаксимальныйИндекс = КоличествоПросматриваемыхСимволов - 1;
	Если БуферТокенов.ИндексТекущегоЭлемента > 0 Тогда
		Сдвиг = БуферТокенов.ИндексТекущегоЭлемента;
		Для Индекс = Сдвиг По МаксимальныйИндекс Цикл
			БуферТокенов.Токены[Индекс - Сдвиг] = БуферТокенов.Токены[Индекс];
		КонецЦикла;
		БуферТокенов.ИндексТекущегоЭлемента = 0;
	ИначеЕсли БуферТокенов.ИндексТекущегоЭлемента <> -1 И БуферТокенов.Токены[БуферТокенов.ИндексТекущегоЭлемента] = Неопределено Тогда
		Возврат;
	КонецЕсли;
	КоличествоДочитываемых = МаксимальныйИндекс - БуферТокенов.ИндексТекущегоЭлемента;
	Для Сч = 1 По КоличествоДочитываемых Цикл
		БуферТокенов.Токены[БуферТокенов.ИндексТекущегоЭлемента + Сч] = ЛексическийАнализатор.СледующийТокен();
	КонецЦикла;
КонецПроцедуры

Функция СледующийТокенИзБуфера()
	Если БуферТокенов.ИндексТекущегоЭлемента = -1 Тогда
		ЗаполнитьБуферТокенов();
		БуферТокенов.ИндексТекущегоЭлемента = 0;
		Возврат БуферТокенов.Токены[0];
	КонецЕсли;
	БуферТокенов.ИндексТекущегоЭлемента = БуферТокенов.ИндексТекущегоЭлемента + 1;
	Токен = БуферТокенов.Токены[БуферТокенов.ИндексТекущегоЭлемента];
	ЗаполнитьБуферТокенов();
	Возврат Токен;
КонецФункции

Процедура УстановитьТекущийТокен()
	ТекущийТокен = СледующийТокенИзБуфера();
КонецПроцедуры

Функция ТипТокенаПросмотра(Смещение)
	Индекс = БуферТокенов.ИндексТекущегоЭлемента + Смещение;
	Если Индекс < 0 Или Индекс >= БуферТокенов.Токены.Количество() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Токен = БуферТокенов.Токены[Индекс];
	Если Токен = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Токен.Тип;
КонецФункции

Функция Терминал(ТипТерминала)
	Если ТипТокенаПросмотра(0) <> ТипТерминала Тогда
		ВызватьИсключениеСинтаксическаяОшибка(ТипТерминала, Истина);
	КонецЕсли;
	Значение = ТекущийТокен.Тип;
	УстановитьТекущийТокен();
	Возврат Значение;
КонецФункции

Функция Лексема(ТипЛексемы)
	Возврат Терминал(ТипЛексемы);
КонецФункции

Функция Идентификатор(ТипИдентификатора)
	СтруктураПоиска = Новый Структура("Тип, Идентификатор", ТипИдентификатора, ТипТокенаПросмотра(0));
	Если ОпределенияИдентификаторов.НайтиСтроки(СтруктураПоиска).Количество() = 0 Тогда
		ВызватьИсключениеСинтаксическаяОшибка(ТипИдентификатора, Истина);
	КонецЕсли;
	Значение = ТекущийТокен.Лексема;
	УстановитьТекущийТокен();
	Возврат Значение;
КонецФункции

Функция Константа(ТипКонстанты)
	Если ТипТокенаПросмотра(0) <> ТипКонстанты Тогда
		ВызватьИсключениеСинтаксическаяОшибка(ТипКонстанты, Истина);
	КонецЕсли;
	Значение = ТекущийТокен.Значение;
	УстановитьТекущийТокен();
	Возврат Значение;
КонецФункции

Функция РезультатРазбора()
	УстановитьТекущийТокен();
	Результат = НеТерминалПакетЗапросов();
	Если ТипТокенаПросмотра(0) <> Неопределено Тогда
		ВызватьИсключениеСинтаксическаяОшибка("ПакетЗапросов");
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция РезультатРазбораВыражения()
	УстановитьТекущийТокен();
	Результат = НеТерминалВыражение();
	Если ТипТокенаПросмотра(0) <> Неопределено Тогда
		ВызватьИсключениеСинтаксическаяОшибка("Выражение");
	КонецЕсли;
	Возврат Результат;
КонецФункции

Процедура ВызватьИсключениеСинтаксическаяОшибка(Ожидаемое, ОжидаетсяКонкретныйТокен = Ложь)
	Если ТекущийТокен = Неопределено Тогда
		Если ОжидаетсяКонкретныйТокен Тогда
			ВызватьИсключение "Синтаксическая ошибка. Ожидается """ + Ожидаемое + """";
		Иначе
			ВызватьИсключение "Синтаксическая ошибка. Ожидается следующий токен";
		КонецЕсли;
	ИначеЕсли ОжидаетсяКонкретныйТокен Тогда
		ШаблонОшибки = "{(%1, %2)}: Синтаксическая ошибка. Ожидается ""%3""";
		ТекстОшибки = СтрШаблон(ШаблонОшибки, ТекущийТокен.НомерСтроки, ТекущийТокен.НомерСимвола, Ожидаемое);
		ВызватьИсключение ТекстОшибки;
	ИначеЕсли ТипТокенаПросмотра(0) = Неопределено Тогда
		ШаблонОшибки = "{(%1, %2)}: Синтаксическая ошибка. Ожидается следующий токен";
		ТекстОшибки = СтрШаблон(ШаблонОшибки, ТекущийТокен.НомерСтроки, ТекущийТокен.НомерСимвола);
		ВызватьИсключение ТекстОшибки;
	Иначе
		ШаблонОшибки = "{(%1, %2)}: Синтаксическая ошибка. Неожиданный токен ""%3""";
		ТекстОшибки = СтрШаблон(ШаблонОшибки, ТекущийТокен.НомерСтроки, ТекущийТокен.НомерСимвола, ТекущийТокен.Тип);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
КонецПроцедуры

Функция НеТерминалПакетЗапросов()
	РезультатПродукции = Неопределено;
	ЭтотУзел = ЭлементыМоделиЗапроса.НовыйПакетЗапросов(ТекущийТокен);
	Значение1 = НеТерминалЗапросПакета();
	ЭтотУзел.Элементы.Добавить(Значение1);
	Пока (ТипТокенаПросмотра(0) = ";" И (ТипТокенаПросмотра(1) = "ВЫБРАТЬ" Или ТипТокенаПросмотра(1) = "УНИЧТОЖИТЬ")) Цикл
		Лексема(";");
		Значение2 = НеТерминалЗапросПакета();
		ЭтотУзел.Элементы.Добавить(Значение2);
	КонецЦикла;
	Если (ТипТокенаПросмотра(0) = ";") Тогда
		Лексема(";");
	КонецЕсли;
	РезультатПродукции = ЭтотУзел;
	Возврат РезультатПродукции;
КонецФункции

Функция НеТерминалЗапросПакета()
	РезультатПродукции = Неопределено;
	Если (ТипТокенаПросмотра(0) = "ВЫБРАТЬ") Тогда
		Значение1 = НеТерминалЗапросВыбора();
		РезультатПродукции = Значение1;
	ИначеЕсли (ТипТокенаПросмотра(0) = "УНИЧТОЖИТЬ") Тогда
		Значение2 = НеТерминалЗапросУничтожения();
		РезультатПродукции = Значение2;
	Иначе
		ВызватьИсключениеСинтаксическаяОшибка("ЗапросПакета");
	КонецЕсли;
	Возврат РезультатПродукции;
КонецФункции

Функция НеТерминалЗапросУничтожения()
	РезультатПродукции = Неопределено;
	ЭтотУзел = ЭлементыМоделиЗапроса.НовыйЗапросУничтожения(ТекущийТокен);
	Терминал("УНИЧТОЖИТЬ");
	Значение1 = Идентификатор("ID_ИмяТаблицы");
	ЭтотУзел.ИмяТаблицы = Значение1;
	РезультатПродукции = ЭтотУзел;
	Возврат РезультатПродукции;
КонецФункции

Функция НеТерминалЗапросВыбора()
	РезультатПродукции = Неопределено;
	ЭтотУзел = ЭлементыМоделиЗапроса.НовыйЗапросВыбора(ТекущийТокен);
	Значение1 = НеТерминалОбъединяемыйЗапрос();
	ЭтотУзел.Операторы.Добавить(Значение1);
	Пока (ТипТокенаПросмотра(0) = "ОБЪЕДИНИТЬ") Цикл
		Значение2 = НеТерминалОператорОбъединения();
		ЭтотУзел.Операторы.Добавить(Значение2);
	КонецЦикла;
	Если (ТипТокенаПросмотра(0) = "УПОРЯДОЧИТЬ") Тогда
		Терминал("УПОРЯДОЧИТЬ");
		Терминал("ПО");
		Значение3 = НеТерминалСписокЭлементовУпорядочивания();
		ЭтотУзел.Порядок = Значение3;
		Значение4 = НеТерминалРасширениеСКД();
		Если Значение4 <> Неопределено Тогда
			Для Каждого ЭлементКоллекции Из Значение4 Цикл
				ЭтотУзел.Операторы[0].ОтборыСКД.Добавить(ЭлементКоллекции);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	Если (ТипТокенаПросмотра(0) = "ИНДЕКСИРОВАТЬ") Тогда
		Терминал("ИНДЕКСИРОВАТЬ");
		Терминал("ПО");
		Значение5 = НеТерминалСписокВыражений();
		ЭтотУзел.Индекс = Значение5;
		Значение6 = НеТерминалРасширениеСКД();
		Если Значение6 <> Неопределено Тогда
			Для Каждого ЭлементКоллекции Из Значение6 Цикл
				ЭтотУзел.Операторы[0].ОтборыСКД.Добавить(ЭлементКоллекции);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	Если (ТипТокенаПросмотра(0) = "ИТОГИ") Тогда
		Терминал("ИТОГИ");
		Значение7 = НеТерминалПоляИтогов();
		ЭтотУзел.ВыраженияИтогов = Значение7;
		Терминал("ПО");
		Значение8 = НеТерминалКонтрольныеТочкиИтогов();
		ЭтотУзел.КонтрольныеТочкиИтогов = Значение8;
		Значение9 = НеТерминалРасширениеСКД();
		Если Значение9 <> Неопределено Тогда
			Для Каждого ЭлементКоллекции Из Значение9 Цикл
				ЭтотУзел.Операторы[0].ОтборыСКД.Добавить(ЭлементКоллекции);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	Если (ТипТокенаПросмотра(0) = "АВТОУПОРЯДОЧИВАНИЕ") Тогда
		Терминал("АВТОУПОРЯДОЧИВАНИЕ");
		ЭтотУзел.Автопорядок = Истина;
	КонецЕсли;
	РезультатПродукции = ЭтотУзел;
	Возврат РезультатПродукции;
КонецФункции

Функция НеТерминалОбъединяемыйЗапрос()
	РезультатПродукции = Неопределено;
	ЭтотУзел = ЭлементыМоделиЗапроса.НовыйОператорЗапроса(ТекущийТокен);
	Терминал("ВЫБРАТЬ");
	Если (ТипТокенаПросмотра(0) = "ПЕРВЫЕ") Тогда
		Терминал("ПЕРВЫЕ");
		Значение1 = Константа("ЧисловаяКонстанта");
		ЭтотУзел.КоличествоПолучаемыхЗаписей = Значение1;
		Если (ТипТокенаПросмотра(0) = "РАЗЛИЧНЫЕ") Тогда
			Терминал("РАЗЛИЧНЫЕ");
			ЭтотУзел.ВыбиратьРазличные = Истина;
			Если (ТипТокенаПросмотра(0) = "РАЗРЕШЕННЫЕ") Тогда
				Терминал("РАЗРЕШЕННЫЕ");
				ЭтотУзел.__ВыбиратьРазрешенные = Истина;
			КонецЕсли;
		ИначеЕсли (ТипТокенаПросмотра(0) = "РАЗРЕШЕННЫЕ") Тогда
			Терминал("РАЗРЕШЕННЫЕ");
			ЭтотУзел.__ВыбиратьРазрешенные = Истина;
			Если (ТипТокенаПросмотра(0) = "РАЗЛИЧНЫЕ") Тогда
				Терминал("РАЗЛИЧНЫЕ");
				ЭтотУзел.ВыбиратьРазличные = Истина;
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли (ТипТокенаПросмотра(0) = "РАЗЛИЧНЫЕ") Тогда
		Терминал("РАЗЛИЧНЫЕ");
		ЭтотУзел.ВыбиратьРазличные = Истина;
		Если (ТипТокенаПросмотра(0) = "ПЕРВЫЕ") Тогда
			Терминал("ПЕРВЫЕ");
			Значение2 = Константа("ЧисловаяКонстанта");
			ЭтотУзел.КоличествоПолучаемыхЗаписей = Значение2;
			Если (ТипТокенаПросмотра(0) = "РАЗРЕШЕННЫЕ") Тогда
				Терминал("РАЗРЕШЕННЫЕ");
				ЭтотУзел.__ВыбиратьРазрешенные = Истина;
			КонецЕсли;
		ИначеЕсли (ТипТокенаПросмотра(0) = "РАЗРЕШЕННЫЕ") Тогда
			Терминал("РАЗРЕШЕННЫЕ");
			ЭтотУзел.__ВыбиратьРазрешенные = Истина;
			Если (ТипТокенаПросмотра(0) = "ПЕРВЫЕ") Тогда
				Терминал("ПЕРВЫЕ");
				Значение3 = Константа("ЧисловаяКонстанта");
				ЭтотУзел.КоличествоПолучаемыхЗаписей = Значение3;
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли (ТипТокенаПросмотра(0) = "РАЗРЕШЕННЫЕ") Тогда
		Терминал("РАЗРЕШЕННЫЕ");
		ЭтотУзел.__ВыбиратьРазрешенные = Истина;
		Если (ТипТокенаПросмотра(0) = "ПЕРВЫЕ") Тогда
			Терминал("ПЕРВЫЕ");
			Значение4 = Константа("ЧисловаяКонстанта");
			ЭтотУзел.КоличествоПолучаемыхЗаписей = Значение4;
			Если (ТипТокенаПросмотра(0) = "РАЗЛИЧНЫЕ") Тогда
				Терминал("РАЗЛИЧНЫЕ");
				ЭтотУзел.ВыбиратьРазличные = Истина;
			КонецЕсли;
		ИначеЕсли (ТипТокенаПросмотра(0) = "РАЗЛИЧНЫЕ") Тогда
			Терминал("РАЗЛИЧНЫЕ");
			ЭтотУзел.ВыбиратьРазличные = Истина;
			Если (ТипТокенаПросмотра(0) = "ПЕРВЫЕ") Тогда
				Терминал("ПЕРВЫЕ");
