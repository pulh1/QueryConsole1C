#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОписаниеПеременных

Перем СхемаЗапросаПоставщика;
Перем ДоступныеТаблицыПоставщика;
Перем ОписанияТаблицПоИменам;
Перем СегментыПоставщика;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Инициализирует принадлежащую экземпляру схему и положительный кэш описаний.
//
// Возвращаемое значение:
//  ОбработкаОбъект.ПоставщикМетаданныхСтандартныхТаблиц - Этот поставщик.
Функция Инициализировать() Экспорт

	Если СхемаЗапросаПоставщика <> Неопределено Тогда
		Возврат ЭтотОбъект;
	КонецЕсли;

	СхемаЗапросаПоставщика = Новый СхемаЗапроса;
	ЗапросВыбора = СхемаЗапросаПоставщика.ПакетЗапросов.Добавить(
		Тип("ЗапросВыбораСхемыЗапроса"));
	ДоступныеТаблицыПоставщика = ЗапросВыбора.ДоступныеТаблицы;
	ОписанияТаблицПоИменам = Новый Соответствие;
	СегментыПоставщика = СтатическиеСегменты();

	Возврат ЭтотОбъект;

КонецФункции

// Возвращает стабильное имя поставщика.
//
// Возвращаемое значение:
//  Строка - Имя поставщика.
Функция ИмяПоставщика() Экспорт

	Возврат "СтандартныеТаблицы";

КонецФункции

// Возвращает сегменты имен стандартных таблиц платформы.
//
// Возвращаемое значение:
//  Массив из Строка - Сегменты доступных платформенных таблиц.
Функция Сегменты() Экспорт

	Возврат СегментыПоставщика;

КонецФункции

// Проверяет наличие стандартной таблицы в принадлежащей экземпляру схеме.
//
// Параметры:
//  ИмяТаблицы - Строка - Полное имя таблицы.
//
// Возвращаемое значение:
//  Булево - Истина, если таблица доступна платформе.
Функция ТаблицаСуществует(ИмяТаблицы) Экспорт

	Возврат ДоступныеТаблицыПоставщика.Найти(ИмяТаблицы) <> Неопределено;

КонецФункции

// Возвращает нейтральное описание стандартной таблицы.
//
// Параметры:
//  ИмяТаблицы - Строка - Полное имя таблицы.
//
// Возвращаемое значение:
//  Неопределено - Таблица с указанным именем не найдена.
//  Структура - Описание найденной таблицы:
// * ИмяТаблицы - Строка
// * ИмяПоставщика - Строка
// * ВидИсточника - Строка
// * Представление - Строка
// * Поля - Массив из Структура
// * Параметры - Массив из Структура
// * ДанныеПоставщика - Произвольный
Функция ОписаниеТаблицы(ИмяТаблицы) Экспорт

	КлючКэша = ВРег(ИмяТаблицы);
	Описание = ОписанияТаблицПоИменам.Получить(КлючКэша);
	Если Описание <> Неопределено Тогда
		Возврат Описание;
	КонецЕсли;

	ДоступнаяТаблица = ДоступныеТаблицыПоставщика.Найти(ИмяТаблицы);
	Если ДоступнаяТаблица = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Описание = ПреобразоватьТаблицу(ДоступнаяТаблица);
	ОписанияТаблицПоИменам.Вставить(КлючКэша, Описание);
	Возврат Описание;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СтатическиеСегменты()

	Результат = Новый Массив;
	Результат.Добавить("Справочник");
	Результат.Добавить("Документ");
	Результат.Добавить("РегистрСведений");
	Результат.Добавить("РегистрНакопления");
	Результат.Добавить("РегистрБухгалтерии");
	Результат.Добавить("РегистрРасчета");
	Результат.Добавить("ПланВидовХарактеристик");
	Результат.Добавить("ПланСчетов");
	Результат.Добавить("ПланВидовРасчета");
	Результат.Добавить("БизнесПроцесс");
	Результат.Добавить("Задача");
	Результат.Добавить("Перечисление");
	Результат.Добавить("Константа");
	Результат.Добавить("ПланОбмена");
	Результат.Добавить("КритерийОтбора");
	Результат.Добавить("Константы");
	Результат.Добавить("ЖурналДокументов");
	Результат.Добавить("ВнешнийИсточникДанных");
	Результат.Добавить("Последовательность");

	Возврат Результат;

КонецФункции

Функция ПреобразоватьТаблицу(ДоступнаяТаблица)

	Описание = МетаданныеТаблицЗапроса.НовыйОписаниеТаблицы(
		ДоступнаяТаблица.Имя,
		ИмяПоставщика(),
		"СтандартнаяТаблица",
		ДоступнаяТаблица.Имя);
	Описание.ДанныеПоставщика = ДоступнаяТаблица;

	Для Каждого ДоступноеПоле Из ДоступнаяТаблица.Поля Цикл
		Описание.Поля.Добавить(ПреобразоватьПоле(ДоступноеПоле));
	КонецЦикла;

	Для Каждого ДоступныйПараметр Из ДоступнаяТаблица.Параметры Цикл
		Описание.Параметры.Добавить(ПреобразоватьПараметр(ДоступныйПараметр));
	КонецЦикла;

	Возврат Описание;

КонецФункции

Функция ПреобразоватьПоле(ДоступноеПоле)

	Если ТипЗнч(ДоступноеПоле) = Тип("ДоступнаяВложеннаяТаблицаСхемыЗапроса") Тогда
		Описание = МетаданныеТаблицЗапроса.НовыйОписаниеПоля(
			ДоступноеПоле.Имя,
			ДоступноеПоле.Имя,
			МетаданныеТаблицЗапроса.ВидПоляВложеннаяТаблица(),
			Неопределено,
			"");
		Для Каждого ВложенноеПоле Из ДоступноеПоле.Поля Цикл
			Описание.Поля.Добавить(ПреобразоватьПоле(ВложенноеПоле));
		КонецЦикла;
	Иначе
		Описание = МетаданныеТаблицЗапроса.НовыйОписаниеПоля(
			ДоступноеПоле.Имя,
			ДоступноеПоле.Имя,
			МетаданныеТаблицЗапроса.ВидПоляОбычное(),
			ДоступноеПоле.ТипЗначения,
			Строка(ДоступноеПоле.Роль));
	КонецЕсли;

	Описание.ДанныеПоставщика = ДоступноеПоле;
	Возврат Описание;

КонецФункции

Функция ПреобразоватьПараметр(ДоступныйПараметр)

	Описание = МетаданныеТаблицЗапроса.НовыйОписаниеПараметра(
		ДоступныйПараметр.Имя,
		Неопределено,
		ДоступныйПараметр.ТипЗначения,
		Ложь);
	Описание.ДанныеПоставщика = ДоступныйПараметр;

	Для Каждого Вариант Из ДоступныйПараметр.Варианты Цикл
		Описание.Варианты.Добавить(Вариант);
	КонецЦикла;

	Для Каждого ДоступноеПоле Из ДоступныйПараметр.ДоступныеПоля Цикл
		Описание.Поля.Добавить(ПреобразоватьПоле(ДоступноеПоле));
	КонецЦикла;

	Возврат Описание;

КонецФункции

#КонецОбласти

#КонецЕсли
