#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОписаниеПеременных

Перем СхемаЗапросаПоставщика;
Перем ДоступныеТаблицыПоставщика;
Перем ОписанияТаблицПоИменам;
Перем КраткиеОписанияТаблицПоИменам;
Перем ОписанияПолейПоИменам;
Перем СегментыПоставщика;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Инициализирует принадлежащую экземпляру схему и положительный кэш описаний.
//
// Возвращаемое значение:
//  ОбработкаОбъект.ПоставщикМетаданныхСтандартныхТаблиц - Этот поставщик.
Функция Инициализировать() Экспорт

	Если СхемаЗапросаПоставщика <> Неопределено Тогда
		Возврат ЭтотОбъект;
	КонецЕсли;

	СхемаЗапросаПоставщика = Новый СхемаЗапроса;
	ЗапросВыбора = СхемаЗапросаПоставщика.ПакетЗапросов.Добавить(
		Тип("ЗапросВыбораСхемыЗапроса"));
	ДоступныеТаблицыПоставщика = ЗапросВыбора.ДоступныеТаблицы;
	ОписанияТаблицПоИменам = Новый Соответствие;
	КраткиеОписанияТаблицПоИменам = Новый Соответствие;
	ОписанияПолейПоИменам = Новый Соответствие;
	СегментыПоставщика = СтатическиеСегменты();

	Возврат ЭтотОбъект;

КонецФункции

// Возвращает стабильное имя поставщика.
//
// Возвращаемое значение:
//  Строка - Имя поставщика.
Функция ИмяПоставщика() Экспорт

	Возврат "СтандартныеТаблицы";

КонецФункции

// Возвращает сегменты имен стандартных таблиц платформы.
//
// Возвращаемое значение:
//  Массив из Строка - Сегменты доступных платформенных таблиц.
Функция Сегменты() Экспорт

	Возврат СегментыПоставщика;

КонецФункции

// Возвращает дочерние элементы ленивого каталога стандартных таблиц.
//
// Параметры:
//  ИдентификаторРодителя - Строка, Неопределено - Идентификатор раскрываемого элемента.
//
// Возвращаемое значение:
//  Массив из Структура - Transport-safe элементы каталога.
Функция ДочерниеЭлементы(ИдентификаторРодителя = Неопределено) Экспорт

	Если ИдентификаторРодителя = Неопределено Тогда
		Возврат КорневыеЭлементыКаталога();
	КонецЕсли;

	Если СегментыПоставщика.Найти(ИдентификаторРодителя) <> Неопределено Тогда
		Возврат ТаблицыСегмента(ИдентификаторРодителя);
	КонецЕсли;

	Возврат Новый Массив;

КонецФункции

// Проверяет наличие стандартной таблицы в принадлежащей экземпляру схеме.
//
// Параметры:
//  ИмяТаблицы - Строка - Полное имя таблицы.
//
// Возвращаемое значение:
//  Булево - Истина, если таблица доступна платформе.
Функция ТаблицаСуществует(ИмяТаблицы) Экспорт

	Возврат ДоступныеТаблицыПоставщика.Найти(ИмяТаблицы) <> Неопределено;

КонецФункции

// Возвращает краткое описание стандартной таблицы без полей и параметров.
//
// Параметры:
//  ИмяТаблицы - Строка - Полное имя таблицы.
//
// Возвращаемое значение:
//  Неопределено - Таблица с указанным именем не найдена.
//  Структура - Краткое описание найденной таблицы:
// * ИмяТаблицы - Строка
// * ИмяПоставщика - Строка
// * ВидИсточника - Строка
// * Представление - Строка
// * ДанныеПоставщика - Произвольный
Функция НайтиТаблицу(ИмяТаблицы) Экспорт

	КлючКэша = ВРег(ИмяТаблицы);
	Описание = КраткиеОписанияТаблицПоИменам.Получить(КлючКэша);
	Если Описание <> Неопределено Тогда
		Возврат Описание;
	КонецЕсли;

	ДоступнаяТаблица = ДоступныеТаблицыПоставщика.Найти(ИмяТаблицы);
	Если ДоступнаяТаблица = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Описание = МетаданныеТаблицЗапроса.НовоеКраткоеОписаниеТаблицы(
		ДоступнаяТаблица.Имя,
		ИмяПоставщика(),
		"СтандартнаяТаблица",
		ДоступнаяТаблица.Имя);
	Описание.ДанныеПоставщика = ДоступнаяТаблица;
	КраткиеОписанияТаблицПоИменам.Вставить(КлючКэша, Описание);
	Возврат Описание;

КонецФункции

// Возвращает описание только запрошенного поля стандартной таблицы.
//
// Параметры:
//  ИмяТаблицы - Строка - Полное имя таблицы.
//  ИмяПоля - Строка - Имя поля.
//
// Возвращаемое значение:
//  Неопределено - Поле с указанным именем не найдено.
//  Структура - Описание найденного поля:
// * Имя - Строка
// * Представление - Строка
// * ВидПоля - Строка
// * ТипЗначения - Произвольный
// * Роль - Строка
// * Поля - Массив из Структура
// * ДанныеПоставщика - Произвольный
Функция НайтиПоле(ИмяТаблицы, ИмяПоля) Экспорт

	КлючКэша = ВРег(ИмяТаблицы) + Символы.ПС + ВРег(ИмяПоля);
	Описание = ОписанияПолейПоИменам.Получить(КлючКэша);
	Если Описание <> Неопределено Тогда
		Возврат Описание;
	КонецЕсли;

	ДоступнаяТаблица = ДоступныеТаблицыПоставщика.Найти(ИмяТаблицы);
	Если ДоступнаяТаблица = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ДоступноеПоле = ДоступнаяТаблица.Поля.Найти(ИмяПоля);
	Если ДоступноеПоле = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Описание = ПреобразоватьПоле(ДоступноеПоле);
	ОписанияПолейПоИменам.Вставить(КлючКэша, Описание);
	Возврат Описание;

КонецФункции

// Возвращает нейтральное описание стандартной таблицы.
//
// Параметры:
//  ИмяТаблицы - Строка - Полное имя таблицы.
//
// Возвращаемое значение:
//  Неопределено - Таблица с указанным именем не найдена.
//  Структура - Описание найденной таблицы:
// * ИмяТаблицы - Строка
// * ИмяПоставщика - Строка
// * ВидИсточника - Строка
// * Представление - Строка
// * Поля - Массив из Структура
// * Параметры - Массив из Структура
// * ДанныеПоставщика - Произвольный
Функция ОписаниеТаблицы(ИмяТаблицы) Экспорт

	КлючКэша = ВРег(ИмяТаблицы);
	Описание = ОписанияТаблицПоИменам.Получить(КлючКэша);
	Если Описание <> Неопределено Тогда
		Возврат Описание;
	КонецЕсли;

	ДоступнаяТаблица = ДоступныеТаблицыПоставщика.Найти(ИмяТаблицы);
	Если ДоступнаяТаблица = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Описание = ПреобразоватьТаблицу(ДоступнаяТаблица);
	ОписанияТаблицПоИменам.Вставить(КлючКэша, Описание);
	Возврат Описание;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СтатическиеСегменты()

	Результат = Новый Массив;
	Результат.Добавить("Справочник");
	Результат.Добавить("Документ");
	Результат.Добавить("РегистрСведений");
	Результат.Добавить("РегистрНакопления");
	Результат.Добавить("РегистрБухгалтерии");
	Результат.Добавить("РегистрРасчета");
	Результат.Добавить("ПланВидовХарактеристик");
	Результат.Добавить("ПланСчетов");
	Результат.Добавить("ПланВидовРасчета");
	Результат.Добавить("БизнесПроцесс");
	Результат.Добавить("Задача");
	Результат.Добавить("Перечисление");
	Результат.Добавить("Константа");
	Результат.Добавить("ПланОбмена");
	Результат.Добавить("КритерийОтбора");
	Результат.Добавить("Константы");
	Результат.Добавить("ЖурналДокументов");
	Результат.Добавить("ВнешнийИсточникДанных");
	Результат.Добавить("Последовательность");

	Возврат Результат;

КонецФункции

Функция КорневыеЭлементыКаталога()

	Элементы = Новый Массив;
	Для Каждого Сегмент Из СегментыПоставщика Цикл
		Элементы.Добавить(МетаданныеТаблицЗапроса.НовыйЭлементКаталога(
			Сегмент,
			Неопределено,
			Неопределено,
			Сегмент,
			Истина,
			Истина,
			"СтандартнаяГруппа"));
	КонецЦикла;

	Возврат Элементы;

КонецФункции

Функция ТаблицыСегмента(Сегмент)

	Элементы = Новый Массив;
	ПредставлениеГруппы = ПредставлениеГруппыСегмента(Сегмент);
	Если ПустаяСтрока(ПредставлениеГруппы) Тогда
		Возврат Элементы;
	КонецЕсли;

	ГруппаСегмента = ДоступныеТаблицыПоставщика.Найти(ПредставлениеГруппы);
	Если ГруппаСегмента = Неопределено
		Или ТипЗнч(ГруппаСегмента) <> Тип("ГруппаДоступныхТаблицСхемыЗапроса") Тогда
		Возврат Элементы;
	КонецЕсли;

	ДобавитьТаблицыСегмента(Элементы, ГруппаСегмента.Состав, Сегмент);
	Возврат Элементы;

КонецФункции

Функция ПредставлениеГруппыСегмента(Сегмент)

	Если Сегмент = "Справочник" Тогда
		Возврат "Справочники";
	ИначеЕсли Сегмент = "Документ" Тогда
		Возврат "Документы";
	ИначеЕсли Сегмент = "РегистрСведений" Тогда
		Возврат "РегистрыСведений";
	ИначеЕсли Сегмент = "РегистрНакопления" Тогда
		Возврат "РегистрыНакопления";
	ИначеЕсли Сегмент = "РегистрБухгалтерии" Тогда
		Возврат "РегистрыБухгалтерии";
	ИначеЕсли Сегмент = "РегистрРасчета" Тогда
		Возврат "РегистрыРасчета";
	ИначеЕсли Сегмент = "ПланВидовХарактеристик" Тогда
		Возврат "ПланыВидовХарактеристик";
	ИначеЕсли Сегмент = "ПланСчетов" Тогда
		Возврат "ПланыСчетов";
	ИначеЕсли Сегмент = "ПланВидовРасчета" Тогда
		Возврат "ПланыВидовРасчета";
	ИначеЕсли Сегмент = "БизнесПроцесс" Тогда
		Возврат "БизнесПроцессы";
	ИначеЕсли Сегмент = "Задача" Тогда
		Возврат "Задачи";
	ИначеЕсли Сегмент = "Перечисление" Тогда
		Возврат "Перечисления";
	ИначеЕсли Сегмент = "Константа" Или Сегмент = "Константы" Тогда
		Возврат "Константы";
	ИначеЕсли Сегмент = "ПланОбмена" Тогда
		Возврат "ПланыОбмена";
	ИначеЕсли Сегмент = "КритерийОтбора" Тогда
		Возврат "КритерииОтбора";
	ИначеЕсли Сегмент = "ЖурналДокументов" Тогда
		Возврат "ЖурналыДокументов";
	ИначеЕсли Сегмент = "ВнешнийИсточникДанных" Тогда
		Возврат "ВнешниеИсточникиДанных";
	ИначеЕсли Сегмент = "Последовательность" Тогда
		Возврат "Последовательности";
	КонецЕсли;

	Возврат "";

КонецФункции

Процедура ДобавитьТаблицыСегмента(Элементы, ДоступныеЭлементы, Сегмент)

	Для Каждого ДоступныйЭлемент Из ДоступныеЭлементы Цикл
		Если ТипЗнч(ДоступныйЭлемент) = Тип("ГруппаДоступныхТаблицСхемыЗапроса") Тогда
			ДобавитьТаблицыСегмента(Элементы, ДоступныйЭлемент.Состав, Сегмент);
		ИначеЕсли ТипЗнч(ДоступныйЭлемент) = Тип("ДоступнаяТаблицаСхемыЗапроса")
			И ПервыйСегментИмениТаблицы(ДоступныйЭлемент.Имя) = Сегмент
			И Не СтрЗаканчиваетсяНа(ДоступныйЭлемент.Имя, ".Изменения") Тогда

			Элементы.Добавить(МетаданныеТаблицЗапроса.НовыйЭлементКаталога(
				ДоступныйЭлемент.Имя,
				Сегмент,
				ДоступныйЭлемент.Имя,
				ПредставлениеТаблицы(ДоступныйЭлемент.Имя),
				Ложь,
				Истина,
				"СтандартнаяТаблица"));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ПервыйСегментИмениТаблицы(ИмяТаблицы)

	ЧастиИмени = СтрРазделить(ИмяТаблицы, ".");
	Если ЧастиИмени.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат ЧастиИмени[0];

КонецФункции

Функция ПредставлениеТаблицы(ИмяТаблицы)

	ЧастиПредставления = СтрРазделить(ИмяТаблицы, ".");
	Если ЧастиПредставления.Количество() = 3 Тогда
		Возврат ЧастиПредставления[1] + ЧастиПредставления[2];
	КонецЕсли;

	Возврат ЧастиПредставления[ЧастиПредставления.ВГраница()];

КонецФункции

Функция ПреобразоватьТаблицу(ДоступнаяТаблица)

	Описание = МетаданныеТаблицЗапроса.НовыйОписаниеТаблицы(
		ДоступнаяТаблица.Имя,
		ИмяПоставщика(),
		"СтандартнаяТаблица",
		ДоступнаяТаблица.Имя);
	Описание.ДанныеПоставщика = ДоступнаяТаблица;

	Для Каждого ДоступноеПоле Из ДоступнаяТаблица.Поля Цикл
		Описание.Поля.Добавить(ПреобразоватьПоле(ДоступноеПоле));
	КонецЦикла;

	Для Каждого ДоступныйПараметр Из ДоступнаяТаблица.Параметры Цикл
		Описание.Параметры.Добавить(ПреобразоватьПараметр(ДоступныйПараметр));
	КонецЦикла;

	Возврат Описание;

КонецФункции

Функция ПреобразоватьПоле(ДоступноеПоле)

	Если ТипЗнч(ДоступноеПоле) = Тип("ДоступнаяВложеннаяТаблицаСхемыЗапроса") Тогда
		Описание = МетаданныеТаблицЗапроса.НовыйОписаниеПоля(
			ДоступноеПоле.Имя,
			ДоступноеПоле.Имя,
			МетаданныеТаблицЗапроса.ВидПоляВложеннаяТаблица(),
			Неопределено,
			"");
		Для Каждого ВложенноеПоле Из ДоступноеПоле.Поля Цикл
			Описание.Поля.Добавить(ПреобразоватьПоле(ВложенноеПоле));
		КонецЦикла;
	Иначе
		Описание = МетаданныеТаблицЗапроса.НовыйОписаниеПоля(
			ДоступноеПоле.Имя,
			ДоступноеПоле.Имя,
			МетаданныеТаблицЗапроса.ВидПоляОбычное(),
			ДоступноеПоле.ТипЗначения,
			Строка(ДоступноеПоле.Роль));
	КонецЕсли;

	Описание.ДанныеПоставщика = ДоступноеПоле;
	Возврат Описание;

КонецФункции

Функция ПреобразоватьПараметр(ДоступныйПараметр)

	Описание = МетаданныеТаблицЗапроса.НовыйОписаниеПараметра(
		ДоступныйПараметр.Имя,
		Неопределено,
		ДоступныйПараметр.ТипЗначения,
		Ложь);
	Описание.ДанныеПоставщика = ДоступныйПараметр;

	Для Каждого Вариант Из ДоступныйПараметр.Варианты Цикл
		Описание.Варианты.Добавить(Вариант);
	КонецЦикла;

	Для Каждого ДоступноеПоле Из ДоступныйПараметр.ДоступныеПоля Цикл
		Описание.Поля.Добавить(ПреобразоватьПоле(ДоступноеПоле));
	КонецЦикла;

	Возврат Описание;

КонецФункции

#КонецОбласти

#КонецЕсли
