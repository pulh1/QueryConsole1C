#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОписаниеПеременных

Перем СегментыПоставщика;
Перем СхемаЗапросаПоставщика;
Перем ДоступныеТаблицыПоставщика;

#КонецОбласти

#Область ПрограммныйИнтерфейс

Функция Инициализировать() Экспорт
	СегментыПоставщика = Новый Массив();
	СегментыПоставщика.Добавить("Справочник");
	СегментыПоставщика.Добавить("Документ");
	СегментыПоставщика.Добавить("РегистрСведений");
	СегментыПоставщика.Добавить("РегистрНакопления");
	СегментыПоставщика.Добавить("РегистрБухгалтерии");
	СегментыПоставщика.Добавить("РегистрРасчета");
	СегментыПоставщика.Добавить("ПланВидовХарактеристик");
	СегментыПоставщика.Добавить("ПланСчетов");
	СегментыПоставщика.Добавить("ПланВидовРасчета");
	СегментыПоставщика.Добавить("БизнесПроцесс");
	СегментыПоставщика.Добавить("Задача");
	СегментыПоставщика.Добавить("Перечисление");
	СегментыПоставщика.Добавить("Константа");
	СегментыПоставщика.Добавить("ПланОбмена");
	
	СхемаЗапросаПоставщика = Новый СхемаЗапроса;
	ДоступныеТаблицыПоставщика = СхемаЗапросаПоставщика.ПакетЗапросов.Добавить(Тип("ЗапросВыбораСхемыЗапроса")).ДоступныеТаблицы;
	
	Возврат ЭтотОбъект;
КонецФункции

Функция ИмяПоставщика() Экспорт
	Возврат "СтандартныеТаблицы1С";
КонецФункции

Функция ПредставлениеПоставщика() Экспорт
	Возврат "Таблицы информационной базы";
КонецФункции

Функция Сегменты() Экспорт
	Возврат СегментыПоставщика;
КонецФункции

Функция Контекстный() Экспорт
	Возврат Ложь;
КонецФункции

Функция ТаблицаСуществует(ИмяТаблицы) Экспорт
	Возврат ДоступныеТаблицыПоставщика.Найти(ИмяТаблицы) <> Неопределено;
КонецФункции

Функция ОписаниеТаблицы(ИмяТаблицы) Экспорт
	ДоступнаяТаблица = ДоступныеТаблицыПоставщика.Найти(ИмяТаблицы);
	Если ДоступнаяТаблица = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Описание = НовыйОписаниеТаблицы(ИмяТаблицы, ИмяПоставщика());
	Описание.Представление = ДоступнаяТаблица.Представление;
	Описание.Поля = КопияПолейДоступнойТаблицы(ДоступнаяТаблица.Поля);
	
	Возврат Описание;
КонецФункции

Функция ПоляТаблицы(ИмяТаблицы) Экспорт
	Описание = ОписаниеТаблицы(ИмяТаблицы);
	Если Описание = Неопределено Тогда
		Возврат Новый Массив();
	КонецЕсли;
	
	Возврат Описание.Поля;
КонецФункции

Функция ПараметрыТаблицы(ИмяТаблицы) Экспорт
	Возврат Новый Массив();
КонецФункции

Функция ДочерниеЭлементы(ИдентификаторРодителя = Неопределено) Экспорт
	Если ИдентификаторРодителя = Неопределено Тогда
		Возврат КорневыеСегменты();
	КонецЕсли;
	
	Если ЭтоСегментПоставщика(ИдентификаторРодителя) Тогда
		Возврат ТаблицыСегмента(ИдентификаторРодителя);
	КонецЕсли;
	
	Описание = ОписаниеТаблицы(ИдентификаторРодителя);
	Если Описание <> Неопределено Тогда
		Возврат Описание.Поля;
	КонецЕсли;
	
	Возврат ПоляВложеннойТаблицы(ИдентификаторРодителя);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыйОписаниеТаблицы(ИмяТаблицы = "", ВидПоставщика = "")
	Описание = Новый Структура;
	Описание.Вставить("Тип", "ОписаниеТаблицыПоставщикаМетаданных");
	Описание.Вставить("ИмяТаблицы", ИмяТаблицы);
	Описание.Вставить("ПервыйСегмент", ПервыйСегментИмениТаблицы(ИмяТаблицы));
	Описание.Вставить("ВидПоставщика", ВидПоставщика);
	Описание.Вставить("Представление", ИмяТаблицы);
	Описание.Вставить("Поля", Новый Массив());
	Описание.Вставить("Параметры", Новый Массив());
	Описание.Вставить("ДочерниеЭлементы", Новый Массив());
	Описание.Вставить("ИсходноеОписание", Неопределено);
	
	Возврат Описание;
КонецФункции

Функция НовыйПолеТаблицы(Имя = "", ТипЗначения = Неопределено)
	Поле = Новый Структура;
	Поле.Вставить("Тип", "ПолеТаблицыПоставщикаМетаданных");
	Поле.Вставить("Имя", Имя);
	Поле.Вставить("Представление", Имя);
	Поле.Вставить("ТипЗначения", ТипЗначения);
	Поле.Вставить("ВидПоставщика", ИмяПоставщика());
	Поле.Вставить("Поля", Новый Массив());
	Поле.Вставить("Роль", Неопределено);
	Поле.Вставить("ИсходноеОписание", Неопределено);
	
	Возврат Поле;
КонецФункции

Функция НовыйЭлементИерархии(Идентификатор = "", Наименование = "", ЭтоГруппа = Ложь)
	Элемент = Новый Структура;
	Элемент.Вставить("Тип", "ЭлементИерархииПоставщикаМетаданных");
	Элемент.Вставить("Идентификатор", Идентификатор);
	Элемент.Вставить("Имя", Идентификатор);
	Элемент.Вставить("Наименование", Наименование);
	Элемент.Вставить("Представление", Наименование);
	Элемент.Вставить("ЭтоГруппа", ЭтоГруппа);
	Элемент.Вставить("ВидПоставщика", ИмяПоставщика());
	Элемент.Вставить("ТипЗначения", "");
	Элемент.Вставить("ЕстьДочерниеЭлементы", Истина);
	Элемент.Вставить("ИсходноеОписание", Неопределено);
	
	Возврат Элемент;
КонецФункции

Функция ПервыйСегментИмениТаблицы(ИмяТаблицы)
	ЧастиИмени = СтрРазделить(ИмяТаблицы, ".");
	Если ЧастиИмени.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат ЧастиИмени[0];
КонецФункции

Функция КопияПолейДоступнойТаблицы(Поля)
	КопияПолей = Новый Массив();
	Для Каждого Поле Из Поля Цикл
		Если ТипЗнч(Поле) = Тип("ДоступнаяВложеннаяТаблицаСхемыЗапроса") Тогда
			КопияПоля = НовыйПолеТаблицы(Поле.Имя, "ДоступнаяВложеннаяТаблицаСхемыЗапроса");
			КопияПоля.Поля = КопияПолейДоступнойТаблицы(Поле.Поля);
		Иначе
			КопияПоля = НовыйПолеТаблицы(Поле.Имя, Поле.ТипЗначения);
			КопияПоля.Роль = Поле.Роль;
			КопияПоля.Поля = КопияПолейДоступнойТаблицы(Поле.Поля);
		КонецЕсли;
		
		КопияПоля.Представление = Поле.Имя;
		КопияПолей.Добавить(КопияПоля);
	КонецЦикла;
	
	Возврат КопияПолей;
КонецФункции

Функция КорневыеСегменты()
	Элементы = Новый Массив();
	Для Каждого Сегмент Из СегментыПоставщика Цикл
		Элемент = НовыйЭлементИерархии(Сегмент, Сегмент, Истина);
		Элемент.ТипЗначения = "СегментСтандартныхТаблиц1С";
		Элементы.Добавить(Элемент);
	КонецЦикла;
	
	Возврат Элементы;
КонецФункции

Функция ТаблицыСегмента(Сегмент)
	Элементы = Новый Массив();
	ДобавитьТаблицыСегмента(Элементы, ДоступныеТаблицыПоставщика, Сегмент);
	Возврат Элементы;
КонецФункции

Функция ПоляВложеннойТаблицы(ИдентификаторРодителя)
	ЧастиИмени = СтрРазделить(ИдентификаторРодителя, ".");
	Для КоличествоСегментовТаблицы = 2 По ЧастиИмени.Количество() Цикл
		ИмяТаблицы = ИмяИзСегментов(ЧастиИмени, КоличествоСегментовТаблицы);
		Описание = ОписаниеТаблицы(ИмяТаблицы);
		Если Описание = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Поля = Описание.Поля;
		Для ИндексСегмента = КоличествоСегментовТаблицы По ЧастиИмени.ВГраница() Цикл
			Поле = НайтиПолеВМассиве(Поля, ЧастиИмени[ИндексСегмента]);
			Если Поле = Неопределено Тогда
				Поля = Новый Массив();
				Прервать;
			КонецЕсли;
			Поля = Поле.Поля;
		КонецЦикла;
		
		Возврат Поля;
	КонецЦикла;
	
	Возврат Новый Массив();
КонецФункции

Процедура ДобавитьТаблицыСегмента(Элементы, ДоступныеТаблицы, Сегмент)
	Для Каждого ДоступныйЭлемент Из ДоступныеТаблицы Цикл
		Если ТипЗнч(ДоступныйЭлемент) = Тип("ГруппаДоступныхТаблицСхемыЗапроса") Тогда
			ДобавитьТаблицыСегмента(Элементы, ДоступныйЭлемент.Состав, Сегмент);
		ИначеЕсли ТипЗнч(ДоступныйЭлемент) = Тип("ДоступнаяТаблицаСхемыЗапроса")
			И ПервыйСегментИмениТаблицы(ДоступныйЭлемент.Имя) = Сегмент
			И Не СтрЗаканчиваетсяНа(ДоступныйЭлемент.Имя, ".Изменения") Тогда
			
			Элемент = НовыйЭлементИерархии(ДоступныйЭлемент.Имя, ПредставлениеТаблицы(ДоступныйЭлемент.Имя), Ложь);
			Элемент.ТипЗначения = "ИсточникДанныхТаблица";
			Элементы.Добавить(Элемент);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ПредставлениеТаблицы(ИмяТаблицы)
	ЧастиПредставления = СтрРазделить(ИмяТаблицы, ".");
	Если ЧастиПредставления.Количество() = 3 Тогда
		Возврат ЧастиПредставления[1] + ЧастиПредставления[2];
	КонецЕсли;
	
	Возврат ЧастиПредставления[ЧастиПредставления.ВГраница()];
КонецФункции

Функция ИмяИзСегментов(ЧастиИмени, КоличествоСегментов)
	Имя = "";
	Для Индекс = 0 По КоличествоСегментов - 1 Цикл
		Если Индекс > 0 Тогда
			Имя = Имя + ".";
		КонецЕсли;
		Имя = Имя + ЧастиИмени[Индекс];
	КонецЦикла;
	
	Возврат Имя;
КонецФункции

Функция НайтиПолеВМассиве(Поля, ИмяПоля)
	Для Каждого Поле Из Поля Цикл
		Если Поле.Имя = ИмяПоля Тогда
			Возврат Поле;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
КонецФункции

Функция ЭтоСегментПоставщика(Идентификатор)
	Для Каждого Сегмент Из СегментыПоставщика Цикл
		Если Сегмент = Идентификатор Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
КонецФункции

#КонецОбласти

#КонецЕсли
