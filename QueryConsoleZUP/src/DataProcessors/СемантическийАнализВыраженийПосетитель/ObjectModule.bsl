Процедура ДобавитьВызовФункцииВСтек(ИмяФункции)
	Если ИмяФункции = "ПРЕДСТАВЛЕНИЕ" Тогда
		Для Каждого ВнешняяФункция Из СтэкВызововФункций Цикл
			Если ВнешняяФункция <> "ПРЕДСТАВЛЕНИЕ" Тогда
				ВызватьИсключение "ПРЕДСТАВЛЕНИЕ не может использоваться аргументом другой функции";
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	СтэкВызововФункций.Добавить(ИмяФункции);
КонецПроцедуры

Процедура УдалитьВызовФункцииИзСтека()
	СтэкВызововФункций.Удалить(СтэкВызововФункций.ВГраница());
КонецПроцедуры

Процедура ПроверитьКонтекстВызоваФункции(Выражение, Описание)
	Если Не УсловияПримененияФункций.ПроверятьКонтекстЗапроса Тогда
		Возврат;
	КонецЕсли;
	Если Описание.ИмяФункции = "АВТОНОМЕРЗАПИСИ" Тогда
		Если Не УсловияПримененияФункций.РазрешенАвтоНомерЗаписи Тогда
			ВызватьИсключение "АВТОНОМЕРЗАПИСИ разрешена только отдельным полем создания ВТ без объединения";
		КонецЕсли;
	ИначеЕсли Описание.ИмяФункции = "СГРУППИРОВАНОПО" Тогда
		// До runtime-сверки не запрещаем случай без группировки, принятый EDT.
		Если УсловияПримененияФункций.ВыраженияГруппировки.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		Для Каждого Ключ Из УсловияПримененияФункций.ВыраженияГруппировки Цикл
			Если МодельЗапросаУтилиты.ВыраженияРавны(Выражение.Аргументы.Элементы[0], Ключ.Значение) Тогда
				Возврат;
			КонецЕсли;
		КонецЦикла;
		ВызватьИсключение "СГРУППИРОВАНОПО: аргумент отсутствует в группировке текущего оператора";
	КонецЕсли;
КонецПроцедуры

Функция ИзвлечьЭлементИзСтэка()
	Элемент = СтэкТипов[СтэкТипов.ВГраница()];
	СтэкТипов.Удалить(СтэкТипов.ВГраница());
	
	Возврат Элемент;
КонецФункции

Процедура УстановитьТипПараметраЗапроса(Выражение, ТипЗначения, ЭтоСписокЗначений = Ложь)
	Если ТипЗначения = Неопределено 
		Или Не Выражение.Тип = "ПараметрЗапроса" Тогда	
		
		Возврат;
	КонецЕсли;
	ОписаниеПараметра = РассчитываемыеСвойства.ПараметрыЗапроса.Получить(ВРег(Выражение.Имя));
	ОписаниеПараметра.ТипЗначения = ТипЗначения;
	ОписаниеПараметра.ЭтоСписокЗначений = ЭтоСписокЗначений;
КонецПроцедуры

