Функция НовыйТокен(Класс, ТипТокена, Лексема, Позиция)
	Токен = Новый Структура(
		"Класс, Тип, Лексема, НомерСтроки, НомерСимвола",
		Класс, ТипТокена, Лексема,
		Позиция.НомерСтроки, Позиция.НомерСимвола);

	Возврат Токен;
КонецФункции

Функция НовыйТокенЛексема(Лексема, Позиция)
	Возврат НовыйТокен(КлассЛексема, Лексема, Лексема, Позиция);
КонецФункции

Функция НовыйТокенСлово(Лексема, Позиция)
	НормализованнаяЛексема = ВРег(Лексема);
	Если КлючевыеСлова[НормализованнаяЛексема] = Истина Тогда
		ТипТокена = НормализованнаяЛексема;
	Иначе
		ТипТокена = ТипИдентификатор;
	КонецЕсли;

	Возврат НовыйТокен(КлассСлово, ТипТокена, Лексема, Позиция);
КонецФункции

Функция НовыйТокенСРешеткой(Лексема, Позиция)
	Возврат НовыйТокен(
		КлассСлово, ТипИдентификаторСРешеткой, Лексема, Позиция);
КонецФункции

Функция НовыйТокенСтрока(Значение, Позиция)
