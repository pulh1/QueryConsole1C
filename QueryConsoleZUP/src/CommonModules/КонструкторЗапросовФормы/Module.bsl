#Область СлужебныеПроцедурыИФункции

// Создает серверный контекст поставщиков для одной операции формы.
//
// Возвращаемое значение:
//  Структура - Реестр и два разделяемых с ним экземпляра поставщиков.
Функция НовыйКонтекстМетаданныхUI() Экспорт

	СтандартныйПоставщик =
		Обработки.ПоставщикМетаданныхСтандартныхТаблиц.Создать();
	ПоставщикПредставлений =
		Обработки.ПоставщикМетаданныхИсполняемыхПредставлений.Создать();
	Поставщики = Новый Массив;
	Поставщики.Добавить(СтандартныйПоставщик);
	Поставщики.Добавить(ПоставщикПредставлений);
	Реестр = Обработки.РеестрПоставщиковМетаданныхТаблиц.СоздатьРеестр(Поставщики);

	Возврат Новый Структура(
		"Реестр,СтандартныйПоставщик,ПоставщикПредставлений",
		Реестр,
		СтандартныйПоставщик,
		ПоставщикПредставлений);

КонецФункции

// Возвращает корневые строки каталога в порядке отображения формы.
Функция ОписанияКорневыхСтрокКаталога(КонтекстМетаданныхUI) Экспорт

	Описания = Новый Массив;
	Для Каждого ЭлементКаталога
		Из КонтекстМетаданныхUI.СтандартныйПоставщик.ДочерниеЭлементы() Цикл

		Описания.Добавить(ОписаниеСтрокиКаталога(ЭлементКаталога));

	КонецЦикла;

	КореньПредставлений = МетаданныеТаблицЗапроса.НовыйЭлементКаталога(
		"Представления",
		Неопределено,
		Неопределено,
		"Представления",
		Истина,
		Истина,
		"ИсполняемаяГруппа");
	Описания.Добавить(ОписаниеСтрокиКаталога(КореньПредставлений));

	Возврат Описания;

КонецФункции

// Возвращает строки непосредственных потомков группы каталога.
Функция ОписанияДочернихСтрокКаталога(
	КонтекстМетаданныхUI,
	ОписаниеРодителя) Экспорт

	ЭлементыКаталога = Новый Массив;
	Если ОписаниеРодителя.ВидИсточника = "СтандартнаяГруппа" Тогда
		ЭлементыКаталога =
			КонтекстМетаданныхUI.СтандартныйПоставщик.ДочерниеЭлементы(
				ОписаниеРодителя.Имя);
	ИначеЕсли ОписаниеРодителя.ВидИсточника = "ИсполняемаяГруппа" Тогда
		ИдентификаторРодителя = ОписаниеРодителя.Имя;
		Если ИдентификаторРодителя = "Представления" Тогда
			ИдентификаторРодителя = Неопределено;
		КонецЕсли;
		ЭлементыКаталога =
			КонтекстМетаданныхUI.ПоставщикПредставлений.ДочерниеЭлементы(
				ИдентификаторРодителя);
	КонецЕсли;

	Описания = Новый Массив;
	Для Каждого ЭлементКаталога Из ЭлементыКаталога Цикл
		Описания.Добавить(ОписаниеСтрокиКаталога(ЭлементКаталога));
	КонецЦикла;
	Возврат Описания;

КонецФункции

// Возвращает строки полей таблицы только в момент её раскрытия.
Функция ОписанияСтрокПолейТаблицы(
	КонтекстМетаданныхUI,
	ИмяТаблицы) Экспорт

	ОписаниеТаблицы =
		КонтекстМетаданныхUI.Реестр.ОписаниеТаблицы(ИмяТаблицы);
	Если ОписаниеТаблицы = Неопределено Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Возврат ОписанияСтрокПолей(ОписаниеТаблицы.Поля);

КонецФункции

Функция ОписанияСтрокПолей(Поля)

	Описания = Новый Массив;
	Для Каждого ОписаниеПоля Из Поля Цикл
		Описания.Добавить(ОписаниеСтрокиПоля(ОписаниеПоля));
	КонецЦикла;
	Возврат Описания;

КонецФункции

Процедура ДобавитьОписанияСтрокВДеревоТаблиц(Узел, Описания)

	Для Каждого ОписаниеСтроки Из Описания Цикл
		ДобавитьОписаниеСтрокиВДеревоТаблиц(Узел, ОписаниеСтроки);
	КонецЦикла;

КонецПроцедуры

Функция ДобавитьОписаниеСтрокиВДеревоТаблиц(ТекущийУзел, ОписаниеСтроки)

	ИмяСтроки = ОписаниеСтроки.Имя;
	Если ОписаниеСтроки.ТипЗначения =
		"ДоступнаяВложеннаяТаблицаСхемыЗапроса"
		И ТекущийУзел.Свойство("Имя")
		И ЗначениеЗаполнено(ТекущийУзел.Имя) Тогда

		ИмяСтроки = ТекущийУзел.Имя + "." + ОписаниеСтроки.Имя;
	КонецЕсли;

	НовыйУзел = ТекущийУзел.ПолучитьЭлементы().Добавить();
	УстановитьСвойствоСтроки(НовыйУзел, "Имя", ИмяСтроки);
	УстановитьСвойствоСтроки(НовыйУзел, "Представление", ОписаниеСтроки.Представление);
	УстановитьСвойствоСтроки(НовыйУзел, "ТипЗначения", ОписаниеСтроки.ТипЗначения);
	УстановитьСвойствоСтроки(
		НовыйУзел,
		"ТипЗначенияПоля",
		ОписаниеСтроки.ТипЗначенияПоля);
	УстановитьСвойствоСтроки(НовыйУзел, "Картинка", ОписаниеСтроки.Картинка);
	УстановитьСвойствоСтроки(
		НовыйУзел,
		"ЭтоГруппаИсполняемыхПредставлений",
		ОписаниеСтроки.ЭтоГруппаИсполняемыхПредставлений);
	УстановитьСвойствоСтроки(
		НовыйУзел,
		"ЭтоИсполняемоеПредставление",
		ОписаниеСтроки.ЭтоИсполняемоеПредставление);
	УстановитьСвойствоСтроки(
		НовыйУзел,
		"ВидИсточника",
		ОписаниеСтроки.ВидИсточника);

	Если ОписаниеСтроки.ЕстьДочерние Тогда
		НовыйУзел.ПолучитьЭлементы().Добавить();
	КонецЕсли;

	Возврат НовыйУзел;

КонецФункции

Процедура УстановитьСвойствоСтроки(СтрокаДерева, ИмяСвойства, Значение)

	Если СтрокаДерева.Свойство(ИмяСвойства) Тогда
		СтрокаДерева[ИмяСвойства] = Значение;
	КонецЕсли;

КонецПроцедуры

// Преобразует transport-safe элемент каталога в нейтральное описание строки дерева.
Функция ОписаниеСтрокиКаталога(ЭлементКаталога) Экспорт

	Описание = НовыйОписаниеСтрокиДерева();
	Описание.Имя = ЭлементКаталога.Идентификатор;
	Описание.Представление = ЭлементКаталога.Представление;
	Описание.ЕстьДочерние = ЭлементКаталога.ЕстьДочерние;
	Описание.ВидИсточника = ЭлементКаталога.ВидИсточника;

	Если ЭлементКаталога.ВидИсточника = "СтандартнаяГруппа" Тогда
		Описание.ТипЗначения = "ГруппаДоступныхТаблицСхемыЗапроса";
		Описание.Картинка = ИндексКартинки(ЭлементКаталога.Идентификатор);
	ИначеЕсли ЭлементКаталога.ВидИсточника = "СтандартнаяТаблица" Тогда
		Описание.ТипЗначения = "ДоступнаяТаблицаСхемыЗапроса";
		Описание.Картинка = ИндексКартинки(ЭлементКаталога.ИмяТаблицы);
	ИначеЕсли ЭлементКаталога.ВидИсточника = "ИсполняемаяГруппа" Тогда
		Описание.ТипЗначения = "ЭлементИерархииИсполняемыхПредставлений";
		Описание.Картинка = 20;
		Описание.ЭтоГруппаИсполняемыхПредставлений = Истина;
	ИначеЕсли ЭлементКаталога.ВидИсточника = "ИсполняемоеПредставление" Тогда
		Описание.ТипЗначения = "ЭлементИерархииИсполняемыхПредставлений";
		Описание.Картинка = 18;
		Описание.ЭтоИсполняемоеПредставление = Истина;
	КонецЕсли;

	Возврат Описание;

КонецФункции

// Преобразует нейтральное описание поля в описание строки дерева.
Функция ОписаниеСтрокиПоля(ОписаниеПоля) Экспорт

	Описание = НовыйОписаниеСтрокиДерева();
	Описание.Имя = ОписаниеПоля.Имя;
	Описание.Представление = ОписаниеПоля.Представление;
	Описание.ТипЗначенияПоля = ОписаниеПоля.ТипЗначения;
	Описание.РольПоля = ОписаниеПоля.Роль;
	Описание.ВидИсточника = ОписаниеПоля.ВидПоля;

	Если ОписаниеПоля.ВидПоля = МетаданныеТаблицЗапроса.ВидПоляВложеннаяТаблица() Тогда
		Описание.ТипЗначения = "ДоступнаяВложеннаяТаблицаСхемыЗапроса";
		Описание.Картинка = 29;
	Иначе
		Описание.ТипЗначения = "ДоступноеПолеТаблицы";
		Описание.Картинка = ИндексКартинкиПоля(ОписаниеПоля.Роль);
	КонецЕсли;

	Описание.ЕстьДочерние = ОписаниеПоля.Поля.Количество() > 0;
	Возврат Описание;

КонецФункции

Функция НовыйОписаниеСтрокиДерева()

	Возврат Новый Структура(
		"Имя,Представление,ТипЗначения,ТипЗначенияПоля,РольПоля,Картинка,"
		+ "ЭтоГруппаИсполняемыхПредставлений,ЭтоИсполняемоеПредставление,"
		+ "ЕстьДочерние,ВидИсточника",
		"",
		"",
		"",
		Неопределено,
		Неопределено,
		0,
		Ложь,
		Ложь,
		Ложь,
		"");

КонецФункции

Функция ИндексКартинкиПоля(РольПоля)

	ПредставлениеРоли = ВРег(Строка(РольПоля));
	Если СтрНайти(ПредставлениеРоли, "ИЗМЕРЕНИЕ") > 0 Тогда
		Возврат 27;
	ИначеЕсли СтрНайти(ПредставлениеРоли, "РЕСУРС") > 0 Тогда
		Возврат 23;
	КонецЕсли;

	Возврат 22;

КонецФункции

