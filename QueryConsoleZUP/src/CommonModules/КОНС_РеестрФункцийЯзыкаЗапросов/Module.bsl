#Область ПрограммныйИнтерфейс

// Возвращает описание встроенной функции языка запросов.
// Параметры:
//  ИмяФункции - Строка - Имя без учёта регистра.
// Возвращаемое значение:
//  Неопределено - Неизвестная функция.
//  Структура - см. НовоеОписаниеФункцииЗапроса
Функция ОписаниеФункцииЗапроса(ИмяФункции) Экспорт
	Имя = ВРег(ИмяФункции);
	Описание = НовоеОписаниеФункцииЗапроса();
	Описание.ИмяФункции = Имя;
	Если Имя = "ГОД"
		Или Имя = "КВАРТАЛ"
		Или Имя = "МЕСЯЦ"
		Или Имя = "ДЕНЬГОДА"
		Или Имя = "ДЕНЬ"
		Или Имя = "НЕДЕЛЯ"
		Или Имя = "ДЕНЬНЕДЕЛИ"
		Или Имя = "ЧАС"
		Или Имя = "МИНУТА"
		Или Имя = "СЕКУНДА" Тогда
		ЗаполнитьОписаниеЧастиПериода(Описание);
	ИначеЕсли Имя = "ПОДСТРОКА" Тогда
		ЗаполнитьОписаниеПодстрока(Описание);
	ИначеЕсли Имя = "ЕСТЬNULL" Тогда
		ЗаполнитьОписаниеЕстьNull(Описание);
	ИначеЕсли Имя = "ПРЕДСТАВЛЕНИЕ" Тогда
		ЗаполнитьОписаниеПредставление(Описание);
	ИначеЕсли Имя = "ПРЕДСТАВЛЕНИЕССЫЛКИ" Тогда
		ЗаполнитьОписаниеПредставлениеСсылки(Описание);
	ИначеЕсли Имя = "ТИПЗНАЧЕНИЯ" Тогда
		ЗаполнитьОписаниеТипЗначения(Описание);
	ИначеЕсли Имя = "ДАТАВРЕМЯ" Тогда
		ЗаполнитьОписаниеДатаВремя(Описание);
	ИначеЕсли Имя = "СУММА"
		Или Имя = "СРЕДНЕЕ" Тогда
		ЗаполнитьОписаниеСуммаИСреднее(Описание);
	ИначеЕсли Имя = "МИНИМУМ"
		Или Имя = "МАКСИМУМ" Тогда
		ЗаполнитьОписаниеМинимумИМаксимум(Описание);
	ИначеЕсли Имя = "СТРОКА" Тогда
		ЗаполнитьОписаниеСтрока(Описание);
	ИначеЕсли Имя = "ДЛИНАСТРОКИ" Тогда
		ЗаполнитьОписаниеДлинаСтроки(Описание);
	ИначеЕсли Имя = "СОКРЛ"
		Или Имя = "СОКРП"
		Или Имя = "СОКРЛП"
		Или Имя = "ВРЕГ"
		Или Имя = "НРЕГ" Тогда
		ЗаполнитьОписаниеПреобразованиеСтроки(Описание);
	ИначеЕсли Имя = "ЛЕВ"
		Или Имя = "ПРАВ" Тогда
		ЗаполнитьОписаниеЛевИПрав(Описание);
	ИначеЕсли Имя = "СТРНАЙТИ" Тогда
		ЗаполнитьОписаниеСтрНайти(Описание);
	ИначеЕсли Имя = "СТРЗАМЕНИТЬ" Тогда
		ЗаполнитьОписаниеСтрЗаменить(Описание);
	ИначеЕсли Имя = "SIN"
		Или Имя = "COS"
		Или Имя = "TAN"
		Или Имя = "ASIN"
		Или Имя = "ACOS"
		Или Имя = "ATAN"
		Или Имя = "EXP"
		Или Имя = "LOG"
		Или Имя = "LOG10"
		Или Имя = "SQRT"
		Или Имя = "ЦЕЛ" Тогда
		ЗаполнитьОписаниеМатематическаяОдноаргументная(Описание);
	ИначеЕсли Имя = "POW" Тогда
		ЗаполнитьОписаниеСтепень(Описание);
	ИначеЕсли Имя = "ОКР" Тогда
		ЗаполнитьОписаниеОкругление(Описание);
	ИначеЕсли Имя = "РАЗМЕРХРАНИМЫХДАННЫХ" Тогда
		ЗаполнитьОписаниеРазмерХранимыхДанных(Описание);
	ИначеЕсли Имя = "УНИКАЛЬНЫЙИДЕНТИФИКАТОР" Тогда
		ЗаполнитьОписаниеУникальныйИдентификатор(Описание);
	ИначеЕсли Имя = "АВТОНОМЕРЗАПИСИ" Тогда
		ЗаполнитьОписаниеАвтоНомерЗаписи(Описание);
	ИначеЕсли Имя = "СГРУППИРОВАНОПО" Тогда
		ЗаполнитьОписаниеСгруппированоПо(Описание);
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	Возврат Описание;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Создаёт начальное описание функции.
// Возвращаемое значение:
//  Структура:
// * ИмяФункции - Строка - Каноническое имя.
// * ДопустимыеКоличестваАргументов - Массив из Число - Варианты количества аргументов.
// * ТипыАргументов - Массив из Произвольный - По одному массиву допустимых имён типов для каждой позиции.
// * КоличествоАргументовДляВыводаТипа - Число - Число первых аргументов для объединения типов.
// * ВозвращаемыйТип - ОписаниеТипов, Неопределено - Фиксированный тип результата.
// * Агрегатная - Булево - Признак агрегатной функции.
Функция НовоеОписаниеФункцииЗапроса()
	Описание = Новый Структура;
	Описание.Вставить("ИмяФункции", "");
	Описание.Вставить("ДопустимыеКоличестваАргументов", Новый Массив);
	Описание.Вставить("ТипыАргументов", Новый Массив);
	Описание.Вставить("КоличествоАргументовДляВыводаТипа", 0);
	Описание.Вставить("ВозвращаемыйТип", Неопределено);
	Описание.Вставить("Агрегатная", Ложь);
	Возврат Описание;
КонецФункции

Процедура ЗаполнитьОписаниеЧастиПериода(Описание)
	Описание.ДопустимыеКоличестваАргументов.Добавить(1);
	ДопустимыеТипы = Новый Массив;
	ДопустимыеТипы.Добавить("Дата");
	Описание.ТипыАргументов.Добавить(ДопустимыеТипы);
	Описание.ВозвращаемыйТип = Новый ОписаниеТипов("Число");
КонецПроцедуры

Процедура ЗаполнитьОписаниеПодстрока(Описание)
	Описание.ДопустимыеКоличестваАргументов.Добавить(3);
	ДопустимыеТипы = Новый Массив;
	ДопустимыеТипы.Добавить("Строка");
	Описание.ТипыАргументов.Добавить(ДопустимыеТипы);
	ДопустимыеТипы = Новый Массив;
	ДопустимыеТипы.Добавить("Число");
	Описание.ТипыАргументов.Добавить(ДопустимыеТипы);
	ДопустимыеТипы = Новый Массив;
	ДопустимыеТипы.Добавить("Число");
	Описание.ТипыАргументов.Добавить(ДопустимыеТипы);
	Описание.ВозвращаемыйТип = Новый ОписаниеТипов("Строка");
КонецПроцедуры

Процедура ЗаполнитьОписаниеЕстьNull(Описание)
	Описание.ДопустимыеКоличестваАргументов.Добавить(2);
	Для НомерАргумента = 1 По 2 Цикл
		ДопустимыеТипы = Новый Массив;
		Описание.ТипыАргументов.Добавить(ДопустимыеТипы);
	КонецЦикла;
	Описание.КоличествоАргументовДляВыводаТипа = 2;
КонецПроцедуры

Процедура ЗаполнитьОписаниеПредставление(Описание)
