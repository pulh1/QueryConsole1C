#Область ПрограммныйИнтерфейс

// Создает transport-safe элемент ленивого каталога таблиц.
//
// Параметры:
//  Идентификатор - Строка - Идентификатор элемента.
//  ИдентификаторРодителя - Строка, Неопределено - Идентификатор родительского элемента.
//  ИмяТаблицы - Строка, Неопределено - Полное имя таблицы для конечного элемента.
//  Представление - Строка - Представление элемента.
//  ЭтоГруппа - Булево - Признак группирующего элемента.
//  ЕстьДочерние - Булево - Признак доступности ленивого раскрытия.
//  ВидИсточника - Строка - Вид источника таблицы.
//
// Возвращаемое значение:
//  Структура - Transport-safe элемент каталога.
Функция НовыйЭлементКаталога(
	Идентификатор,
	ИдентификаторРодителя = Неопределено,
	ИмяТаблицы = Неопределено,
	Представление = "",
	ЭтоГруппа = Ложь,
	ЕстьДочерние = Ложь,
	ВидИсточника = "") Экспорт

	Возврат Новый Структура(
		"Идентификатор,ИдентификаторРодителя,ИмяТаблицы,Представление,ЭтоГруппа,ЕстьДочерние,ВидИсточника",
		Идентификатор,
		ИдентификаторРодителя,
		ИмяТаблицы,
		Представление,
		ЭтоГруппа,
		ЕстьДочерние,
		ВидИсточника);

КонецФункции

// Создает нейтральное описание таблицы запроса.
//
// Параметры:
//  ИмяТаблицы - Строка - Полное имя таблицы.
//  ИмяПоставщика - Строка - Имя поставщика.
//  ВидИсточника - Строка - Вид источника таблицы.
//  Представление - Строка - Представление таблицы.
//
// Возвращаемое значение:
//  Структура - Нейтральное описание таблицы:
// * ИмяТаблицы - Строка
// * ИмяПоставщика - Строка
// * ВидИсточника - Строка
// * Представление - Строка
// * Поля - Массив из Структура
// * Параметры - Массив из Структура
// * ДанныеПоставщика - Неопределено
Функция НовыйОписаниеТаблицы(ИмяТаблицы = "", ИмяПоставщика = "", ВидИсточника = "", Представление = "") Экспорт

	Описание = Новый Структура;
	Описание.Вставить("ИмяТаблицы", ИмяТаблицы);
	Описание.Вставить("ИмяПоставщика", ИмяПоставщика);
	Описание.Вставить("ВидИсточника", ВидИсточника);
	Описание.Вставить("Представление", Представление);
	Описание.Вставить("Поля", Новый Массив);
	Описание.Вставить("Параметры", Новый Массив);
	Описание.Вставить("ДанныеПоставщика", Неопределено);
	Возврат Описание;

КонецФункции

// Создает краткое нейтральное описание таблицы без полей и параметров.
