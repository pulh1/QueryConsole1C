КонецФункции

// Создает нейтральное описание поля таблицы запроса.
//
// Параметры:
//  Имя - Строка - Имя поля.
//  Представление - Строка - Представление поля.
//  ВидПоля - Строка - Вид поля.
//  ТипЗначения - ОписаниеТипов, Неопределено - Тип значения поля.
//  Роль - Строка - Роль поля.
//
// Возвращаемое значение:
//  Структура - Нейтральное описание поля:
// * Имя - Строка
// * Представление - Строка
// * ВидПоля - Строка
// * ТипЗначения - ОписаниеТипов
// * Роль - Строка
// * Поля - Массив из Структура
// * ДанныеПоставщика - Неопределено
Функция НовыйОписаниеПоля(Имя = "", Представление = "", ВидПоля = "",
	ТипЗначения = Неопределено, Роль = "") Экспорт

	Если ПустаяСтрока(ВидПоля) Тогда
		ВидПоля = ВидПоляОбычное();
	КонецЕсли;

	Описание = Новый Структура;
	Описание.Вставить("Имя", Имя);
	Описание.Вставить("Представление", Представление);
	Описание.Вставить("ВидПоля", ВидПоля);
	Описание.Вставить("ТипЗначения", ТипЗначения);
	Описание.Вставить("Роль", Роль);
	Описание.Вставить("Поля", Новый Массив);
	Описание.Вставить("ДанныеПоставщика", Неопределено);
	Возврат Описание;

КонецФункции

// Создает нейтральное описание параметра таблицы запроса.
//
// Параметры:
//  Имя - Строка - Имя параметра.
//  ВидПараметра - Строка - Вид параметра.
//  ТипЗначения - ОписаниеТипов, Неопределено - Тип значения параметра.
//  Обязательный - Булево - Признак обязательного параметра.
//
// Возвращаемое значение:
//  Структура - Нейтральное описание параметра:
// * Имя - Строка
// * ВидПараметра - Строка
// * ТипЗначения - ОписаниеТипов
// * Обязательный - Булево
// * Варианты - Массив из Произвольный
// * Поля - Массив из Структура
// * ДанныеПоставщика - Неопределено
Функция НовыйОписаниеПараметра(Имя = "", ВидПараметра = "",
	ТипЗначения = Неопределено, Обязательный = Ложь) Экспорт

	Описание = Новый Структура;
	Описание.Вставить("Имя", Имя);
	Описание.Вставить("ВидПараметра", ВидПараметра);
	Описание.Вставить("ТипЗначения", ТипЗначения);
	Описание.Вставить("Обязательный", Обязательный);
	Описание.Вставить("Варианты", Новый Массив);
	Описание.Вставить("Поля", Новый Массив);
	Описание.Вставить("ДанныеПоставщика", Неопределено);
	Возврат Описание;

КонецФункции

// Возвращает поле по имени без учета регистра.
//
// Параметры:
//  Поля - Массив из Структура - Описания полей.
//  ИмяПоля - Строка - Искомое имя поля.
//
// Возвращаемое значение:
//  Структура, Неопределено - Найденное описание поля.
Функция НайтиПоле(Поля, ИмяПоля) Экспорт

	Для Каждого Поле Из Поля Цикл
		Если ВРег(Поле.Имя) = ВРег(ИмяПоля) Тогда
			Возврат Поле;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Возвращает вид обычного поля.
//
// Возвращаемое значение:
//  Строка - Вид обычного поля.
Функция ВидПоляОбычное() Экспорт

	Возврат "ОбычноеПоле";

КонецФункции

// Возвращает вид поля вложенной таблицы.
