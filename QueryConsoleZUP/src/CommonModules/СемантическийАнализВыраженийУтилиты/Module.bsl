#Область СлужебныеПроцедурыИФункции

// Определяет результат и проверяет ограничения общего вызова.
// Параметры:
//  Выражение - см. ЭлементыМоделиЗапроса.НовыйВызовФункции
//  ОписаниеФункции - см. КОНС_РеестрФункцийЯзыкаЗапросов.ОписаниеФункцииЗапроса
//  ТипыАргументов - Массив из ОписаниеТипов - Типы в исходном порядке.
// Возвращаемое значение:
//  ОписаниеТипов - Тип результата.
Функция ТипВызоваФункции(Выражение, ОписаниеФункции, ТипыАргументов) Экспорт
	ИмяФункции = ОписаниеФункции.ИмяФункции;
	Если ИмяФункции <> "ПРЕДСТАВЛЕНИЕ"
		И СодержитВызовПредставления(Выражение.Аргументы) Тогда
		ВызватьИсключение "ПРЕДСТАВЛЕНИЕ не может использоваться аргументом другой функции";
	КонецЕсли;
	Для Индекс = 0 По ТипыАргументов.ВГраница() Цикл
		ДопустимыеТипы = ОписаниеФункции.ТипыАргументов[Индекс];
		ПроверитьТипАргументаФункции(ИмяФункции, Индекс + 1, ТипыАргументов[Индекс], ДопустимыеТипы);
	КонецЦикла;
	Если ИмяФункции = "ДАТАВРЕМЯ" Тогда
		ПроверитьКонстантуДаты(Выражение.Аргументы.Элементы);
	ИначеЕсли ИмяФункции = "РАЗМЕРХРАНИМЫХДАННЫХ" Тогда
		Если Не ЭтоАргументПолеТаблицы(Выражение.Аргументы.Элементы[0]) Тогда
			ВызватьИсключение "Функция " + ИмяФункции + ": аргумент должен быть полем таблицы";
		КонецЕсли;
	КонецЕсли;

	Если ИмяФункции = "ПРЕДСТАВЛЕНИЕССЫЛКИ" Тогда
		Возврат ТипПредставленияСсылки(ТипыАргументов[0]);
	КонецЕсли;
	Если ОписаниеФункции.КоличествоАргументовДляВыводаТипа > 0 Тогда
		ТипРезультата = ТипыАргументов[0];
		Для Индекс = 1 По ОписаниеФункции.КоличествоАргументовДляВыводаТипа - 1 Цикл
			ТипРезультата = Новый ОписаниеТипов(ТипРезультата, ТипыАргументов[Индекс].Типы());
		КонецЦикла;
		Возврат ТипРезультата;
	КонецЕсли;

	УчитыватьNull = ИмяФункции <> "ПРЕДСТАВЛЕНИЕ"
		И ИмяФункции <> "ТИПЗНАЧЕНИЯ"
		И ИмяФункции <> "СГРУППИРОВАНОПО"
		И ИмяФункции <> "РАЗМЕРХРАНИМЫХДАННЫХ";
	ЕстьNull = Ложь;
	Если УчитыватьNull Тогда
		Для Каждого ТипАргумента Из ТипыАргументов Цикл
			Если ТипАргумента.СодержитТип(Тип("Null")) Тогда
				Если ТипАргумента.Типы().Количество() = 1 Тогда
					Возврат Новый ОписаниеТипов("Null");
				КонецЕсли;
				ЕстьNull = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если ЕстьNull Тогда
		ДобавляемыеТипы = Новый Массив;
		ДобавляемыеТипы.Добавить(Тип("Null"));
		Возврат Новый ОписаниеТипов(ОписаниеФункции.ВозвращаемыйТип, ДобавляемыеТипы);
	КонецЕсли;
	Возврат ОписаниеФункции.ВозвращаемыйТип;
КонецФункции

// Возвращает ограничение непосредственного параметра запроса.
// Параметры:
//  ДопустимыеТипы - Массив из Строка - Допустимые типы одной позиции.
// Возвращаемое значение:
//  ОписаниеТипов, Неопределено - Ограничение простого типа либо Неопределено.
Функция ОписаниеТипаАргументаФункции(ДопустимыеТипы) Экспорт
	Если ДопустимыеТипы.Количество() = 1 Тогда
		ИмяТипа = ДопустимыеТипы[0];
		Если ИмяТипа = "Число" Или ИмяТипа = "Строка" Или ИмяТипа = "Дата" Тогда
			Возврат Новый ОписаниеТипов(ИмяТипа);
		КонецЕсли;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция ЭтоАргументПолеТаблицы(Аргумент)
	Если ТипЗнч(Аргумент) <> Тип("Структура") Или Не Аргумент.Свойство("Тип") Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Аргумент.Тип = "СписокВыражений" И Аргумент.Элементы.Количество() = 1 Тогда
		Возврат ЭтоАргументПолеТаблицы(Аргумент.Элементы[0]);
	ИначеЕсли Аргумент.Тип = "Разыменование" И Аргумент.Элементы.Количество() > 0 Тогда
		Возврат ЭтоАргументПолеТаблицы(Аргумент.Элементы[0]);
	КонецЕсли;
	Возврат Аргумент.Тип = "ПолеИсточника";
КонецФункции

Функция СодержитВызовПредставления(Узел)
	Если ТипЗнч(Узел) = Тип("Структура") Тогда
		// Вложенный запрос самостоятельно проверяет свои выражения.
		Если Узел.Свойство("Тип") И Узел.Тип = "ЗапросВыбора" Тогда
			Возврат Ложь;
		КонецЕсли;
		Если Узел.Свойство("Тип") И Узел.Тип = "ВызовФункции"
			И ВРег(Узел.ИмяФункции) = "ПРЕДСТАВЛЕНИЕ" Тогда
			Возврат Истина;
		КонецЕсли;
		Для Каждого Свойство Из Узел Цикл
			Если СодержитВызовПредставления(Свойство.Значение) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТипЗнч(Узел) = Тип("Массив") Тогда
		Для Каждого Элемент Из Узел Цикл
			Если СодержитВызовПредставления(Элемент) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

Процедура ПроверитьТипАргументаФункции(ИмяФункции, НомерАргумента, ТипАргумента, ДопустимыеТипы)
	Если ДопустимыеТипы.Количество() = 0 Или МодельЗапросаТипы.СодержитПроизвольныйТип(ТипАргумента) Тогда
		Возврат;
	КонецЕсли;
	Для Каждого ПроверяемыйТип Из ТипАргумента.Типы() Цикл
		Если ПроверяемыйТип = Тип("Null") Тогда
			Продолжить;
		КонецЕсли;
		Допустим = Ложь;
		Для Каждого ИмяДопустимогоТипа Из ДопустимыеТипы Цикл
			Если ИмяДопустимогоТипа = "Ссылка" Тогда
				Допустим = ЭтоСсылочныйТипФункции(ПроверяемыйТип);
			Иначе
				Допустим = ПроверяемыйТип = Тип(ИмяДопустимогоТипа);
			КонецЕсли;
			Если Допустим Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не Допустим Тогда
			ВызватьИсключение "Функция " + ИмяФункции + ": недопустимый тип аргумента " + Строка(НомерАргумента);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ЭтоСсылочныйТипФункции(ПроверяемыйТип)
	ОписаниеМетаданных = Метаданные.НайтиПоТипу(ПроверяемыйТип);
	Если ОписаниеМетаданных = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	ПолноеИмя = ОписаниеМетаданных.ПолноеИмя();
	Возврат Не СтрНачинаетсяС(ПолноеИмя, "ВнешнийИсточникДанных.")
		И Не СтрНачинаетсяС(ПолноеИмя, "ExternalDataSource.");
КонецФункции

Функция ТипПредставленияСсылки(ТипАргумента)
	Если МодельЗапросаТипы.СодержитПроизвольныйТип(ТипАргумента) Тогда
		Возврат ТипАргумента;
	КонецЕсли;
	ТипыРезультата = Новый Массив;
	Для Каждого ПроверяемыйТип Из ТипАргумента.Типы() Цикл
		Если ЭтоСсылочныйТипФункции(ПроверяемыйТип) Тогда
			ТипРезультата = Тип("Строка");
		Иначе
			ТипРезультата = ПроверяемыйТип;
		КонецЕсли;
		Если ТипыРезультата.Найти(ТипРезультата) = Неопределено Тогда
			ТипыРезультата.Добавить(ТипРезультата);
		КонецЕсли;
	КонецЦикла;
	Возврат Новый ОписаниеТипов(ТипыРезультата);
КонецФункции

Процедура ПроверитьКонстантуДаты(Аргументы)
	Значения = Новый Массив;
	Для Каждого Аргумент Из Аргументы Цикл
		Если Аргумент.Тип <> "Константа" Или ТипЗнч(Аргумент.Значение) <> Тип("Число") Тогда
			ВызватьИсключение "Функция ДАТАВРЕМЯ: аргументы должны быть целыми числовыми константами";
		КонецЕсли;
		Если Цел(Аргумент.Значение) <> Аргумент.Значение Тогда
			ВызватьИсключение "Функция ДАТАВРЕМЯ: аргументы должны быть целыми числовыми константами";
		КонецЕсли;
		Значения.Добавить(Аргумент.Значение);
	КонецЦикла;
	Если Значения[0] < 1 Или Значения[0] > 3999 Тогда
		ВызватьИсключение "Функция ДАТАВРЕМЯ: недопустимое значение даты";
	КонецЕсли;
	Попытка
		Если Значения.Количество() = 3 Тогда
			ПроверяемаяДата = Дата(Значения[0], Значения[1], Значения[2]);
		Иначе
			ПроверяемаяДата = Дата(Значения[0], Значения[1], Значения[2], Значения[3], Значения[4], Значения[5]);
		КонецЕсли;
	Исключение
		ВызватьИсключение "Функция ДАТАВРЕМЯ: недопустимое значение даты";
	КонецПопытки;
	Если Год(ПроверяемаяДата) <> Значения[0] Или Месяц(ПроверяемаяДата) <> Значения[1]
		Или День(ПроверяемаяДата) <> Значения[2] Тогда
		ВызватьИсключение "Функция ДАТАВРЕМЯ: недопустимое значение даты";
	КонецЕсли;
	Если Значения.Количество() = 6 Тогда
		Если Час(ПроверяемаяДата) <> Значения[3] Или Минута(ПроверяемаяДата) <> Значения[4]
			Или Секунда(ПроверяемаяДата) <> Значения[5] Тогда
			ВызватьИсключение "Функция ДАТАВРЕМЯ: недопустимое значение даты";
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура ОбработатьОбращениеКПолюИсточника(ЭлементыРазыменования, Контекст) Экспорт
	ПервыйЭлементРазыменования = ЭлементыРазыменования[0];

	Если ТипЗнч(ПервыйЭлементРазыменования) <> Тип("Строка") Тогда
		Возврат;
	КонецЕсли;

	ПолеИсточникаЗапроса = ЭлементыМоделиЗапроса.НовыйПолеИсточника();

	Источник = Контекст.ИспользуемыеТаблицы.Получить(ВРег(ПервыйЭлементРазыменования));

	Если Источник = Неопределено Или Не Контекст.ДоступныПсевдонимыИсточников Тогда
		Результат = НайтиПолеВоВсехИсточниках(ПервыйЭлементРазыменования, Контекст);
		Если Результат.Поле = Неопределено Тогда
			ВызватьИсключение "Таблица " + ПервыйЭлементРазыменования + " не найдена";
		КонецЕсли;

		ПолеИсточникаЗапроса.ИдентификаторИсточника = Результат.Источник.ИдентификаторИсточника;
		ПолеИсточникаЗапроса.ИмяПоля = Результат.Поле.Имя;
	Иначе
		Если ЭлементыРазыменования.Количество() = 1  Тогда
			ВызватьИсключение "Поле " + ПервыйЭлементРазыменования + " не найдено";
		КонецЕсли;

		Если (Не Контекст.ДоступныИсточникиВнешнегоЗапроса
			И Контекст.ИдентификаторыИсточниковВнешнегоЗапроса.Получить(Источник.ИдентификаторИсточника) <> Неопределено) Тогда

			ВызватьИсключение "Таблица " + ПервыйЭлементРазыменования + " не найдена";
		КонецЕсли;

		ПолеИсточникаЗапроса.ИдентификаторИсточника = Источник.ИдентификаторИсточника;
		ПолеИсточникаЗапроса.ИмяПоля = ЭлементыРазыменования[1];

		ЭлементыРазыменования.Удалить(0);
	КонецЕсли;

	ЭлементыРазыменования[0] = ПолеИсточникаЗапроса;
КонецПроцедуры

Функция НайтиПолеВоВсехИсточниках(ИмяПоля, Контекст)
	РезультатПоиска = Новый Структура("Поле, Источник");

	Поле = Неопределено;
	Источник = Неопределено;
	Для Каждого КлючЗначение Из Контекст.ИспользуемыеТаблицы Цикл
		Если (Не Контекст.ДоступныИсточникиВнешнегоЗапроса
			И Контекст.ИдентификаторыИсточниковВнешнегоЗапроса.Получить(КлючЗначение.Значение.ИдентификаторИсточника) <> Неопределено) Тогда

			Продолжить;
		КонецЕсли;

		ТекущееПоле = НайтиПолеВИсточнике(
			ИмяПоля, КлючЗначение.Значение.Источник, Контекст, Ложь);
		Источник = КлючЗначение.Значение;
		Если Поле <> Неопределено
			И ТекущееПоле <> Неопределено Тогда

			ВызватьИсключение "Не однозначное имя поля " + ИмяПоля;
		ИначеЕсли ТекущееПоле <> Неопределено Тогда
			Поле = ТекущееПоле;
			НайденныйИсточника = Источник;
		КонецЕсли;
	КонецЦикла;

	РезультатПоиска.Поле = Поле;
	РезультатПоиска.Источник = НайденныйИсточника;

	Возврат РезультатПоиска;
КонецФункции

Функция НайтиПолеВИсточнике(
	ИмяПоля, Источник, Контекст, РазрешитьНеявноеПолеЛокальногоИсточника = Истина) Экспорт
	Если Источник.Тип = "ИсточникДанныхВложенныйЗапрос" Тогда
		Колонка = Источник.ЗапросВыбора.КолонкиПоПсевдонимам.Получить(ВРег(ИмяПоля));
		Если Колонка = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат МетаданныеТаблицЗапроса.НовыйОписаниеПоля(
			ИмяПоля, ИмяПоля, МетаданныеТаблицЗапроса.ВидПоляОбычное(), Колонка.ТипЗначения);
	ИначеЕсли Источник.Тип = "ИсточникДанныхВременнаяТаблица" Тогда
		ОписаниеВТ = Источник.ОписаниеВТ;
		Если ОписаниеВТ = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		ТипЗначения = ОписаниеВТ.Колонки.Получить(ВРег(ИмяПоля));
		Если ТипЗначения = Неопределено Тогда
			ЗаполнятьОписаниеВТ = Ложь;
			Контекст.Свойство("ЗаполнятьОписаниеВременныхТаблиц", ЗаполнятьОписаниеВТ);
			Если Не ЗаполнятьОписаниеВТ
				Или ОписаниеВТ.ИндексЗапросаСоздания <> -1
				Или Не РазрешитьНеявноеПолеЛокальногоИсточника Тогда

				Возврат Неопределено;
			КонецЕсли;
			ТипЗначения = МодельЗапросаТипы.ОписаниеПроизвольногоТипа();
			МодельЗапросаУтилиты.ДобавитьПолеВОписаниеВТ(
				ОписаниеВТ, ИмяПоля, ТипЗначения);
		КонецЕсли;
		Возврат МетаданныеТаблицЗапроса.НовыйОписаниеПоля(
			ИмяПоля, ИмяПоля, МетаданныеТаблицЗапроса.ВидПоляОбычное(), ТипЗначения);
	ИначеЕсли Источник.Тип = "ИсточникДанныхТаблицаЗначений"
		И РазрешитьНеявноеПолеЛокальногоИсточника Тогда
		Возврат МетаданныеТаблицЗапроса.НовыйОписаниеПоля(
			ИмяПоля,
			ИмяПоля,
			МетаданныеТаблицЗапроса.ВидПоляОбычное(),
			МодельЗапросаТипы.ОписаниеПроизвольногоТипа());
	ИначеЕсли Источник.Тип = "ИсточникДанныхТаблица"
		Или Источник.Тип = "ИсполняемоеПредставление" Тогда

		Возврат НайтиПолеВИменованномИсточнике(
			Источник.ИмяТаблицы, ИмяПоля, Контекст);
	КонецЕсли;

	Возврат Неопределено;
КонецФункции

Функция НайтиПолеВИменованномИсточнике(ИмяТаблицы, ИмяПоля, Контекст)
	Реестр = Контекст.РеестрПоставщиковМетаданныхТаблиц;
	Если Реестр = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Реестр.НайтиПоле(ИмяТаблицы, ИмяПоля);
КонецФункции

Функция ТипЭлементаРазыменованияИзОписанияТипов(
	ЭлементРазыменования, ТекущийТип, Контекст) Экспорт

	НовыйТип = Неопределено;
	Для Каждого Тип Из ТекущийТип.Типы() Цикл
		Если Тип = МодельЗапросаТипы.ПроизвольныйТип() Тогда
			Если НовыйТип = Неопределено Тогда
				НовыйТип = МодельЗапросаТипы.ОписаниеПроизвольногоТипа();
			Иначе
				ДобавляемыеТипы = Новый Массив;
				ДобавляемыеТипы.Добавить(МодельЗапросаТипы.ПроизвольныйТип());
				НовыйТип = Новый ОписаниеТипов(НовыйТип, ДобавляемыеТипы);
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		МетаданныеТипа = Метаданные.НайтиПоТипу(Тип);
		Если МетаданныеТипа = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Поле = НайтиПолеВИменованномИсточнике(
			МетаданныеТипа.ПолноеИмя(),
			ЭлементРазыменования,
			Контекст);
		Если Поле = Неопределено
			Или Поле.ВидПоля <> МетаданныеТаблицЗапроса.ВидПоляОбычное()
			Или Поле.ТипЗначения = Неопределено Тогда

			Продолжить;
		КонецЕсли;
		Если НовыйТип = Неопределено Тогда
			НовыйТип = Поле.ТипЗначения;
		Иначе
			НовыйТип = Новый ОписаниеТипов(НовыйТип, Поле.ТипЗначения.Типы());
		КонецЕсли;
	КонецЦикла;

	Если НовыйТип = Неопределено Тогда
		ВызватьИсключение "Поле не найдено " + ЭлементРазыменования;
	КонецЕсли;

	Возврат НовыйТип;
КонецФункции

Функция ТипПоляПоИмени(ИмяПоля, Источник, Контекст) Экспорт
	Поле = НайтиПолеВИсточнике(ИмяПоля, Источник, Контекст);
	Если Поле <> Неопределено Тогда
		Возврат Поле.ТипЗначения;
	КонецЕсли;

	Если Источник.Тип = "ИсточникДанныхВложенныйЗапрос" Тогда
		ВызватьИсключение "Поле " + Источник.Псевдоним + "." + ИмяПоля + " не найдено";
	ИначеЕсли Источник.Тип = "ИсточникДанныхВременнаяТаблица" Тогда
		Если Контекст.ЗаполнятьОписаниеВременныхТаблиц
			И Источник.ОписаниеВТ.ИндексЗапросаСоздания = -1 Тогда
			ТипПоля = МодельЗапросаТипы.ОписаниеПроизвольногоТипа();
			МодельЗапросаУтилиты.ДобавитьПолеВОписаниеВТ(Источник.ОписаниеВТ, ИмяПоля, ТипПоля);

			Возврат ТипПоля;
		Иначе
			ВызватьИсключение "Поле " + Источник.Псевдоним + "." + ИмяПоля + " не найдено";
		КонецЕсли;
	ИначеЕсли Источник.Тип = "ИсточникДанныхТаблица" Тогда
		ВызватьИсключение "Поле " + Источник.Псевдоним + "." + ИмяПоля + " не найдено";
	ИначеЕсли Источник.Тип = "ИсполняемоеПредставление" Тогда
		ВызватьИсключение "Поле " + Источник.Псевдоним + "." + ИмяПоля + " не найдено";
	Иначе
		ВызватьИсключение "Не известный тип источника";
	КонецЕсли;
КонецФункции

Функция ТипИзОписанияТипаЗапроса(ОписаниеТипаЗапроса) Экспорт
	Если ОписаниеТипаЗапроса.Тип = "ОписаниеТипаБулево" Тогда
		Возврат Новый ОписаниеТипов("Булево");
	ИначеЕсли ОписаниеТипаЗапроса.Тип = "ОписаниеТипаДата" Тогда
		Возврат Новый ОписаниеТипов("Дата");
	ИначеЕсли ОписаниеТипаЗапроса.Тип = "ОписаниеТипаЧисло" Тогда
		Возврат Новый ОписаниеТипов("Число");
	ИначеЕсли ОписаниеТипаЗапроса.Тип = "ОписаниеТипаСтрока" Тогда
		Возврат Новый ОписаниеТипов("Строка");
	ИначеЕсли ОписаниеТипаЗапроса.Тип = "ТипСсылочногоПоля" Тогда
		Возврат ТипСссылкиПоОписанию(ОписаниеТипаЗапроса);
	Иначе
		Возврат Неопределено;
	КонецЕсли;
КонецФункции

Функция ТипСссылкиПоОписанию(ТипСсылочногоПоля)	Экспорт
	Имя = ТипСсылочногоПоля.Группа + "." + ТипСсылочногоПоля.Таблица;
	МетаданныеТипа = Метаданные.НайтиПоПолномуИмени(Имя);
	Если МетаданныеТипа = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Метаданные.Справочники.Содержит(МетаданныеТипа) Тогда
		Возврат Новый ОписаниеТипов("СправочникСсылка." + ТипСсылочногоПоля.Таблица);
	ИначеЕсли Метаданные.Документы.Содержит(МетаданныеТипа) Тогда
		Возврат Новый ОписаниеТипов("ДокументСсылка." + ТипСсылочногоПоля.Таблица);
	ИначеЕсли Метаданные.Перечисления.Содержит(МетаданныеТипа) Тогда
		Возврат Новый ОписаниеТипов("ПеречислениеСсылка." + ТипСсылочногоПоля.Таблица);
	ИначеЕсли Метаданные.ПланыОбмена.Содержит(МетаданныеТипа) Тогда
		Возврат Новый ОписаниеТипов("ПланОбменаСсылка." + ТипСсылочногоПоля.Таблица);
	ИначеЕсли Метаданные.ПланыСчетов.Содержит(МетаданныеТипа) Тогда
		Возврат Новый ОписаниеТипов("ПланСчетовСсылка." + ТипСсылочногоПоля.Таблица);
	ИначеЕсли Метаданные.ПланыВидовРасчета.Содержит(МетаданныеТипа) Тогда
		Возврат Новый ОписаниеТипов("ПланВидовРасчетаСсылка." + ТипСсылочногоПоля.Таблица);
	ИначеЕсли Метаданные.ПланыВидовХарактеристик.Содержит(МетаданныеТипа) Тогда
		Возврат Новый ОписаниеТипов("ПланВидовХарактеристикСсылка." + ТипСсылочногоПоля.Таблица);
	ИначеЕсли Метаданные.БизнесПроцессы.Содержит(МетаданныеТипа) Тогда
		Возврат Новый ОписаниеТипов("БизнесПроцессСсылка." + ТипСсылочногоПоля.Таблица);
	ИначеЕсли Метаданные.Задачи.Содержит(МетаданныеТипа) Тогда
		Возврат Новый ОписаниеТипов("ЗадачаСсылка." + ТипСсылочногоПоля.Таблица);
	Иначе
		Возврат Неопределено;
	КонецЕсли;
КонецФункции

Функция ТипФункцииЗначение(ФункцияЗначение) Экспорт
	Если ФункцияЗначение.ЧастиПути.Количество() = 2 Тогда
		// TODO проверять обращения к системны перечислениям, пока вернем заглущку
		Возврат Новый ОписаниеТипов("ВидДвиженияНакопления");
	Иначе
		ОписаниеСсылочногоПоля = ЭлементыМоделиЗапроса.НовыйТипСсылочногоПоля();
		ОписаниеСсылочногоПоля.Группа = ФункцияЗначение.ЧастиПути[0];
		ОписаниеСсылочногоПоля.Таблица = ФункцияЗначение.ЧастиПути[1];

		Тип = ТипСссылкиПоОписанию(ОписаниеСсылочногоПоля);
		Если ВРег(ФункцияЗначение.ЧастиПути[2]) = "ПУСТАЯССЫЛКА" Тогда
			Возврат Тип;
		Иначе
			// TODO проверить наличие предопределенного элемента
			Возврат Тип;
		КонецЕсли;
	КонецЕсли;
КонецФункции

#КонецОбласти
