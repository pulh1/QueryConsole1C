#Область ОписаниеПеременных

Перем СегментыПоставщика;
Перем СуществующиеТаблицы;
Перем ИмяПоставщикаШпиона;
Перем СчетчикПроверокСуществования;
//@skip-check module-accessibility-at-client
Перем СчетчикПоисковТаблицы;
//@skip-check module-accessibility-at-client
Перем СчетчикПоисковПоля;
Перем СчетчикПолученийОписания;

#КонецОбласти

#Область ПрограммныйИнтерфейс

&НаСервере
Функция Инициализировать() Экспорт

	СчетчикПроверокСуществования = 0;
	СчетчикПоисковТаблицы = 0;
	СчетчикПоисковПоля = 0;
	СчетчикПолученийОписания = 0;
	Возврат ЭтотОбъект;

КонецФункции

&НаСервере
Функция Настроить(ИмяПоставщика, Сегменты, Таблицы) Экспорт

	ИмяПоставщикаШпиона = ИмяПоставщика;
	СегментыПоставщика = Сегменты;
	СуществующиеТаблицы = Таблицы;
	Возврат ЭтотОбъект;

КонецФункции

&НаСервере
Функция ИмяПоставщика() Экспорт

	Возврат ИмяПоставщикаШпиона;

КонецФункции

&НаСервере
Функция Сегменты() Экспорт

	Возврат СегментыПоставщика;

КонецФункции

&НаСервере
Функция ТаблицаСуществует(ИмяТаблицы) Экспорт

	СчетчикПроверокСуществования = СчетчикПроверокСуществования + 1;
	Возврат СуществующиеТаблицы.Получить(ВРег(ИмяТаблицы)) <> Неопределено;

КонецФункции

// Возвращает описание таблицы из тестовых данных.
//
// Параметры:
//  ИмяТаблицы - Строка - Полное имя таблицы.
//
// Возвращаемое значение:
//  Структура, Неопределено - Найденное описание.
//@skip-check bsl-legacy-check-pragma-for-unused-method
//@skip-check form-module-pragma
&НаСервере
Функция НайтиТаблицу(ИмяТаблицы) Экспорт

	СчетчикПоисковТаблицы = СчетчикПоисковТаблицы + 1;
	Возврат СуществующиеТаблицы.Получить(ВРег(ИмяТаблицы));

КонецФункции

// Возвращает описание поля из тестовых данных.
//
// Параметры:
//  ИмяТаблицы - Строка - Полное имя таблицы.
//  ИмяПоля - Строка - Имя поля.
//
// Возвращаемое значение:
//  Структура, Неопределено - Найденное описание поля.
//@skip-check bsl-legacy-check-pragma-for-unused-method
//@skip-check form-module-pragma
&НаСервере
Функция НайтиПоле(ИмяТаблицы, ИмяПоля) Экспорт

	СчетчикПоисковПоля = СчетчикПоисковПоля + 1;
	ОписаниеТаблицы = СуществующиеТаблицы.Получить(ВРег(ИмяТаблицы));
	Если ОписаниеТаблицы = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Для Каждого Поле Из ОписаниеТаблицы.Поля Цикл
		Если ВРег(Поле.Имя) = ВРег(ИмяПоля) Тогда
			Возврат Поле;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

&НаСервере
Функция ОписаниеТаблицы(ИмяТаблицы) Экспорт

	СчетчикПолученийОписания = СчетчикПолученийОписания + 1;
	Возврат СуществующиеТаблицы.Получить(ВРег(ИмяТаблицы));

КонецФункции

&НаСервере
Функция КоличествоПроверокСуществования() Экспорт

	Возврат СчетчикПроверокСуществования;

КонецФункции

// Возвращает количество точечных поисков таблицы.
//
// Возвращаемое значение:
//  Число - Количество вызовов.
//@skip-check bsl-legacy-check-pragma-for-unused-method
//@skip-check form-module-pragma
&НаСервере
Функция КоличествоПоисковТаблицы() Экспорт

	Возврат СчетчикПоисковТаблицы;

КонецФункции

// Возвращает количество точечных поисков поля.
//
// Возвращаемое значение:
//  Число - Количество вызовов.
//@skip-check bsl-legacy-check-pragma-for-unused-method
//@skip-check form-module-pragma
&НаСервере
Функция КоличествоПоисковПоля() Экспорт

	Возврат СчетчикПоисковПоля;

КонецФункции

&НаСервере
Функция КоличествоПолученийОписания() Экспорт

	Возврат СчетчикПолученийОписания;

КонецФункции

#КонецОбласти
