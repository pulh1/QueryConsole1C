		Возврат "Сотрудник";
	ИначеЕсли ИмяМенеджера = "ПредставлениеДанныеУчетаВремениСотрудников" Тогда
		Возврат "Сотрудник";
	ИначеЕсли ИмяМенеджера = "ПредставлениеДанныеФизическихЛиц" Тогда
		Возврат "ФизическоеЛицо";
	ИначеЕсли ИмяМенеджера = "ПредставлениеНачисленияУдержанияВыплаты" Тогда
		Возврат "Сотрудник";
	ИначеЕсли ИмяМенеджера = "ПредставлениеНачисленияУдержанияВыплатыАвансом" Тогда
		Возврат "Сотрудник";
	ИначеЕсли ИмяМенеджера = "ПредставлениеОстаткиОтпусков" Тогда
		Возврат "Сотрудник";
	ИначеЕсли ИмяМенеджера = "ПредставлениеПериоды" Тогда
		Возврат "Период";
	ИначеЕсли ИмяМенеджера = "ПредставлениеПлановоеВремяСотрудников" Тогда
		Возврат "Сотрудник";
	ИначеЕсли ИмяМенеджера = "ПредставлениеРабочиеМестаСотрудников" Тогда
		Возврат "Сотрудник";
	ИначеЕсли ИмяМенеджера = "ПредставлениеРегистрСведенийЗаписи" Тогда
		Возврат "Сотрудник";
	ИначеЕсли ИмяМенеджера = "ПредставлениеРегистрСведенийСрезПоследних" Тогда
		Возврат "Сотрудник";
	ИначеЕсли ИмяМенеджера = "ПредставлениеСотрудникиОрганизации" Тогда
		Возврат "Сотрудник";
	ИначеЕсли ИмяМенеджера = "ПредставлениеСтажиФизическихЛиц" Тогда
		Возврат "ФизическоеЛицо";
	ИначеЕсли ИмяМенеджера = "ПредставлениеФактическиеОтпускаСотрудников" Тогда
		Возврат "Сотрудник";
	Иначе
		ВызватьИсключение "Неизвестное ожидаемое значение: " + ИмяМенеджера;
	КонецЕсли;

КонецФункции

Функция ОжидаемыйМаркерИсполняемогоКода(ИмяМенеджера)

	Если ИмяМенеджера = "ПредставлениеДанныеПозицийШтатногоРасписания" Тогда
		Возврат "СоздатьВТШтатноеРасписание";
	ИначеЕсли ИмяМенеджера = "ПредставлениеДанныеСотрудников" Тогда
		Возврат "СоздатьВТКадровыеДанныеСотрудников";
	ИначеЕсли ИмяМенеджера = "ПредставлениеДанныеУчетаВремениСотрудников" Тогда
		Возврат "СоздатьВТДанныеУчетаВремениИСостоянийСотрудников";
	ИначеЕсли ИмяМенеджера = "ПредставлениеДанныеФизическихЛиц" Тогда
		Возврат "СоздатьВТКадровыеДанныеФизическихЛиц";
	ИначеЕсли ИмяМенеджера = "ПредставлениеНачисленияУдержанияВыплаты" Тогда
		Возврат "НачисленияУдержания";
	ИначеЕсли ИмяМенеджера = "ПредставлениеНачисленияУдержанияВыплатыАвансом" Тогда
		Возврат "НачисленияУдержанияАвансом";
	ИначеЕсли ИмяМенеджера = "ПредставлениеОстаткиОтпусков" Тогда
		Возврат "ОстаткиОтпусков.ОстаткиОтпусков";
	ИначеЕсли ИмяМенеджера = "ПредставлениеПериоды" Тогда
		Возврат "СоздатьВТПериоды";
	ИначеЕсли ИмяМенеджера = "ПредставлениеПлановоеВремяСотрудников" Тогда
		Возврат "СоздатьВТПлановоеВремя";
	ИначеЕсли ИмяМенеджера = "ПредставлениеРабочиеМестаСотрудников" Тогда
		Возврат "СоздатьВТРабочиеМестаСотрудников";
	ИначеЕсли ИмяМенеджера = "ПредставлениеРегистрСведенийЗаписи" Тогда
		Возврат "СоздатьВТИмяРегистра";
	ИначеЕсли ИмяМенеджера = "ПредставлениеРегистрСведенийСрезПоследних" Тогда
		Возврат "СоздатьВТИмяРегистраСрезПоследних";
	ИначеЕсли ИмяМенеджера = "ПредставлениеСотрудникиОрганизации" Тогда
		Возврат "СоздатьВТСотрудникиОрганизации";
	ИначеЕсли ИмяМенеджера = "ПредставлениеСтажиФизическихЛиц" Тогда
		Возврат "СоздатьВТСтажиФизическихЛиц";
	ИначеЕсли ИмяМенеджера = "ПредставлениеФактическиеОтпускаСотрудников" Тогда
		Возврат "СоздатьВТФактическиеОтпускаСотрудников";
	Иначе
		ВызватьИсключение "Неизвестное ожидаемое значение: " + ИмяМенеджера;
	КонецЕсли;

КонецФункции

Функция ПолноеИмяПредставления(ИмяМенеджера)

	Если ИмяМенеджера = "ПредставлениеРегистрСведенийЗаписи" Тогда
		Возврат "РегистрСведений.ГрафикРаботыСотрудников.Записи";
	ИначеЕсли ИмяМенеджера = "ПредставлениеРегистрСведенийСрезПоследних" Тогда
