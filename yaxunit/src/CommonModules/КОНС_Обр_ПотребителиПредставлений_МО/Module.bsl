Функция ПараметрыВыполненияДляМенеджера(ИмяМенеджера)

	Описание = ВызватьОписание(ИмяМенеджера);
	Параметры = НовыйПараметрыВыполненияПредставленияДляТеста();
	Параметры.ИмяИсполняемогоПредставления = ПолноеИмяПредставления(ИмяМенеджера);
	Параметры.ИмяВТРезультат = "ВТКонтрактПредставления";
	Параметры.ИдентификаторИсточника = Новый УникальныйИдентификатор;

	ИмяПоля = ОжидаемоеИспользуемоеПоле(ИмяМенеджера);
	Параметры.ИспользуемыеПоля.Вставить(ВРег(ИмяПоля), Истина);
	Параметры.ПсевдонимыПолей.Вставить(ВРег(ИмяПоля), ИмяПоля);

	Для Каждого ОписаниеПараметра Из Описание.ОписаниеПараметров Цикл
		ЗначениеПараметра = НовыйЗначениеПараметраКонстантаДляТеста();
		Если ИмяМенеджера = "ПредставлениеДанныеУчетаВремениСотрудников" Тогда
			ЗначениеПараметра.Значение = ОписаниеПараметра.Имя;
			ЗначениеПараметра.ЭтоПараметрЗапроса = Истина;
		Иначе
			ЗначениеПараметра.Значение = ОписаниеПараметра.ЗначениеПоУмолчанию;
		КонецЕсли;
		Параметры.ЗначенияПараметровКонстант.Вставить(ОписаниеПараметра.Имя, ЗначениеПараметра);
	КонецЦикла;

	Если Описание.ОписаниеВТФильтр <> Неопределено Тогда
		Параметры.ОписаниеВТФильтр = НовыйОписаниеВТФильтрДляТеста();
		Параметры.ОписаниеВТФильтр.ИмяВТ = "ВТФильтрКонтракт";
		Для Каждого ПолеФильтра Из Описание.ОписаниеВТФильтр.ПоляФильтра Цикл
			Параметры.ОписаниеВТФильтр.ПсевдонимыПолей.Вставить(ПолеФильтра.Имя, ПолеФильтра.Имя);
		КонецЦикла;
	КонецЕсли;

	Возврат Параметры;

КонецФункции

