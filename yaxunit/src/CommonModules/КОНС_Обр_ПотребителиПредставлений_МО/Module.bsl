#Область Исполнение

Функция ПараметрыВыполненияДляИсполнения(ИмяМенеджера, Запрос)

	Параметры = ПараметрыВыполненияДляМенеджера(ИмяМенеджера);
	Описание = ВызватьОписание(ИмяМенеджера);
	ФактическиеЗначения = Новый Соответствие;
	ТекстПараметров = "";

	Для Каждого ОписаниеПараметра Из Описание.ОписаниеПараметров Цикл
		Значение = ОписаниеПараметра.ЗначениеПоУмолчанию;
		Если Значение = Неопределено И ОписаниеПараметра.ТипКонстанты <> Неопределено Тогда
			Значение = ОписаниеПараметра.ТипКонстанты.ПривестиЗначение(Неопределено);
		КонецЕсли;
		Если ТипЗнч(Значение) = Тип("Дата") Тогда
			Значение = ТекущаяДата();
		КонецЕсли;
		Если ОписаниеПараметра.Имя = "СписокСотрудников"
			Или ОписаниеПараметра.Имя = "Сотрудники"
			Или ОписаниеПараметра.Имя = "ВидыОтпусков" Тогда
			Значение = Новый Массив;
		КонецЕсли;

		ЗначениеПараметра = Параметры.ЗначенияПараметровКонстант[ОписаниеПараметра.Имя];
		Если ОписаниеПараметра.ДопустимПараметрЗапроса Тогда
			ЗначениеПараметра.Значение = ОписаниеПараметра.Имя;
			ЗначениеПараметра.ЭтоПараметрЗапроса = Истина;
			ФактическиеЗначения.Вставить(ОписаниеПараметра.Имя, Значение);
			Если ТекстПараметров <> "" Тогда
				ТекстПараметров = ТекстПараметров + "," + Символы.ПС;
			КонецЕсли;
			ТекстПараметров = ТекстПараметров
				+ "&" + ОписаниеПараметра.Имя + " КАК " + ОписаниеПараметра.Имя;
		Иначе
			ЗначениеПараметра.Значение = Значение;
			ЗначениеПараметра.ЭтоПараметрЗапроса = Ложь;
		КонецЕсли;
	КонецЦикла;

	Если ТекстПараметров <> "" Тогда
		Запрос.Текст = "ВЫБРАТЬ " + ТекстПараметров;
		Для Каждого ПараметрЗапроса Из ФактическиеЗначения Цикл
			Запрос.УстановитьПараметр(ПараметрЗапроса.Ключ, ПараметрЗапроса.Значение);
		КонецЦикла;
	КонецЕсли;

	Возврат Параметры;

КонецФункции

Процедура СоздатьПустуюВТФильтра(ИмяМенеджера, Параметры, МенеджерВременныхТаблиц)

	Если Параметры.ОписаниеВТФильтр = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Описание = ВызватьОписание(ИмяМенеджера);
	ТаблицаФильтра = Новый ТаблицаЗначений;
	Поля = "";
	Для Каждого ПолеФильтра Из Описание.ОписаниеВТФильтр.ПоляФильтра Цикл
		Псевдоним = Параметры.ОписаниеВТФильтр.ПсевдонимыПолей.Получить(ПолеФильтра.Имя);
		ТаблицаФильтра.Колонки.Добавить(Псевдоним, ТипПоляФильтра(Описание, ПолеФильтра));
		Если Поля <> "" Тогда
			Поля = Поля + "," + Символы.ПС;
		КонецЕсли;
		Поля = Поля + "Источник." + Псевдоним + " КАК " + Псевдоним;
	КонецЦикла;

	ЗапросФильтра = Новый Запрос(
		"ВЫБРАТЬ " + Поля + Символы.ПС
		+ "ПОМЕСТИТЬ " + Параметры.ОписаниеВТФильтр.ИмяВТ + Символы.ПС
		+ "ИЗ &Источник КАК Источник");
	ЗапросФильтра.УстановитьПараметр("Источник", ТаблицаФильтра);
	ЗапросФильтра.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	ЗапросФильтра.Выполнить();

КонецПроцедуры

Функция ТипПоляФильтра(Описание, ПолеФильтра)

	Если ПолеФильтра.ТипЗначения <> Неопределено Тогда
		Возврат ПолеФильтра.ТипЗначения;
	КонецЕсли;

	Для Каждого ПолеПредставления Из Описание.Поля Цикл
		Если ВРег(ПолеПредставления.Имя) = ВРег(ПолеФильтра.Имя)
			И ПолеПредставления.ТипЗначения <> Неопределено Тогда
			Возврат ПолеПредставления.ТипЗначения;
		КонецЕсли;
	КонецЦикла;

	Если ПолеФильтра.Имя = "Сотрудник" Тогда
		Возврат Новый ОписаниеТипов("СправочникСсылка.Сотрудники");
	ИначеЕсли ПолеФильтра.Имя = "ФизическоеЛицо" Тогда
		Возврат Новый ОписаниеТипов("СправочникСсылка.ФизическиеЛица");
	ИначеЕсли ПолеФильтра.Имя = "ПозицияШтатногоРасписания" Тогда
		Возврат Новый ОписаниеТипов("СправочникСсылка.ШтатноеРасписание");
	ИначеЕсли СтрНайти(ПолеФильтра.Имя, "Дата") > 0
		Или СтрНайти(ПолеФильтра.Имя, "Период") > 0
		Или ПолеФильтра.Имя = "Месяц" Тогда
		Возврат Новый ОписаниеТипов("Дата");
	Иначе
		Возврат Новый ОписаниеТипов("Строка");
	КонецЕсли;

КонецФункции

Функция ВызватьИсполнить(ИмяМенеджера, Параметры, Запрос)

	Если ИмяМенеджера = "ПредставлениеДанныеПозицийШтатногоРасписания" Тогда
		Возврат Обработки.ПредставлениеДанныеПозицийШтатногоРасписания.Исполнить(Параметры, Запрос);
	ИначеЕсли ИмяМенеджера = "ПредставлениеДанныеСотрудников" Тогда
		Возврат Обработки.ПредставлениеДанныеСотрудников.Исполнить(Параметры, Запрос);
	ИначеЕсли ИмяМенеджера = "ПредставлениеДанныеУчетаВремениСотрудников" Тогда
		Возврат Обработки.ПредставлениеДанныеУчетаВремениСотрудников.Исполнить(Параметры, Запрос);
	ИначеЕсли ИмяМенеджера = "ПредставлениеДанныеФизическихЛиц" Тогда
		Возврат Обработки.ПредставлениеДанныеФизическихЛиц.Исполнить(Параметры, Запрос);
	ИначеЕсли ИмяМенеджера = "ПредставлениеНачисленияУдержанияВыплаты" Тогда
		Возврат Обработки.ПредставлениеНачисленияУдержанияВыплаты.Исполнить(Параметры, Запрос);
	ИначеЕсли ИмяМенеджера = "ПредставлениеНачисленияУдержанияВыплатыАвансом" Тогда
		Возврат Обработки.ПредставлениеНачисленияУдержанияВыплатыАвансом.Исполнить(Параметры, Запрос);
	ИначеЕсли ИмяМенеджера = "ПредставлениеОстаткиОтпусков" Тогда
		Возврат Обработки.ПредставлениеОстаткиОтпусков.Исполнить(Параметры, Запрос);
	ИначеЕсли ИмяМенеджера = "ПредставлениеПериоды" Тогда
		Возврат Обработки.ПредставлениеПериоды.Исполнить(Параметры, Запрос);
	ИначеЕсли ИмяМенеджера = "ПредставлениеПлановоеВремяСотрудников" Тогда
		Возврат Обработки.ПредставлениеПлановоеВремяСотрудников.Исполнить(Параметры, Запрос);
	ИначеЕсли ИмяМенеджера = "ПредставлениеРабочиеМестаСотрудников" Тогда
		Возврат Обработки.ПредставлениеРабочиеМестаСотрудников.Исполнить(Параметры, Запрос);
	ИначеЕсли ИмяМенеджера = "ПредставлениеРегистрСведенийЗаписи" Тогда
		Возврат Обработки.ПредставлениеРегистрСведенийЗаписи.Исполнить(Параметры, Запрос);
	ИначеЕсли ИмяМенеджера = "ПредставлениеРегистрСведенийСрезПоследних" Тогда
		Возврат Обработки.ПредставлениеРегистрСведенийСрезПоследних.Исполнить(Параметры, Запрос);
	ИначеЕсли ИмяМенеджера = "ПредставлениеСотрудникиОрганизации" Тогда
		Возврат Обработки.ПредставлениеСотрудникиОрганизации.Исполнить(Параметры, Запрос);
	ИначеЕсли ИмяМенеджера = "ПредставлениеСтажиФизическихЛиц" Тогда
		Возврат Обработки.ПредставлениеСтажиФизическихЛиц.Исполнить(Параметры, Запрос);
	ИначеЕсли ИмяМенеджера = "ПредставлениеФактическиеОтпускаСотрудников" Тогда
		Возврат Обработки.ПредставлениеФактическиеОтпускаСотрудников.Исполнить(Параметры, Запрос);
	Иначе
		ВызватьИсключение "Неизвестный manager adapter: " + ИмяМенеджера;
	КонецЕсли;

КонецФункции

