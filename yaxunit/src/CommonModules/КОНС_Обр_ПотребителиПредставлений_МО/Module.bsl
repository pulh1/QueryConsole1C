Функция ВызватьОписание(ИмяМенеджера)

	Если ИмяМенеджера = "ПредставлениеДанныеПозицийШтатногоРасписания" Тогда
		Возврат Обработки.ПредставлениеДанныеПозицийШтатногоРасписания.Описание();
	ИначеЕсли ИмяМенеджера = "ПредставлениеДанныеСотрудников" Тогда
		Возврат Обработки.ПредставлениеДанныеСотрудников.Описание();
	ИначеЕсли ИмяМенеджера = "ПредставлениеДанныеУчетаВремениСотрудников" Тогда
		Возврат Обработки.ПредставлениеДанныеУчетаВремениСотрудников.Описание();
	ИначеЕсли ИмяМенеджера = "ПредставлениеДанныеФизическихЛиц" Тогда
		Возврат Обработки.ПредставлениеДанныеФизическихЛиц.Описание();
	ИначеЕсли ИмяМенеджера = "ПредставлениеНачисленияУдержанияВыплаты" Тогда
		Возврат Обработки.ПредставлениеНачисленияУдержанияВыплаты.Описание();
	ИначеЕсли ИмяМенеджера = "ПредставлениеНачисленияУдержанияВыплатыАвансом" Тогда
		Возврат Обработки.ПредставлениеНачисленияУдержанияВыплатыАвансом.Описание();
	ИначеЕсли ИмяМенеджера = "ПредставлениеОстаткиОтпусков" Тогда
		Возврат Обработки.ПредставлениеОстаткиОтпусков.Описание();
	ИначеЕсли ИмяМенеджера = "ПредставлениеПериоды" Тогда
		Возврат Обработки.ПредставлениеПериоды.Описание();
	ИначеЕсли ИмяМенеджера = "ПредставлениеПлановоеВремяСотрудников" Тогда
		Возврат Обработки.ПредставлениеПлановоеВремяСотрудников.Описание();
	ИначеЕсли ИмяМенеджера = "ПредставлениеРабочиеМестаСотрудников" Тогда
		Возврат Обработки.ПредставлениеРабочиеМестаСотрудников.Описание();
	ИначеЕсли ИмяМенеджера = "ПредставлениеРегистрСведенийЗаписи" Тогда
		Возврат Обработки.ПредставлениеРегистрСведенийЗаписи.Описание("ГрафикРаботыСотрудников");
	ИначеЕсли ИмяМенеджера = "ПредставлениеРегистрСведенийСрезПоследних" Тогда
		Возврат Обработки.ПредставлениеРегистрСведенийСрезПоследних.Описание("ГрафикРаботыСотрудников");
	ИначеЕсли ИмяМенеджера = "ПредставлениеСотрудникиОрганизации" Тогда
		Возврат Обработки.ПредставлениеСотрудникиОрганизации.Описание();
	ИначеЕсли ИмяМенеджера = "ПредставлениеСтажиФизическихЛиц" Тогда
		Возврат Обработки.ПредставлениеСтажиФизическихЛиц.Описание();
	ИначеЕсли ИмяМенеджера = "ПредставлениеФактическиеОтпускаСотрудников" Тогда
		Возврат Обработки.ПредставлениеФактическиеОтпускаСотрудников.Описание();
	Иначе
		ВызватьИсключение "Неизвестный manager adapter: " + ИмяМенеджера;
	КонецЕсли;

