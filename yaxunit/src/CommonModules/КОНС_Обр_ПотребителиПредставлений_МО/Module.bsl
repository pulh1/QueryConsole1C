// Проверяет предметное описание и отдельную capability центрального СКД.
Процедура МенеджерПубликуетОписание(ИмяМенеджера) Экспорт

	Описание = ВызватьОписание(ИмяМенеджера);
	ЮТест.ОжидаетЧто(Описание).НеРавно(Неопределено);
	ЮТест.ОжидаетЧто(Описание.Поля.Количество()).Больше(0);

	ОжидаетсяЦентральныйСКД = ИмяМенеджера <> "ПредставлениеОстаткиОтпусков";
	ЮТест.ОжидаетЧто(Описание.ДоступноВМеханизмеПредставленийСКД)
		.Равно(ОжидаетсяЦентральныйСКД);

КонецПроцедуры

// Проверяет стабильную help identity и непустое предметное описание.
Процедура МенеджерПубликуетСправку(ИмяМенеджера) Экспорт

	Справка = ВызватьСправку(ИмяМенеджера);
	ЮТест.ОжидаетЧто(Справка).НеРавно(Неопределено);
	ЮТест.ОжидаетЧто(Справка.Имя).Равно(ОжидаемоеИмяСправки(ИмяМенеджера));
	ЮТест.ОжидаетЧто(Справка.Описание).НеРавно("");

КонецПроцедуры

// Проверяет литеральное имя представления для dynamic provider dispatch.
Процедура МенеджерПубликуетИмяПредставления(ИмяМенеджера) Экспорт

	ЮТест.ОжидаетЧто(ВызватьИмяПредставления(ИмяМенеджера))
		.Равно(ОжидаемоеИмяПредставления(ИмяМенеджера));

КонецПроцедуры

// Проверяет предметный generator call и характерный fragment generated BSL.
Процедура МенеджерФормируетИсполняемыйКод(ИмяМенеджера) Экспорт

	Параметры = ПараметрыВыполненияДляМенеджера(ИмяМенеджера);
	Код = ВызватьИсполняемыйКод(ИмяМенеджера, Параметры);

	ЮТест.ОжидаетЧто(Код).НеРавно("");
	ЮТест.ОжидаетЧто(Код)
		.Содержит(ОжидаемыйМаркерИсполняемогоКода(ИмяМенеджера));
	Если ИмяМенеджера <> "ПредставлениеПлановоеВремяСотрудников" Тогда
		ЮТест.ОжидаетЧто(Код).Содержит("ВТКонтрактПредставления");
	КонецЕсли;

КонецПроцедуры

// Проверяет прямой SKD-export, литеральное поле и query-language shape.
Процедура МенеджерФормируетТекстЗапросаДляСКД(ИмяМенеджера) Экспорт

	Если ИмяМенеджера = "ПредставлениеРабочиеМестаСотрудников" Тогда
		ЮТест.Пропустить(
			"Production defect: Обработки.ПредставлениеРабочиеМестаСотрудников.ТекстЗапросаДляСКД(ПараметрыВыполнения) читает .ОписаниеФильтра вместо поля live factory .ОписаниеВТФильтр; требуется production fix ManagerModule.bsl:275");
	КонецЕсли;

	Параметры = ПараметрыВыполненияДляМенеджера(ИмяМенеджера);
	ТекстЗапроса = ВызватьТекстЗапросаДляСКД(ИмяМенеджера, Параметры);

	ЮТест.ОжидаетЧто(ТекстЗапроса).НеРавно("");
	ЮТест.ОжидаетЧто(ТекстЗапроса).Содержит("ВЫБРАТЬ");
	ЮТест.ОжидаетЧто(ТекстЗапроса)
		.Содержит(ОжидаемоеИспользуемоеПоле(ИмяМенеджера));
	ЮТест.ОжидаетЧто(ТекстЗапроса).Содержит("ВТКонтрактПредставления");
	ЮТест.ОжидаетЧто(ТекстЗапроса).НеСодержит("ИсполняемоеПредставление.");

	Если Параметры.ОписаниеВТФильтр <> Неопределено Тогда
		ЮТест.ОжидаетЧто(ТекстЗапроса).Содержит("ВТФильтрКонтракт");
	КонецЕсли;

	МодельЗапроса = Обработки.Парсер.Создать().Разобрать(ТекстЗапроса);
	ЮТест.ОжидаетЧто(МодельЗапроса).НеРавно(Неопределено);

КонецПроцедуры

// Исполняет manager export в headless-контуре и проверяет созданную временную таблицу.
Процедура МенеджерИсполняетПредставительнуюМодель(ИмяМенеджера) Экспорт

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Параметры = ПараметрыВыполненияДляИсполнения(ИмяМенеджера, Запрос);
	СоздатьПустуюВТФильтра(ИмяМенеджера, Параметры, Запрос.МенеджерВременныхТаблиц);

	РезультатВызова = ВызватьИсполнить(ИмяМенеджера, Параметры, Запрос);
	ЮТест.ОжидаетЧто(РезультатВызова).Равно(Неопределено);

	ИмяВТДляПроверки = Параметры.ИмяВТРезультат;
	Если ИмяМенеджера = "ПредставлениеПлановоеВремяСотрудников" Тогда
		ИмяВТДляПроверки = "ВТПлановоеВремя";
	КонецЕсли;
	ПроверочныйЗапрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1 * ИЗ " + ИмяВТДляПроверки);
	ПроверочныйЗапрос.МенеджерВременныхТаблиц = Запрос.МенеджерВременныхТаблиц;
	ТаблицаРезультата = ПроверочныйЗапрос.Выполнить().Выгрузить();

	ЮТест.ОжидаетЧто(
		ТаблицаРезультата.Колонки.Найти(ОжидаемоеИспользуемоеПоле(ИмяМенеджера)))
		.НеРавно(Неопределено);

КонецПроцедуры

