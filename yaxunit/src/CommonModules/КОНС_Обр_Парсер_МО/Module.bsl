#Область ТестовыйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	Кавычка = Символ(34);

	ЮТТесты
		.ДобавитьТестовыйНабор("Парсер")
			.Тег("Парсер")
			.ДобавитьСерверныйТест("РазборКонстантногоВыражения")
			.ДобавитьСерверныйТест("КонстантаРазбирается")
				.СПараметрамиНаСервере("1", 1)
				.СПараметрамиНаСервере("12.5", 12.5)
				.СПараметрамиНаСервере(Кавычка + "текст" + Кавычка, "текст")
				.СПараметрамиНаСервере("ИСТИНА", Истина)
				.СПараметрамиНаСервере("ЛОЖЬ", Ложь)
				.СПараметрамиНаСервере("NULL", Null)
				.СПараметрамиНаСервере("НЕОПРЕДЕЛЕНО", Неопределено)
			.ДобавитьСерверныйТест("ПараметрЗапросаРазбирается")
			.ДобавитьСерверныйТест("РазыменованиеРазбирается")
				.СПараметрамиНаСервере("Поле", 1, "Поле", Неопределено)
				.СПараметрамиНаСервере("Таблица.Поле", 2, "Таблица", "Поле")
			.ДобавитьСерверныйТест("БинарнаяАрифметическаяОперацияРазбирается")
				.СПараметрамиНаСервере("1 + 2", "+")
				.СПараметрамиНаСервере("3 - 2", "-")
				.СПараметрамиНаСервере("2 * 3", "*")
				.СПараметрамиНаСервере("6 / 2", "/")
				.СПараметрамиНаСервере("5 % 2", "%")
			.ДобавитьСерверныйТест("УнарнаяОперацияРазбирается")
				.СПараметрамиНаСервере("-1", "-")
				.СПараметрамиНаСервере("+1", "+")
			.ДобавитьСерверныйТест("УмножениеИмеетПриоритетНадСложением")
			.ДобавитьСерверныйТест("СкобкиЗадаютГруппировку")
			.ДобавитьСерверныйТест("ОперацияСравненияРазбирается")
				.СПараметрамиНаСервере("1 = 2", "=")
				.СПараметрамиНаСервере("1 <> 2", "<>")
				.СПараметрамиНаСервере("1 > 2", ">")
				.СПараметрамиНаСервере("1 < 2", "<")
				.СПараметрамиНаСервере("1 >= 2", ">=")
				.СПараметрамиНаСервере("1 <= 2", "<=")
