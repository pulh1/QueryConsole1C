Процедура ОдноаргументнаяФункцияРазбирается(ИсходныйТекст, ОжидаемыйТип) Экспорт

	Узел = РазобратьВыражениеДляТеста(ИсходныйТекст);
	ПроверитьТипУзла(Узел, ОжидаемыйТип, "Ожидается специализированный узел одноаргументной функции");

	Если ОжидаемыйТип = "ФункцияЧастьПериодаЧислом" Тогда
		ИмяФункции = Лев(ИсходныйТекст, СтрНайти(ИсходныйТекст, "(") - 1);
		ЮТест.ОжидаетЧто(ВРег(Узел.ИмяФункции))
			.Равно(ИмяФункции, "Функция части периода должна сохранять имя ключевого слова");
		ПроверитьТипУзла(Узел.Аргумент, "ПараметрЗапроса",
			"Аргументом функции части периода должен быть параметр запроса");
		ЮТест.ОжидаетЧто(Узел.Аргумент.Имя)
			.Равно("Дата", "Функция части периода должна сохранять аргумент");
	Иначе
		ПроверитьТипУзла(Узел.Аргумент, "Разыменование",
			"Аргументом функции представления должно быть поле");
		ЮТест.ОжидаетЧто(Узел.Аргумент.Элементы.Количество())
			.Равно(1, "Аргумент функции представления должен содержать одно поле");
		ЮТест.ОжидаетЧто(Узел.Аргумент.Элементы[0])
			.Равно("Поле", "Функция представления должна сохранять аргумент");
	КонецЕсли;

КонецПроцедуры

Процедура СпециализированнаяФункцияРазбирается(ИсходныйТекст, ОжидаемыйТип) Экспорт

	Узел = РазобратьВыражениеДляТеста(ИсходныйТекст);
	ПроверитьТипУзла(Узел, ОжидаемыйТип, "Ожидается специализированный узел встроенной функции");

	Если ОжидаемыйТип = "ФункцияПодстрока" Тогда
		ПроверитьКонстанту(Узел.Строка, "abc");
		ПроверитьКонстанту(Узел.НачальнаяПозиция, 1);
		ПроверитьКонстанту(Узел.КоличествоСимволов, 2);
	ИначеЕсли ОжидаемыйТип = "ФункцияНачалоПериода"
		Или ОжидаемыйТип = "ФункцияКонецПериода" Тогда
		ПроверитьТипУзла(Узел.Дата, "ПараметрЗапроса", "Дата должна быть параметром запроса");
		ЮТест.ОжидаетЧто(Узел.Дата.Имя).Равно("Дата", "Функция должна сохранять дату");
		ЮТест.ОжидаетЧто(Узел.ТипПериода).Равно("МЕСЯЦ", "Функция должна сохранять тип периода");
	ИначеЕсли ОжидаемыйТип = "ФункцияДобавитьКДате" Тогда
		ПроверитьТипУзла(Узел.Дата, "ПараметрЗапроса", "Дата должна быть параметром запроса");
		ЮТест.ОжидаетЧто(Узел.Дата.Имя).Равно("Дата", "ДОБАВИТЬКДАТЕ должна сохранять дату");
		ЮТест.ОжидаетЧто(Узел.ТипПериода).Равно("ДЕНЬ", "ДОБАВИТЬКДАТЕ должна сохранять тип периода");
		ПроверитьКонстанту(Узел.Сдвиг, 1);
	ИначеЕсли ОжидаемыйТип = "ФункцияРазностьДат" Тогда
		ПроверитьТипУзла(Узел.Дата1, "ПараметрЗапроса", "Первая дата должна быть параметром запроса");
		ПроверитьТипУзла(Узел.Дата2, "ПараметрЗапроса", "Вторая дата должна быть параметром запроса");
		ЮТест.ОжидаетЧто(Узел.Дата1.Имя).Равно("Начало", "РАЗНОСТЬДАТ должна сохранять первую дату");
		ЮТест.ОжидаетЧто(Узел.Дата2.Имя).Равно("Конец", "РАЗНОСТЬДАТ должна сохранять вторую дату");
		ЮТест.ОжидаетЧто(Узел.ТипПериода).Равно("ДЕНЬ", "РАЗНОСТЬДАТ должна сохранять тип периода");
	ИначеЕсли ОжидаемыйТип = "ФункцияIsNull" Тогда
		ПроверитьТипУзла(Узел.ПроверяемоеЗначение, "ПараметрЗапроса",
			"Первый аргумент ЕСТЬNULL должен быть параметром запроса");
		ЮТест.ОжидаетЧто(Узел.ПроверяемоеЗначение.Имя)
			.Равно("Значение", "ЕСТЬNULL должна сохранять проверяемое значение");
		ПроверитьКонстанту(Узел.Действие, 0);
	ИначеЕсли ОжидаемыйТип = "ФункцияДатаВремя" Тогда
		ЮТест.ОжидаетЧто(Узел.Аргументы.Количество())
			.Равно(3, "ДАТАВРЕМЯ должна сохранять три аргумента");
		ЮТест.ОжидаетЧто(Узел.Аргументы[0]).Равно(2024, "ДАТАВРЕМЯ должна сохранять год");
		ЮТест.ОжидаетЧто(Узел.Аргументы[1]).Равно(1, "ДАТАВРЕМЯ должна сохранять месяц");
		ЮТест.ОжидаетЧто(Узел.Аргументы[2]).Равно(2, "ДАТАВРЕМЯ должна сохранять день");
	ИначеЕсли ОжидаемыйТип = "ФункцияЗначение" Тогда
		ЮТест.ОжидаетЧто(Узел.ЧастиПути.Количество())
			.Равно(3, "ЗНАЧЕНИЕ должна сохранять три части пути");
		ЮТест.ОжидаетЧто(Узел.ЧастиПути[0]).Равно("Справочник", "ЗНАЧЕНИЕ должна сохранять группу");
		ЮТест.ОжидаетЧто(Узел.ЧастиПути[1]).Равно("Номенклатура", "ЗНАЧЕНИЕ должна сохранять таблицу");
		ЮТест.ОжидаетЧто(Узел.ЧастиПути[2]).Равно("ПустаяСсылка", "ЗНАЧЕНИЕ должна сохранять значение");
	ИначеЕсли ОжидаемыйТип = "ФункцияТип" Тогда
		ПроверитьТипУзла(Узел.Аргумент, "ТипСсылочногоПоля",
			"ТИП должна сохранять описание ссылочного типа");
		ЮТест.ОжидаетЧто(Узел.Аргумент.Группа).Равно("Справочник", "ТИП должна сохранять группу");
		ЮТест.ОжидаетЧто(Узел.Аргумент.Таблица).Равно("Номенклатура", "ТИП должна сохранять таблицу");
	КонецЕсли;

КонецПроцедуры

Процедура ПриведениеТипаРазбирается(ИсходныйТекст, ОжидаемыйТипОписания, ОжидаемаяДлина, ОжидаемаяТочность) Экспорт

	Узел = РазобратьВыражениеДляТеста(ИсходныйТекст);
	ПроверитьТипУзла(Узел, "Разыменование", "Приведение типа должно быть обёрнуто в разыменование");
	ЮТест.ОжидаетЧто(Узел.Элементы.Количество())
		.Равно(1, "Разыменование должно содержать только узел приведения типа");

	Приведение = Узел.Элементы[0];
	ПроверитьТипУзла(Приведение, "ПриведениеТипа", "Ожидается вложенный узел приведения типа");
	ПроверитьКонстанту(Приведение.Выражение, 1);
	ПроверитьТипУзла(Приведение.ОписаниеТипа, ОжидаемыйТипОписания,
		"Приведение типа должно сохранять описание целевого типа");

	Если ОжидаемыйТипОписания = "ОписаниеТипаЧисло" Тогда
		ЮТест.ОжидаетЧто(Приведение.ОписаниеТипа.Длина)
			.Равно(ОжидаемаяДлина, "Описание числа должно сохранять длину");
		ЮТест.ОжидаетЧто(Приведение.ОписаниеТипа.Точность)
			.Равно(ОжидаемаяТочность, "Описание числа должно сохранять точность");
	ИначеЕсли ОжидаемыйТипОписания = "ОписаниеТипаСтрока" Тогда
		ЮТест.ОжидаетЧто(Приведение.ОписаниеТипа.Длина)
			.Равно(ОжидаемаяДлина, "Описание строки должно сохранять длину");
	КонецЕсли;

КонецПроцедуры

Процедура ВыборРазбирается(ИсходныйТекст, ОжидаемоеКоличествоАльтернатив) Экспорт

	Узел = РазобратьВыражениеДляТеста(ИсходныйТекст);
	ПроверитьТипУзла(Узел, "Выбор", "Ожидается узел оператора ВЫБОР");
	ЮТест.ОжидаетЧто(Узел.АльтернативыВыбора.Количество())
		.Равно(ОжидаемоеКоличествоАльтернатив, "ВЫБОР должен сохранять количество альтернатив");
	ПроверитьТипУзла(Узел.АльтернативыВыбора[0].Условие, "БинарнаяОперация",
		"Условие первой альтернативы должно быть сравнением");
