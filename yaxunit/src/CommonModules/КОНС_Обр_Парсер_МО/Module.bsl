КонецПроцедуры

Процедура КоличествоРазбирается(ИсходныйТекст, ОжидаемыеРазличные) Экспорт

	Узел = РазобратьВыражениеДляТеста(ИсходныйТекст);
	ПроверитьТипУзла(Узел, "АгрегатнаяФункцияКоличество", "Ожидается узел функции КОЛИЧЕСТВО");
	ЮТест.ОжидаетЧто(Узел.Различные)
		.Равно(ОжидаемыеРазличные, "КОЛИЧЕСТВО должно сохранять признак РАЗЛИЧНЫЕ");

	Если ИсходныйТекст = "КОЛИЧЕСТВО(*)" Тогда
		ЮТест.ОжидаетЧто(Узел.Аргумент)
			.Равно("*", "КОЛИЧЕСТВО(*) должно сохранять звёздочку как аргумент");
	Иначе
		ПроверитьТипУзла(Узел.Аргумент, "Разыменование", "Аргументом КОЛИЧЕСТВО должно быть поле");
		ЮТест.ОжидаетЧто(Узел.Аргумент.Элементы[0])
			.Равно("Поле", "КОЛИЧЕСТВО должно сохранять аргумент");
	КонецЕсли;

КонецПроцедуры

