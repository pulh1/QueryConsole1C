			.Равно("Номенклатура", "Ссылочное описание должно сохранять имя типа");
	ИначеЕсли ОжидаемыйТипОписания = "ОписаниеТипаЧисло" Тогда
		ЮТест.ОжидаетЧто(Приведение.ОписаниеТипа.Длина)
			.Равно(ОжидаемаяДлина, "Описание числа должно сохранять длину");
		ЮТест.ОжидаетЧто(Приведение.ОписаниеТипа.Точность)
			.Равно(ОжидаемаяТочность, "Описание числа должно сохранять точность");
	ИначеЕсли ОжидаемыйТипОписания = "ОписаниеТипаСтрока" Тогда
		ЮТест.ОжидаетЧто(Приведение.ОписаниеТипа.Длина)
			.Равно(ОжидаемаяДлина, "Описание строки должно сохранять длину");
	КонецЕсли;

