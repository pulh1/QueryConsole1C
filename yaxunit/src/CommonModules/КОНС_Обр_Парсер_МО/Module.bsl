Процедура КонстантаРазбирается(ИсходныйТекст, ОжидаемоеЗначение) Экспорт

	Узел = РазобратьВыражениеДляТеста(ИсходныйТекст);
	ПроверитьКонстанту(Узел, ОжидаемоеЗначение);

КонецПроцедуры

Процедура ПараметрЗапросаРазбирается() Экспорт

	Узел = РазобратьВыражениеДляТеста("&Параметр");
	ПроверитьТипУзла(Узел, "ПараметрЗапроса", "Ожидается узел параметра запроса");
	ЮТест.ОжидаетЧто(Узел.Имя)
		.Равно("Параметр", "Параметр запроса должен сохранять имя");

КонецПроцедуры

Процедура РазыменованиеРазбирается(ИсходныйТекст, КоличествоЭлементов, ПервыйЭлемент, ВторойЭлемент) Экспорт

	Узел = РазобратьВыражениеДляТеста(ИсходныйТекст);
	ПроверитьТипУзла(Узел, "Разыменование", "Ожидается узел разыменования");
	ЮТест.ОжидаетЧто(Узел.Элементы.Количество())
		.Равно(КоличествоЭлементов, "Разыменование должно сохранять количество элементов");
	ЮТест.ОжидаетЧто(Узел.Элементы[0])
		.Равно(ПервыйЭлемент, "Разыменование должно сохранять первый элемент");

	Если ВторойЭлемент <> Неопределено Тогда
		ЮТест.ОжидаетЧто(Узел.Элементы[1])
			.Равно(ВторойЭлемент, "Разыменование должно сохранять второй элемент");
	КонецЕсли;

КонецПроцедуры

Процедура БинарнаяАрифметическаяОперацияРазбирается(ИсходныйТекст, ОжидаемаяОперация) Экспорт

	Узел = РазобратьВыражениеДляТеста(ИсходныйТекст);
	ПроверитьТипУзла(Узел, "БинарнаяОперация", "Ожидается узел бинарной операции");
	ЮТест.ОжидаетЧто(Узел.Операция)
		.Равно(ОжидаемаяОперация, "Бинарная операция должна сохранять оператор");
	ПроверитьТипУзла(Узел.ЛеваяЧасть, "Константа", "Левая часть должна быть константой");
	ПроверитьТипУзла(Узел.ПраваяЧасть, "Константа", "Правая часть должна быть константой");

КонецПроцедуры

Процедура УнарнаяОперацияРазбирается(ИсходныйТекст, ОжидаемыйЗнак) Экспорт

	Узел = РазобратьВыражениеДляТеста(ИсходныйТекст);
	ПроверитьТипУзла(Узел, "УнарнаяОперация", "Ожидается узел унарной операции");
	ЮТест.ОжидаетЧто(Узел.Знаки.Количество())
		.Равно(1, "Унарная операция должна сохранять один знак");
	ЮТест.ОжидаетЧто(Узел.Знаки[0])
		.Равно(ОжидаемыйЗнак, "Унарная операция должна сохранять знак");
	ПроверитьКонстанту(Узел.Выражение, 1);

КонецПроцедуры

Процедура УмножениеИмеетПриоритетНадСложением() Экспорт

	Узел = РазобратьВыражениеДляТеста("1 + 2 * 3");
	ПроверитьТипУзла(Узел, "БинарнаяОперация", "Корнем должна быть операция сложения");
	ЮТест.ОжидаетЧто(Узел.Операция)
		.Равно("+", "Сложение должно быть корневой операцией");
	ПроверитьКонстанту(Узел.ЛеваяЧасть, 1);
	ПроверитьТипУзла(Узел.ПраваяЧасть, "БинарнаяОперация", "Правая часть должна быть умножением");
	ЮТест.ОжидаетЧто(Узел.ПраваяЧасть.Операция)
		.Равно("*", "Умножение должно иметь приоритет над сложением");

КонецПроцедуры

Процедура СкобкиЗадаютГруппировку() Экспорт

	Узел = РазобратьВыражениеДляТеста("(1 + 2) * 3");
	ПроверитьТипУзла(Узел, "БинарнаяОперация", "Корнем должна быть операция умножения");
	ЮТест.ОжидаетЧто(Узел.Операция)
		.Равно("*", "Умножение должно быть корневой операцией");
	ПроверитьТипУзла(Узел.ЛеваяЧасть, "СписокВыражений", "Скобки должны формировать список выражений");
	ЮТест.ОжидаетЧто(Узел.ЛеваяЧасть.Элементы.Количество())
		.Равно(1, "Список выражений в скобках должен содержать один элемент");
	ПроверитьТипУзла(Узел.ЛеваяЧасть.Элементы[0], "БинарнаяОперация", "В скобках должна быть бинарная операция");
	ЮТест.ОжидаетЧто(Узел.ЛеваяЧасть.Элементы[0].Операция)
		.Равно("+", "В скобках должна быть операция сложения");
	ПроверитьКонстанту(Узел.ПраваяЧасть, 3);

КонецПроцедуры

#Область ВспомогательныеПроцедуры

Функция РазобратьВыражениеДляТеста(ИсходныйТекст)

	Парсер = КОНС_ТестовыеФабрикиСлужебный.СоздатьПарсер();
	Возврат Парсер.РазобратьВыражение(ИсходныйТекст);

КонецФункции

Процедура ПроверитьТипУзла(Узел, ОжидаемыйТип, Описание)

	ЮТест.ОжидаетЧто(Узел.Тип).Равно(ОжидаемыйТип, Описание);

КонецПроцедуры

Процедура ПроверитьКонстанту(Узел, ОжидаемоеЗначение)

	ПроверитьТипУзла(Узел, "Константа", "Ожидается узел константы");
	ЮТест.ОжидаетЧто(Узел.Значение)
		.Равно(ОжидаемоеЗначение, "Константа должна сохранять значение");

КонецПроцедуры

#КонецОбласти

#КонецОбласти
