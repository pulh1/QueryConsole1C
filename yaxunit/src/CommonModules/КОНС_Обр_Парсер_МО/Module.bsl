#Область ТестовыйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	Кавычка = Символ(34);

	ЮТТесты
		.ДобавитьТестовыйНабор("Парсер")
			.Тег("Парсер")
			.ДобавитьСерверныйТест("РазборКонстантногоВыражения")
			.ДобавитьСерверныйТест("КонстантаРазбирается")
				.СПараметрамиНаСервере("1", 1)
				.СПараметрамиНаСервере("12.5", 12.5)
				.СПараметрамиНаСервере(Кавычка + "текст" + Кавычка, "текст")
				.СПараметрамиНаСервере("ИСТИНА", Истина)
				.СПараметрамиНаСервере("ЛОЖЬ", Ложь)
				.СПараметрамиНаСервере("NULL", Null)
				.СПараметрамиНаСервере("НЕОПРЕДЕЛЕНО", Неопределено)
			.ДобавитьСерверныйТест("ПараметрЗапросаРазбирается")
			.ДобавитьСерверныйТест("РазыменованиеРазбирается")
				.СПараметрамиНаСервере("Поле", 1, "Поле", Неопределено)
				.СПараметрамиНаСервере("Таблица.Поле", 2, "Таблица", "Поле")
			.ДобавитьСерверныйТест("БинарнаяАрифметическаяОперацияРазбирается")
				.СПараметрамиНаСервере("1 + 2", "+")
				.СПараметрамиНаСервере("3 - 2", "-")
				.СПараметрамиНаСервере("2 * 3", "*")
				.СПараметрамиНаСервере("6 / 2", "/")
				.СПараметрамиНаСервере("5 % 2", "%")
			.ДобавитьСерверныйТест("УнарнаяОперацияРазбирается")
				.СПараметрамиНаСервере("-1", "-")
				.СПараметрамиНаСервере("+1", "+")
			.ДобавитьСерверныйТест("УмножениеИмеетПриоритетНадСложением")
			.ДобавитьСерверныйТест("СкобкиЗадаютГруппировку")
			.ДобавитьСерверныйТест("ОперацияСравненияРазбирается")
				.СПараметрамиНаСервере("1 = 2", "=")
				.СПараметрамиНаСервере("1 <> 2", "<>")
				.СПараметрамиНаСервере("1 > 2", ">")
				.СПараметрамиНаСервере("1 < 2", "<")
				.СПараметрамиНаСервере("1 >= 2", ">=")
				.СПараметрамиНаСервере("1 <= 2", "<=")
			.ДобавитьСерверныйТест("ЛогическийОператорРазбирается")
				.СПараметрамиНаСервере("1 = 1 И 2 = 2", "И")
				.СПараметрамиНаСервере("1 = 1 ИЛИ 2 = 2", "ИЛИ")
			.ДобавитьСерверныйТест("ЛогическоеИмеетПриоритетНадИли")
			.ДобавитьСерверныйТест("ЛогическоеОтрицаниеРазбирается")
			.ДобавитьСерверныйТест("МеждуРазбирается")
				.СПараметрамиНаСервере("1 МЕЖДУ 0 И 2", Ложь)
				.СПараметрамиНаСервере("1 НЕ МЕЖДУ 0 И 2", Истина)
			.ДобавитьСерверныйТест("ПроверкаNullРазбирается")
				.СПараметрамиНаСервере("Поле ЕСТЬ NULL", Ложь)
				.СПараметрамиНаСервере("Поле ЕСТЬ НЕ NULL", Истина)
			.ДобавитьСерверныйТест("ОператорВРазбирается")
				.СПараметрамиНаСервере("1 В (1, 2)", Ложь, Ложь)
				.СПараметрамиНаСервере("1 НЕ В (1, 2)", Истина, Ложь)
				.СПараметрамиНаСервере("1 В ИЕРАРХИИ (1, 2)", Ложь, Истина)
			.ДобавитьСерверныйТест("ПодобноРазбирается")
				.СПараметрамиНаСервере(Кавычка + "abc" + Кавычка + " ПОДОБНО " + Кавычка + "a%" + Кавычка, Ложь)
				.СПараметрамиНаСервере(Кавычка + "abc" + Кавычка + " НЕ ПОДОБНО " + Кавычка + "a%" + Кавычка, Истина)
			.ДобавитьСерверныйТест("ПроверкаСсылочногоТипаРазбирается")
			.ДобавитьСерверныйТест("ПриведениеТипаРазбирается")
				.СПараметрамиНаСервере("ВЫРАЗИТЬ(1 КАК БУЛЕВО)", "ОписаниеТипаБулево", 0, 0)
				.СПараметрамиНаСервере("ВЫРАЗИТЬ(1 КАК ДАТА)", "ОписаниеТипаДата", 0, 0)
				.СПараметрамиНаСервере("ВЫРАЗИТЬ(1 КАК ЧИСЛО(10, 2))", "ОписаниеТипаЧисло", 10, 2)
				.СПараметрамиНаСервере("ВЫРАЗИТЬ(1 КАК СТРОКА(20))", "ОписаниеТипаСтрока", 20, 0)
			.ДобавитьСерверныйТест("ВыборРазбирается")
				.СПараметрамиНаСервере("ВЫБОР КОГДА 1 = 1 ТОГДА 10 ИНАЧЕ 0 КОНЕЦ", 1)
				.СПараметрамиНаСервере("ВЫБОР КОГДА 1 = 1 ТОГДА 10 КОГДА 2 = 2 ТОГДА 20 ИНАЧЕ 0 КОНЕЦ", 2)
			.ДобавитьСерверныйТест("АгрегатнаяФункцияРазбирается")
				.СПараметрамиНаСервере("СУММА(Поле)", "СУММА")
				.СПараметрамиНаСервере("МАКСИМУМ(Поле)", "МАКСИМУМ")
				.СПараметрамиНаСервере("МИНИМУМ(Поле)", "МИНИМУМ")
				.СПараметрамиНаСервере("СРЕДНЕЕ(Поле)", "СРЕДНЕЕ")
			.ДобавитьСерверныйТест("КоличествоРазбирается")
				.СПараметрамиНаСервере("КОЛИЧЕСТВО(*)", Ложь)
				.СПараметрамиНаСервере("КОЛИЧЕСТВО(Поле)", Ложь)
				.СПараметрамиНаСервере("КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Поле)", Истина);

КонецПроцедуры

Процедура ПриведениеТипаРазбирается(ИсходныйТекст, ОжидаемыйТипОписания, ОжидаемаяДлина, ОжидаемаяТочность) Экспорт

	Узел = РазобратьВыражениеДляТеста(ИсходныйТекст);
	ПроверитьТипУзла(Узел, "Разыменование", "Приведение типа должно быть обёрнуто в разыменование");
	ЮТест.ОжидаетЧто(Узел.Элементы.Количество())
		.Равно(1, "Разыменование должно содержать только узел приведения типа");

	Приведение = Узел.Элементы[0];
	ПроверитьТипУзла(Приведение, "ПриведениеТипа", "Ожидается вложенный узел приведения типа");
	ПроверитьКонстанту(Приведение.Выражение, 1);
	ПроверитьТипУзла(Приведение.ОписаниеТипа, ОжидаемыйТипОписания,
		"Приведение типа должно сохранять описание целевого типа");

	Если ОжидаемыйТипОписания = "ОписаниеТипаЧисло" Тогда
		ЮТест.ОжидаетЧто(Приведение.ОписаниеТипа.Длина)
			.Равно(ОжидаемаяДлина, "Описание числа должно сохранять длину");
		ЮТест.ОжидаетЧто(Приведение.ОписаниеТипа.Точность)
			.Равно(ОжидаемаяТочность, "Описание числа должно сохранять точность");
	ИначеЕсли ОжидаемыйТипОписания = "ОписаниеТипаСтрока" Тогда
		ЮТест.ОжидаетЧто(Приведение.ОписаниеТипа.Длина)
			.Равно(ОжидаемаяДлина, "Описание строки должно сохранять длину");
	КонецЕсли;

КонецПроцедуры

Процедура ВыборРазбирается(ИсходныйТекст, ОжидаемоеКоличествоАльтернатив) Экспорт

	Узел = РазобратьВыражениеДляТеста(ИсходныйТекст);
	ПроверитьТипУзла(Узел, "Выбор", "Ожидается узел оператора ВЫБОР");
	ЮТест.ОжидаетЧто(Узел.АльтернативыВыбора.Количество())
		.Равно(ОжидаемоеКоличествоАльтернатив, "ВЫБОР должен сохранять количество альтернатив");
	ПроверитьТипУзла(Узел.АльтернативыВыбора[0].Условие, "БинарнаяОперация",
		"Условие первой альтернативы должно быть сравнением");
	ЮТест.ОжидаетЧто(Узел.АльтернативыВыбора[0].Условие.Операция)
		.Равно("=", "Условие первой альтернативы должно сохранять оператор сравнения");
	ПроверитьКонстанту(Узел.АльтернативыВыбора[0].Действие, 10);
	ПроверитьКонстанту(Узел.Иначе, 0);

КонецПроцедуры

Процедура АгрегатнаяФункцияРазбирается(ИсходныйТекст, ОжидаемоеИмяФункции) Экспорт

	Узел = РазобратьВыражениеДляТеста(ИсходныйТекст);
	ПроверитьТипУзла(Узел, "АгрегатнаяФункция", "Ожидается узел агрегатной функции");
	ЮТест.ОжидаетЧто(Узел.ИмяФункции)
		.Равно(ОжидаемоеИмяФункции, "Агрегатная функция должна сохранять имя");
	ПроверитьТипУзла(Узел.Аргумент, "Разыменование", "Аргументом агрегатной функции должно быть поле");
	ЮТест.ОжидаетЧто(Узел.Аргумент.Элементы[0])
