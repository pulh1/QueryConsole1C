#Область ТестовыйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	Кавычка = Символ(34);

	ЮТТесты
		.ДобавитьТестовыйНабор("Парсер")
			.Тег("Парсер")
			.ДобавитьСерверныйТест("РазборКонстантногоВыражения")
			.ДобавитьСерверныйТест("КонстантаРазбирается")
				.СПараметрамиНаСервере("1", 1)
				.СПараметрамиНаСервере("12.5", 12.5)
				.СПараметрамиНаСервере(Кавычка + "текст" + Кавычка, "текст")
				.СПараметрамиНаСервере("ИСТИНА", Истина)
				.СПараметрамиНаСервере("ЛОЖЬ", Ложь)
				.СПараметрамиНаСервере("NULL", Null)
				.СПараметрамиНаСервере("НЕОПРЕДЕЛЕНО", Неопределено)
			.ДобавитьСерверныйТест("ПараметрЗапросаРазбирается")
			.ДобавитьСерверныйТест("РазыменованиеРазбирается")
				.СПараметрамиНаСервере("Поле", 1, "Поле", Неопределено)
				.СПараметрамиНаСервере("Таблица.Поле", 2, "Таблица", "Поле");

КонецПроцедуры

Процедура РазборКонстантногоВыражения() Экспорт

	Парсер = КОНС_ТестовыеФабрикиСлужебный.СоздатьПарсер();
	Результат = Парсер.РазобратьВыражение("1");

	ЮТест.ОжидаетЧто(Результат.Тип)
		.Равно("Константа", "Парсер должен построить узел константы");
	ЮТест.ОжидаетЧто(Результат.Значение)
		.Равно(1, "Парсер должен сохранить числовое значение константы");

КонецПроцедуры

Процедура КонстантаРазбирается(ИсходныйТекст, ОжидаемоеЗначение) Экспорт

	Узел = РазобратьВыражениеДляТеста(ИсходныйТекст);
	ПроверитьКонстанту(Узел, ОжидаемоеЗначение);

КонецПроцедуры

Процедура ПараметрЗапросаРазбирается() Экспорт

	Узел = РазобратьВыражениеДляТеста("&Параметр");
	ПроверитьТипУзла(Узел, "ПараметрЗапроса", "Ожидается узел параметра запроса");
	ЮТест.ОжидаетЧто(Узел.Имя)
		.Равно("Параметр", "Параметр запроса должен сохранять имя");

КонецПроцедуры

Процедура РазыменованиеРазбирается(ИсходныйТекст, КоличествоЭлементов, ПервыйЭлемент, ВторойЭлемент) Экспорт

	Узел = РазобратьВыражениеДляТеста(ИсходныйТекст);
	ПроверитьТипУзла(Узел, "Разыменование", "Ожидается узел разыменования");
	ЮТест.ОжидаетЧто(Узел.Элементы.Количество())
		.Равно(КоличествоЭлементов, "Разыменование должно сохранять количество элементов");
	ЮТест.ОжидаетЧто(Узел.Элементы[0])
		.Равно(ПервыйЭлемент, "Разыменование должно сохранять первый элемент");

	Если ВторойЭлемент <> Неопределено Тогда
		ЮТест.ОжидаетЧто(Узел.Элементы[1])
			.Равно(ВторойЭлемент, "Разыменование должно сохранять второй элемент");
	КонецЕсли;

КонецПроцедуры

#Область ВспомогательныеПроцедуры

Функция РазобратьВыражениеДляТеста(ИсходныйТекст)

	Парсер = КОНС_ТестовыеФабрикиСлужебный.СоздатьПарсер();
	Возврат Парсер.РазобратьВыражение(ИсходныйТекст);

КонецФункции

Процедура ПроверитьТипУзла(Узел, ОжидаемыйТип, Описание)

	ЮТест.ОжидаетЧто(Узел.Тип).Равно(ОжидаемыйТип, Описание);

КонецПроцедуры

Процедура ПроверитьКонстанту(Узел, ОжидаемоеЗначение)

	ПроверитьТипУзла(Узел, "Константа", "Ожидается узел константы");
	ЮТест.ОжидаетЧто(Узел.Значение)
		.Равно(ОжидаемоеЗначение, "Константа должна сохранять значение");

КонецПроцедуры

#КонецОбласти

#КонецОбласти
