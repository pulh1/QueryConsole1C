				.СПараметрамиНаСервере("1 = 1 И 2 = 2", "И")
				.СПараметрамиНаСервере("1 = 1 ИЛИ 2 = 2", "ИЛИ")
			.ДобавитьСерверныйТест("ЛогическоеИмеетПриоритетНадИли")
			.ДобавитьСерверныйТест("ЛогическоеОтрицаниеРазбирается")
