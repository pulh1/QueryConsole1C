// Проверяет семантически значимую проекцию разобранного выражения.
//
// Параметры:
//  Сценарий - Строка - Имя проверяемого сценария выражения.
//@skip-check module-structure-method-in-regions
Процедура ПроверяетсяСемантическаяПроекцияВыражения(Сценарий) Экспорт

	Если Сценарий = "ЛеваяАссоциативностьВычитания" Тогда
		Узел = РазобратьВыражениеДляТеста("1 - 2 - 3");
		ПроверитьТипУзла(Узел, "БинарнаяОперация", "Корнем цепочки должна быть бинарная операция");
		ЮТест.ОжидаетЧто(Узел.Операция).Равно("-", "Корень должен сохранять второй оператор минус");
		ПроверитьТипУзла(Узел.ЛеваяЧасть, "БинарнаяОперация",
			"Первое вычитание должно быть вложено слева");
		ЮТест.ОжидаетЧто(Узел.ЛеваяЧасть.Операция).Равно("-",
			"Левая часть должна сохранять первый оператор минус");
		ПроверитьКонстанту(Узел.ЛеваяЧасть.ЛеваяЧасть, 1);
		ПроверитьКонстанту(Узел.ЛеваяЧасть.ПраваяЧасть, 2);
		ПроверитьКонстанту(Узел.ПраваяЧасть, 3);
	ИначеЕсли Сценарий = "ЛеваяАссоциативностьДеления" Тогда
		Узел = РазобратьВыражениеДляТеста("8 / 4 / 2");
		ПроверитьТипУзла(Узел, "БинарнаяОперация", "Корнем цепочки должно быть деление");
		ЮТест.ОжидаетЧто(Узел.Операция).Равно("/", "Корень должен сохранять второй оператор");
		ПроверитьТипУзла(Узел.ЛеваяЧасть, "БинарнаяОперация", "Первое деление должно быть вложено слева");
		ЮТест.ОжидаетЧто(Узел.ЛеваяЧасть.Операция).Равно("/", "Левая часть должна сохранять первый оператор");
		ПроверитьКонстанту(Узел.ЛеваяЧасть.ЛеваяЧасть, 8);
		ПроверитьКонстанту(Узел.ЛеваяЧасть.ПраваяЧасть, 4);
		ПроверитьКонстанту(Узел.ПраваяЧасть, 2);
	ИначеЕсли Сценарий = "ЛеваяАссоциативностьЛогическогоИ" Тогда
		ПроверитьЛевуюАссоциативностьЛогическойЦепочки("1=1 И 2=2 И 3=3", "И");
	ИначеЕсли Сценарий = "ЛеваяАссоциативностьЛогическогоИли" Тогда
		ПроверитьЛевуюАссоциативностьЛогическойЦепочки("1=1 ИЛИ 2=2 ИЛИ 3=3", "ИЛИ");
	ИначеЕсли Сценарий = "ПриоритетУмножения" Тогда
		Узел = РазобратьВыражениеДляТеста("1 + 2 * 3");
		ЮТест.ОжидаетЧто(Узел.Операция).Равно("+", "Сложение должно оставаться корнем выражения");
		ПроверитьКонстанту(Узел.ЛеваяЧасть, 1);
		ЮТест.ОжидаетЧто(Узел.ПраваяЧасть.Операция).Равно("*", "Умножение должно быть вложено справа");
		ПроверитьКонстанту(Узел.ПраваяЧасть.ЛеваяЧасть, 2);
		ПроверитьКонстанту(Узел.ПраваяЧасть.ПраваяЧасть, 3);
	ИначеЕсли Сценарий = "ПорядокРазыменования" Тогда
		Узел = РазобратьВыражениеДляТеста("Источник.Контрагент.Наименование");
		ЮТест.ОжидаетЧто(Узел.Элементы.Количество()).Равно(3, "Разыменование должно сохранять три элемента");
		ЮТест.ОжидаетЧто(Узел.Элементы[0]).Равно("Источник", "Первым должен быть источник");
		ЮТест.ОжидаетЧто(Узел.Элементы[1]).Равно("Контрагент", "Вторым должно быть ссылочное поле");
		ЮТест.ОжидаетЧто(Узел.Элементы[2]).Равно("Наименование", "Третьим должно быть конечное поле");
	ИначеЕсли Сценарий = "ПорядокАргументовФункции" Тогда
		Узел = РазобратьВыражениеДляТеста("ДАТАВРЕМЯ(2024, 5, 6)");
		ПроверитьТипУзла(Узел, "ФункцияДатаВремя", "Ожидается функция ДАТАВРЕМЯ");
		ЮТест.ОжидаетЧто(Узел.Аргументы.Количество()).Равно(3, "Функция должна сохранять три аргумента");
		ЮТест.ОжидаетЧто(Узел.Аргументы[0]).Равно(2024, "Первым аргументом должен быть год");
		ЮТест.ОжидаетЧто(Узел.Аргументы[1]).Равно(5, "Вторым аргументом должен быть месяц");
		ЮТест.ОжидаетЧто(Узел.Аргументы[2]).Равно(6, "Третьим аргументом должен быть день");
	ИначеЕсли Сценарий = "АльтернативыУсловногоВыражения" Тогда
		Узел = РазобратьВыражениеДляТеста(
			"ВЫБОР КОГДА 1 = 1 ТОГДА 10 КОГДА 2 = 2 ТОГДА 20 ИНАЧЕ 30 КОНЕЦ");
		ЮТест.ОжидаетЧто(Узел.АльтернативыВыбора.Количество()).Равно(2,
			"ВЫБОР должен сохранять обе альтернативы и их порядок");
		ПроверитьКонстанту(Узел.АльтернативыВыбора[0].Условие.ЛеваяЧасть, 1);
		ПроверитьКонстанту(Узел.АльтернативыВыбора[0].Действие, 10);
		ПроверитьКонстанту(Узел.АльтернативыВыбора[1].Условие.ЛеваяЧасть, 2);
		ПроверитьКонстанту(Узел.АльтернативыВыбора[1].Действие, 20);
		ПроверитьКонстанту(Узел.Иначе, 30);
	КонецЕсли;

КонецПроцедуры

