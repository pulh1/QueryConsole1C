#Область ПрограммныйИнтерфейс

// Регистрирует один server benchmark по восьми классам corpus.
Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Runtime benchmark парсера")
			.Тег("БенчмаркПарсера");

	ЮТТесты.ДобавитьСерверныйТест("RuntimeBaselineПарсераФормируется");

КонецПроцедуры

#КонецОбласти

#Область Тесты

// Измеряет runtime parser и сохраняет UTF-8 JSON рядом с JUnit report.
Процедура RuntimeBaselineПарсераФормируется() Экспорт

	Результат = ВыполнитьБенчмарк();

	ЮТест.ОжидаетЧто(Результат.corpora.Количество()).Равно(8,
		"Baseline должен содержать ровно восемь классов corpus");
	ЮТест.ОжидаетЧто(Результат.corpora[0].id).Равно("query_examples_all_42",
		"Первым corpus должен быть полный набор QueryExamples");
	ЮТест.ОжидаетЧто(Результат.corpora[0].input_count).Равно(42,
		"Runtime corpus должен содержать все 42 embedded /querylist/query/text");

	Для Каждого Корпус Из Результат.corpora Цикл
		ЮТест.ОжидаетЧто(Корпус.wall_clock_median_ms).Больше(0,
			Корпус.id + ": median должен быть положительным");
		ЮТест.ОжидаетЧто(Корпус.wall_clock_p95_ms).Больше(0,
			Корпус.id + ": p95 должен быть положительным");
		ЮТест.ОжидаетЧто(Корпус.samples_ms.Количество()).Равно(20,
			Корпус.id + ": должно быть двадцать фактических samples");
	КонецЦикла;

	ПутьРезультата = ЗаписатьРезультатJSON(Результат);
	ФайлРезультата = Новый Файл(ПутьРезультата);
	ЮТест.ОжидаетЧто(ФайлРезультата.Существует()).ЭтоИстина(
		"Runtime JSON должен быть записан рядом с JUnit report");

КонецПроцедуры

#КонецОбласти

#Область ВыполнениеБенчмарка

Функция ВыполнитьБенчмарк()

	Результат = Новый Структура;
	Результат.Вставить("schema_version", 1);
	Результат.Вставить("benchmark_id", "runtime_parser_before_ebnf_lr");
	Результат.Вставить("captured_at_platform_ms", ТекущаяУниверсальнаяДатаВМиллисекундах());
	Результат.Вставить("warmup_count", 3);
	Результат.Вставить("sample_count", 20);
	Результат.Вставить("clock", "ТекущаяУниверсальнаяДатаВМиллисекундах");
	Результат.Вставить("clock_resolution_ms", 1);
	Результат.Вставить("batch_calibration_target_ms", 25);
	Результат.Вставить("runtime", ОписаниеRuntime());
	Результат.Вставить("parser_artifact", ОписаниеParserArtifact());
	Результат.Вставить("measurement_scope",
		"Парсер.Разобрать/РазобратьВыражение на повторно используемом объекте; создание parser object не входит в sample");
	Результат.Вставить("internal_counters", НедоступныеВнутренниеСчетчики());
	Результат.Вставить("corpora", Новый Массив);

	Для Каждого Корпус Из КорпусыБенчмарка() Цикл
		Результат.corpora.Добавить(ИзмеритьКорпус(Корпус, Результат.warmup_count, Результат.sample_count));
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ИзмеритьКорпус(Корпус, КоличествоПрогревов, КоличествоЗамеров)

	//@skip-check undefined-variable
	Парсер = КОНС_ТестовыеФабрикиСлужебный.СоздатьПарсер();
	ИтерацийВПакете = КалиброватьРазмерПакета(Парсер, Корпус, 25);

	Для НомерПрогрева = 1 По КоличествоПрогревов Цикл
		ВыполнитьПакет(Парсер, Корпус, ИтерацийВПакете);
	КонецЦикла;

	Замеры = Новый Массив;
	Для НомерЗамера = 1 По КоличествоЗамеров Цикл
		ДлительностьПакета = ИзмеритьПакет(Парсер, Корпус, ИтерацийВПакете);
		Замеры.Добавить(ДлительностьПакета / ИтерацийВПакете);
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("id", Корпус.id);
	Результат.Вставить("entrypoint", Корпус.entrypoint);
	Результат.Вставить("provenance", Корпус.provenance);
	Результат.Вставить("generator_parameters", Корпус.generator_parameters);
	Результат.Вставить("inputs", ОписаниеВходов(Корпус.inputs));
	Результат.Вставить("input_count", Корпус.inputs.Количество());
	Результат.Вставить("input_length", ОбщаяДлинаВходов(Корпус.inputs));
	Результат.Вставить("operation_count_per_iteration", Корпус.inputs.Количество());
	Результат.Вставить("iterations_per_sample", ИтерацийВПакете);
	Результат.Вставить("parse_calls_per_sample", ИтерацийВПакете * Корпус.inputs.Количество());
	Результат.Вставить("warmup_count", КоличествоПрогревов);
	Результат.Вставить("sample_count", КоличествоЗамеров);
	Результат.Вставить("samples_ms", Замеры);
	Результат.Вставить("wall_clock_median_ms", Медиана(Замеры));
	Результат.Вставить("wall_clock_p95_ms", Процентиль95(Замеры));

	Возврат Результат;

КонецФункции

Функция КалиброватьРазмерПакета(Парсер, Корпус, ЦелеваяДлительностьМс)

	Итераций = 1;
	Для НомерПопытки = 1 По 16 Цикл
		Длительность = ИзмеритьПакет(Парсер, Корпус, Итераций);
		Если Длительность >= ЦелеваяДлительностьМс Тогда
			Возврат Итераций;
		КонецЕсли;
		Итераций = Итераций * 2;
	КонецЦикла;

	Если Длительность <= 0 Тогда
		ВызватьИсключение Корпус.id + ": разрешения millisecond clock недостаточно даже после batch calibration";
	КонецЕсли;

	Возврат Итераций / 2;

КонецФункции

Функция ИзмеритьПакет(Парсер, Корпус, КоличествоИтераций)

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ВыполнитьПакет(Парсер, Корпус, КоличествоИтераций);
	Возврат ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

КонецФункции

Процедура ВыполнитьПакет(Парсер, Корпус, КоличествоИтераций)

	Для НомерИтерации = 1 По КоличествоИтераций Цикл
		Для Каждого Вход Из Корпус.inputs Цикл
			Если Корпус.entrypoint = "Разобрать" Тогда
				РезультатРазбора = Парсер.Разобрать(Вход.text);
			ИначеЕсли Корпус.entrypoint = "РазобратьВыражение" Тогда
				РезультатРазбора = Парсер.РазобратьВыражение(Вход.text);
			Иначе
				ВызватьИсключение "Неизвестный parser entrypoint: " + Корпус.entrypoint;
			КонецЕсли;

			Если РезультатРазбора = Неопределено Тогда
				ВызватьИсключение Корпус.id + ": parser вернул Неопределено";
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Функция Медиана(Замеры)

	Список = Новый СписокЗначений;
	Список.ЗагрузитьЗначения(Замеры);
	Список.СортироватьПоЗначению();
	Количество = Список.Количество();

	Если Количество % 2 = 0 Тогда
		Возврат (Список[Количество / 2 - 1].Значение + Список[Количество / 2].Значение) / 2;
	КонецЕсли;

	Возврат Список[Цел(Количество / 2)].Значение;

КонецФункции

Функция Процентиль95(Замеры)

	Список = Новый СписокЗначений;
	Список.ЗагрузитьЗначения(Замеры);
	Список.СортироватьПоЗначению();
	Индекс = Цел((95 * Список.Количество() + 99) / 100) - 1;
	Индекс = Макс(0, Мин(Список.Количество() - 1, Индекс));
	Возврат Список[Индекс].Значение;

КонецФункции

#КонецОбласти

#Область Corpus

Функция КорпусыБенчмарка()

	Корпусы = Новый Массив;

	QueryExamples = НовыйКорпус(
		"query_examples_all_42", "Разобрать",
		"Все логические XML /querylist/query/text из 42 QueryExamples/*.q1c, embedded exact text",
		Новый Структура("file_count,xpath", 42, "/querylist/query/text"));
	ДобавитьВсеQueryExamples(QueryExamples.inputs);
	Если QueryExamples.inputs.Количество() <> 42 Тогда
		ВызватьИсключение СтрШаблон(
			"query_examples_all_42: ожидалось 42 embedded inputs, получено %1",
			QueryExamples.inputs.Количество());
	КонецЕсли;
	Корпусы.Добавить(QueryExamples);

	LargePackage = НовыйКорпус("large_package", "Разобрать",
		"Largest real QueryExamples package: QueryExamples/ТестПакетЗапрсов.q1c",
		Новый Структура("source_path,query_name", "QueryExamples/ТестПакетЗапрсов.q1c", "СотрудникиОрганизации"));
	LargePackage.inputs.Добавить(QueryExamples.inputs[31]);
	Корпусы.Добавить(LargePackage);

	LongFieldList = НовыйКорпус("long_field_list", "Разобрать",
		"Synthetic deterministic SELECT field list", Новый Структура("field_count", 200));
	ДобавитьСинтетическийВход(LongFieldList.inputs, "long_field_list_200", ПостроитьДлинныйСписокПолей(200),
		"ПостроитьДлинныйСписокПолей", LongFieldList.generator_parameters);
	Корпусы.Добавить(LongFieldList);

	JoinChain = НовыйКорпус("join_chain", "Разобрать",
		"Synthetic deterministic LEFT JOIN chain", Новый Структура("join_count", 40));
	ДобавитьСинтетическийВход(JoinChain.inputs, "join_chain_40", ПостроитьЦепочкуСоединений(40),
		"ПостроитьЦепочкуСоединений", JoinChain.generator_parameters);
	Корпусы.Добавить(JoinChain);

	UnionPackage = НовыйКорпус("union_package_chain", "Разобрать",
		"Synthetic deterministic two-query package with UNION ALL chains",
		Новый Структура("package_query_count,union_branches_per_query", 2, 40));
	ДобавитьСинтетическийВход(UnionPackage.inputs, "union_package_2x40", ПостроитьЦепочкуОбъединений(2, 40),
		"ПостроитьЦепочкуОбъединений", UnionPackage.generator_parameters);
	Корпусы.Добавить(UnionPackage);

	Arithmetic = НовыйКорпус("arithmetic_chain", "РазобратьВыражение",
		"Synthetic deterministic left-associative arithmetic chain", Новый Структура("term_count", 200));
	ДобавитьСинтетическийВход(Arithmetic.inputs, "arithmetic_chain_200", ПостроитьАрифметическуюЦепочку(200),
		"ПостроитьАрифметическуюЦепочку", Arithmetic.generator_parameters);
	Корпусы.Добавить(Arithmetic);

	Logical = НовыйКорпус("logical_chain", "РазобратьВыражение",
		"Synthetic deterministic AND chain", Новый Структура("predicate_count", 120));
	ДобавитьСинтетическийВход(Logical.inputs, "logical_chain_120", ПостроитьЛогическуюЦепочку(120),
		"ПостроитьЛогическуюЦепочку", Logical.generator_parameters);
	Корпусы.Добавить(Logical);

	Dereference = НовыйКорпус("dereference_chain", "РазобратьВыражение",
		"Synthetic deterministic dereference chain", Новый Структура("part_count", 120));
	ДобавитьСинтетическийВход(Dereference.inputs, "dereference_chain_120", ПостроитьЦепочкуРазыменований(120),
		"ПостроитьЦепочкуРазыменований", Dereference.generator_parameters);
	Корпусы.Добавить(Dereference);

	Возврат Корпусы;

КонецФункции

Функция НовыйКорпус(Идентификатор, ТочкаВхода, Провенанс, ПараметрыГенератора)

	Возврат Новый Структура("id,entrypoint,provenance,generator_parameters,inputs",
		Идентификатор, ТочкаВхода, Провенанс, ПараметрыГенератора, Новый Массив);

КонецФункции

