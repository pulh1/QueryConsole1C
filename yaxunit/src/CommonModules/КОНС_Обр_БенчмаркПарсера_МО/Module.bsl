Функция ЗаписатьРезультатJSON(Результат)

	ПутьРезультата = ПутьКРезультатуJSON();
	Результат.Вставить("raw_result_path", ПутьРезультата);
	СтрокаJSON = ЮТОбщий.СтрокаJSON(Результат, Ложь, Ложь);
	Запись = Новый ЗаписьТекста(ПутьРезультата, КодировкаТекста.UTF8);
	Запись.Записать(СтрокаJSON);
	Запись.Закрыть();
	Возврат ПутьРезультата;

