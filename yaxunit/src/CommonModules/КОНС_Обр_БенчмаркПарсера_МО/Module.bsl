Функция ПутьКРезультатуJSON()

	ПараметрыЗапуска = ЮТКонтекстСлужебный.ПараметрыЗапуска();
	Если ПараметрыЗапуска = Неопределено
		Или НЕ ПараметрыЗапуска.Свойство("reportPath")
		Или ПустаяСтрока(ПараметрыЗапуска.reportPath) Тогда
		ВызватьИсключение "YAxUnit reportPath недоступен; runtime JSON нельзя записать рядом с JUnit report";
	КонецЕсли;

	ФайлОтчета = Новый Файл(ПараметрыЗапуска.reportPath);
	Если ПустаяСтрока(ФайлОтчета.Расширение) Тогда
		КаталогОтчета = ФайлОтчета.ПолноеИмя;
	Иначе
