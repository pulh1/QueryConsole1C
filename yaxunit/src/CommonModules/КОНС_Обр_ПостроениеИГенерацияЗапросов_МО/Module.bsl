#Область ПрограммныйИнтерфейс

// Регистрирует серверные тесты построения и генерации запросов.
Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Построение и генерация запросов")
			.Тег("ПостроениеИГенерацияЗапросов")
			.ДобавитьСерверныйТест("ПостроительМеняетИсточникиОтборСортировкуИИтогиПоШагам")
			.ДобавитьСерверныйТест("ТекстПакетаПослеПовторногоРазбораСохраняетСемантику");

КонецПроцедуры

// Подтверждает пошаговое изменение модели публичными методами построителя.
Процедура ПостроительМеняетИсточникиОтборСортировкуИИтогиПоШагам() Экспорт

	Пакет = РазобратьИОбработатьЗапрос("ВЫБРАТЬ 1");
	//@skip-check server-execution-safe-mode
	МодульУтилитМодели = Вычислить("МодельЗапросаУтилиты");
	Построитель = МодульУтилитМодели.СоздатьПостроительМодели(Пакет);

	Построитель = Построитель.ДобавитьИсточник("&Данные", "Данные");
	Модель = Построитель.ПолучитьМодель();
	Запрос = Модель.Элементы[0];
	Оператор = Запрос.Операторы[0];
	ЮТест.ОжидаетЧто(Оператор.Источники.Элементы.Количество())
		.Равно(1, "Источник должен быть добавлен");
	Источник = Оператор.Источники.Элементы[0].Источник;
	ЮТест.ОжидаетЧто(Источник.Тип).Равно("ИсточникДанныхТаблицаЗначений");
	ЮТест.ОжидаетЧто(Источник.ИмяТаблицы).Равно("&Данные");
	ЮТест.ОжидаетЧто(Источник.Псевдоним).Равно("Данные");

	Построитель = Построитель.ДобавитьОтбор("1 = 1");
	Оператор = Построитель.ПолучитьМодель().Элементы[0].Операторы[0];
	ЮТест.ОжидаетЧто(Оператор.Отбор.Количество()).Равно(1, "Отбор должен быть добавлен");
	ЮТест.ОжидаетЧто(Оператор.Отбор[0].Значение.Тип).Равно("БинарнаяОперация");

	Построитель = Построитель.ДобавитьУпорядочивание("1");
	Запрос = Построитель.ПолучитьМодель().Элементы[0];
	ЮТест.ОжидаетЧто(Запрос.Порядок.Количество()).Равно(1, "Сортировка должна быть добавлена");
	ЮТест.ОжидаетЧто(Запрос.Порядок[0].Направление).Равно("Возр");
	ЮТест.ОжидаетЧто(Запрос.Порядок[0].Выражение.Значение.Тип).Равно("СсылкаНаКолонкуЗапроса");

	Построитель = Построитель.ДобавитьКонтрольнуюТочкуИтогов("1");
	Запрос = Построитель.ПолучитьМодель().Элементы[0];
	ЮТест.ОжидаетЧто(Запрос.КонтрольныеТочкиИтогов.Количество()).Равно(1, "Контрольная точка должна быть добавлена");
	ЮТест.ОжидаетЧто(Запрос.КонтрольныеТочкиИтогов[0].Выражение.Значение.Тип).Равно("СсылкаНаКолонкуЗапроса");

	Построитель = Построитель.УстановитьПолучениеОбщихИтогов(Истина);
	Запрос = Построитель.ПолучитьМодель().Элементы[0];
	ЮТест.ОжидаетЧто(Запрос.ОбщиеИтоги).Равно(Истина, "Общие итоги должны быть включены");

КонецПроцедуры

// Подтверждает семантическую эквивалентность модели до и после генерации текста.
Процедура ТекстПакетаПослеПовторногоРазбораСохраняетСемантику() Экспорт

	ИсходныйТекст =
		"ВЫБРАТЬ ФизическиеЛица.Ссылка КАК ФизическоеЛицо "
		+ "ИЗ Справочник.ФизическиеЛица КАК ФизическиеЛица "
		+ "ГДЕ ФизическиеЛица.Ссылка = ФизическиеЛица.Ссылка "
		+ "ОБЪЕДИНИТЬ ВСЕ ВЫБРАТЬ ФизическиеЛица.Ссылка КАК ФизическоеЛицо "
		+ "ИЗ Справочник.ФизическиеЛица КАК ФизическиеЛица "
		+ "УПОРЯДОЧИТЬ ПО ФизическоеЛицо УБЫВ "
		+ "ИТОГИ КОЛИЧЕСТВО(ФизическоеЛицо) КАК Количество ПО ОБЩИЕ, ФизическоеЛицо; "
		+ "ВЫБРАТЬ 2 КАК Второй";

	ИсходнаяМодель = РазобратьИОбработатьЗапрос(ИсходныйТекст);
	//@skip-check server-execution-safe-mode
	МодульГенерации = Вычислить("ГенерацияТекстовЗапросов");
	ИсходнаяПроекция = СтрокаПроекции(ИсходнаяМодель, МодульГенерации);

	СгенерированныйТекст = МодульГенерации.ТекстПакетаЗапросов(ИсходнаяМодель);
	ПовторнаяМодель = РазобратьИОбработатьЗапрос(СгенерированныйТекст);
	ПовторнаяПроекция = СтрокаПроекции(ПовторнаяМодель, МодульГенерации);

	ЮТест.ОжидаетЧто(ПовторнаяПроекция)
		.Равно(ИсходнаяПроекция,
			"Генерация и повторный разбор должны сохранять предметную проекцию");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РазобратьИОбработатьЗапрос(ИсходныйТекст)

	//@skip-check server-execution-safe-mode
	МодульТестовыхФабрик = Вычислить("КОНС_ТестовыеФабрикиСлужебный");
	Парсер = МодульТестовыхФабрик.СоздатьПарсер();
	Пакет = Парсер.Разобрать(ИсходныйТекст);
	//@skip-check server-execution-safe-mode
	МодульОбработкиМодели = Вычислить("ОбработкаМоделиЗапроса");
	МодульОбработкиМодели.ОбработатьМодельЗапроса(Пакет);
	Возврат Пакет;

КонецФункции

Функция СтрокаПроекции(Пакет, МодульГенерации)

	Проекция = ПроекцияПакета(Пакет, МодульГенерации);
	Возврат ЮТОбщий.СтрокаJSON(Проекция, Ложь, Истина);

КонецФункции

Функция ПроекцияПакета(Пакет, МодульГенерации)

	Результат = Новый Структура;
	ЭлементыПакета = Новый Массив;
	Результат.Вставить("Элементы", ЭлементыПакета);
	Для Каждого ЭлементПакета Из Пакет.Элементы Цикл
		Если ЭлементПакета.Тип = "ЗапросВыбора" Тогда
			ЭлементыПакета.Добавить(ПроекцияЗапроса(ЭлементПакета, МодульГенерации));
		Иначе
			ЭлементыПакета.Добавить(Новый Структура("Тип", ЭлементПакета.Тип));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПроекцияЗапроса(Запрос, МодульГенерации)

	Результат = Новый Структура("Тип,ОбщиеИтоги", Запрос.Тип, Запрос.ОбщиеИтоги);
	Операторы = Новый Массив;
	Результат.Вставить("Операторы", Операторы);
	Для Каждого Оператор Из Запрос.Операторы Цикл
		Операторы.Добавить(ПроекцияОператора(Оператор, Запрос, МодульГенерации));
	КонецЦикла;
	Результат.Вставить("Порядок", ПроекцияПорядка(Запрос, МодульГенерации));
	Результат.Вставить("ТочкиИтогов", ПроекцияТочекИтогов(Запрос, МодульГенерации));
	Возврат Результат;

КонецФункции

Функция ПроекцияОператора(Оператор, Запрос, МодульГенерации)

	Генератор = ГенераторВыражений(Оператор, Запрос, МодульГенерации);
	Результат = Новый Структура("ТипОбъединения", Оператор.ТипОбъединения);
	Источники = Новый Массив;
	Для Каждого УзелИсточника Из Оператор.Источники.Элементы Цикл
		Источник = УзелИсточника.Источник;
		Источники.Добавить(Новый Структура("Тип,ИмяТаблицы,Псевдоним",
			Источник.Тип, Источник.ИмяТаблицы, Источник.Псевдоним));
	КонецЦикла;
	Результат.Вставить("Источники", Источники);

	Поля = Новый Массив;
	Для Каждого Поле Из Оператор.ВыбираемыеПоля Цикл
		Поля.Добавить(Новый Структура("Выражение,Псевдоним",
			ТекстВыражения(Поле.Выражение, Генератор, МодульГенерации), Поле.Псевдоним));
	КонецЦикла;
	Результат.Вставить("Поля", Поля);

	Отборы = Новый Массив;
	Для Каждого Отбор Из Оператор.Отбор Цикл
		Отборы.Добавить(ТекстВыражения(Отбор, Генератор, МодульГенерации));
	КонецЦикла;
	Результат.Вставить("Отборы", Отборы);
	Возврат Результат;

КонецФункции

Функция ПроекцияПорядка(Запрос, МодульГенерации)

	Результат = Новый Массив;
	Генератор = ГенераторВыражений(Запрос.Операторы[0], Запрос, МодульГенерации);
	Для Каждого ЭлементПорядка Из Запрос.Порядок Цикл
		Результат.Добавить(Новый Структура("Выражение,Направление,Иерархия",
			ТекстВыражения(ЭлементПорядка.Выражение, Генератор, МодульГенерации),
			ЭлементПорядка.Направление, ЭлементПорядка.Иерархия));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПроекцияТочекИтогов(Запрос, МодульГенерации)

	Результат = Новый Массив;
	Генератор = ГенераторВыражений(Запрос.Операторы[0], Запрос, МодульГенерации);
	Для Каждого Точка Из Запрос.КонтрольныеТочкиИтогов Цикл
		Результат.Добавить(Новый Структура("Выражение,Тип,ИмяКолонки",
			ТекстВыражения(Точка.Выражение, Генератор, МодульГенерации),
			Точка.ТипКонтрольнойТочки, Точка.ИмяКолонки));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ГенераторВыражений(Оператор, Запрос, МодульГенерации)

	Генератор = МодульГенерации.СоздатьГенераторТекстовВыражений();
	Генератор.УстановитьИсточники(Оператор.Источники.Элементы);
	Генератор.УстановитьКолонки(Запрос.Колонки);
	Возврат Генератор;

КонецФункции

Функция ТекстВыражения(Выражение, Генератор, МодульГенерации)

	Возврат МодульГенерации.ВыражениеВСтроку(Выражение, Генератор);

КонецФункции

#КонецОбласти
