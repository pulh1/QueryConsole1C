#Область ПрограммныйИнтерфейс

// Регистрирует серверные тесты построения и генерации запросов.
Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Построение и генерация запросов")
			.Тег("ПостроениеИГенерацияЗапросов")
			.ДобавитьСерверныйТест("ПостроительМеняетИсточникиОтборСортировкуИИтогиПоШагам")
			.ДобавитьСерверныйТест("ПостроительХранитСоединенияДеревом")
			.ДобавитьСерверныйТест("ПостроительОтклоняетЦиклИсточников")
			.ДобавитьСерверныйТест("ТекстПакетаПослеПовторногоРазбораСохраняетСемантику");

КонецПроцедуры

Процедура ПостроительХранитСоединенияДеревом() Экспорт

	Пакет = РазобратьИОбработатьЗапрос("ВЫБРАТЬ 1");
	МодульУтилитМодели = Вычислить("МодельЗапросаУтилиты");
	Построитель = МодульУтилитМодели.СоздатьПостроительМодели(Пакет);
	Построитель.ДобавитьИсточник("&ЛеваяТаблица", "Левая");
	Построитель.ДобавитьИсточник("&ПраваяТаблица", "Правая");
	Построитель.ДобавитьСоединение("Правая", "Левая", Неопределено);

	Оператор = Построитель.ПолучитьМодель().Элементы[0].Операторы[0];
	ЮТест.ОжидаетЧто(Оператор.Источники.Количество()).Равно(1,
		"После соединения в корневом массиве должен остаться владелец");
	ЮТест.ОжидаетЧто(ВсеИсточникиОператора(Оператор).Количество()).Равно(2,
		"Обход дерева должен возвращать оба источника");
	ЮТест.ОжидаетЧто(Оператор.Источники[0].Соединения.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(Оператор.Источники[0].Соединения[0].Источник.Источник.Псевдоним)
		.Равно("Правая", "JOIN должен непосредственно хранить дочерний узел источника");

КонецПроцедуры

Процедура ПостроительОтклоняетЦиклИсточников() Экспорт

	Пакет = РазобратьИОбработатьЗапрос("ВЫБРАТЬ 1");
	МодульУтилитМодели = Вычислить("МодельЗапросаУтилиты");
	Построитель = МодульУтилитМодели.СоздатьПостроительМодели(Пакет);
	Построитель.ДобавитьИсточник("&ЛеваяТаблица", "Левая");
	Построитель.ДобавитьИсточник("&ПраваяТаблица", "Правая");
	Построитель.ДобавитьСоединение("Правая", "Левая", Неопределено);

	ЮТест.ОжидаетЧто(Построитель)
		.Метод("ДобавитьСоединение", ЮТМетоды.МассивПараметров("Левая", "Правая", Неопределено))
		.ВыбрасываетИсключение("Соединение не должно образовывать цикл источников");

КонецПроцедуры

// Подтверждает пошаговое изменение модели публичными методами построителя.
Процедура ПостроительМеняетИсточникиОтборСортировкуИИтогиПоШагам() Экспорт

	Пакет = РазобратьИОбработатьЗапрос("ВЫБРАТЬ 1");
	//@skip-check server-execution-safe-mode
	МодульУтилитМодели = Вычислить("МодельЗапросаУтилиты");
	Построитель = МодульУтилитМодели.СоздатьПостроительМодели(Пакет);

	Построитель = Построитель.ДобавитьИсточник("&Данные", "Данные");
	Модель = Построитель.ПолучитьМодель();
	Запрос = Модель.Элементы[0];
	Оператор = Запрос.Операторы[0];
	ПроверитьНакопленноеСостояние(Построитель, 1, 0, 0, 0, Ложь);
	ЮТест.ОжидаетЧто(ВсеИсточникиОператора(Оператор).Количество())
		.Равно(1, "Источник должен быть добавлен");
	Источник = Оператор.Источники[0].Источник;
	ЮТест.ОжидаетЧто(Источник.Тип).Равно("ИсточникДанныхТаблицаЗначений");
	ЮТест.ОжидаетЧто(Источник.ИмяТаблицы).Равно("&Данные");
	ЮТест.ОжидаетЧто(Источник.Псевдоним).Равно("Данные");

	Построитель = Построитель.ДобавитьОтбор("1 = 1");
	Оператор = Построитель.ПолучитьМодель().Элементы[0].Операторы[0];
	ПроверитьНакопленноеСостояние(Построитель, 1, 1, 0, 0, Ложь);
	ЮТест.ОжидаетЧто(Оператор.Отбор.Количество()).Равно(1, "Отбор должен быть добавлен");
	ЮТест.ОжидаетЧто(Оператор.Отбор[0].Значение.Тип).Равно("БинарнаяОперация");

	Построитель = Построитель.ДобавитьУпорядочивание("1");
	Запрос = Построитель.ПолучитьМодель().Элементы[0];
	ПроверитьНакопленноеСостояние(Построитель, 1, 1, 1, 0, Ложь);
	ЮТест.ОжидаетЧто(Запрос.Порядок.Количество()).Равно(1, "Сортировка должна быть добавлена");
	ЮТест.ОжидаетЧто(Запрос.Порядок[0].Направление).Равно("Возр");
	ЮТест.ОжидаетЧто(Запрос.Порядок[0].Выражение.Значение.Тип).Равно("СсылкаНаКолонкуЗапроса");

	Построитель = Построитель.ДобавитьКонтрольнуюТочкуИтогов("1");
	Запрос = Построитель.ПолучитьМодель().Элементы[0];
	ПроверитьНакопленноеСостояние(Построитель, 1, 1, 1, 1, Ложь);
	ЮТест.ОжидаетЧто(Запрос.КонтрольныеТочкиИтогов.Количество()).Равно(1, "Контрольная точка должна быть добавлена");
	ЮТест.ОжидаетЧто(Запрос.КонтрольныеТочкиИтогов[0].Выражение.Значение.Тип).Равно("СсылкаНаКолонкуЗапроса");

	Построитель = Построитель.УстановитьПолучениеОбщихИтогов(Истина);
	Запрос = Построитель.ПолучитьМодель().Элементы[0];
	ПроверитьНакопленноеСостояние(Построитель, 1, 1, 1, 1, Истина);
	ЮТест.ОжидаетЧто(Запрос.ОбщиеИтоги).Равно(Истина, "Общие итоги должны быть включены");

КонецПроцедуры

// Подтверждает семантическую эквивалентность модели до и после генерации текста.
Процедура ТекстПакетаПослеПовторногоРазбораСохраняетСемантику() Экспорт

	ИсходныйТекст =
		"ВЫБРАТЬ ФизическиеЛица.Ссылка КАК ФизическоеЛицо "
		+ "ИЗ Справочник.ФизическиеЛица КАК ФизическиеЛица "
		+ "ГДЕ ФизическиеЛица.Ссылка = ФизическиеЛица.Ссылка "
		+ "ОБЪЕДИНИТЬ ВСЕ ВЫБРАТЬ ФизическиеЛица.Ссылка КАК ФизическоеЛицо "
		+ "ИЗ Справочник.ФизическиеЛица КАК ФизическиеЛица "
		+ "УПОРЯДОЧИТЬ ПО ФизическоеЛицо УБЫВ "
		+ "ИТОГИ КОЛИЧЕСТВО(ФизическоеЛицо) КАК Количество ПО ОБЩИЕ, ФизическоеЛицо; "
		+ "ВЫБРАТЬ 2 КАК Второй";

	ИсходнаяМодель = РазобратьИОбработатьЗапрос(ИсходныйТекст);
	//@skip-check server-execution-safe-mode
	МодульГенерации = Вычислить("ГенерацияТекстовЗапросов");
	ИсходнаяПроекция = СтрокаПроекции(ИсходнаяМодель);

	СгенерированныйТекст = МодульГенерации.ТекстПакетаЗапросов(ИсходнаяМодель);
	ПовторнаяМодель = РазобратьИОбработатьЗапрос(СгенерированныйТекст);
	ПовторнаяПроекция = СтрокаПроекции(ПовторнаяМодель);

	ЮТест.ОжидаетЧто(ПовторнаяПроекция)
		.Равно(ИсходнаяПроекция,
			"Генерация и повторный разбор должны сохранять предметную проекцию");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РазобратьИОбработатьЗапрос(ИсходныйТекст)

	//@skip-check server-execution-safe-mode
	МодульТестовыхФабрик = Вычислить("КОНС_ТестовыеФабрикиСлужебный");
	Парсер = МодульТестовыхФабрик.СоздатьПарсер();
	Пакет = Парсер.Разобрать(ИсходныйТекст);
	//@skip-check server-execution-safe-mode
	МодульОбработкиМодели = Вычислить("ОбработкаМоделиЗапроса");
	МодульОбработкиМодели.ОбработатьМодельЗапроса(Пакет);
	Возврат Пакет;

КонецФункции

Процедура ПроверитьНакопленноеСостояние(Построитель, Источники, Отборы, Порядок, ТочкиИтогов, ОбщиеИтоги)

	Запрос = Построитель.ПолучитьМодель().Элементы[0];
	Оператор = Запрос.Операторы[0];
	ЮТест.ОжидаетЧто(ВсеИсточникиОператора(Оператор).Количество()).Равно(Источники,
		"Предыдущие источники должны сохраняться после fluent-операции");
	ЮТест.ОжидаетЧто(Оператор.Отбор.Количество()).Равно(Отборы,
		"Предыдущие отборы должны сохраняться после fluent-операции");
	ЮТест.ОжидаетЧто(Запрос.Порядок.Количество()).Равно(Порядок,
		"Предыдущая сортировка должна сохраняться после fluent-операции");
	ЮТест.ОжидаетЧто(Запрос.КонтрольныеТочкиИтогов.Количество()).Равно(ТочкиИтогов,
		"Предыдущие точки итогов должны сохраняться после fluent-операции");
	ЮТест.ОжидаетЧто(Запрос.ОбщиеИтоги).Равно(ОбщиеИтоги,
		"Флаг общих итогов должен сохранять ожидаемое состояние");

КонецПроцедуры

Функция СтрокаПроекции(Пакет)

	Проекция = ПроекцияПакета(Пакет);
	Возврат ЮТОбщий.СтрокаJSON(Проекция, Ложь, Истина);

КонецФункции

Функция ПроекцияПакета(Пакет)

	Результат = Новый Структура;
	ЭлементыПакета = Новый Массив;
	Результат.Вставить("Элементы", ЭлементыПакета);
	Для Каждого ЭлементПакета Из Пакет.Элементы Цикл
		Если ЭлементПакета.Тип = "ЗапросВыбора" Тогда
			ЭлементыПакета.Добавить(ПроекцияЗапроса(ЭлементПакета));
		Иначе
			ЭлементыПакета.Добавить(Новый Структура("Тип", ЭлементПакета.Тип));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПроекцияЗапроса(Запрос)

	Результат = Новый Структура("Тип,ОбщиеИтоги", Запрос.Тип, Запрос.ОбщиеИтоги);
	Операторы = Новый Массив;
	Результат.Вставить("Операторы", Операторы);
	Для Каждого Оператор Из Запрос.Операторы Цикл
		Операторы.Добавить(ПроекцияОператора(Оператор, Запрос));
	КонецЦикла;
	Результат.Вставить("Порядок", ПроекцияПорядка(Запрос));
	Результат.Вставить("ТочкиИтогов", ПроекцияТочекИтогов(Запрос));
	Возврат Результат;

КонецФункции

Функция ПроекцияОператора(Оператор, Запрос)

	Результат = Новый Структура("ТипОбъединения", Оператор.ТипОбъединения);
	Источники = Новый Массив;
	Для Каждого УзелИсточника Из ВсеИсточникиОператора(Оператор) Цикл
		Источник = УзелИсточника.Источник;
		Источники.Добавить(Новый Структура("Тип,ИмяТаблицы,Псевдоним",
			Источник.Тип, Источник.ИмяТаблицы, Источник.Псевдоним));
	КонецЦикла;
	Результат.Вставить("Источники", Источники);

	Поля = Новый Массив;
	Для Каждого Поле Из Оператор.ВыбираемыеПоля Цикл
		Поля.Добавить(Новый Структура("Выражение,Псевдоним",
			ПроекцияВыражения(Поле.Выражение, Запрос), Поле.Псевдоним));
	КонецЦикла;
	Результат.Вставить("Поля", Поля);

	Отборы = Новый Массив;
	Для Каждого Отбор Из Оператор.Отбор Цикл
		Отборы.Добавить(ПроекцияВыражения(Отбор, Запрос));
	КонецЦикла;
	Результат.Вставить("Отборы", Отборы);
	Возврат Результат;

КонецФункции

Функция ВсеИсточникиОператора(Оператор)
	МодульУтилитМодели = Вычислить("МодельЗапросаУтилиты");
	Возврат МодульУтилитМодели.ВсеИсточникиОператора(Оператор);
КонецФункции

Функция ПроекцияПорядка(Запрос)

	Результат = Новый Массив;
	Для Каждого ЭлементПорядка Из Запрос.Порядок Цикл
		Результат.Добавить(Новый Структура("Выражение,Направление,Иерархия",
			ПроекцияВыражения(ЭлементПорядка.Выражение, Запрос),
			ЭлементПорядка.Направление, ЭлементПорядка.Иерархия));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПроекцияТочекИтогов(Запрос)

	Результат = Новый Массив;
	Для Каждого Точка Из Запрос.КонтрольныеТочкиИтогов Цикл
		Результат.Добавить(Новый Структура("Выражение,Тип,ИмяКолонки",
			ПроекцияВыражения(Точка.Выражение, Запрос),
			Точка.ТипКонтрольнойТочки, Точка.ИмяКолонки));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПроекцияВыражения(Выражение, Запрос)

	Если Выражение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Выражение.Тип = "ВыражениеМоделиЗапроса" Тогда
		Возврат Новый Структура("Тип,Значение", Выражение.Тип,
			ПроекцияВыражения(Выражение.Значение, Запрос));
	ИначеЕсли Выражение.Тип = "БинарнаяОперация" Тогда
		Результат = Новый Структура("Тип,Операция,ЛеваяЧасть", Выражение.Тип,
			Выражение.Операция, ПроекцияВыражения(Выражение.ЛеваяЧасть, Запрос));
		Результат.Вставить("ПраваяЧасть", ПроекцияВыражения(Выражение.ПраваяЧасть, Запрос));
		Возврат Результат;
	ИначеЕсли Выражение.Тип = "Разыменование" Тогда
		Элементы = Новый Массив;
		Для Каждого Элемент Из Выражение.Элементы Цикл
			Если ТипЗнч(Элемент) = Тип("Строка") Тогда
				Элементы.Добавить(Элемент);
			Иначе
				Элементы.Добавить(ПроекцияВыражения(Элемент, Запрос));
			КонецЕсли;
		КонецЦикла;
		Возврат Новый Структура("Тип,Элементы", Выражение.Тип, Элементы);
	ИначеЕсли Выражение.Тип = "ПолеИсточника" Тогда
		Возврат Новый Структура("Тип,ИмяПоля", Выражение.Тип, Выражение.ИмяПоля);
	ИначеЕсли Выражение.Тип = "СсылкаНаКолонкуЗапроса" Тогда
		Возврат Новый Структура("Тип,ИмяКолонки", Выражение.Тип,
			ИмяКолонкиПоИдентификатору(Запрос, Выражение.Идентификатор));
	ИначеЕсли Выражение.Тип = "Константа" Тогда
		Возврат Новый Структура("Тип,Значение", Выражение.Тип, Выражение.Значение);
	ИначеЕсли Выражение.Тип = "АгрегатнаяФункцияКоличество" Тогда
		Возврат Новый Структура("Тип,Различные,Аргумент", Выражение.Тип, Выражение.Различные,
			ПроекцияВыражения(Выражение.Аргумент, Запрос));
	КонецЕсли;

	Возврат Новый Структура("Тип", Выражение.Тип);

КонецФункции

Функция ИмяКолонкиПоИдентификатору(Запрос, Идентификатор)

	Для Каждого Колонка Из Запрос.Колонки Цикл
		Если Колонка.Идентификатор = Идентификатор Тогда
			Возврат Колонка.Имя;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "Не найдена колонка для семантической проекции";

КонецФункции

#КонецОбласти
