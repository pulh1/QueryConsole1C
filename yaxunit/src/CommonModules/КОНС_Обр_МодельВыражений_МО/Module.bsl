	МодульОбхода.ОбойтиДерево(НедопустимоеУсловие, Посетитель);
	РезультатРазделения = Посетитель.ВыделитьИМодифицироватьОтбор(НедопустимоеУсловие);
	ЮТест.ОжидаетЧто(РезультатРазделения.ДелегируемыеУсловия.Количество()).Равно(0);
	ЮТест.ОжидаетЧто(РезультатРазделения.НовоеУсловие.Операция).Равно("ИЛИ");

КонецПроцедуры

// Проверяет контракт ПосетительСКДПреобразуетРазыменованиеИТип.
Процедура ПосетительСКДПреобразуетРазыменованиеИТип() Экспорт

	//@skip-check server-execution-safe-mode

	МодульЭлементовМодели = Вычислить("ЭлементыМоделиЗапроса");
	//@skip-check server-execution-safe-mode
	МодульУтилитМодели = Вычислить("МодельЗапросаУтилиты");
	//@skip-check server-execution-safe-mode
	МодульОбхода = Вычислить("ОбходМоделиЯзыкаВыражений");

	Оператор = МодульЭлементовМодели.НовыйОператорЗапроса();
	Источник = МодульЭлементовМодели.НовыйИсточник();
	Таблица = МодульЭлементовМодели.НовыйИсточникДанныхТаблица();
	Таблица.ИмяТаблицы = "Справочник.Организации";
	Таблица.Псевдоним = "Организации";
	Источник.Источник = Таблица;
	Оператор.Источники.Элементы.Добавить(Источник);

	ПолеСсылка = МодульЭлементовМодели.НовыйПолеИсточника();
	ПолеСсылка.ИдентификаторИсточника = Источник.ИдентификаторИсточника;
	ПолеСсылка.ИмяПоля = "Ссылка";
	Разыменование = МодульЭлементовМодели.НовыйРазыменование();
	Разыменование.Элементы.Добавить(ПолеСсылка);
	Разыменование.Элементы.Добавить("Наименование");

	Контекст = МодульУтилитМодели.КонтекстОбработкиВыражения(Оператор, 0);
	//@skip-check bsl-legacy-check-static-feature-access-for-unknown-left-part
	Посетитель = Обработки.ОбработчикРазыменованийДляСКДПосетитель.СоздатьОбработчик(Контекст);
	МодульОбхода.ОбойтиДерево(Разыменование, Посетитель);

	ЮТест.ОжидаетЧто(Разыменование.Элементы[0].Тип).Равно("ПриведениеТипа");
	ЮТест.ОжидаетЧто(Разыменование.Элементы[0].Выражение.Тип).Равно("ПолеИсточника");
	ЮТест.ОжидаетЧто(Разыменование.Элементы[0].ОписаниеТипа.Группа).Равно("Справочник");
	ЮТест.ОжидаетЧто(Разыменование.Элементы[0].ОписаниеТипа.Таблица).Равно("Организации");
	ЮТест.ОжидаетЧто(Разыменование.Элементы[1]).Равно("Наименование");

КонецПроцедуры

