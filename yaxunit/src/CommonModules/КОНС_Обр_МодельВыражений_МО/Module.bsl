Функция УсловиеПоПолю(МодульЭлементовМодели, ИдентификаторИсточника, ИмяПоля)

	Поле = МодульЭлементовМодели.НовыйПолеИсточника();
	Поле.ИдентификаторИсточника = ИдентификаторИсточника;
	Поле.ИмяПоля = ИмяПоля;
	Разыменование = МодульЭлементовМодели.НовыйРазыменование();
	Разыменование.Элементы.Добавить(Поле);
	Константа = МодульЭлементовМодели.НовыйКонстанта();
	Константа.Значение = 1;
	Возврат БинарноеУсловие(МодульЭлементовМодели, "=", Разыменование, Константа);

КонецФункции

Функция БинарноеУсловие(МодульЭлементовМодели, Операция, ЛеваяЧасть, ПраваяЧасть)

	Результат = МодульЭлементовМодели.НовыйБинарнаяОперация();
	Результат.Операция = Операция;
	Результат.ЛеваяЧасть = ЛеваяЧасть;
	Результат.ПраваяЧасть = ПраваяЧасть;
	Возврат Результат;

КонецФункции

Процедура ПроверитьСемействоФабрик(Семейство, ОжидаемоеКоличество)

	Инвентарь = ИнвентарьФабрик();
	ЮТест.ОжидаетЧто(Инвентарь.Количество()).Равно(91, "Инвентарь должен содержать все 91 factory export");

	Имена = Новый Соответствие;
	КоличествоВСемействе = 0;
	Для Каждого ОписаниеФабрики Из Инвентарь Цикл
		ЮТест.ОжидаетЧто(Имена.Получить(ОписаниеФабрики.Имя)).Равно(Неопределено,
			"Имя фабрики должно встречаться в инвентаре ровно один раз: " + ОписаниеФабрики.Имя);
		Имена.Вставить(ОписаниеФабрики.Имя, Истина);
		Если ОписаниеФабрики.Семейство = Семейство Тогда
			КоличествоВСемействе = КоличествоВСемействе + 1;
			ПроверитьФабрику(ОписаниеФабрики);
		КонецЕсли;
	КонецЦикла;

	ЮТест.ОжидаетЧто(КоличествоВСемействе).Равно(ОжидаемоеКоличество,
		"Каждая фабрика должна принадлежать ровно одному утвержденному семейству");

КонецПроцедуры

Процедура ПроверитьФабрику(ОписаниеФабрики)

	Результат = ОписаниеФабрики.Результат;
	Если ОписаниеФабрики.Вид = "Структура" Тогда
		ЮТест.ОжидаетЧто(ТипЗнч(Результат)).Равно(Тип("Структура"), ОписаниеФабрики.Имя);
		ФактическийТип = Неопределено;
		ЮТест.ОжидаетЧто(Результат.Свойство("Тип", ФактическийТип)).ЭтоИстина(ОписаниеФабрики.Имя);
		ЮТест.ОжидаетЧто(ФактическийТип).Равно(ОписаниеФабрики.ОжидаемыйТип, ОписаниеФабрики.Имя);
		ПроверитьСкалярныеСвойства(ОписаниеФабрики);
		ПроверитьПустыеСвойстваКоллекций(ОписаниеФабрики, "Массивы", Тип("Массив"));
		ПроверитьПустыеСвойстваКоллекций(ОписаниеФабрики, "Соответствия", Тип("Соответствие"));
	ИначеЕсли ОписаниеФабрики.Вид = "Массив" Тогда
		ЮТест.ОжидаетЧто(ТипЗнч(Результат)).Равно(Тип("Массив"), ОписаниеФабрики.Имя);
		ЮТест.ОжидаетЧто(Результат.Количество()).Равно(0, ОписаниеФабрики.Имя);
	Иначе
		ПроверитьЗначениеПоОписанию(Результат, ОписаниеФабрики.ОжидаемоеЗначение, ОписаниеФабрики.Имя);
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьСкалярныеСвойства(ОписаниеФабрики)

	Если ПустаяСтрока(ОписаниеФабрики.Скалярные) Тогда
		Возврат;
	КонецЕсли;

	Для Каждого ОписаниеСвойства Из СтрРазделить(ОписаниеФабрики.Скалярные, ";", Ложь) Цикл
		Части = СтрРазделить(ОписаниеСвойства, "=", Ложь);
		ФактическоеЗначение = Неопределено;
		ЮТест.ОжидаетЧто(ОписаниеФабрики.Результат.Свойство(Части[0], ФактическоеЗначение)).ЭтоИстина(
			ОписаниеФабрики.Имя + "." + Части[0]);
		ПроверитьЗначениеПоОписанию(ФактическоеЗначение, Части[1], ОписаниеФабрики.Имя + "." + Части[0]);
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьПустыеСвойстваКоллекций(ОписаниеФабрики, ИмяПоляОписания, ОжидаемыйТип)

	ИменаСвойств = ОписаниеФабрики[ИмяПоляОписания];
	Если ПустаяСтрока(ИменаСвойств) Тогда
		Возврат;
	КонецЕсли;

	Для Каждого ИмяСвойства Из СтрРазделить(ИменаСвойств, ",", Ложь) Цикл
		ЗначениеСвойства = Неопределено;
		ЮТест.ОжидаетЧто(ОписаниеФабрики.Результат.Свойство(ИмяСвойства, ЗначениеСвойства)).ЭтоИстина(
			ОписаниеФабрики.Имя + "." + ИмяСвойства);
		ЮТест.ОжидаетЧто(ТипЗнч(ЗначениеСвойства)).Равно(ОжидаемыйТип, ОписаниеФабрики.Имя + "." + ИмяСвойства);
		ЮТест.ОжидаетЧто(ЗначениеСвойства.Количество()).Равно(0, ОписаниеФабрики.Имя + "." + ИмяСвойства);
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьЗначениеПоОписанию(ФактическоеЗначение, ОписаниеЗначения, ОписаниеПроверки)

	Если ОписаниеЗначения = "Неопределено" Тогда
		ОжидаемоеЗначение = Неопределено;
	ИначеЕсли ОписаниеЗначения = "Истина" Тогда
		ОжидаемоеЗначение = Истина;
	ИначеЕсли ОписаниеЗначения = "Ложь" Тогда
		ОжидаемоеЗначение = Ложь;
	ИначеЕсли ОписаниеЗначения = "УникальныйИдентификатор" Тогда
		ЮТест.ОжидаетЧто(ТипЗнч(ФактическоеЗначение)).Равно(Тип("УникальныйИдентификатор"), ОписаниеПроверки);
		Возврат;
	ИначеЕсли СтрНачинаетсяС(ОписаниеЗначения, "Строка:") Тогда
		ОжидаемоеЗначение = Сред(ОписаниеЗначения, 8);
	ИначеЕсли СтрНачинаетсяС(ОписаниеЗначения, "Тип:") Тогда
		ЮТест.ОжидаетЧто(ТипЗнч(ФактическоеЗначение)).Равно(Тип("Структура"), ОписаниеПроверки);
		ЮТест.ОжидаетЧто(ФактическоеЗначение.Тип).Равно(Сред(ОписаниеЗначения, 5), ОписаниеПроверки);
		Возврат;
	Иначе
		ОжидаемоеЗначение = Число(ОписаниеЗначения);
	КонецЕсли;

	ЮТест.ОжидаетЧто(ФактическоеЗначение).Равно(ОжидаемоеЗначение, ОписаниеПроверки);

КонецПроцедуры

Функция ИнвентарьФабрик()

	Результат = Новый Массив;
	ДобавитьФабрикиЗапроса(Результат);
	ДобавитьФабрикиВыражений(Результат);
	ДобавитьОстальныеФабрики(Результат);
	Возврат Результат;

КонецФункции

Процедура ДобавитьФабрику(Инвентарь, Имя, Семейство, РезультатФабрики, Контракт)

	Части = СтрРазделить(Контракт, "|", Истина);
	//@skip-check structure-consructor-too-many-keys
	Инвентарь.Добавить(Новый Структура(
		"Имя, Семейство, Результат, ОжидаемыйТип, Скалярные, Массивы, Соответствия, Вид, ОжидаемоеЗначение",
		Имя, Семейство, РезультатФабрики, Части[0], Части[1], Части[2], Части[3], Части[4], Части[5]));

КонецПроцедуры

