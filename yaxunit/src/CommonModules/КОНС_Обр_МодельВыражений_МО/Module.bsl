	//@skip-check server-execution-safe-mode

	МодульЭлементовМодели = Вычислить("ЭлементыМоделиЗапроса");
	//@skip-check server-execution-safe-mode
	МодульОбхода = Вычислить("ОбходМоделиЯзыкаВыражений");
	//@skip-check server-execution-safe-mode
	ТестовыйПосетитель = Вычислить("КОНС_Обр_МодельВыражений_МО");
	ЗаписьКолбэковТеста = Новый Массив;
	ЮТест.КонтекстТеста().Вставить("ЗаписьКолбэковМодели", ЗаписьКолбэковТеста);

	Узлы = Новый Массив;
	Узлы.Добавить(МодульЭлементовМодели.НовыйБинарнаяОперация());
	Узлы.Добавить(МодульЭлементовМодели.НовыйОператорМежду());
	Узлы.Добавить(МодульЭлементовМодели.НовыйОператорПроверкиТипа());
	Узлы.Добавить(МодульЭлементовМодели.НовыйОператорПроверкиНаNULL());
	Узлы.Добавить(МодульЭлементовМодели.НовыйСписокВыражений());

	ОператорВ = МодульЭлементовМодели.НовыйОператорВ();
	ОператорВ.Операнд = МодульЭлементовМодели.НовыйКонстанта();
	ОператорВ.Список = МодульЭлементовМодели.НовыйЗапросВыбора();
	Узлы.Добавить(ОператорВ);

	Узлы.Добавить(МодульЭлементовМодели.НовыйЛогическоеОтрицание());
	Узлы.Добавить(МодульЭлементовМодели.НовыйУнарнаяОперация());
	Узлы.Добавить(МодульЭлементовМодели.НовыйОператорПодобно());
	Узлы.Добавить(МодульЭлементовМодели.НовыйРазыменование());
	Узлы.Добавить(МодульЭлементовМодели.НовыйПриведениеТипа());
	Узлы.Добавить(МодульЭлементовМодели.НовыйВыбор());
	Узлы.Добавить(МодульЭлементовМодели.НовыйПараметрЗапроса());
	Узлы.Добавить(МодульЭлементовМодели.НовыйАгрегатнаяФункция());
	Узлы.Добавить(МодульЭлементовМодели.НовыйАгрегатнаяФункцияКоличество());
	Узлы.Добавить(МодульЭлементовМодели.НовыйФункцияЧастьПериодаЧислом("Год", Неопределено));
	Узлы.Добавить(МодульЭлементовМодели.НовыйФункцияНачалоПериода());
	Узлы.Добавить(МодульЭлементовМодели.НовыйФункцияКонецПериода());
	Узлы.Добавить(МодульЭлементовМодели.НовыйФункцияДобавитьКДате());
	Узлы.Добавить(МодульЭлементовМодели.НовыйФункцияДатаВремя());
	Узлы.Добавить(МодульЭлементовМодели.НовыйФункцияIsNull());
	Узлы.Добавить(МодульЭлементовМодели.НовыйФункцияПредставление());
	Узлы.Добавить(МодульЭлементовМодели.НовыйФункцияПредставлениеСсылки());
	Узлы.Добавить(МодульЭлементовМодели.НовыйФункцияТипЗначения());
	Узлы.Добавить(МодульЭлементовМодели.НовыйФункцияЗначение());
	Узлы.Добавить(МодульЭлементовМодели.НовыйФункцияТип());
	Узлы.Добавить(МодульЭлементовМодели.НовыйФункцияРазностьДат());
	Узлы.Добавить(МодульЭлементовМодели.НовыйВыражениеВсеПоля());

	Для Каждого Узел Из Узлы Цикл
		МодульОбхода.ОбойтиДерево(Узел, ТестовыйПосетитель);
	КонецЦикла;

	ОжидаемыеКолбэки = ОжидаемыйПорядокКолбэков();
	ЮТест.ОжидаетЧто(ЗаписьКолбэковТеста.Количество()).Равно(59,
		"Диспетчер должен вызвать каждый callback шаблона ровно один раз");
	Для Индекс = 0 По ОжидаемыеКолбэки.ВГраница() Цикл
		ЮТест.ОжидаетЧто(ЗаписьКолбэковТеста[Индекс]).Равно(ОжидаемыеКолбэки[Индекс],
			"Нарушен порядок callback на позиции " + Строка(Индекс));
	КонецЦикла;

КонецПроцедуры

