// Проверяет контракт ПосетительОтбораРазделяетДелегируемыеСмешанныеИНедопустимыеУсловия.
Процедура ПосетительОтбораРазделяетДелегируемыеСмешанныеИНедопустимыеУсловия() Экспорт

	//@skip-check server-execution-safe-mode

	МодульЭлементовМодели = Вычислить("ЭлементыМоделиЗапроса");
	//@skip-check server-execution-safe-mode
	МодульОписанийПредставлений = Вычислить("ЭлементыМоделиОписанияПредставлений");
	//@skip-check server-execution-safe-mode
	МодульОбхода = Вычислить("ОбходМоделиЯзыкаВыражений");
	ОписаниеОтбора = МодульОписанийПредставлений.НовыйОписаниеОтбора();
	ОписаниеОтбора.ДоступныеПоля.Добавить("Поле");
	ИдентификаторПредставления = Новый УникальныйИдентификатор;
	ИдентификаторДругогоИсточника = Новый УникальныйИдентификатор;

	ДелегируемоеУсловие = УсловиеПоПолю(МодульЭлементовМодели, ИдентификаторПредставления, "Поле");
	//@skip-check bsl-legacy-check-static-feature-access-for-unknown-left-part
	Посетитель = Обработки.ПроверкаПрименимостиОтбораПосетитель.СоздатьДелегаторОтбора(
		ИдентификаторПредставления, "ТестовоеПредставление", ОписаниеОтбора);
	МодульОбхода.ОбойтиДерево(ДелегируемоеУсловие, Посетитель);
	ЮТест.ОжидаетЧто(Посетитель.МожноДелегироватьВесьОтбор()).ЭтоИстина();

	НеделегируемоеУсловие = УсловиеПоПолю(МодульЭлементовМодели, ИдентификаторДругогоИсточника, "Поле");
	СмешанноеУсловие = БинарноеУсловие(МодульЭлементовМодели, "И", ДелегируемоеУсловие, НеделегируемоеУсловие);
	//@skip-check bsl-legacy-check-static-feature-access-for-unknown-left-part
	Посетитель = Обработки.ПроверкаПрименимостиОтбораПосетитель.СоздатьДелегаторОтбора(
		ИдентификаторПредставления, "ТестовоеПредставление", ОписаниеОтбора);
	МодульОбхода.ОбойтиДерево(СмешанноеУсловие, Посетитель);
	РезультатРазделения = Посетитель.ВыделитьИМодифицироватьОтбор(СмешанноеУсловие);
	ЮТест.ОжидаетЧто(РезультатРазделения.ДелегируемыеУсловия.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(РезультатРазделения.НовоеУсловие.Операция).Равно("=");
	ЮТест.ОжидаетЧто(
		РезультатРазделения.НовоеУсловие.ЛеваяЧасть.Элементы[0].ИдентификаторИсточника)
		.Равно(ИдентификаторДругогоИсточника);

	НедопустимоеУсловие = БинарноеУсловие(МодульЭлементовМодели, "ИЛИ",
		ДелегируемоеУсловие, НеделегируемоеУсловие);
	//@skip-check bsl-legacy-check-static-feature-access-for-unknown-left-part
	Посетитель = Обработки.ПроверкаПрименимостиОтбораПосетитель.СоздатьДелегаторОтбора(
