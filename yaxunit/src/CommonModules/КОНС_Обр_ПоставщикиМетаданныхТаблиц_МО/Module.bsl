// Проверяет, что semantic context не владеет платформенным деревом доступных таблиц.
Процедура КорневойКонтекстНеСодержитДоступныеТаблицыИБ() Экспорт

	//@skip-check server-execution-safe-mode
	МодульОбработки = Вычислить("ОбработкаМоделиЗапроса");
	Контекст = МодульОбработки.КонтекстОбработкиЗапроса();

	ЮТест.ОжидаетЧто(Контекст.Свойство("ДоступныеТаблицыИБ")).ЭтоЛожь();

