#Область ПрограммныйИнтерфейс

// Регистрирует серверные сценарии контракта поставщиков метаданных таблиц.
Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты.ДобавитьТестовыйНабор("Поставщики метаданных таблиц")
		.Тег("ПоставщикиМетаданныхТаблиц")
		.ДобавитьСерверныйТест("ОписаниеТаблицыСодержитНейтральныеПоля")
		.ДобавитьСерверныйТест("ОписаниеПоляСодержитНейтральныеПоля")
		.ДобавитьСерверныйТест("ОписаниеПараметраСодержитНейтральныеПоля")
		.ДобавитьСерверныйТест("ФабрикиСоздаютНезависимыеМассивы")
		.ДобавитьСерверныйТест("НайтиПолеНеУчитываетРегистр")
		.ДобавитьСерверныйТест("ВидыПоляВозвращаютСтабильныеЗначения")
		.ДобавитьСерверныйТест("РеестрДелегируетОписаниеБезПредварительнойПроверки")
		.ДобавитьСерверныйТест("РеестрДелегируетПроверкуСуществования")
		.ДобавитьСерверныйТест("РеестрВозвращаетНеопределеноДляНеизвестногоСегмента")
		.ДобавитьСерверныйТест("РеестрОтклоняетКоллизиюСегментов")
		.ДобавитьСерверныйТест("ПустоеОписаниеРеестраНеИспользуетLegacyИсполняемыйПоставщик")
		.ДобавитьСерверныйТест("СтандартныйПоставщикИнициализируетсяНаРеальныхГруппахТаблиц")
		.ДобавитьСерверныйТест("СтандартныйПоставщикОписываетВложеннуюТаблицу")
		.ДобавитьСерверныйТест("СтандартныйПоставщикОписываетПараметрыВиртуальнойТаблицы")
		.ДобавитьСерверныйТест("СтандартныйПоставщикВозвращаетНеопределеноДляНеизвестнойТаблицы")
		.ДобавитьСерверныйТест("КэшСтандартногоПоставщикаНеУчитываетРегистр")
		.ДобавитьСерверныйТест("ЭкземплярыСтандартногоПоставщикаНеРазделяютКэш")
		.ДобавитьСерверныйТест("РеестрПоУмолчаниюСодержитСтандартныйПоставщик")
		.ДобавитьСерверныйТест("ИсполняемыйПоставщикОписываетРеальноеПредставление")
		.ДобавитьСерверныйТест("РеестрПоУмолчаниюСодержитИсполняемыйПоставщик")
		.ДобавитьСерверныйТест("ВложенныйКонтекстРазделяетРеестрИОписанияВременныхТаблиц")
		.ДобавитьСерверныйТест("КонтекстПараметровВиртуальнойТаблицыРазделяетРеестрИОписанияВременныхТаблиц")
		.ДобавитьСерверныйТест("КорневыеКонтекстыИзолируютРеестрыИОписанияВременныхТаблиц")
		.ДобавитьСерверныйТест("КонтекстОтбораИсполняемогоПредставленияРазделяетРеестр")
		.ДобавитьСерверныйТест("КонтекстыМоделиПереиспользуютЯвноПереданныйРеестрДляJoin");

КонецПроцедуры

// Проверяет точный состав нейтрального описания таблицы.
Процедура ОписаниеТаблицыСодержитНейтральныеПоля() Экспорт

	//@skip-check server-execution-safe-mode
	Описание = Вычислить("МетаданныеТаблицЗапроса.НовыйОписаниеТаблицы(
		|""Кадры.Сотрудники"", ""Кадры"", ""Служебный"", ""Сотрудники"")");

	ЮТест.ОжидаетЧто(Описание.Количество()).Равно(7);
	ЮТест.ОжидаетЧто(Описание.ИмяТаблицы).Равно("Кадры.Сотрудники");
	ЮТест.ОжидаетЧто(Описание.ИмяПоставщика).Равно("Кадры");
	ЮТест.ОжидаетЧто(Описание.ВидИсточника).Равно("Служебный");
	ЮТест.ОжидаетЧто(Описание.Представление).Равно("Сотрудники");
	ЮТест.ОжидаетЧто(Описание.Поля.Количество()).Равно(0);
	ЮТест.ОжидаетЧто(Описание.Параметры.Количество()).Равно(0);
	ЮТест.ОжидаетЧто(Описание.ДанныеПоставщика).Равно(Неопределено);

КонецПроцедуры

// Проверяет точный состав нейтрального описания поля.
Процедура ОписаниеПоляСодержитНейтральныеПоля() Экспорт

	ТипЗначения = "Строка";
	//@skip-check server-execution-safe-mode
	Описание = Вычислить("МетаданныеТаблицЗапроса.НовыйОписаниеПоля(
		|""Код"", ""Код сотрудника"", """", ТипЗначения, ""Ключ"")");

	ЮТест.ОжидаетЧто(Описание.Количество()).Равно(7);
	ЮТест.ОжидаетЧто(Описание.Имя).Равно("Код");
	ЮТест.ОжидаетЧто(Описание.Представление).Равно("Код сотрудника");
	ЮТест.ОжидаетЧто(Описание.ВидПоля).Равно("ОбычноеПоле");
	ЮТест.ОжидаетЧто(Описание.ТипЗначения).Равно(ТипЗначения);
	ЮТест.ОжидаетЧто(Описание.Роль).Равно("Ключ");
	ЮТест.ОжидаетЧто(Описание.Поля.Количество()).Равно(0);
	ЮТест.ОжидаетЧто(Описание.ДанныеПоставщика).Равно(Неопределено);

КонецПроцедуры

// Проверяет точный состав нейтрального описания параметра.
Процедура ОписаниеПараметраСодержитНейтральныеПоля() Экспорт

	ТипЗначения = "Дата";
	//@skip-check server-execution-safe-mode
	Описание = Вычислить("МетаданныеТаблицЗапроса.НовыйОписаниеПараметра(
		|""Период"", ""МоментВремени"", ТипЗначения, Истина)");

	ЮТест.ОжидаетЧто(Описание.Количество()).Равно(7);
	ЮТест.ОжидаетЧто(Описание.Имя).Равно("Период");
	ЮТест.ОжидаетЧто(Описание.ВидПараметра).Равно("МоментВремени");
	ЮТест.ОжидаетЧто(Описание.ТипЗначения).Равно(ТипЗначения);
	ЮТест.ОжидаетЧто(Описание.Обязательный).ЭтоИстина();
	ЮТест.ОжидаетЧто(Описание.Варианты.Количество()).Равно(0);
	ЮТест.ОжидаетЧто(Описание.Поля.Количество()).Равно(0);
	ЮТест.ОжидаетЧто(Описание.ДанныеПоставщика).Равно(Неопределено);

КонецПроцедуры

// Проверяет, что фабрики не разделяют изменяемые массивы между описаниями.
Процедура ФабрикиСоздаютНезависимыеМассивы() Экспорт

	//@skip-check server-execution-safe-mode
	ПерваяТаблица = Вычислить("МетаданныеТаблицЗапроса.НовыйОписаниеТаблицы()");
	//@skip-check server-execution-safe-mode
	ВтораяТаблица = Вычислить("МетаданныеТаблицЗапроса.НовыйОписаниеТаблицы()");
	ПерваяТаблица.Поля.Добавить("Поле");
	ПерваяТаблица.Параметры.Добавить("Параметр");

	//@skip-check server-execution-safe-mode
	ПервоеПоле = Вычислить("МетаданныеТаблицЗапроса.НовыйОписаниеПоля()");
	//@skip-check server-execution-safe-mode
	ВтороеПоле = Вычислить("МетаданныеТаблицЗапроса.НовыйОписаниеПоля()");
	ПервоеПоле.Поля.Добавить("ВложенноеПоле");

	//@skip-check server-execution-safe-mode
	ПервыйПараметр = Вычислить("МетаданныеТаблицЗапроса.НовыйОписаниеПараметра()");
	//@skip-check server-execution-safe-mode
	ВторойПараметр = Вычислить("МетаданныеТаблицЗапроса.НовыйОписаниеПараметра()");
	ПервыйПараметр.Варианты.Добавить("Вариант");
	ПервыйПараметр.Поля.Добавить("Поле");

	ЮТест.ОжидаетЧто(ВтораяТаблица.Поля.Количество()).Равно(0);
	ЮТест.ОжидаетЧто(ВтораяТаблица.Параметры.Количество()).Равно(0);
	ЮТест.ОжидаетЧто(ВтороеПоле.Поля.Количество()).Равно(0);
	ЮТест.ОжидаетЧто(ВторойПараметр.Варианты.Количество()).Равно(0);
	ЮТест.ОжидаетЧто(ВторойПараметр.Поля.Количество()).Равно(0);

КонецПроцедуры

// Проверяет регистронезависимый поиск поля и безопасный результат при отсутствии.
Процедура НайтиПолеНеУчитываетРегистр() Экспорт

	//@skip-check server-execution-safe-mode
	Поле = Вычислить("МетаданныеТаблицЗапроса.НовыйОписаниеПоля(""Код"")");
	Поля = Новый Массив;
	Поля.Добавить(Поле);

	//@skip-check server-execution-safe-mode
	НайденноеПоле = Вычислить("МетаданныеТаблицЗапроса.НайтиПоле(Поля, ""кОД"")");
	//@skip-check server-execution-safe-mode
	ОтсутствующееПоле = Вычислить("МетаданныеТаблицЗапроса.НайтиПоле(Поля, ""Наименование"")");

	ЮТест.ОжидаетЧто(НайденноеПоле).Равно(Поле);
	ЮТест.ОжидаетЧто(ОтсутствующееПоле).Равно(Неопределено);

КонецПроцедуры

// Проверяет стабильные значения видов поля.
Процедура ВидыПоляВозвращаютСтабильныеЗначения() Экспорт

	//@skip-check server-execution-safe-mode
	ОбычноеПоле = Вычислить("МетаданныеТаблицЗапроса.ВидПоляОбычное()");
	//@skip-check server-execution-safe-mode
	ВложеннаяТаблица = Вычислить("МетаданныеТаблицЗапроса.ВидПоляВложеннаяТаблица()");

	ЮТест.ОжидаетЧто(ОбычноеПоле).Равно("ОбычноеПоле");
	ЮТест.ОжидаетЧто(ВложеннаяТаблица).Равно("ВложеннаяТаблица");

КонецПроцедуры

// Проверяет делегирование описания без предварительной проверки существования.
Процедура РеестрДелегируетОписаниеБезПредварительнойПроверки() Экспорт

	ИмяТаблицы = "Кадры.Сотрудники";
	Описание = Новый Структура("ИмяТаблицы", ИмяТаблицы);
	Поставщик = НовыйПоставщик("Кадры", "Кадры", ИмяТаблицы, Описание);
	Поставщики = Новый Массив;
	Поставщики.Добавить(Поставщик);
	Реестр = НовыйРеестр(Поставщики);

	ЮТест.ОжидаетЧто(Реестр).НеРавно(Неопределено);
	//@skip-check server-execution-safe-mode
	ФактическоеОписание = Вычислить("Реестр.ОписаниеТаблицы(ИмяТаблицы)");

	ЮТест.ОжидаетЧто(ФактическоеОписание).Равно(Описание);
	ЮТест.ОжидаетЧто(Поставщик.КоличествоПроверокСуществования()).Равно(0);
	ЮТест.ОжидаетЧто(Поставщик.КоличествоПолученийОписания()).Равно(1);

КонецПроцедуры

// Проверяет делегирование проверки существования выбранному поставщику.
Процедура РеестрДелегируетПроверкуСуществования() Экспорт

	ИмяТаблицы = "Кадры.Сотрудники";
	Поставщик = НовыйПоставщик("Кадры", "Кадры", ИмяТаблицы,
		Новый Структура("ИмяТаблицы", ИмяТаблицы));
	Поставщики = Новый Массив;
	Поставщики.Добавить(Поставщик);
	Реестр = НовыйРеестр(Поставщики);

	ЮТест.ОжидаетЧто(Реестр).НеРавно(Неопределено);
	//@skip-check server-execution-safe-mode
	ТаблицаСуществует = Вычислить("Реестр.ТаблицаСуществует(ИмяТаблицы)");

	ЮТест.ОжидаетЧто(ТаблицаСуществует).ЭтоИстина();
	ЮТест.ОжидаетЧто(Поставщик.КоличествоПроверокСуществования()).Равно(1);
	ЮТест.ОжидаетЧто(Поставщик.КоличествоПолученийОписания()).Равно(0);

КонецПроцедуры

// Проверяет неопределенный результат для сегмента без поставщика.
Процедура РеестрВозвращаетНеопределеноДляНеизвестногоСегмента() Экспорт

	Поставщик = НовыйПоставщик("Кадры", "Кадры", "Кадры.Сотрудники",
		Новый Структура("ИмяТаблицы", "Кадры.Сотрудники"));
	Поставщики = Новый Массив;
	Поставщики.Добавить(Поставщик);
	Реестр = НовыйРеестр(Поставщики);

	ЮТест.ОжидаетЧто(Реестр).НеРавно(Неопределено);
	//@skip-check server-execution-safe-mode
	Описание = Вычислить("Реестр.ОписаниеТаблицы(""НеизвестныйСегмент.Таблица"")");

	ЮТест.ОжидаетЧто(Описание).Равно(Неопределено);
	ЮТест.ОжидаетЧто(Поставщик.КоличествоПолученийОписания()).Равно(0);

КонецПроцедуры

// Проверяет текст ошибки коллизии сегмента для обоих поставщиков.
Процедура РеестрОтклоняетКоллизиюСегментов() Экспорт

	Поставщики = Новый Массив;
	Поставщики.Добавить(НовыйПоставщик("Первый", "Кадры", "Кадры.Сотрудники",
		Новый Структура("ИмяТаблицы", "Кадры.Сотрудники")));
	Поставщики.Добавить(НовыйПоставщик("Второй", "Кадры", "Кадры.ФизическиеЛица",
		Новый Структура("ИмяТаблицы", "Кадры.ФизическиеЛица")));
	КоллизияОтклонена = Ложь;
	ТекстОшибки = "";
	Попытка
		ЮТест.ОжидаетЧто(НовыйРеестр(Поставщики)).НеРавно(Неопределено);
	Исключение
		КоллизияОтклонена = Истина;
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

	ЮТест.ОжидаетЧто(КоллизияОтклонена).ЭтоИстина();
	ЮТест.ОжидаетЧто(СтрНайти(ТекстОшибки, "Кадры") > 0).ЭтоИстина();
	ЮТест.ОжидаетЧто(СтрНайти(ТекстОшибки, "Первый") > 0).ЭтоИстина();
	ЮТест.ОжидаетЧто(СтрНайти(ТекстОшибки, "Второй") > 0).ЭтоИстина();

КонецПроцедуры

// Проверяет отсутствие legacy fallback после пустого ответа существующего реестра.
Процедура ПустоеОписаниеРеестраНеИспользуетLegacyИсполняемыйПоставщик() Экспорт

	ИмяТаблицы = "ИсполняемоеПредставление.Периоды";
	Пакет = КОНС_ТестовыеФабрикиСлужебный.СоздатьПарсер().Разобрать(
		"ВЫБРАТЬ Периоды.Период КАК Период "
		+ "ИЗ " + ИмяТаблицы + "("
		+ "НачалоИнтервала = &ДатаНачала, "
		+ "ОкончаниеИнтервала = &ДатаОкончания, "
		+ "Периодичность = ""ДЕНЬ"") КАК Периоды");
	Источник = Пакет.Элементы[0].Операторы[0].Источники[0];
	Поставщик = НовыйПоставщик(
		"ПустойИсполняемыйПоставщик", "ИсполняемоеПредставление", ИмяТаблицы, Неопределено);
	Поставщики = Новый Массив;
	Поставщики.Добавить(Поставщик);
	Реестр = НовыйРеестр(Поставщики);
	//@skip-check server-execution-safe-mode
	МодульОбработкиМодели = Вычислить("ОбработкаМоделиЗапроса");
	Контекст = МодульОбработкиМодели.КонтекстОбработкиЗапроса(Реестр);
	//@skip-check server-execution-safe-mode
	МодульОбработкиПредставлений = Вычислить("ОбработкаПредставлениеЗапросов");

	ЮТест.ОжидаетЧто(МодульОбработкиПредставлений)
		.Метод(
			"ОбработатьИсточникЗапроса",
			ЮТМетоды.МассивПараметров(Источник, Контекст))
		.ВыбрасываетИсключение("Таблица " + ИмяТаблицы + " не найдена");
	ЮТест.ОжидаетЧто(Поставщик.КоличествоПолученийОписания()).Равно(1);
	ЮТест.ОжидаетЧто(Источник.Источник.Тип).Равно("ИсточникДанныхТаблица");

КонецПроцедуры

// Проверяет обход реальной иерархии доступных таблиц платформы.
Процедура СтандартныйПоставщикИнициализируетсяНаРеальныхГруппахТаблиц() Экспорт

	//@skip-check server-execution-safe-mode
	Поставщик = Вычислить("Обработки.ПоставщикМетаданныхСтандартныхТаблиц.Создать()");

	ЮТест.ОжидаетЧто(Поставщик)
		.Метод("Инициализировать")
		.НеВыбрасываетИсключение();

	ЮТест.ОжидаетЧто(Поставщик.Сегменты().Найти("Документ") <> Неопределено).ЭтоИстина();
	ЮТест.ОжидаетЧто(Поставщик.Сегменты().Найти("Справочник") <> Неопределено).ЭтоИстина();
	Описание = Поставщик.ОписаниеТаблицы("Документ.НачислениеЗарплаты");
	ЮТест.ОжидаетЧто(Описание).НеРавно(Неопределено);
	ЮТест.ОжидаетЧто(Описание.ИмяТаблицы).Равно("Документ.НачислениеЗарплаты");

КонецПроцедуры

// Проверяет нейтральное описание стандартной таблицы и рекурсивную конверсию вложенного поля.
Процедура СтандартныйПоставщикОписываетВложеннуюТаблицу() Экспорт

	Поставщик = НовыйСтандартныйПоставщик();
	Описание = Поставщик.ОписаниеТаблицы("Документ.НачислениеЗарплаты");
	//@skip-check server-execution-safe-mode
	Поле = Вычислить("МетаданныеТаблицЗапроса.НайтиПоле(Описание.Поля, ""Начисления"")");

	ЮТест.ОжидаетЧто(Поставщик.ИмяПоставщика()).Равно("СтандартныеТаблицы");
	ЮТест.ОжидаетЧто(Поставщик.Сегменты().Найти("Документ") <> Неопределено).ЭтоИстина();
	ЮТест.ОжидаетЧто(Описание).НеРавно(Неопределено);
	ЮТест.ОжидаетЧто(Описание.ВидИсточника).Равно("СтандартнаяТаблица");
	ЮТест.ОжидаетЧто(Описание.ДанныеПоставщика).НеРавно(Неопределено);
	ЮТест.ОжидаетЧто(Поле.ВидПоля).Равно("ВложеннаяТаблица");
