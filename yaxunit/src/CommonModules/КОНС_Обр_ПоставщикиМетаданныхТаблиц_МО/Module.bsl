// Проверяет порядок корней и маршрутизацию дочерних элементов через реестр.
Процедура РеестрАгрегируетКорниИМаршрутизируетДочерниеЭлементы() Экспорт

	КаталогПервого = Новый Соответствие;
	КорниПервого = Новый Массив;
	КореньПервого = НовыйЭлементКаталога(
		"Корень", Неопределено, Неопределено, "Первый", Истина, Истина, "ТестоваяГруппа");
	КорниПервого.Добавить(КореньПервого);
	КаталогПервого.Вставить("", КорниПервого);
	ДетиПервого = Новый Массив;
	ДетиПервого.Добавить(НовыйЭлементКаталога(
		"Дочерний|Узел", "Корень", "Первый.Таблица", "Таблица", Ложь, Истина, "ТестоваяТаблица"));
	КаталогПервого.Вставить("Корень", ДетиПервого);
	ВнукиПервого = Новый Массив;
	ВнукиПервого.Добавить(НовыйЭлементКаталога(
		"Конечный", "Дочерний|Узел", "Первый.Конечная", "Конечная", Ложь, Ложь, "ТестоваяТаблица"));
	КаталогПервого.Вставить("Дочерний|Узел", ВнукиПервого);

	КаталогВторого = Новый Соответствие;
	КорниВторого = Новый Массив;
	КорниВторого.Добавить(НовыйЭлементКаталога(
		"ВторойКорень", Неопределено, Неопределено, "Второй", Истина, Ложь, "ТестоваяГруппа"));
	КаталогВторого.Вставить("", КорниВторого);

	Поставщики = Новый Массив;
	Поставщики.Добавить(НовыйПоставщик(
		"Первый", "Первый", "Первый.Таблица", Неопределено, КаталогПервого));
	Поставщики.Добавить(НовыйПоставщик(
		"Второй", "Второй", "Второй.Таблица", Неопределено, КаталогВторого));
	Реестр = НовыйРеестр(Поставщики);
	//@skip-check bsl-legacy-check-dynamic-feature-access
	Корни = Реестр.КорневыеЭлементыКаталога();
	МаршрутКорня = Корни[0].МаршрутКаталога;
	//@skip-check bsl-legacy-check-dynamic-feature-access
	Дочерние = Реестр.ДочерниеЭлементыКаталога(МаршрутКорня);
	//@skip-check bsl-legacy-check-dynamic-feature-access
	Внуки = Реестр.ДочерниеЭлементыКаталога(Дочерние[0].МаршрутКаталога);

	ЮТест.ОжидаетЧто(Корни.Количество()).Равно(2);
	ЮТест.ОжидаетЧто(Корни[0].Представление).Равно("Первый");
	ЮТест.ОжидаетЧто(Корни[0].МаршрутКаталога).Равно("Первый|Корень");
	ЮТест.ОжидаетЧто(Корни[1].Представление).Равно("Второй");
	ЮТест.ОжидаетЧто(Корни[1].МаршрутКаталога).Равно("Второй|ВторойКорень");
	ЮТест.ОжидаетЧто(КореньПервого.МаршрутКаталога).Равно("");
	ЮТест.ОжидаетЧто(Дочерние.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(Дочерние[0].Идентификатор).Равно("Дочерний|Узел");
	ЮТест.ОжидаетЧто(Дочерние[0].МаршрутКаталога).Равно("Первый|Дочерний|Узел");
	ЮТест.ОжидаетЧто(Внуки.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(Внуки[0].ИдентификаторРодителя).Равно("Дочерний|Узел");
	ЮТест.ОжидаетЧто(Внуки[0].МаршрутКаталога).Равно("Первый|Конечный");

