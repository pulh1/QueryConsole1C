		.ДобавитьИсточник("&ЛеваяТаблица", "Левая")
		.ДобавитьИсточник("&ПраваяТаблица", "Правая")
		.ДобавитьСоединение("Правая", "Левая", Неопределено);
	Оператор = Построитель.ПолучитьМодель().Элементы[0].Операторы[0];
