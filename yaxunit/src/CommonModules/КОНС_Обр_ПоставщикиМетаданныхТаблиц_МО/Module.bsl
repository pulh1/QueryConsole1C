// Проверяет сохранение реестра в контексте отбора исполняемого представления.
Процедура КонтекстОтбораИсполняемогоПредставленияРазделяетРеестр() Экспорт

	//@skip-check server-execution-safe-mode
	МодульОбработки = Вычислить("ОбработкаМоделиЗапроса");
	//@skip-check server-execution-safe-mode
	МодульПредставлений = Вычислить("ОбработкаПредставлениеЗапросов");
	КорневойКонтекст = МодульОбработки.КонтекстОбработкиЗапроса();
	ИсточникТаблицы = Новый Структура("Псевдоним", "Представление");
	Источник = Новый Структура(
		"Источник, ИдентификаторИсточника", ИсточникТаблицы, Новый УникальныйИдентификатор);

	КонтекстОтбора = МодульПредставлений.КонтекстОбработкиОтбора(
		Источник,
		КорневойКонтекст.ОписанияВременныхТаблиц,
		КорневойКонтекст.РеестрПоставщиковМетаданныхТаблиц);

	ЮТест.ОжидаетЧто(
		КонтекстОтбора.РеестрПоставщиковМетаданныхТаблиц
			= КорневойКонтекст.РеестрПоставщиковМетаданныхТаблиц).ЭтоИстина();

КонецПроцедуры

// Проверяет повторное использование явно переданного реестра в контекстах JOIN.
Процедура КонтекстыМоделиПереиспользуютЯвноПереданныйРеестрДляJoin() Экспорт

	//@skip-check server-execution-safe-mode
	МодульУтилит = Вычислить("МодельЗапросаУтилиты");
	Модель = МодульУтилит.СоздатьПакетЗапросов();
	Построитель = МодульУтилит.СоздатьПостроительМодели(Модель);
	Построитель
		.ДобавитьИсточник("&ЛеваяТаблица", "Левая")
		.ДобавитьИсточник("&ПраваяТаблица", "Правая")
		.ДобавитьСоединение("Правая", "Левая", Неопределено);
	Оператор = Построитель.ПолучитьМодель().Элементы[0].Операторы[0];
	Реестр = НовыйРеестр(Неопределено);

	ПервыйКонтекст = МодульУтилит.КонтекстОбработкиВыражения(
		Оператор, 0, Неопределено, Реестр);
	ВторойКонтекст = МодульУтилит.КонтекстОбработкиВыражения(
		Оператор, 0, Неопределено, Реестр);

	ЮТест.ОжидаетЧто(
		ПервыйКонтекст.РеестрПоставщиковМетаданныхТаблиц = Реестр).ЭтоИстина();
	ЮТест.ОжидаетЧто(
		ВторойКонтекст.РеестрПоставщиковМетаданныхТаблиц = Реестр).ЭтоИстина();
	ЮТест.ОжидаетЧто(ПервыйКонтекст.ИспользуемыеТаблицы.Количество()).Равно(2);
	ЮТест.ОжидаетЧто(ВторойКонтекст.ИспользуемыеТаблицы.Количество()).Равно(2);

КонецПроцедуры

