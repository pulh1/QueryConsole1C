// Проверяет точный transport-safe контракт элемента каталога.
Процедура ЭлементКаталогаСодержитТолькоТранспортныеПоля() Экспорт

	//@skip-check server-execution-safe-mode
	Элемент = Вычислить("МетаданныеТаблицЗапроса.НовыйЭлементКаталога(
		|""Справочник"", ""Корень"", ""Справочник.Сотрудники"", ""Сотрудники"",
		|Истина, Ложь, ""СтандартнаяТаблица"")");

	ЮТест.ОжидаетЧто(Элемент.Количество()).Равно(8);
	ЮТест.ОжидаетЧто(Элемент.Идентификатор).Равно("Справочник");
	ЮТест.ОжидаетЧто(Элемент.ИдентификаторРодителя).Равно("Корень");
	ЮТест.ОжидаетЧто(Элемент.ИмяТаблицы).Равно("Справочник.Сотрудники");
	ЮТест.ОжидаетЧто(Элемент.Представление).Равно("Сотрудники");
	ЮТест.ОжидаетЧто(Элемент.ЭтоГруппа).ЭтоИстина();
	ЮТест.ОжидаетЧто(Элемент.ЕстьДочерние).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Элемент.ВидИсточника).Равно("СтандартнаяТаблица");
	ЮТест.ОжидаетЧто(Элемент.МаршрутКаталога).Равно("");
	ЮТест.ОжидаетЧто(Элемент.Свойство("ДанныеПоставщика")).ЭтоЛожь();

КонецПроцедуры

// Проверяет точный состав нейтрального описания таблицы.
Процедура ОписаниеТаблицыСодержитНейтральныеПоля() Экспорт

	//@skip-check server-execution-safe-mode
	Описание = Вычислить("МетаданныеТаблицЗапроса.НовыйОписаниеТаблицы(
		|""Кадры.Сотрудники"", ""Кадры"", ""Служебный"", ""Сотрудники"")");

	ЮТест.ОжидаетЧто(Описание.Количество()).Равно(7);
	ЮТест.ОжидаетЧто(Описание.ИмяТаблицы).Равно("Кадры.Сотрудники");
	ЮТест.ОжидаетЧто(Описание.ИмяПоставщика).Равно("Кадры");
	ЮТест.ОжидаетЧто(Описание.ВидИсточника).Равно("Служебный");
	ЮТест.ОжидаетЧто(Описание.Представление).Равно("Сотрудники");
	ЮТест.ОжидаетЧто(Описание.Поля.Количество()).Равно(0);
	ЮТест.ОжидаетЧто(Описание.Параметры.Количество()).Равно(0);
	ЮТест.ОжидаетЧто(Описание.ДанныеПоставщика).Равно(Неопределено);

КонецПроцедуры

// Проверяет, что краткое описание не раскрывает поля и параметры таблицы.
