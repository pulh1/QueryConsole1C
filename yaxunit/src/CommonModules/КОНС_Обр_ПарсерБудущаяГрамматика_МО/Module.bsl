#Область ПрограммныйИнтерфейс

// Opt-in acceptance RED для будущей регенерации парсера из грамматики.
// Production-парсер вручную не исправляется.
Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("ПарсерБудущаяГрамматика")
			.Тег("БудущаяГрамматика")
			.ДобавитьСерверныйТест("ПовторныеУнарныеЗнакиРазбираются");

КонецПроцедуры

// Opt-in acceptance RED: после регенерации из грамматики --1 должен строить унарный узел.
Процедура ПовторныеУнарныеЗнакиРазбираются() Экспорт

	Парсер = КОНС_ТестовыеФабрикиСлужебный.СоздатьПарсер();
	Узел = Парсер.РазобратьВыражение("--1");

	ЮТест.ОжидаетЧто(Узел.Тип)
		.Равно("УнарнаяОперация", "Ожидается узел унарной операции");
	ЮТест.ОжидаетЧто(Узел.Знаки.Количество())
		.Равно(2, "Повторные унарные знаки должны сохраняться");
	ЮТест.ОжидаетЧто(Узел.Знаки[0])
		.Равно("-", "Первый унарный знак должен сохраняться");
	ЮТест.ОжидаетЧто(Узел.Знаки[1])
		.Равно("-", "Второй унарный знак должен сохраняться");
	ЮТест.ОжидаетЧто(Узел.Выражение.Тип)
		.Равно("Константа", "Вложенным выражением должна быть константа");
	ЮТест.ОжидаетЧто(Узел.Выражение.Значение)
		.Равно(1, "Вложенная константа должна сохранять значение");

КонецПроцедуры

#КонецОбласти
