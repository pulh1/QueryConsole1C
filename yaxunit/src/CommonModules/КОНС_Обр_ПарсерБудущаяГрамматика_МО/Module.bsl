#Область ПрограммныйИнтерфейс

// Opt-in acceptance RED для будущей регенерации парсера из грамматики.
// Production-парсер вручную не исправляется.
Процедура ИсполняемыеСценарии() Экспорт

	Фильтр = ЮТКонтекстСлужебный.КонтекстЧитателя().Фильтр;
	// RED регистрируется только при явном modules=["КОНС_Обр_ПарсерБудущаяГрамматика_МО"]; общий запуск его не регистрирует.
	Если НЕ Фильтр.ЕстьФильтрМодулей
		ИЛИ НЕ Фильтр.Модули.Свойство("КОНС_Обр_ПарсерБудущаяГрамматика_МО") Тогда
		Возврат;
	КонецЕсли;

	ЮТТесты
		.ДобавитьТестовыйНабор("ПарсерБудущаяГрамматика")
			.Тег("БудущаяГрамматика")
			.ДобавитьСерверныйТест("ПовторныеУнарныеЗнакиРазбираются")
			.ДобавитьСерверныйТест("НеделяСохраняетИмяФункции")
			.ДобавитьСерверныйТест("НезавершеннаяБинарнаяОперацияСообщаетОбОжидаемомТокене")
			.ДобавитьСерверныйТест("МодификаторПолногоЗапросаБудущаяГрамматикаCase")
				.СПараметрамиНаСервере("M06", "ВЫБРАТЬ ПЕРВЫЕ 5 РАЗЛИЧНЫЕ РАЗРЕШЕННЫЕ 1", 5, Истина, Истина)
				.СПараметрамиНаСервере("M07", "ВЫБРАТЬ ПЕРВЫЕ 5 РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ 1", 5, Истина, Истина)
				.СПараметрамиНаСервере("M10", "ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 5 РАЗРЕШЕННЫЕ 1", 5, Истина, Истина)
				.СПараметрамиНаСервере("M14", "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 5 РАЗЛИЧНЫЕ 1", 5, Истина, Истина);

КонецПроцедуры

Процедура МодификаторПолногоЗапросаБудущаяГрамматикаCase(
	Идентификатор, ИсходныйТекст, ОжидаемыеПервые,
	ОжидаемыеРазличные, ОжидаемыеРазрешенные) Экспорт

	Парсер = КОНС_ТестовыеФабрикиСлужебный.СоздатьПарсер();
	Пакет = Парсер.Разобрать(ИсходныйТекст);
	ЮТест.ОжидаетЧто(Пакет.Тип).Равно("ПакетЗапросов", Идентификатор);
	ЮТест.ОжидаетЧто(Пакет.Элементы.Количество()).Равно(1, Идентификатор);
	Запрос = Пакет.Элементы[0];
	ЮТест.ОжидаетЧто(Запрос.Тип).Равно("ЗапросВыбора", Идентификатор);
	ЮТест.ОжидаетЧто(Запрос.Операторы.Количество()).Равно(1, Идентификатор);
	Оператор = Запрос.Операторы[0];
	ЮТест.ОжидаетЧто(Оператор.КоличествоПолучаемыхЗаписей)
		.Равно(ОжидаемыеПервые, Идентификатор);
	ЮТест.ОжидаетЧто(Оператор.ВыбиратьРазличные)
		.Равно(ОжидаемыеРазличные, Идентификатор);
	ФактическиеРазрешенные = Неопределено;
	ЮТест.ОжидаетЧто(Оператор.Свойство(
		"__ВыбиратьРазрешенные", ФактическиеРазрешенные))
		.Равно(Истина, Идентификатор);
	ЮТест.ОжидаетЧто(ФактическиеРазрешенные)
		.Равно(ОжидаемыеРазрешенные, Идентификатор);

КонецПроцедуры

// Opt-in acceptance RED: после регенерации из грамматики --1 должен строить унарный узел.
Процедура ПовторныеУнарныеЗнакиРазбираются() Экспорт

	Парсер = КОНС_ТестовыеФабрикиСлужебный.СоздатьПарсер();
	Узел = Парсер.РазобратьВыражение("--1");

	ЮТест.ОжидаетЧто(Узел.Тип)
		.Равно("УнарнаяОперация", "Ожидается узел унарной операции");
	ЮТест.ОжидаетЧто(Узел.Знаки.Количество())
		.Равно(2, "Повторные унарные знаки должны сохраняться");
	ЮТест.ОжидаетЧто(Узел.Знаки[0])
		.Равно("-", "Первый унарный знак должен сохраняться");
	ЮТест.ОжидаетЧто(Узел.Знаки[1])
		.Равно("-", "Второй унарный знак должен сохраняться");
	ЮТест.ОжидаетЧто(Узел.Выражение.Тип)
		.Равно("Константа", "Вложенным выражением должна быть константа");
	ЮТест.ОжидаетЧто(Узел.Выражение.Значение)
		.Равно(1, "Вложенная константа должна сохранять значение");

КонецПроцедуры

// Opt-in acceptance RED: сгенерированная ветка НЕДЕЛЯ вызывает НовыйФункцияДеньМесяца.
// Исправление выполняется только через изменение грамматики и регенерацию парсера.
Процедура НеделяСохраняетИмяФункции() Экспорт

	Парсер = КОНС_ТестовыеФабрикиСлужебный.СоздатьПарсер();
	Узел = Парсер.РазобратьВыражение("НЕДЕЛЯ(&Дата)");

	ЮТест.ОжидаетЧто(Узел.Тип)
		.Равно("ФункцияЧастьПериодаЧислом", "Ожидается узел функции части периода");
	ЮТест.ОжидаетЧто(Узел.Аргумент.Тип)
		.Равно("ПараметрЗапроса", "Аргумент НЕДЕЛЯ должен быть параметром запроса");
	ЮТест.ОжидаетЧто(Узел.Аргумент.Имя)
		.Равно("Дата", "НЕДЕЛЯ должна сохранять аргумент");
	ЮТест.ОжидаетЧто(ВРег(Узел.ИмяФункции))
		.Равно("НЕДЕЛЯ", "НЕДЕЛЯ должна сохранять имя функции");

КонецПроцедуры

// Opt-in acceptance RED: незавершённая бинарная операция должна сообщать об ожидаемом токене.
// Сейчас: {(1, 3)}: Синтаксическая ошибка. Неожиданный токен "+".
// Исправление выполняется только через изменение грамматики и регенерацию парсера.
Процедура НезавершеннаяБинарнаяОперацияСообщаетОбОжидаемомТокене() Экспорт

	Парсер = КОНС_ТестовыеФабрикиСлужебный.СоздатьПарсер();

	ЮТест.ОжидаетЧто(Парсер)
		.Метод("РазобратьВыражение", ЮТМетоды.МассивПараметров("1 +"))
		.ВыбрасываетИсключение("Синтаксическая ошибка. Ожидается следующий токен",
			"Незавершённая бинарная операция должна сообщать об ожидаемом токене");

КонецПроцедуры

#КонецОбласти
