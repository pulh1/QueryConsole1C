#Область ТестовыйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Лексер")
			.Тег("Лексер")
			.ДобавитьСерверныйТест("ОбычныйИдентификаторРазбираетсяВТокен")
			.ДобавитьСерверныйТест("ВосстановлениеТекстаЗавершаетсяНаКонцеВхода");

КонецПроцедуры

Процедура ОбычныйИдентификаторРазбираетсяВТокен() Экспорт

	Лексер = КОНС_ТестовыеФабрикиСлужебный.СоздатьЛексическийАнализатор("Поле_1");
	Токен = Лексер.СледующийТокен();

	ЮТест.ОжидаетЧто(Токен.Класс)
		.Равно("Слово", "Лексер должен классифицировать идентификатор как слово");
	ЮТест.ОжидаетЧто(Токен.Тип)
		.Равно("ID", "Обычное слово должно иметь тип идентификатора");
	ЮТест.ОжидаетЧто(Токен.Лексема)
		.Равно("Поле_1", "Лексер должен сохранить исходную лексему");

КонецПроцедуры

Процедура ВосстановлениеТекстаЗавершаетсяНаКонцеВхода() Экспорт

	Лексер = КОНС_ТестовыеФабрикиСлужебный.СоздатьЛексическийАнализатор("ВЫБРАТЬ 1");
	Результат = Лексер.ПолучитьТекстЗапроса();

	ЮТест.ОжидаетЧто(Результат)
		.ИмеетТип("Строка", "Восстановленный текст запроса должен быть строкой")
		.Содержит("ВЫБРАТЬ", "Восстановленный текст должен содержать ключевое слово")
		.Содержит("1", "Восстановленный текст должен содержать числовую константу");

КонецПроцедуры

#КонецОбласти
