Процедура ПрямоеПреобразованиеЧиселСовместимо() Экспорт

	ПроверитьЭквивалентностьПотока(
		"0 1 01 42 12.5 .5 1. 1..2", "numeric-direct/main");
	ПроверитьЭквивалентностьПотока(
		"0.0000000000000000000000000001 "
		+ "9999999999999999999999999999 "
		+ "99999999999999.99999999999999",
		"numeric-direct/precision");

КонецПроцедуры

Процедура ПроверитьЭквивалентностьТокенов(СтарыйТокен, НовыйТокен, Контекст)

	ЮТест.ОжидаетЧто(НовыйТокен.Класс).Равно(СтарыйТокен.Класс, Контекст + ": Класс");
	ЮТест.ОжидаетЧто(НовыйТокен.Тип).Равно(СтарыйТокен.Тип, Контекст + ": Тип");
	ЮТест.ОжидаетЧто(НовыйТокен.Лексема).Равно(СтарыйТокен.Лексема, Контекст + ": Лексема");
	СтароеЗначение = Неопределено;
	НовоеЗначение = Неопределено;
	ЕстьСтарое = СтарыйТокен.Свойство("Значение", СтароеЗначение);
	ЕстьНовое = НовыйТокен.Свойство("Значение", НовоеЗначение);
	ЮТест.ОжидаетЧто(ЕстьНовое).Равно(ЕстьСтарое, Контекст + ": наличие Значение");
	Если ЕстьСтарое Тогда
		ЮТест.ОжидаетЧто(НовоеЗначение).Равно(СтароеЗначение, Контекст + ": Значение");
	КонецЕсли;
	Если СтарыйТокен.Тип = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЮТест.ОжидаетЧто(НовыйТокен.НомерСтроки).Равно(
		СтарыйТокен.НомерСтроки, Контекст + ": строка");
	Если НовыйТокен.Тип = "ID_СРешеткой" Тогда
		ЮТест.ОжидаетЧто(
			НовыйТокен.НомерСимвола + СтрДлина(НовыйТокен.Лексема))
			.Равно(СтарыйТокен.НомерСимвола, Контекст + ": позиция #ID");
	Иначе
		ЮТест.ОжидаетЧто(НовыйТокен.НомерСимвола).Равно(
			СтарыйТокен.НомерСимвола, Контекст + ": колонка");
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьЭквивалентностьПотока(Текст, Контекст)

	СтарыйЛексер = Обработки.КОНС_СтарыйЛексическийАнализатор.Создать();
	СтарыйЛексер.Инициализировать();
	СтарыйЛексер.УстановитьОбрабатываемыйТекст(Текст);
	НовыйЛексер = Обработки.ЛексическийАнализатор.Создать();
	НовыйЛексер.Инициализировать();
	НовыйЛексер.УстановитьОбрабатываемыйТекст(Текст);

	МаксимумЧтений = СтрДлина(Текст) + 2;
	Для НомерТокена = 1 По МаксимумЧтений Цикл
		СтарыйТокен = СтарыйЛексер.СледующийТокен();
		НовыйТокен = НовыйЛексер.СледующийТокен();
		КонтекстТокена = СтрШаблон("%1/token/%2", Контекст, НомерТокена);
		ПроверитьЭквивалентностьТокенов(СтарыйТокен, НовыйТокен, КонтекстТокена);
		Если СтарыйТокен.Тип = Неопределено Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;

	ЮТест.ОжидаетЧто(Истина).Равно(
		Ложь, Контекст + ": лексер превысил защитный максимум чтений");

КонецПроцедуры

Функция ПроверитьЭквивалентностьПрефиксаДоОшибки(Текст, Контекст)

	СтарыйЛексер = Обработки.КОНС_СтарыйЛексическийАнализатор.Создать();
	СтарыйЛексер.Инициализировать();
	СтарыйЛексер.УстановитьОбрабатываемыйТекст(Текст);
	НовыйЛексер = Обработки.ЛексическийАнализатор.Создать();
	НовыйЛексер.Инициализировать();
	НовыйЛексер.УстановитьОбрабатываемыйТекст(Текст);

	МаксимумЧтений = СтрДлина(Текст) + 2;
	Для НомерТокена = 1 По МаксимумЧтений Цикл
		СтарыйВыдалОшибку = Ложь;
		Попытка
			СтарыйТокен = СтарыйЛексер.СледующийТокен();
		Исключение
			СтарыйВыдалОшибку = Истина;
		КонецПопытки;

		НовыйВыдалОшибку = Ложь;
		Попытка
			НовыйТокен = НовыйЛексер.СледующийТокен();
		Исключение
			НовыйВыдалОшибку = Истина;
		КонецПопытки;

		КонтекстТокена = СтрШаблон("%1/token/%2", Контекст, НомерТокена);
		Если СтарыйВыдалОшибку Или НовыйВыдалОшибку Тогда
			ЮТест.ОжидаетЧто(НовыйВыдалОшибку).Равно(
				СтарыйВыдалОшибку, КонтекстТокена + ": наличие ошибки");
			Возврат НомерТокена;
		КонецЕсли;

		ПроверитьЭквивалентностьТокенов(СтарыйТокен, НовыйТокен, КонтекстТокена);
		Если СтарыйТокен.Тип = Неопределено Тогда
			ЮТест.ОжидаетЧто(Истина).Равно(
				Ложь, КонтекстТокена + ": достигнут EOF вместо ожидаемой ошибки");
			Возврат 0;
		КонецЕсли;
	КонецЦикла;

	ЮТест.ОжидаетЧто(Истина).Равно(
		Ложь, Контекст + ": не получена ошибка до защитного максимума чтений");
	Возврат 0;

КонецФункции

Функция СинтетическиеВходыДляДифференциальнойПроверки()

	Входы = Новый Массив;
	Кавычка = Символ(34);

	ДобавитьДифференциальныйВход(Входы, "string-empty", Кавычка + Кавычка);
	ДобавитьДифференциальныйВход(Входы, "string-ordinary", Кавычка + "текст" + Кавычка);
	ДобавитьДифференциальныйВход(
		Входы, "string-escaped-quote", Кавычка + "а" + Кавычка + Кавычка + "б" + Кавычка);
	ДобавитьДифференциальныйВход(
		Входы, "string-multiline-lf", Кавычка + "первая" + Символы.ПС + "вторая" + Кавычка);
	ДобавитьДифференциальныйВход(
		Входы, "string-multiline-crlf",
		Кавычка + "первая" + Символы.ВК + Символы.ПС + "вторая" + Кавычка);
	ДобавитьДифференциальныйВход(
		Входы, "all-lexemes", ". / <= <> { >= } < % = & > ( ) * + , - ;");
	ДобавитьДифференциальныйВход(
		Входы, "numbers-main", "0 1 01 42 12.5 .5 1. 1..2");
	ДобавитьДифференциальныйВход(
		Входы, "numbers-precision",
		"0.0000000000000000000000000001 "
		+ "9999999999999999999999999999 "
		+ "99999999999999.99999999999999");
	ДобавитьДифференциальныйВход(
		Входы, "identifiers", "latin latin_field Поле Поле_1 Ёлка ёж");
	ДобавитьДифференциальныйВход(
		Входы, "comment-lf", "Первое // комментарий" + Символы.ПС + "Второе");
	ДобавитьДифференциальныйВход(
		Входы, "comment-crlf", "Первое // комментарий" + Символы.ВК + Символы.ПС + "Второе");
	ДобавитьДифференциальныйВход(
		Входы, "comment-eof", "Первое // комментарий");

	Возврат Входы;

КонецФункции

Процедура ДобавитьДифференциальныйВход(Входы, Идентификатор, Текст)

	Входы.Добавить(Новый Структура("id,text", Идентификатор, Текст));

КонецПроцедуры


#КонецОбласти
