		.Равно(ПерваяСтрока, "Строка первого значимого токена должна учитывать комментарии");

	Если ВтораяЛексема <> Неопределено Тогда
		ВторойТокен = Лексер.СледующийТокен();
		ЮТест.ОжидаетЧто(ВторойТокен.Лексема)
			.Равно(ВтораяЛексема, "Второй значимый токен должен следовать после комментария");
