Процедура ИдентификаторКлассифицируется(ИсходнаяЛексема, ОжидаемыйТип) Экспорт

	Лексер = КОНС_ТестовыеФабрикиСлужебный.СоздатьЛексическийАнализатор(ИсходнаяЛексема);
	Токен = Лексер.СледующийТокен();

	ЮТест.ОжидаетЧто(Токен.Класс)
		.Равно("Слово", "Идентификатор должен классифицироваться как слово");
	ЮТест.ОжидаетЧто(Токен.Тип)
		.Равно(ОжидаемыйТип, "Тип идентификатора должен соответствовать наличию решётки");
	ЮТест.ОжидаетЧто(Токен.Лексема)
		.Равно(ИсходнаяЛексема, "Исходная лексема идентификатора должна сохраняться");

КонецПроцедуры

Процедура ПозицияТокенаОпределяется(ИсходныйТекст, НомерТокена, ОжидаемаяСтрока, ОжидаемыйСимвол) Экспорт

	Лексер = КОНС_ТестовыеФабрикиСлужебный.СоздатьЛексическийАнализатор(ИсходныйТекст);
	Для Индекс = 1 По НомерТокена Цикл
		Токен = Лексер.СледующийТокен();
	КонецЦикла;

	ЮТест.ОжидаетЧто(Токен.НомерСтроки)
		.Равно(ОжидаемаяСтрока, "Номер строки токена должен соответствовать позиции во входе");
	ЮТест.ОжидаетЧто(Токен.НомерСимвола)
		.Равно(ОжидаемыйСимвол, "Номер символа токена должен соответствовать позиции во входе");

КонецПроцедуры

Процедура КоординатаВременногоИдентификатораСоответствуетТекущемуПоведению(
	ИсходнаяЛексема,
	ОжидаемыйСимвол) Экспорт

	Лексер = КОНС_ТестовыеФабрикиСлужебный.СоздатьЛексическийАнализатор(ИсходнаяЛексема);
	Токен = Лексер.СледующийТокен();

	ЮТест.ОжидаетЧто(Токен.НомерСтроки)
		.Равно(1, "Временный идентификатор должен находиться в первой строке");
	ЮТест.ОжидаетЧто(Токен.НомерСимвола)
		.Равно(ОжидаемыйСимвол, "Фиксируется текущая координата временного идентификатора");

КонецПроцедуры

Процедура ЛексерПовторноИспользуетсяСНовымТекстом() Экспорт

	Лексер = КОНС_ТестовыеФабрикиСлужебный.СоздатьЛексическийАнализатор("Первое");
	ПервыйТокен = Лексер.СледующийТокен();
	Лексер.УстановитьОбрабатываемыйТекст("Второе");
	ВторойТокен = Лексер.СледующийТокен();

	ЮТест.ОжидаетЧто(ПервыйТокен.Лексема)
		.Равно("Первое", "Первый текст должен быть разобран до повторной инициализации");
	ЮТест.ОжидаетЧто(ВторойТокен.Лексема)
		.Равно("Второе", "После смены текста лексер должен разобрать новый вход");
	ЮТест.ОжидаетЧто(ВторойТокен.НомерСтроки)
		.Равно(1, "После смены текста номер строки должен сброситься");
	ЮТест.ОжидаетЧто(ВторойТокен.НомерСимвола)
		.Равно(1, "После смены текста номер символа должен сброситься");

КонецПроцедуры

Процедура КомментарииНеВозвращаютсяКакТокены(
	ИсходныйТекст,
	ПерваяЛексема,
	ПерваяСтрока,
	ВтораяЛексема,
	ВтораяСтрока) Экспорт

	Лексер = КОНС_ТестовыеФабрикиСлужебный.СоздатьЛексическийАнализатор(ИсходныйТекст);
	ПервыйТокен = Лексер.СледующийТокен();

	ЮТест.ОжидаетЧто(ПервыйТокен.Лексема)
		.Равно(ПерваяЛексема, "Первый значимый токен должен следовать после комментариев");
	ЮТест.ОжидаетЧто(ПервыйТокен.НомерСтроки)
		.Равно(ПерваяСтрока, "Строка первого значимого токена должна учитывать комментарии");

	Если ВтораяЛексема <> Неопределено Тогда
		ВторойТокен = Лексер.СледующийТокен();
		ЮТест.ОжидаетЧто(ВторойТокен.Лексема)
			.Равно(ВтораяЛексема, "Второй значимый токен должен следовать после комментария");
		ЮТест.ОжидаетЧто(ВторойТокен.НомерСтроки)
			.Равно(ВтораяСтрока, "Строка второго токена должна учитывать комментарий");
	КонецЕсли;

	ТокенКонца = Лексер.СледующийТокен();
	ЮТест.ОжидаетЧто(ТокенКонца.Тип)
		.Равно(Неопределено, "После значимых токенов должен возвращаться EOF");

КонецПроцедуры

Процедура КомментарийБезПереводаСтрокиЗавершаетсяEOF() Экспорт

	Лексер = КОНС_ТестовыеФабрикиСлужебный.СоздатьЛексическийАнализатор(
		"// комментарий без перевода строки");
	Токен = Лексер.СледующийТокен();

	ЮТест.ОжидаетЧто(Токен.Тип)
		.Равно(Неопределено, "Комментарий до конца входа должен завершаться EOF без исключения");

КонецПроцедуры

Процедура НекорректныйВводВызываетИсключение(ИсходныйТекст, ОжидаемыйТекстОшибки) Экспорт

	Лексер = КОНС_ТестовыеФабрикиСлужебный.СоздатьЛексическийАнализатор(ИсходныйТекст);

	ЮТест.ОжидаетЧто(Лексер)
		.Метод("СледующийТокен")
		.ВыбрасываетИсключение(
			ОжидаемыйТекстОшибки,
			"Некорректный ввод должен вызывать ожидаемую ошибку лексера");

КонецПроцедуры

Процедура ТекстЗапросаВосстанавливаетЗначимыеКонструкции(
	ИсходныйТекст,
	ПервыйФрагмент,
	ВторойФрагмент,
	ЗапрещенныйФрагмент) Экспорт

	Лексер = КОНС_ТестовыеФабрикиСлужебный.СоздатьЛексическийАнализатор(ИсходныйТекст);
	Результат = Лексер.ПолучитьТекстЗапроса();

	ЮТест.ОжидаетЧто(Результат)
		.ИмеетТип("Строка", "Восстановленный запрос должен быть строкой")
		.Содержит(ПервыйФрагмент, "Восстановленный запрос должен содержать первый фрагмент")
		.Содержит(ВторойФрагмент, "Восстановленный запрос должен содержать второй фрагмент");

	Если ЗапрещенныйФрагмент <> "" Тогда
		ЮТест.ОжидаетЧто(Результат)
			.НеСодержит(ЗапрещенныйФрагмент, "Комментарии не должны попадать в восстановленный запрос");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
