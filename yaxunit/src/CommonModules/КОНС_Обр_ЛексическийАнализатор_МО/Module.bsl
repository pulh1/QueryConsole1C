	ИсходныеТексты.Добавить(Кавычка + "abc " + Кавычка + Кавычка + "quoted" + Кавычка + Кавычка + " text" + Кавычка);
	ИсходныеТексты.Добавить(Кавычка + "abc " + Кавычка + Кавычка + " // " + Кавычка + Кавычка + " 123" + Кавычка);

	ОжидаемыеЗначения = Новый Массив;
	ОжидаемыеЗначения.Добавить("abc // 123 <> test");
	ОжидаемыеЗначения.Добавить("abc " + Кавычка + "quoted" + Кавычка + " text");
	ОжидаемыеЗначения.Добавить("abc " + Кавычка + " // " + Кавычка + " 123");

	Для Индекс = 0 По ИсходныеТексты.ВГраница() Цикл
		Лексер = КОНС_ТестовыеФабрикиСлужебный.СоздатьЛексическийАнализатор(ИсходныеТексты[Индекс]);
