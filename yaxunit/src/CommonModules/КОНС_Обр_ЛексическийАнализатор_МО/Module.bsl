Функция ПолучитьВсеЗначимыеТокены(Лексер)
	Результат = Новый Массив;
	Пока Истина Цикл
		Токен = Лексер.СледующийТокен();
		Если Токен.Тип = Неопределено Тогда
			Прервать;
		КонецЕсли;
		Результат.Добавить(Токен);
	КонецЦикла;
	Возврат Результат;
КонецФункции

