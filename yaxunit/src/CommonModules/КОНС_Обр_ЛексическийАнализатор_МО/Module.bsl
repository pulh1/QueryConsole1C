		ЮТест.ОжидаетЧто(Токены[Индекс].Класс).Равно("Лексема");
		ЮТест.ОжидаетЧто(Токены[Индекс].Тип).Равно(ОжидаемыеЛексемы[Индекс]);
		ЮТест.ОжидаетЧто(Токены[Индекс].Лексема).Равно(ОжидаемыеЛексемы[Индекс]);
	КонецЦикла;

КонецПроцедуры

