			ЮТест.ОжидаетЧто(Токены[Индекс].Класс).Равно("Слово");
		Иначе
			ЮТест.ОжидаетЧто(Токены[Индекс].Класс).Равно("Лексема",
				"Токены блочного комментария должны быть обычными лексемами");
		КонецЕсли;
		ЮТест.ОжидаетЧто(Токены[Индекс].Тип).Равно(ОжидаемыеТипы[Индекс]);
		ЮТест.ОжидаетЧто(Токены[Индекс].Лексема).Равно(ОжидаемыеТипы[Индекс]);
	КонецЦикла;

КонецПроцедуры


