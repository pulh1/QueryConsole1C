			.ДобавитьСерверныйТест("ПакетныйCase")
				.СПараметрамиНаСервере("Q01", "ВЫБРАТЬ 1; ВЫБРАТЬ 2", 2, "ЗапросВыбора", "ЗапросВыбора")
