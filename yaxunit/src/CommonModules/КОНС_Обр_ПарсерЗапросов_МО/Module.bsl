// Проверяет семантически значимую проекцию разобранного полного запроса.
//
// Параметры:
//  Сценарий - Строка - Имя проверяемого сценария полного запроса.
Процедура ПроверяетсяСемантическаяПроекцияПолногоЗапроса(Сценарий) Экспорт
	Если Сценарий = "ПорядокПакета" Тогда
		Пакет = РазобратьЗапросДляТеста("ВЫБРАТЬ 1 КАК Первый; ВЫБРАТЬ 2 КАК Второй");
		//@skip-check undefined-variable
		ОбработкаМоделиЗапроса.ОбработатьМодельЗапроса(Пакет);
		ЮТест.ОжидаетЧто(Пакет.Элементы.Количество()).Равно(2, "Пакет должен сохранять два запроса");
		ЮТест.ОжидаетЧто(Пакет.Элементы[0].Операторы[0].ВыбираемыеПоля[0].Псевдоним)
			.Равно("Первый", "Первый элемент пакета должен сохранять порядок");
		ЮТест.ОжидаетЧто(Пакет.Элементы[1].Операторы[0].ВыбираемыеПоля[0].Псевдоним)
			.Равно("Второй", "Второй элемент пакета должен сохранять порядок");
	ИначеЕсли Сценарий = "ИсточникИПсевдоним" Тогда
		Оператор = ЕдинственныйОператорПослеСемантики(
			"ВЫБРАТЬ ФизическиеЛица.Ссылка КАК ФизическоеЛицо ИЗ Справочник.ФизическиеЛица КАК ФизическиеЛица");
		Источник = Оператор.Источники.Элементы[0].Источник;
		ЮТест.ОжидаетЧто(Источник.ИмяТаблицы).Равно("Справочник.ФизическиеЛица");
		ЮТест.ОжидаетЧто(Источник.Псевдоним).Равно("ФизическиеЛица");
	ИначеЕсли Сценарий = "ПорядокПолей" Тогда
		Оператор = ЕдинственныйОператорПослеСемантики(
			"ВЫБРАТЬ ФизическиеЛица.Ссылка КАК Ссылка, ФизическиеЛица.Наименование КАК Наименование "
			+ "ИЗ Справочник.ФизическиеЛица КАК ФизическиеЛица");
		ЮТест.ОжидаетЧто(Оператор.ВыбираемыеПоля.Количество()).Равно(2,
			"Оператор должен сохранять оба выбираемых поля");
		ЮТест.ОжидаетЧто(Оператор.ВыбираемыеПоля[0].Псевдоним).Равно("Ссылка");
		ЮТест.ОжидаетЧто(Оператор.ВыбираемыеПоля[1].Псевдоним).Равно("Наименование");
	ИначеЕсли Сценарий = "ЛевоеСоединение" Тогда
		Оператор = ЕдинственныйОператорПослеСемантики(
			"ВЫБРАТЬ Сотрудники.Ссылка КАК Сотрудник ИЗ Справочник.Сотрудники КАК Сотрудники "
			+ "ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица КАК ФизическиеЛица "
			+ "ПО Сотрудники.ФизическоеЛицо = ФизическиеЛица.Ссылка");
		Корень = Оператор.Источники.Элементы[0];
		ЮТест.ОжидаетЧто(Корень.Соединения.Количество()).Равно(1, "Должно быть одно соединение");
		ЮТест.ОжидаетЧто(Корень.Соединения[0].ТипСоединения).Равно("Левое");
		ЮТест.ОжидаетЧто(Корень.Соединения[0].Условие.Значение.Операция).Равно("=");
		ЮТест.ОжидаетЧто(Оператор.Источники.Элементы[1].Источник.Псевдоним).Равно("ФизическиеЛица");
	ИначеЕсли Сценарий = "ВложенныйЗапрос" Тогда
		Оператор = ЕдинственныйОператорПослеСемантики(
			"ВЫБРАТЬ Вложенный.Ссылка КАК Ссылка ИЗ "
			+ "(ВЫБРАТЬ ФизическиеЛица.Ссылка КАК Ссылка ИЗ Справочник.ФизическиеЛица КАК ФизическиеЛица) "
			+ "КАК Вложенный");
		Источник = Оператор.Источники.Элементы[0].Источник;
		ЮТест.ОжидаетЧто(Источник.Тип).Равно("ИсточникДанныхВложенныйЗапрос");
		ЮТест.ОжидаетЧто(Источник.Псевдоним).Равно("Вложенный");
		ЮТест.ОжидаетЧто(Источник.ЗапросВыбора.Операторы.Количество()).Равно(1);
	ИначеЕсли Сценарий = "ПорядокОбъединения" Тогда
		Запрос = ЕдинственныйЗапросВыбораПослеСемантики(
			"ВЫБРАТЬ 1 КАК Значение ОБЪЕДИНИТЬ ВСЕ ВЫБРАТЬ 2 КАК Значение");
		ЮТест.ОжидаетЧто(Запрос.Операторы.Количество()).Равно(2,
			"ОБЪЕДИНИТЬ должно сохранять оба оператора");
		ЮТест.ОжидаетЧто(Запрос.Операторы[1].ТипОбъединения).Равно("ОбъединитьВсе");
		ЮТест.ОжидаетЧто(Запрос.Операторы[1].ВыбираемыеПоля[0].Выражение.Значение.Значение).Равно(2);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

Процедура ПервыйЗапросПримераРазбирается(КлючФайла, ИмяЗапросаXML,
	ИсходныйТекст, Sha256, RuntimeVerifiedCount) Экспорт
	ЮТест.ОжидаетЧто(ПустаяСтрока(КлючФайла)).Равно(Ложь);
	ЮТест.ОжидаетЧто(ПустаяСтрока(ИмяЗапросаXML)).Равно(Ложь);
	ЮТест.ОжидаетЧто(ПустаяСтрока(ИсходныйТекст)).Равно(Ложь);
	Пакет = РазобратьЗапросДляТеста(ИсходныйТекст);
	ЮТест.ОжидаетЧто(Пакет.Тип).Равно("ПакетЗапросов", КлючФайла + Sha256);
	ЮТест.ОжидаетЧто(Пакет.Элементы.Количество())
		.Равно(RuntimeVerifiedCount, КлючФайла + ": runtime count changed");
	Для Каждого Элемент Из Пакет.Элементы Цикл
		ЮТест.ОжидаетЧто(ПустаяСтрока(Элемент.Тип)).Равно(Ложь, КлючФайла);
	КонецЦикла;
	Если КлючФайла = "QueryExamples/ТестПакетЗапрсов.q1c" Тогда
		ЗапросСОбъединением = Пакет.Элементы[4];
		ЮТест.ОжидаетЧто(ЗапросСОбъединением.Операторы.Количество()).Равно(3,
			"Фактический пакет должен сохранять три UNION-member в пятом запросе");
		ЮТест.ОжидаетЧто(ЗапросСОбъединением.Операторы[1].ТипОбъединения)
			.Равно("Объединить", "Второй UNION-member должен сохранять порядок");
		ЮТест.ОжидаетЧто(ЗапросСОбъединением.Операторы[2].ТипОбъединения)
			.Равно("Объединить", "Третий UNION-member должен сохранять порядок");
	КонецЕсли;
КонецПроцедуры

