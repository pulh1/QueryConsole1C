				.СПараметрамиНаСервере("M02", "ВЫБРАТЬ РАЗЛИЧНЫЕ 1", Неопределено, Истина, Ложь, "__ВыбиратьРазрешенные")
				.СПараметрамиНаСервере("M03", "ВЫБРАТЬ РАЗРЕШЕННЫЕ 1", Неопределено, Ложь, Истина, "__ВыбиратьРазрешенные")
				.СПараметрамиНаСервере("M04", "ВЫБРАТЬ ПЕРВЫЕ 5 РАЗЛИЧНЫЕ 1", 5, Истина, Ложь, "__ВыбиратьРазрешенные")
				.СПараметрамиНаСервере("M05", "ВЫБРАТЬ ПЕРВЫЕ 5 РАЗРЕШЕННЫЕ 1", 5, Ложь, Истина, "__ВыбиратьРазрешенные")
				.СПараметрамиНаСервере("M08", "ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 5 1", 5, Истина, Ложь, "__ВыбиратьРазрешенные")
				.СПараметрамиНаСервере("M09", "ВЫБРАТЬ РАЗЛИЧНЫЕ РАЗРЕШЕННЫЕ 1", Неопределено, Истина, Истина, "__ВыбиратьРазрешенные")
				.СПараметрамиНаСервере("M11", "ВЫБРАТЬ РАЗЛИЧНЫЕ РАЗРЕШЕННЫЕ ПЕРВЫЕ 5 1", 5, Истина, Истина, "__ВыбиратьРазрешенные")
				.СПараметрамиНаСервере("M12", "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 5 1", 5, Ложь, Истина, "__ВыбиратьРазрешенные")
				.СПараметрамиНаСервере("M13", "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ 1", Неопределено, Истина, Истина, "__ВыбиратьРазрешенные")
				.СПараметрамиНаСервере("M15", "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ ПЕРВЫЕ 5 1", 5, Истина, Истина, "__ВыбиратьРазрешенные")
			.ДобавитьСерверныйТест("ПолеCase")
