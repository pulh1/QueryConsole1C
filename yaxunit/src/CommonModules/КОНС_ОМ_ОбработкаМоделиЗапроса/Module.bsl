    Описание = Реестр.ОписаниеФункцииЗапроса("УНИКАЛЬНЫЙИДЕНТИФИКАТОР");
    ЮТест.ОжидаетЧто(Описание.ОграниченияТиповАргументов.Количество()).Равно(1);
