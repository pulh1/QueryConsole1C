// Проверяет согласованность проекции источника между полным парсером и семантическим анализатором.
//@skip-check module-structure-method-in-regions
Процедура СемантикаИсточниковПакетаСогласованаСПарсером() Экспорт

    Парсер = КОНС_ТестовыеФабрикиСлужебный.СоздатьПарсер();
    Пакет = Парсер.Разобрать(
        "ВЫБРАТЬ ФизическиеЛица.Ссылка ИЗ Справочник.ФизическиеЛица КАК ФизическиеЛица");

    //@skip-check undefined-variable
    ОбработкаМоделиЗапроса.ОбработатьМодельЗапроса(Пакет);

    Оператор = Пакет.Элементы[0].Операторы[0];
    Источник = Оператор.Источники[0];
    ЮТест.ОжидаетЧто(Источник.Источник.ИмяТаблицы)
        .Равно("Справочник.ФизическиеЛица", "Семантика должна сохранить identity таблицы");
    ЮТест.ОжидаетЧто(Источник.Источник.Псевдоним)
        .Равно("ФизическиеЛица", "Семантика должна сохранить явный alias источника");

    Поле = Оператор.ВыбираемыеПоля[0];
    ЮТест.ОжидаетЧто(Поле.Псевдоним)
        .Равно("Ссылка", "Семантика должна вывести alias выбираемого поля");
    ПолеИсточника = Поле.Выражение.Значение.Элементы[0];
    ЮТест.ОжидаетЧто(ПолеИсточника.Тип)
        .Равно("ПолеИсточника", "Разыменование должно разрешиться в поле источника");
    ЮТест.ОжидаетЧто(ПолеИсточника.ИмяПоля).Равно("Ссылка");
    ЮТест.ОжидаетЧто(ПолеИсточника.ИдентификаторИсточника)
        .Равно(Источник.ИдентификаторИсточника,
            "Разрешённое поле должно ссылаться на исходный source node");

КонецПроцедуры

// Проверяет полный каталог и независимость поиска от регистра.
//@skip-check module-structure-method-in-regions
Процедура КаталогОписывает48ОбщихФункций() Экспорт
    //@skip-check server-execution-safe-mode
    Утилиты = Вычислить("МодельЗапросаУтилиты");
    Имена = СтрРазделить(
        "ПОДСТРОКА,ГОД,КВАРТАЛ,МЕСЯЦ,ДЕНЬГОДА,ДЕНЬ,НЕДЕЛЯ,ДЕНЬНЕДЕЛИ,ЧАС,МИНУТА,СЕКУНДА,"
        + "ЕСТЬNULL,ПРЕДСТАВЛЕНИЕ,ПРЕДСТАВЛЕНИЕССЫЛКИ,ТИПЗНАЧЕНИЯ,ДАТАВРЕМЯ,"
        + "СУММА,СРЕДНЕЕ,МИНИМУМ,МАКСИМУМ,СТРОКА,ДЛИНАСТРОКИ,СОКРЛ,СОКРП,СОКРЛП,ЛЕВ,ПРАВ,"
        + "СТРНАЙТИ,СТРЗАМЕНИТЬ,ВРЕГ,НРЕГ,SIN,COS,TAN,ASIN,ACOS,ATAN,EXP,LOG,LOG10,SQRT,POW,"
        + "ОКР,ЦЕЛ,РАЗМЕРХРАНИМЫХДАННЫХ,УНИКАЛЬНЫЙИДЕНТИФИКАТОР,АВТОНОМЕРЗАПИСИ,СГРУППИРОВАНОПО", ",");
    ЮТест.ОжидаетЧто(Имена.Количество()).Равно(48);
    Для Каждого Имя Из Имена Цикл
        Описание = Утилиты.ОписаниеФункцииЗапроса(НРег(Имя));
        ЮТест.ОжидаетЧто(Описание).НеРавно(Неопределено, Имя);
        ЮТест.ОжидаетЧто(Описание.ИмяФункции).Равно(Имя);
        ЮТест.ОжидаетЧто(Описание.Арности.Количество() > 0).ЭтоИстина(Имя);
    КонецЦикла;
    ЮТест.ОжидаетЧто(Утилиты.ОписаниеФункцииЗапроса("НоваяФункция")).Равно(Неопределено);
КонецПроцедуры

// Проверяет обязательный контейнер аргументов, включая нулевой вызов.
