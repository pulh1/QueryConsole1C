Процедура ПроверитьОшибкуФункции(Текст, ОжидаемаяОшибка)
    //@skip-check server-execution-safe-mode
    МодульОбработки = Вычислить("ОбработкаМоделиЗапроса");
    //@skip-check server-execution-safe-mode
    МодульЭлементов = Вычислить("ЭлементыМоделиЗапроса");
    Парсер = КОНС_ТестовыеФабрикиСлужебный.СоздатьПарсер();
    Узел = Парсер.РазобратьВыражение(Текст);
    Свойства = МодульЭлементов.НовыйВыражениеМоделиЗапроса();
    ЮТест.ОжидаетЧто(МодульОбработки)
        .Метод("ОбработатьВыражение", ЮТМетоды.МассивПараметров(Узел, Новый Структура, Свойства,
            МодульОбработки.НовыеУсловияПримененияФункций()))
        .ВыбрасываетИсключение(ОжидаемаяОшибка, Текст);
КонецПроцедуры

Процедура ПроверитьЗапросФункции(Текст, ОжидаемаяОшибка = Неопределено)
    //@skip-check server-execution-safe-mode
    МодульОбработки = Вычислить("ОбработкаМоделиЗапроса");
    Парсер = КОНС_ТестовыеФабрикиСлужебный.СоздатьПарсер();
    Пакет = Парсер.Разобрать(Текст);
    Если ОжидаемаяОшибка = Неопределено Тогда
        МодульОбработки.ОбработатьМодельЗапроса(Пакет);
        //@skip-check server-execution-safe-mode
        Генерация = Вычислить("ГенерацияТекстовЗапросов");
        ПовторныйПакет = Парсер.Разобрать(Генерация.ТекстПакетаЗапросов(Пакет));
        МодульОбработки.ОбработатьМодельЗапроса(ПовторныйПакет);
    Иначе
        ЮТест.ОжидаетЧто(МодульОбработки)
            .Метод("ОбработатьМодельЗапроса", ЮТМетоды.МассивПараметров(Пакет))
            .ВыбрасываетИсключение(ОжидаемаяОшибка, Текст);
    КонецЕсли;
КонецПроцедуры

Функция РеестрФункцийДляТеста()
    ЮТест.ОжидаетЧто(Метаданные.ОбщиеМодули.Найти("РеестрФункцийЯзыкаЗапросов"))
        .НеРавно(Неопределено, "Каталог выделен в отдельный общий модуль");
    ЮТест.ОжидаетЧто(Метаданные.ОбщиеМодули.Найти("РеестрФункцийЯзыкаЗапросовПовтИсп"))
        .НеРавно(Неопределено, "Есть модуль повторного использования");
    //@skip-check server-execution-safe-mode
    Возврат Вычислить("РеестрФункцийЯзыкаЗапросовПовтИсп");
КонецФункции

Процедура ПроверитьОтсутствиеДанныхЗапроса(Контекст)
    Для Каждого Имя Из СтрРазделить("ЗапросВыбора,ОператорЗапроса,РольВыражения,КореньВыражения", ",") Цикл
        ЮТест.ОжидаетЧто(Контекст.Свойство(Имя)).ЭтоЛожь(Имя);
    КонецЦикла;
КонецПроцедуры

Функция НовыйОбщийУзел(ИмяФункции, Аргумент1 = Неопределено,
    Аргумент2 = Неопределено, Аргумент3 = Неопределено)
    //@skip-check server-execution-safe-mode
    Элементы = Вычислить("ЭлементыМоделиЗапроса");
    Узел = Элементы.НовыйВызовФункции();
    Узел.ИмяФункции = ИмяФункции;
    Для Каждого Аргумент Из ЮТМетоды.МассивПараметров(Аргумент1, Аргумент2, Аргумент3) Цикл
        Если Аргумент <> Неопределено Тогда
            Узел.Аргументы.Элементы.Добавить(Аргумент);
        КонецЕсли;
    КонецЦикла;
    Возврат Узел;
КонецФункции

Функция НовыйУзелКонстанты(Значение)
    //@skip-check server-execution-safe-mode
    МодульЭлементов = Вычислить("ЭлементыМоделиЗапроса");
    Узел = МодульЭлементов.НовыйКонстанта();
    Узел.Значение = Значение;
    Возврат Узел;
КонецФункции

Функция НовыйУзелПараметра(Имя)
    //@skip-check server-execution-safe-mode
    МодульЭлементов = Вычислить("ЭлементыМоделиЗапроса");
    Узел = МодульЭлементов.НовыйПараметрЗапроса();
    Узел.Имя = Имя;
    Возврат Узел;
КонецФункции

Функция НовыйБинарныйУзел(Операция, ЛеваяЧасть, ПраваяЧасть)
    //@skip-check server-execution-safe-mode
    МодульЭлементов = Вычислить("ЭлементыМоделиЗапроса");
    Узел = МодульЭлементов.НовыйБинарнаяОперация();
    Узел.Операция = Операция;
    Узел.ЛеваяЧасть = ЛеваяЧасть;
    Узел.ПраваяЧасть = ПраваяЧасть;
    Возврат Узел;
КонецФункции

Функция НовыйУзелАгрегатнойФункции(ИмяФункции, Аргумент)
    //@skip-check server-execution-safe-mode
    МодульЭлементов = Вычислить("ЭлементыМоделиЗапроса");
    Узел = МодульЭлементов.НовыйВызовФункции();
    Узел.ИмяФункции = ИмяФункции;
    Узел.Аргументы.Элементы.Добавить(Аргумент);
    Возврат Узел;
КонецФункции

Функция ОбработатьУзел(Узел, Контекст = Неопределено)
    //@skip-check server-execution-safe-mode
    МодульЭлементов = Вычислить("ЭлементыМоделиЗапроса");
    //@skip-check server-execution-safe-mode
    МодульОбработки = Вычислить("ОбработкаМоделиЗапроса");
    Если Контекст = Неопределено Тогда
        Контекст = Новый Структура;
    КонецЕсли;
    Результат = МодульЭлементов.НовыйВыражениеМоделиЗапроса();
    Результат.Значение = Узел;
    МодульОбработки.ОбработатьВыражение(Узел, Контекст, Результат,
        МодульОбработки.НовыеУсловияПримененияФункций());
    Возврат Результат;
КонецФункции

Функция МассивТипов(
    Тип1,
    Тип2 = Неопределено,
    Тип3 = Неопределено,
    Тип4 = Неопределено)

    Результат = Новый Массив;
    Результат.Добавить(Тип1);
    Если Тип2 <> Неопределено Тогда
        Результат.Добавить(Тип2);
    КонецЕсли;
    Если Тип3 <> Неопределено Тогда
        Результат.Добавить(Тип3);
    КонецЕсли;
    Если Тип4 <> Неопределено Тогда
        Результат.Добавить(Тип4);
    КонецЕсли;
    Возврат Результат;
КонецФункции

Процедура ПроверитьТипы(ОписаниеТипов, ОжидаемыеТипы, ОписаниеПроверки)
    ЮТест.ОжидаетЧто(ОписаниеТипов.Типы().Количество())
        .Равно(ОжидаемыеТипы.Количество(), ОписаниеПроверки);
    Для Каждого ОжидаемыйТип Из ОжидаемыеТипы Цикл
        ЮТест.ОжидаетЧто(ОписаниеТипов.СодержитТип(ОжидаемыйТип))
            .ЭтоИстина(ОписаниеПроверки);
    КонецЦикла;
КонецПроцедуры

Процедура ПроверитьПараметр(Результат, Имя, ОжидаемыеТипы, ЭтоСписокЗначений = Ложь)
    ОписаниеПараметра = Результат.ПараметрыЗапроса.Получить(ВРег(Имя));
    ЮТест.ОжидаетЧто(ОписаниеПараметра).НеРавно(Неопределено,
        "Параметр должен быть собран семантическим анализом");
    ЮТест.ОжидаетЧто(ОписаниеПараметра.Имя).Равно(Имя);
    ЮТест.ОжидаетЧто(ОписаниеПараметра.ЭтоСписокЗначений).Равно(ЭтоСписокЗначений);
    Если ОжидаемыеТипы <> Неопределено Тогда
        ПроверитьТипы(ОписаниеПараметра.ТипЗначения, ОжидаемыеТипы,
            "Параметр должен получить ожидаемые ограничения типа");
    КонецЕсли;
КонецПроцедуры

