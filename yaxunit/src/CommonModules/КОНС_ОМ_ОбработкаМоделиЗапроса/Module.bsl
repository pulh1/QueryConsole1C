Процедура ВыборОбъединяетТипыВетвей() Экспорт
    //@skip-check server-execution-safe-mode
    МодульЭлементов = Вычислить("ЭлементыМоделиЗапроса");

    Узел = МодульЭлементов.НовыйВыбор();
    Альтернатива = МодульЭлементов.НовыйАльтернативаВыбора();
    Альтернатива.Условие = НовыйУзелКонстанты(Истина);
    Альтернатива.Действие = НовыйУзелКонстанты(1);
    Узел.АльтернативыВыбора.Добавить(Альтернатива);
    Узел.Иначе = НовыйУзелКонстанты("Текст");
    Результат = ОбработатьУзел(Узел);
    ПроверитьТипы(Результат.ТипЗначения,
        МассивТипов(Тип("Число"), Тип("Строка")),
        "ВЫБОР должен объединять типы ветвей");

КонецПроцедуры

