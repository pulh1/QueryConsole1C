// Фабрики создают полный набор правил без полей положения в общем контексте.
Процедура УсловияПримененияФункцийИмеютЯвныйКонтракт() Экспорт
    //@skip-check server-execution-safe-mode
    Обработка = Вычислить("ОбработкаМоделиЗапроса");
    Условия = Обработка.НовыеУсловияПримененияФункций();
    ЮТест.ОжидаетЧто(Условия.ПроверятьКонтекстЗапроса).ЭтоЛожь();
    ЮТест.ОжидаетЧто(Условия.РазрешенАвтоНомерЗаписи).ЭтоЛожь();
    ЮТест.ОжидаетЧто(ТипЗнч(Условия.ВыраженияГруппировки)).Равно(Тип("Массив"));
    ЮТест.ОжидаетЧто(Условия.ВыраженияГруппировки.Количество()).Равно(0);
    Парсер = КОНС_ТестовыеФабрикиСлужебный.СоздатьПарсер();
    Запрос = Парсер.Разобрать("ВЫБРАТЬ 1 КАК X ПОМЕСТИТЬ ВТ").Элементы[0];
    Запрос.ТаблицаДляПомещения = "ВТ";
    Оператор = Запрос.Операторы[0];
    УсловияОператора = Обработка.УсловияПримененияФункцийОператора(Оператор);
    ЮТест.ОжидаетЧто(УсловияОператора.ПроверятьКонтекстЗапроса).ЭтоИстина();
    ЮТест.ОжидаетЧто(УсловияОператора.РазрешенАвтоНомерЗаписи).ЭтоЛожь();
    АвтоНомер = НовыйОбщийУзел("АВТОНОМЕРЗАПИСИ");
    УсловияПоля = Обработка.УсловияПримененияФункцийВыбираемогоПоля(Запрос, Оператор, АвтоНомер);
    ЮТест.ОжидаетЧто(УсловияПоля.РазрешенАвтоНомерЗаписи).ЭтоИстина();
    УсловияВложенногоВызова = Обработка.УсловияПримененияФункцийВыбираемогоПоля(
        Запрос, Оператор, НовыйОбщийУзел("СТРОКА", АвтоНомер));
    ЮТест.ОжидаетЧто(УсловияВложенногоВызова.РазрешенАвтоНомерЗаписи).ЭтоЛожь();
    ЮТест.ОжидаетЧто(УсловияОператора.РазрешенАвтоНомерЗаписи).ЭтоЛожь();
    ЮТест.ОжидаетЧто(Условия.ПроверятьКонтекстЗапроса).ЭтоЛожь();
КонецПроцедуры

// Успех и ошибка анализа не добавляют временное положение в общий контекст.
Процедура АнализЗапросаНеДобавляетПоложениеВКонтекст() Экспорт
    //@skip-check server-execution-safe-mode
    Обработка = Вычислить("ОбработкаМоделиЗапроса");
