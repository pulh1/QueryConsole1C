КонецПроцедуры

// Проверяет схему ограничений всех поддержанных функций.
Процедура ОграниченияТиповРеестраКорректны() Экспорт
    Реестр = РеестрФункцийДляТеста();
    Имена = СтрРазделить(
        "ПОДСТРОКА,ГОД,КВАРТАЛ,МЕСЯЦ,ДЕНЬГОДА,ДЕНЬ,НЕДЕЛЯ,ДЕНЬНЕДЕЛИ,ЧАС,МИНУТА,СЕКУНДА,"
        + "ЕСТЬNULL,ПРЕДСТАВЛЕНИЕ,ПРЕДСТАВЛЕНИЕССЫЛКИ,ТИПЗНАЧЕНИЯ,ДАТАВРЕМЯ,"
        + "СУММА,СРЕДНЕЕ,МИНИМУМ,МАКСИМУМ,СТРОКА,ДЛИНАСТРОКИ,СОКРЛ,СОКРП,СОКРЛП,ЛЕВ,ПРАВ,"
        + "СТРНАЙТИ,СТРЗАМЕНИТЬ,ВРЕГ,НРЕГ,SIN,COS,TAN,ASIN,ACOS,ATAN,EXP,LOG,LOG10,SQRT,POW,"
        + "ОКР,ЦЕЛ,РАЗМЕРХРАНИМЫХДАННЫХ,УНИКАЛЬНЫЙИДЕНТИФИКАТОР,АВТОНОМЕРЗАПИСИ,СГРУППИРОВАНОПО", ",");
    Для Каждого Имя Из Имена Цикл
        Описание = Реестр.ОписаниеФункцииЗапроса(Имя);
        ЮТест.ОжидаетЧто(ТипЗнч(Описание.ОграниченияТиповАргументов)).Равно(Тип("Соответствие"), Имя);
        МаксимумАргументов = 0;
        Для Каждого Количество Из Описание.ДопустимыеКоличестваАргументов Цикл
            МаксимумАргументов = Макс(МаксимумАргументов, Количество);
        КонецЦикла;
        Для Каждого Ограничение Из Описание.ОграниченияТиповАргументов Цикл
            ЮТест.ОжидаетЧто(ТипЗнч(Ограничение.Ключ)).Равно(Тип("Число"), Имя);
            ЮТест.ОжидаетЧто(Ограничение.Ключ = Цел(Ограничение.Ключ)
                И Ограничение.Ключ >= 1 И Ограничение.Ключ <= МаксимумАргументов).ЭтоИстина(Имя);
            ЮТест.ОжидаетЧто(ТипЗнч(Ограничение.Значение)).Равно(Тип("Массив"), Имя);
            ЮТест.ОжидаетЧто(Ограничение.Значение.Количество() > 0).ЭтоИстина(Имя);
            Для Каждого ИмяТипа Из Ограничение.Значение Цикл
                ЮТест.ОжидаетЧто(ТипЗнч(ИмяТипа)).Равно(Тип("Строка"), Имя);
            КонецЦикла;
        КонецЦикла;
    КонецЦикла;
КонецПроцедуры

// Номер позиции ограничений начинается с единицы.
Процедура ОграниченияТиповНумеруютсяСЕдиницы() Экспорт
    Реестр = РеестрФункцийДляТеста();
    Описание = Реестр.ОписаниеФункцииЗапроса("ЛЕВ");
    ЮТест.ОжидаетЧто(Описание.ОграниченияТиповАргументов.Получить(0)).Равно(Неопределено);
    ЮТест.ОжидаетЧто(Описание.ОграниченияТиповАргументов.Получить(1)[0]).Равно("Строка");
    ЮТест.ОжидаетЧто(Описание.ОграниченияТиповАргументов.Получить(2)[0]).Равно("Число");
    ЮТест.ОжидаетЧто(Описание.ОграниченияТиповАргументов.Получить(3)).Равно(Неопределено);
    Описание = Реестр.ОписаниеФункцииЗапроса("ОКР");
    ЮТест.ОжидаетЧто(Описание.ОграниченияТиповАргументов.Количество()).Равно(2);
    ЮТест.ОжидаетЧто(Описание.ОграниченияТиповАргументов.Получить(2)[0]).Равно("Число");
КонецПроцедуры

// Отсутствие записи сохраняет произвольный тип параметра.
Процедура ОтсутствиеОграниченияНеОграничиваетПараметр() Экспорт
    Реестр = РеестрФункцийДляТеста();
    Описание = Реестр.ОписаниеФункцииЗапроса("ЕСТЬNULL");
    ЮТест.ОжидаетЧто(Описание.ОграниченияТиповАргументов.Получить(1)).Равно(Неопределено);
    Результат = ОбработатьУзел(НовыйОбщийУзел("ЕСТЬNULL", НовыйУзелПараметра("Свободный"), НовыйУзелКонстанты(1)));
    ПроверитьПараметр(Результат, "Свободный", Неопределено);
КонецПроцедуры

// Проверяет разреженную вторую позицию и фактический вывод типа параметра.
Процедура ОграничениеВторогоАргументаВыводитТип() Экспорт
    //@skip-check server-execution-safe-mode
    Семантика = Вычислить("СемантическийАнализВыраженийУтилиты");
    Описание = Новый Структура;
    Описание.Вставить("ИмяФункции", "ТЕСТОВАЯ");
    Описание.Вставить("ОграниченияТиповАргументов", Новый Соответствие);
    Описание.ОграниченияТиповАргументов.Вставить(2, ЮТМетоды.МассивПараметров("Число"));
    Описание.Вставить("КоличествоАргументовДляВыводаТипа", 0);
    Описание.Вставить("ВозвращаемыйТип", Новый ОписаниеТипов("Число"));
    Узел = НовыйОбщийУзел("ТЕСТОВАЯ", НовыйУзелКонстанты("Свободный"), НовыйУзелПараметра("Числовой"));
    Типы = ЮТМетоды.МассивПараметров(Новый ОписаниеТипов("Строка"), Новый ОписаниеТипов("Число"));
    ПроверитьТипы(Семантика.ПроанализироватьВызовФункции(Узел, Описание, Типы),
        МассивТипов(Тип("Число")), "Разреженное ограничение");
    ЮТест.ОжидаетЧто(Семантика.ОписаниеТипаАргументаФункции(Описание.ОграниченияТиповАргументов.Получить(1)))
        .Равно(Неопределено);
    ПроверитьТипы(Семантика.ОписаниеТипаАргументаФункции(Описание.ОграниченияТиповАргументов.Получить(2)),
        МассивТипов(Тип("Число")), "Тип второй позиции");
    Типы[1] = Новый ОписаниеТипов("Строка");
    ЮТест.ОжидаетЧто(Семантика)
        .Метод("ПроанализироватьВызовФункции", ЮТМетоды.МассивПараметров(Узел, Описание, Типы))
        .ВыбрасываетИсключение("аргумента 2");
    Результат = ОбработатьУзел(НовыйОбщийУзел("ЛЕВ", НовыйУзелПараметра("Строка"), НовыйУзелПараметра("Длина")));
    ПроверитьПараметр(Результат, "Длина", МассивТипов(Тип("Число")));
КонецПроцедуры

// Представление из независимого запроса не является аргументом внешней функции.
