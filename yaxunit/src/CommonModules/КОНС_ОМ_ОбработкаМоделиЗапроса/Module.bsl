// Проверяет согласованность проекции источника между полным парсером и семантическим анализатором.
//@skip-check module-structure-method-in-regions
Процедура СемантикаИсточниковПакетаСогласованаСПарсером() Экспорт

    Парсер = КОНС_ТестовыеФабрикиСлужебный.СоздатьПарсер();
    Пакет = Парсер.Разобрать(
        "ВЫБРАТЬ ФизическиеЛица.Ссылка ИЗ Справочник.ФизическиеЛица КАК ФизическиеЛица");

    //@skip-check undefined-variable
    ОбработкаМоделиЗапроса.ОбработатьМодельЗапроса(Пакет);

    Оператор = Пакет.Элементы[0].Операторы[0];
    Источник = Оператор.Источники[0];
    ЮТест.ОжидаетЧто(Источник.Источник.ИмяТаблицы)
        .Равно("Справочник.ФизическиеЛица", "Семантика должна сохранить identity таблицы");
    ЮТест.ОжидаетЧто(Источник.Источник.Псевдоним)
        .Равно("ФизическиеЛица", "Семантика должна сохранить явный alias источника");

    Поле = Оператор.ВыбираемыеПоля[0];
    ЮТест.ОжидаетЧто(Поле.Псевдоним)
        .Равно("Ссылка", "Семантика должна вывести alias выбираемого поля");
    ПолеИсточника = Поле.Выражение.Значение.Элементы[0];
    ЮТест.ОжидаетЧто(ПолеИсточника.Тип)
        .Равно("ПолеИсточника", "Разыменование должно разрешиться в поле источника");
    ЮТест.ОжидаетЧто(ПолеИсточника.ИмяПоля).Равно("Ссылка");
    ЮТест.ОжидаетЧто(ПолеИсточника.ИдентификаторИсточника)
        .Равно(Источник.ИдентификаторИсточника,
            "Разрешённое поле должно ссылаться на исходный source node");

КонецПроцедуры

//@skip-check module-structure-method-in-regions
Процедура РеестрВозвращаетОписаниеСНовойСигнатурой() Экспорт
    Реестр = РеестрФункцийДляТеста();
    Описание = Реестр.ОписаниеФункцииЗапроса("датавремя");
    ЮТест.ОжидаетЧто(Описание.ИмяФункции).Равно("ДАТАВРЕМЯ");
    ЮТест.ОжидаетЧто(ТипЗнч(Описание.ДопустимыеКоличестваАргументов)).Равно(Тип("Массив"));
    ЮТест.ОжидаетЧто(Описание.ДопустимыеКоличестваАргументов.Количество()).Равно(2);
    ЮТест.ОжидаетЧто(Описание.ДопустимыеКоличестваАргументов[0]).Равно(3);
    ЮТест.ОжидаетЧто(Описание.ДопустимыеКоличестваАргументов[1]).Равно(6);
    ЮТест.ОжидаетЧто(ТипЗнч(Описание.ОграниченияТиповАргументов)).Равно(Тип("Соответствие"));
    ЮТест.ОжидаетЧто(Описание.ОграниченияТиповАргументов.Количество()).Равно(6);
    Для НомерАргумента = 1 По 6 Цикл
        ТипыПозиции = Описание.ОграниченияТиповАргументов.Получить(НомерАргумента);
        ЮТест.ОжидаетЧто(ТипЗнч(ТипыПозиции)).Равно(Тип("Массив"));
        ЮТест.ОжидаетЧто(ТипыПозиции.Количество()).Равно(1);
        ЮТест.ОжидаетЧто(ТипыПозиции[0]).Равно("Число");
    КонецЦикла;
    Для Каждого СтароеИмя Из СтрРазделить("Арности,Категория,ПравилоРезультата,ОграничениеАргументов,ТипыАргументов", ",") Цикл
        ЮТест.ОжидаетЧто(Описание.Свойство(СтароеИмя)).ЭтоЛожь(СтароеИмя);
    КонецЦикла;
    ПроверитьТипы(Описание.ВозвращаемыйТип, МассивТипов(Тип("Дата")), "Фиксированный результат");
    ЮТест.ОжидаетЧто(Реестр.ОписаниеФункцииЗапроса("НоваяФункция")).Равно(Неопределено);
КонецПроцедуры

