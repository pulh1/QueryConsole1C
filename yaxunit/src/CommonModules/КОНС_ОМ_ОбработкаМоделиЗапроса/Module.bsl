    Запрос = Парсер.Разобрать("ВЫБРАТЬ 1 КАК X УПОРЯДОЧИТЬ ПО 1").Элементы[0];
    Обработка.ОбработатьЗапрос(Запрос, Контекст);
    Для Каждого ИмяПоля Из СтрРазделить("ЗапросВыбора,ОператорЗапроса,РольВыражения", ",") Цикл
        ЮТест.ОжидаетЧто(Контекст.Свойство(ИмяПоля)).ЭтоЛожь(ИмяПоля);
    КонецЦикла;
    Запрос = Парсер.Разобрать("ВЫБРАТЬ АВТОНОМЕРЗАПИСИ() КАК X").Элементы[0];
    ЮТест.ОжидаетЧто(Обработка)
        .Метод("ОбработатьЗапрос", ЮТМетоды.МассивПараметров(Запрос, Контекст))
        .ВыбрасываетИсключение("АВТОНОМЕРЗАПИСИ");
    Для Каждого ИмяПоля Из СтрРазделить("ЗапросВыбора,ОператорЗапроса,РольВыражения", ",") Цикл
        ЮТест.ОжидаетЧто(Контекст.Свойство(ИмяПоля)).ЭтоЛожь(ИмяПоля);
    КонецЦикла;
КонецПроцедуры

// Отсутствие обязательных правил является ошибкой контракта.
Процедура НеопределенныеУсловияНеОтключаютПроверки() Экспорт
    //@skip-check server-execution-safe-mode
