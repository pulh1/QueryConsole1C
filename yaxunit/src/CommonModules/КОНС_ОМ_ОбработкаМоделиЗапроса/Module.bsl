#Область ТестовыйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

    ЮТТесты
        .ДобавитьТестовыйНабор("СемантикаЧистыеВыражения")
            .Тег("СемантикаЧистая")
            .ДобавитьСерверныйТест("ПримитивнаяКонстантаВыводитТип")
                .СПараметрамиНаСервере(1, "Число")
                .СПараметрамиНаСервере("Текст", "Строка")
                .СПараметрамиНаСервере(Истина, "Булево")
                .СПараметрамиНаСервере(Дата(2026, 1, 2), "Дата")
            .ДобавитьСерверныйТест("ПараметрБезОграниченияИмеетПроизвольныйТип")
            .ДобавитьСерверныйТест("АрифметикаВыводитТипПараметра")
            .ДобавитьСерверныйТест("СравнениеВозвращаетБулево")
            .ДобавитьСерверныйТест("ЛогическаяОперацияВыводитБулевоДляПараметра")
            .ДобавитьСерверныйТест("ПриведениеВозвращаетЗаданныйТип")
            .ДобавитьСерверныйТест("ВыборОбъединяетТипыВетвей")
            .ДобавитьСерверныйТест("МинимумСохраняетТипАргумента")
            .ДобавитьСерверныйТест("СуммаВозвращаетЧислоИОтмечаетАгрегат");

КонецПроцедуры

Процедура ПримитивнаяКонстантаВыводитТип(Значение, ИмяТипа) Экспорт

    Результат = ОбработатьУзел(НовыйУзелКонстанты(Значение));
    ПроверитьТипы(Результат.ТипЗначения, МассивТипов(Тип(ИмяТипа)),
        "Примитивная константа должна иметь ожидаемый тип");

КонецПроцедуры

Процедура ПараметрБезОграниченияИмеетПроизвольныйТип() Экспорт

    Результат = ОбработатьУзел(НовыйУзелПараметра("СвободныйПараметр"));
    ЮТест.ОжидаетЧто(МодельЗапросаТипы.СодержитПроизвольныйТип(Результат.ТипЗначения))
        .ЭтоИстина("Свободный параметр должен сохранять произвольный тип");
    ПроверитьПараметр(Результат, "СвободныйПараметр", Неопределено);

КонецПроцедуры

Процедура АрифметикаВыводитТипПараметра() Экспорт

    Узел = НовыйБинарныйУзел("+",
        НовыйУзелПараметра("Слагаемое"),
        НовыйУзелКонстанты(1));
    Результат = ОбработатьУзел(Узел);
    ПроверитьПараметр(Результат, "Слагаемое", МассивТипов(Тип("Число")));

КонецПроцедуры

Процедура СравнениеВозвращаетБулево() Экспорт

    Узел = НовыйБинарныйУзел("=",
        НовыйУзелКонстанты(1),
        НовыйУзелКонстанты(2));
    Результат = ОбработатьУзел(Узел);
    ПроверитьТипы(Результат.ТипЗначения, МассивТипов(Тип("Булево")),
        "Сравнение должно возвращать Булево");

КонецПроцедуры

Процедура ЛогическаяОперацияВыводитБулевоДляПараметра() Экспорт

    Узел = НовыйБинарныйУзел("И",
        НовыйУзелПараметра("Условие"),
        НовыйУзелКонстанты(Истина));
    Результат = ОбработатьУзел(Узел);
    ПроверитьТипы(Результат.ТипЗначения, МассивТипов(Тип("Булево")),
        "Логическая операция должна возвращать Булево");
    ПроверитьПараметр(Результат, "Условие", МассивТипов(Тип("Булево")));

КонецПроцедуры

Процедура ПриведениеВозвращаетЗаданныйТип() Экспорт

    Узел = ЭлементыМоделиЗапроса.НовыйПриведениеТипа();
    Узел.Выражение = НовыйУзелКонстанты(1);
    Узел.ОписаниеТипа = ЭлементыМоделиЗапроса.НовыйОписаниеТипаСтрока();
    Результат = ОбработатьУзел(Узел);
    ПроверитьТипы(Результат.ТипЗначения, МассивТипов(Тип("Строка")),
        "Приведение должно возвращать заданный тип");

КонецПроцедуры

Процедура ВыборОбъединяетТипыВетвей() Экспорт

    Узел = ЭлементыМоделиЗапроса.НовыйВыбор();
    Альтернатива = ЭлементыМоделиЗапроса.НовыйАльтернативаВыбора();
    Альтернатива.Условие = НовыйУзелКонстанты(Истина);
    Альтернатива.Действие = НовыйУзелКонстанты(1);
    Узел.АльтернативыВыбора.Добавить(Альтернатива);
    Узел.Иначе = НовыйУзелКонстанты("Текст");
    Результат = ОбработатьУзел(Узел);
    ПроверитьТипы(Результат.ТипЗначения,
        МассивТипов(Тип("Число"), Тип("Строка")),
        "ВЫБОР должен объединять типы ветвей");

КонецПроцедуры

Процедура МинимумСохраняетТипАргумента() Экспорт

    Результат = ОбработатьУзел(
        НовыйУзелАгрегатнойФункции("МИНИМУМ", НовыйУзелКонстанты("Текст")));
    ПроверитьТипы(Результат.ТипЗначения, МассивТипов(Тип("Строка")),
        "МИНИМУМ должен сохранять тип аргумента");

КонецПроцедуры

Процедура СуммаВозвращаетЧислоИОтмечаетАгрегат() Экспорт

    Результат = ОбработатьУзел(
        НовыйУзелАгрегатнойФункции("СУММА", НовыйУзелКонстанты(1)));
    ПроверитьТипы(Результат.ТипЗначения, МассивТипов(Тип("Число")),
        "СУММА должна возвращать Число");
    ЮТест.ОжидаетЧто(Результат.ИспользуетсяАгрегатнаяФункция)
        .ЭтоИстина("СУММА должна отмечать использование агрегатной функции");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыйУзелКонстанты(Значение)
    Узел = ЭлементыМоделиЗапроса.НовыйКонстанта();
    Узел.Значение = Значение;
    Возврат Узел;
КонецФункции

Функция НовыйУзелПараметра(Имя)
    Узел = ЭлементыМоделиЗапроса.НовыйПараметрЗапроса();
    Узел.Имя = Имя;
    Возврат Узел;
КонецФункции

Функция НовыйБинарныйУзел(Операция, ЛеваяЧасть, ПраваяЧасть)
    Узел = ЭлементыМоделиЗапроса.НовыйБинарнаяОперация();
    Узел.Операция = Операция;
    Узел.ЛеваяЧасть = ЛеваяЧасть;
    Узел.ПраваяЧасть = ПраваяЧасть;
    Возврат Узел;
КонецФункции

Функция НовыйУзелАгрегатнойФункции(ИмяФункции, Аргумент)
    Узел = ЭлементыМоделиЗапроса.НовыйАгрегатнаяФункция();
    Узел.ИмяФункции = ИмяФункции;
    Узел.Аргумент = Аргумент;
    Возврат Узел;
КонецФункции

Функция ОбработатьУзел(Узел, Контекст = Неопределено)
    Если Контекст = Неопределено Тогда
        Контекст = Новый Структура;
    КонецЕсли;
    Результат = ЭлементыМоделиЗапроса.НовыйВыражениеМоделиЗапроса();
    Результат.Значение = Узел;
    ОбработкаМоделиЗапроса.ОбработатьВыражение(Узел, Контекст, Результат);
    Возврат Результат;
КонецФункции

Функция МассивТипов(
    Тип1,
    Тип2 = Неопределено,
    Тип3 = Неопределено,
    Тип4 = Неопределено)

    Результат = Новый Массив;
    Результат.Добавить(Тип1);
    Если Тип2 <> Неопределено Тогда
        Результат.Добавить(Тип2);
    КонецЕсли;
    Если Тип3 <> Неопределено Тогда
        Результат.Добавить(Тип3);
    КонецЕсли;
    Если Тип4 <> Неопределено Тогда
        Результат.Добавить(Тип4);
    КонецЕсли;
    Возврат Результат;
КонецФункции

Процедура ПроверитьТипы(ОписаниеТипов, ОжидаемыеТипы, ОписаниеПроверки)
    ЮТест.ОжидаетЧто(ОписаниеТипов.Типы().Количество())
        .Равно(ОжидаемыеТипы.Количество(), ОписаниеПроверки);
    Для Каждого ОжидаемыйТип Из ОжидаемыеТипы Цикл
        ЮТест.ОжидаетЧто(ОписаниеТипов.СодержитТип(ОжидаемыйТип))
            .ЭтоИстина(ОписаниеПроверки);
    КонецЦикла;
КонецПроцедуры

Процедура ПроверитьПараметр(Результат, Имя, ОжидаемыеТипы, ЭтоСписокЗначений = Ложь)
    ОписаниеПараметра = Результат.ПараметрыЗапроса.Получить(ВРег(Имя));
    ЮТест.ОжидаетЧто(ОписаниеПараметра).НеРавно(Неопределено,
        "Параметр должен быть собран семантическим анализом");
    ЮТест.ОжидаетЧто(ОписаниеПараметра.Имя).Равно(Имя);
    ЮТест.ОжидаетЧто(ОписаниеПараметра.ЭтоСписокЗначений).Равно(ЭтоСписокЗначений);
    Если ОжидаемыеТипы <> Неопределено Тогда
        ПроверитьТипы(ОписаниеПараметра.ТипЗначения, ОжидаемыеТипы,
            "Параметр должен получить ожидаемые ограничения типа");
    КонецЕсли;
КонецПроцедуры

#КонецОбласти
