// Проверяет 0/1/2/3 аргумента и вложенный вызов через реальный семантический обход.
//@skip-check module-structure-method-in-regions
Процедура ОбщийВызовСохраняетБалансТипов() Экспорт
    Результат = ОбработатьУзел(НовыйОбщийУзел("АВТОНОМЕРЗАПИСИ"));
    ПроверитьТипы(Результат.ТипЗначения, МассивТипов(Тип("Число")), "Нулевой вызов");
    Степень = НовыйОбщийУзел("POW", НовыйУзелКонстанты(2), НовыйУзелКонстанты(3));
    Результат = ОбработатьУзел(НовыйОбщийУзел("СТРОКА", Степень));
    ПроверитьТипы(Результат.ТипЗначения, МассивТипов(Тип("Строка")), "Вложенный вызов");
    Результат = ОбработатьУзел(НовыйОбщийУзел("СТРЗАМЕНИТЬ",
        НовыйУзелКонстанты("abc"), НовыйУзелКонстанты("b"), НовыйУзелКонстанты("x")));
    ПроверитьТипы(Результат.ТипЗначения, МассивТипов(Тип("Строка")), "Три аргумента");
    Результат = ОбработатьУзел(НовыйОбщийУзел("МИНИМУМ", НовыйУзелКонстанты("Текст")));
    ПроверитьТипы(Результат.ТипЗначения, МассивТипов(Тип("Строка")), "Тип аргумента MIN");
    ЮТест.ОжидаетЧто(Результат.ИспользуетсяАгрегатнаяФункция).ЭтоИстина();
КонецПроцедуры

// Неправильная арность должна определяться раньше обхода ошибочного дочернего узла.
//@skip-check module-structure-method-in-regions
Процедура ОбщийВызовПроверяетАрностьДоОбхода() Экспорт
    //@skip-check server-execution-safe-mode
    МодульОбработки = Вычислить("ОбработкаМоделиЗапроса");
    //@skip-check server-execution-safe-mode
    Элементы = Вычислить("ЭлементыМоделиЗапроса");
    Узел = НовыйОбщийУзел("ГОД", Новый Структура("Тип", "НеизвестныйУзел"),
        НовыйУзелКонстанты(1));
    РассчитываемыеСвойства = Элементы.НовыйВыражениеМоделиЗапроса();
    ЮТест.ОжидаетЧто(МодульОбработки)
        .Метод("ОбработатьВыражение", ЮТМетоды.МассивПараметров(
            Узел, Новый Структура, РассчитываемыеСвойства))
        .ВыбрасываетИсключение("Функция ГОД: недопустимое количество аргументов");
КонецПроцедуры

