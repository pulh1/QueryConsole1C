#Область ПрограммныйИнтерфейс

// Регистрирует серверные контракты прикладных потребителей модели запроса.
Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Прикладные потребители запроса")
			.Тег("ПрикладныеПотребителиЗапроса")
			.ДобавитьСерверныйТест("КонсольВыполняетМинимальныйЗапросБезФормы")
			.ДобавитьСерверныйТест("КонсольПреобразуетПланВМетаданныеБезФормы")
			.ДобавитьСерверныйТест("СхемаЗапросаВозвращаетсяДляВложеннойПозиции")
			.ДобавитьСерверныйТест("ДоступныеТаблицыРаскрываютсяБезФормы")
			.ДобавитьСерверныйТест("ИсточникиРаскрываютсяБезФормы")
			.ДобавитьСерверныйТест("ГенераторFeatureФайловФормируетЭталонПакетаЗапроса");

КонецПроцедуры

// Подтверждает полный object-call контракт выполнения минимального запроса.
Процедура КонсольВыполняетМинимальныйЗапросБезФормы() Экспорт

	//@skip-check server-execution-safe-mode
	Консоль = Вычислить("Обработки.КонсольЗапросов.Создать()");

	ПараметрыЗапроса = Новый Массив();
	ТабличныйДокументРезультата = Новый ТабличныйДокумент();
	ПараметрыВывода = Новый Структура();
	ПараметрыВывода.Вставить("ВыводитьВременныеТаблицы", Ложь);
	ПараметрыВывода.Вставить("ВыводитьИдентификатор", Ложь);
	ПараметрыВывода.Вставить("ПорядокОбхода", "АВТО");
	ПараметрыВывода.Вставить("ИспользованиеЧередования", Ложь);
	ПараметрыВывода.Вставить("ВыводитьРезультатыЗапроса", -1);

	Отчет = Новый Структура();
	Отчет.Вставить("КоличествоСтрок", 0);
	Отчет.Вставить("ВремяВыполнения", 0);
	Отчет.Вставить("ТекстСообщения", "");

	Результаты = Консоль.ВыполнитьЗапрос(
		"ВЫБРАТЬ 1 КАК Значение",
		ПараметрыЗапроса,
		ТабличныйДокументРезультата,
		ПараметрыВывода,
		Отчет,
		"");

	ЮТест.ОжидаетЧто(Результаты.Количество()).Равно(1);
	ТаблицаРезультата = Результаты[0].Выгрузить();
	ЮТест.ОжидаетЧто(ТаблицаРезультата.Колонки.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(ТаблицаРезультата.Колонки[0].Имя).Равно("Значение");
	ЮТест.ОжидаетЧто(ТаблицаРезультата.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(ТаблицаРезультата[0].Значение).Равно(1);
	ЮТест.ОжидаетЧто(Отчет.КоличествоСтрок).Равно(1);
	ЮТест.ОжидаетЧто(Отчет.ТекстСообщения).Равно("");

КонецПроцедуры

// Подтверждает замену физических таблиц и полей при сохранении стоимости плана.
Процедура КонсольПреобразуетПланВМетаданныеБезФормы() Экспорт

	//@skip-check server-execution-safe-mode
	Консоль = Вычислить("Обработки.КонсольЗапросов.Создать()");
	СтрокаХранения = СтрокаХраненияФизическихЛиц();
	ПолеХранения = ПолеХраненияПоИмени(СтрокаХранения, "Ссылка");

	ТекстSQL = "SELECT " + ПолеХранения.ИмяПоляХранения
		+ " FROM " + СтрокаХранения.ИмяТаблицыХранения;
	План = "Node=" + СтрокаХранения.ИмяТаблицыХранения
		+ ";Field=" + ПолеХранения.ИмяПоляХранения
		+ ";Cost=17";

	Результат = Консоль.ПреобразоватьВМетаданные(ТекстSQL, План, "DBFILE");

	ЮТест.ОжидаетЧто(Результат.ТекстЗапросаВВидеМетаданных)
		.Равно("SELECT Ссылка FROM Справочник.ФизическиеЛица");
	ЮТест.ОжидаетЧто(Результат.ПланВыполненияЗапросаВМетаданных)
		.Равно("Node=Справочник.ФизическиеЛица;Field=Ссылка;Cost=17");

КонецПроцедуры

// Подтверждает навигацию к вложенному запросу по паре индексов оператор/источник.
Процедура СхемаЗапросаВозвращаетсяДляВложеннойПозиции() Экспорт

	//@skip-check server-execution-safe-mode
	Конструктор = Вычислить("Обработки.КонструкторЗапросов.Создать()");
	Схема = Новый СхемаЗапроса();
	Схема.УстановитьТекстЗапроса(
		"ВЫБРАТЬ Второй.Ссылка КАК Ссылка "
		+ "ИЗ (ВЫБРАТЬ 1 КАК Маркер) КАК Первый, "
		+ "(ВЫБРАТЬ ФизическиеЛица.Ссылка КАК Ссылка "
		+ "ИЗ Справочник.ФизическиеЛица КАК ФизическиеЛица) КАК Второй");

	ВерхнийЗапрос = Схема.ПакетЗапросов[0];
	ОжидаемыйВложенныйЗапрос =
		ВерхнийЗапрос.Операторы[0].Источники[1].Источник.Запрос;

	Позиции = Новый Массив();
	Позиции.Добавить(0);
	Позиции.Добавить(1);
	АдресПозиций = ПоместитьВоВременноеХранилище(Позиции);

	ВложенныйЗапрос = Конструктор.GetSchemaQuery(Схема, 0, АдресПозиций);

	ЮТест.ОжидаетЧто(ТипЗнч(ВложенныйЗапрос))
		.Равно(ТипЗнч(ОжидаемыйВложенныйЗапрос));
	ЮТест.ОжидаетЧто(ВерхнийЗапрос.Операторы[0].Источники.Количество()).Равно(2);
	ЮТест.ОжидаетЧто(
		ВерхнийЗапрос.Операторы[0].Источники[0].Источник.Запрос
			.Операторы[0].Источники.Количество()).Равно(0);
	ЮТест.ОжидаетЧто(ВложенныйЗапрос.Операторы.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(ВложенныйЗапрос.Операторы[0].Источники.Количество()).Равно(1);
	СохраненныеПозиции = ПолучитьИзВременногоХранилища(АдресПозиций);
	ЮТест.ОжидаетЧто(СохраненныеПозиции.Количество()).Равно(2);
	ЮТест.ОжидаетЧто(СохраненныеПозиции[0]).Равно(0);
	ЮТест.ОжидаетЧто(СохраненныеПозиции[1]).Равно(1);
	УдалитьИзВременногоХранилища(АдресПозиций);

КонецПроцедуры

// Подтверждает раскрытие группы доступных таблиц через публичный object-call.
Процедура ДоступныеТаблицыРаскрываютсяБезФормы() Экспорт

	ЮТест.Пропустить(
		"Требуется ДанныеФормыДерево: ДеревоЗначений не поддерживает FindByID");

	//@skip-check server-execution-safe-mode
	Конструктор = Вычислить("Обработки.КонструкторЗапросов.Создать()");
	Схема = Новый СхемаЗапроса();
	ЗапросСхемы = Схема.ПакетЗапросов.Добавить(Тип("ЗапросВыбораСхемыЗапроса"));

	Дерево = ДеревоДоступныхТаблиц();
	Корень = Дерево.Строки.Добавить();
	Корень.Type = 0;
	Корень.Index = ИндексГруппыДоступнойТаблицы(
		ЗапросСхемы.ДоступныеТаблицы,
		"Справочник.ФизическиеЛица");

	Конструктор.AvailableTablesBeforeExpandAtServer(
		Неопределено,
		0,
		Неопределено,
		Неопределено,
		Дерево,
		1,
		Истина,
		Неопределено,
		Неопределено,
		ЗапросСхемы);

	СтрокаТаблицы = НайтиСтрокуПоИмени(
		Корень.Строки,
		"Справочник.ФизическиеЛица");
	ЮТест.ОжидаетЧто(СтрокаТаблицы).НеРавно(Неопределено,
		"Раскрытая группа должна содержать Справочник.ФизическиеЛица");
	ЮТест.ОжидаетЧто(СтрокаТаблицы.Name).Равно("Справочник.ФизическиеЛица");

КонецПроцедуры

// Подтверждает раскрытие таблицы-источника и сохранение её идентичности.
Процедура ИсточникиРаскрываютсяБезФормы() Экспорт

	ЮТест.Пропустить(
		"Требуется ДанныеФормыДерево: ДеревоЗначений не поддерживает FindByID");

	//@skip-check server-execution-safe-mode
	Конструктор = Вычислить("Обработки.КонструкторЗапросов.Создать()");
	Схема = Новый СхемаЗапроса();
	Схема.УстановитьТекстЗапроса(
		"ВЫБРАТЬ ФизическиеЛица.Ссылка КАК Ссылка "
		+ "ИЗ Справочник.ФизическиеЛица КАК ФизическиеЛица");
	ЗапросСхемы = Схема.ПакетЗапросов[0];

	Дерево = ДеревоИсточников();
	Корень = Дерево.Строки.Добавить();
	Корень.Type = 0;
	Корень.Index = 0;

	Конструктор.SourcesBeforeExpandAtServer(
		Неопределено,
		0,
		0,
		Неопределено,
		Неопределено,
		Дерево,
		1,
		Неопределено,
		Неопределено,
		ЗапросСхемы);

	ЮТест.ОжидаетЧто(Корень.Строки.Количество()).Равно(1);
	СтрокаИсточника = Корень.Строки[0];
	ЮТест.ОжидаетЧто(СтрокаИсточника.Index).Равно(0);
	ЮТест.ОжидаетЧто(СтрокаИсточника.Name).Равно("ФизическиеЛица");
	ЮТест.ОжидаетЧто(СтрокаИсточника.TableName)
		.Равно("Справочник.ФизическиеЛица");
	ЮТест.ОжидаетЧто(СтрокаИсточника.ValueType).Равно("QuerySchemaTable");

КонецПроцедуры

// Подтверждает литеральный golden feature-текста для одного источника и поля.
Процедура ГенераторFeatureФайловФормируетЭталонПакетаЗапроса() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	//@skip-check server-execution-safe-mode
	Генератор = Вычислить("Обработки.ГенераторFeatureФайлов.Создать()");
	УстановитьПривилегированныйРежим(Ложь);

	//@skip-check server-execution-safe-mode
	МодульГенерации = Вычислить("ГенерацияТекстовЗапросов");
	Генератор.УстановитьГенераторТекстовВыражений(
		МодульГенерации.СоздатьГенераторТекстовВыражений());

	ТекстовыйДокумент = Новый ТекстовыйДокумент();
	Генератор.УстановитьТекстовыйДокумент(ТекстовыйДокумент);
	Генератор.СценарийСозданияПакетаЗапросаВТекДок(
		"ВЫБРАТЬ ФизическиеЛица.Ссылка КАК Ссылка "
		+ "ИЗ Справочник.ФизическиеЛица КАК ФизическиеЛица");

	Результат = ТекстовыйДокумент.ПолучитьТекст();
	ЮТест.ОжидаетЧто(СтрЧислоСтрок(Результат)).Равно(2);
	ЮТест.ОжидаетЧто(СтрПолучитьСтроку(Результат, 1)).Равно(
		"И Я добавляю источник ""Справочник.ФизическиеЛица"" как "
		+ """ФизическиеЛица"" в конструкторе запроса");
	ЮТест.ОжидаетЧто(СтрПолучитьСтроку(Результат, 2)).Равно(
		"И Я добавляю поле запроса ""ФизическиеЛица.Ссылка"" как "
		+ """Ссылка"" в конструкторе запроса");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СтрокаХраненияФизическихЛиц()

	СтруктураХранения = ПолучитьСтруктуруХраненияБазыДанных(, Истина);
	Для Каждого СтрокаХранения Из СтруктураХранения Цикл
		Если СтрокаХранения.ИмяТаблицы = "Справочник.ФизическиеЛица" Тогда
			Возврат СтрокаХранения;
		КонецЕсли;
	КонецЦикла;

	ВызватьИсключение "В структуре хранения не найден Справочник.ФизическиеЛица";

КонецФункции

Функция ПолеХраненияПоИмени(СтрокаХранения, ИмяПоля)

	Для Каждого ПолеХранения Из СтрокаХранения.Поля Цикл
		Если ПолеХранения.ИмяПоля = ИмяПоля Тогда
			Возврат ПолеХранения;
		КонецЕсли;
	КонецЦикла;

	ВызватьИсключение "В структуре хранения не найдено поле " + ИмяПоля;

КонецФункции

Функция ДеревоДоступныхТаблиц()

	Дерево = Новый ДеревоЗначений();
	Дерево.Колонки.Добавить("Type");
	Дерево.Колонки.Добавить("Presentation");
	Дерево.Колонки.Добавить("Name");
	Дерево.Колонки.Добавить("Index");
	Возврат Дерево;

КонецФункции

Функция ДеревоИсточников()

	Дерево = Новый ДеревоЗначений();
	Дерево.Колонки.Добавить("Type");
	Дерево.Колонки.Добавить("Index");
	Дерево.Колонки.Добавить("Presentation");
	Дерево.Колонки.Добавить("ValueType");
	Дерево.Колонки.Добавить("Name");
	Дерево.Колонки.Добавить("TableName");
	Возврат Дерево;

КонецФункции

Функция ИндексГруппыДоступнойТаблицы(ДоступныеТаблицы, ИмяТаблицы)

	Для Индекс = 0 По ДоступныеТаблицы.Количество() - 1 Цикл
		Элемент = ДоступныеТаблицы.Получить(Индекс);
		Если ТипЗнч(Элемент) = Тип("QuerySchemaAvailableTablesGroup")
			И Элемент.Content.Find(ИмяТаблицы) <> Неопределено Тогда
			Возврат Индекс;
		КонецЕсли;
	КонецЦикла;

	ВызватьИсключение "Не найдена группа доступной таблицы " + ИмяТаблицы;

КонецФункции

Функция НайтиСтрокуПоИмени(Строки, Имя)

	Для Каждого СтрокаДерева Из Строки Цикл
		Если СтрокаДерева.Name = Имя Тогда
			Возврат СтрокаДерева;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

#КонецОбласти
