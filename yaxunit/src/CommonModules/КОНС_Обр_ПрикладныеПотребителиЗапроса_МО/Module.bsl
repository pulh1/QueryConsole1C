// Подтверждает полный object-call контракт выполнения минимального запроса.
Процедура КонсольВыполняетМинимальныйЗапросБезФормы() Экспорт

	//@skip-check server-execution-safe-mode
	Консоль = Вычислить("Обработки.КонсольЗапросов.Создать()");

	ПараметрыЗапроса = Новый Массив();
	ТабличныйДокументРезультата = Новый ТабличныйДокумент();
	ПараметрыВывода = Новый Структура();
	ПараметрыВывода.Вставить("ВыводитьВременныеТаблицы", Ложь);
	ПараметрыВывода.Вставить("ВыводитьИдентификатор", Ложь);
	ПараметрыВывода.Вставить("ПорядокОбхода", "АВТО");
	ПараметрыВывода.Вставить("ИспользованиеЧередования", Ложь);
	ПараметрыВывода.Вставить("ВыводитьРезультатыЗапроса", -1);

	Отчет = Новый Структура();
	Отчет.Вставить("КоличествоСтрок", 0);
	Отчет.Вставить("ВремяВыполнения", 0);
	Отчет.Вставить("ТекстСообщения", "");

	Результаты = Консоль.ВыполнитьЗапрос(
		"ВЫБРАТЬ 1 КАК Значение",
		ПараметрыЗапроса,
		ТабличныйДокументРезультата,
		ПараметрыВывода,
		Отчет,
		"");

	ЮТест.ОжидаетЧто(Результаты.Количество()).Равно(1);
	ТаблицаРезультата = Результаты[0].Выгрузить();
	ЮТест.ОжидаетЧто(ТаблицаРезультата.Колонки.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(ТаблицаРезультата.Колонки[0].Имя).Равно("Значение");
	ЮТест.ОжидаетЧто(ТаблицаРезультата.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(ТаблицаРезультата[0].Значение).Равно(1);
	ЮТест.ОжидаетЧто(Отчет.КоличествоСтрок).Равно(1);
	ЮТест.ОжидаетЧто(Отчет.ТекстСообщения).Равно("");

КонецПроцедуры

// Подтверждает замену физических таблиц и полей при сохранении стоимости плана.
Процедура КонсольПреобразуетПланВМетаданныеБезФормы() Экспорт

	//@skip-check server-execution-safe-mode
	Консоль = Вычислить("Обработки.КонсольЗапросов.Создать()");
	СтрокаХранения = СтрокаХраненияФизическихЛиц();
	ПолеХранения = ПолеХраненияПоИмени(СтрокаХранения, "Ссылка");

	ТекстSQL = "SELECT " + ПолеХранения.ИмяПоляХранения
		+ " FROM " + СтрокаХранения.ИмяТаблицыХранения;
	План = "Node=" + СтрокаХранения.ИмяТаблицыХранения
		+ ";Field=" + ПолеХранения.ИмяПоляХранения
		+ ";Cost=17";

	Результат = Консоль.ПреобразоватьВМетаданные(ТекстSQL, План, "DBFILE");

	ЮТест.ОжидаетЧто(Результат.ТекстЗапросаВВидеМетаданных)
		.Равно("SELECT Ссылка FROM Справочник.ФизическиеЛица");
	ЮТест.ОжидаетЧто(Результат.ПланВыполненияЗапросаВМетаданных)
		.Равно("Node=Справочник.ФизическиеЛица;Field=Ссылка;Cost=17");

КонецПроцедуры

// Подтверждает навигацию к вложенному запросу по паре индексов оператор/источник.
Процедура СхемаЗапросаВозвращаетсяДляВложеннойПозиции() Экспорт

	//@skip-check server-execution-safe-mode
	Конструктор = Вычислить("Обработки.КонструкторЗапросов.Создать()");
	Схема = Новый СхемаЗапроса();
	Схема.УстановитьТекстЗапроса(
		"ВЫБРАТЬ Второй.Ссылка КАК Ссылка "
		+ "ИЗ (ВЫБРАТЬ 1 КАК Маркер) КАК Первый, "
		+ "(ВЫБРАТЬ ФизическиеЛица.Ссылка КАК Ссылка "
		+ "ИЗ Справочник.ФизическиеЛица КАК ФизическиеЛица) КАК Второй");

	ВерхнийЗапрос = Схема.ПакетЗапросов[0];
	ОжидаемыйВложенныйЗапрос =
		ВерхнийЗапрос.Операторы[0].Источники[1].Источник.Запрос;

	Позиции = Новый Массив();
	Позиции.Добавить(0);
	Позиции.Добавить(1);
	АдресПозиций = ПоместитьВоВременноеХранилище(Позиции);

	ВложенныйЗапрос = Конструктор.GetSchemaQuery(Схема, 0, АдресПозиций);

	ЮТест.ОжидаетЧто(ТипЗнч(ВложенныйЗапрос))
		.Равно(ТипЗнч(ОжидаемыйВложенныйЗапрос));
	ЮТест.ОжидаетЧто(ВерхнийЗапрос.Операторы[0].Источники.Количество()).Равно(2);
	ЮТест.ОжидаетЧто(
		ВерхнийЗапрос.Операторы[0].Источники[0].Источник.Запрос
			.Операторы[0].Источники.Количество()).Равно(0);
	ЮТест.ОжидаетЧто(ВложенныйЗапрос.Операторы.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(ВложенныйЗапрос.Операторы[0].Источники.Количество()).Равно(1);
	СохраненныеПозиции = ПолучитьИзВременногоХранилища(АдресПозиций);
	ЮТест.ОжидаетЧто(СохраненныеПозиции.Количество()).Равно(2);
	ЮТест.ОжидаетЧто(СохраненныеПозиции[0]).Равно(0);
	ЮТест.ОжидаетЧто(СохраненныеПозиции[1]).Равно(1);
	УдалитьИзВременногоХранилища(АдресПозиций);

КонецПроцедуры

// Проверяет отображение разных узлов каталога без переноса данных поставщиков.
Процедура ФасадФормыПреобразуетЭлементыКаталогаВСтроки() Экспорт

	//@skip-check server-execution-safe-mode
	МетаданныеКаталога = Вычислить("МетаданныеТаблицЗапроса");
	//@skip-check server-execution-safe-mode
	Фасад = Вычислить("КонструкторЗапросовФормы");

	СтандартнаяГруппа = МетаданныеКаталога.НовыйЭлементКаталога(
		"Справочник", Неопределено, Неопределено, "Справочник",
		Истина, Истина, "СтандартнаяГруппа");
	СтандартнаяТаблица = МетаданныеКаталога.НовыйЭлементКаталога(
		"Справочник.ФизическиеЛица", "Справочник", "Справочник.ФизическиеЛица",
		"ФизическиеЛица", Ложь, Истина, "СтандартнаяТаблица");
	ИсполняемаяГруппа = МетаданныеКаталога.НовыйЭлементКаталога(
		"РегистрыНакопления", Неопределено, Неопределено, "РегистрыНакопления",
		Истина, Истина, "ИсполняемаяГруппа");
	ИсполняемаяТаблица = МетаданныеКаталога.НовыйЭлементКаталога(
		"ИсполняемоеПредставление.Таблица", "Группа",
		"ИсполняемоеПредставление.Таблица", "Таблица",
		Ложь, Истина, "ИсполняемоеПредставление");

	СтрокаСтандартнойГруппы = Фасад.ОписаниеСтрокиКаталога(СтандартнаяГруппа);
	СтрокаСтандартнойТаблицы = Фасад.ОписаниеСтрокиКаталога(СтандартнаяТаблица);
	СтрокаИсполняемойГруппы = Фасад.ОписаниеСтрокиКаталога(ИсполняемаяГруппа);
	СтрокаИсполняемойТаблицы = Фасад.ОписаниеСтрокиКаталога(ИсполняемаяТаблица);

	ЮТест.ОжидаетЧто(ТипЗнч(СтрокаСтандартнойГруппы.ТипЗначения))
		.Равно(Тип("ОписаниеТипов"));
	ЮТест.ОжидаетЧто(СтрокаСтандартнойГруппы.ТипЗначения.СодержитТип(
		Тип("ГруппаДоступныхТаблицСхемыЗапроса"))).ЭтоИстина();
	ЮТест.ОжидаетЧто(СтрокаСтандартнойГруппы.ЕстьДочерние).ЭтоИстина();
	ЮТест.ОжидаетЧто(СтрокаСтандартнойТаблицы.Имя)
		.Равно("Справочник.ФизическиеЛица");
	ЮТест.ОжидаетЧто(ТипЗнч(СтрокаСтандартнойТаблицы.ТипЗначения))
		.Равно(Тип("ОписаниеТипов"));
	ЮТест.ОжидаетЧто(СтрокаСтандартнойТаблицы.ТипЗначения.СодержитТип(
		Тип("ДоступнаяТаблицаСхемыЗапроса"))).ЭтоИстина();
	ЮТест.ОжидаетЧто(СтрокаИсполняемойГруппы.ЭтоГруппаИсполняемыхПредставлений)
		.ЭтоИстина();
	ЮТест.ОжидаетЧто(СтрокаИсполняемойГруппы.Картинка).Равно(20);
	ЮТест.ОжидаетЧто(СтрокаИсполняемойТаблицы.ЭтоИсполняемоеПредставление)
		.ЭтоИстина();
	ЮТест.ОжидаетЧто(СтрокаИсполняемойТаблицы.Картинка).Равно(18);

	ОписанияСтрок = Новый Массив;
	ОписанияСтрок.Добавить(СтрокаСтандартнойГруппы);
	ОписанияСтрок.Добавить(СтрокаСтандартнойТаблицы);
	ОписанияСтрок.Добавить(СтрокаИсполняемойГруппы);
	ОписанияСтрок.Добавить(СтрокаИсполняемойТаблицы);
	Для Каждого ОписаниеСтроки Из ОписанияСтрок Цикл
		ЮТест.ОжидаетЧто(ОписаниеСтроки.Свойство("ДанныеПоставщика")).ЭтоЛожь();
	КонецЦикла;

КонецПроцедуры

// Проверяет отображение нейтрального вложенного поля без сырого объекта платформы.
Процедура ФасадФормыПреобразуетНейтральноеПолеВСтроку() Экспорт

	//@skip-check server-execution-safe-mode
	МетаданныеКаталога = Вычислить("МетаданныеТаблицЗапроса");
	//@skip-check server-execution-safe-mode
	Фасад = Вычислить("КонструкторЗапросовФормы");
	ВложенноеПоле = МетаданныеКаталога.НовыйОписаниеПоля(
		"Начисления",
		"Начисления",
		МетаданныеКаталога.ВидПоляВложеннаяТаблица(),
		Неопределено,
		"");
	ВложенноеПоле.Поля.Добавить(МетаданныеКаталога.НовыйОписаниеПоля("ВидРасчета"));

	ОписаниеСтроки = Фасад.ОписаниеСтрокиПоля(ВложенноеПоле);

