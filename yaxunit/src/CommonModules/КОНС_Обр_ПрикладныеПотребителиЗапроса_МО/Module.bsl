// Проверяет, что стандартная группа раскрывается через каталог поставщика.
Процедура ФасадФормыЛенивоРаскрываетСтандартнуюГруппу() Экспорт

	//@skip-check server-execution-safe-mode
	Фасад = Вычислить("КонструкторЗапросовФормы");
	Контекст = Фасад.НовыйКонтекстМетаданныхUI();
	КорневыеСтроки = Фасад.ОписанияКорневыхСтрокКаталога(Контекст);

	ДочерниеСтроки = Фасад.ОписанияДочернихСтрокКаталога(
		Контекст,
		КорневыеСтроки[0]);

	СтрокаФизическихЛиц = Неопределено;
	Для Каждого ОписаниеСтроки Из ДочерниеСтроки Цикл
		Если ОписаниеСтроки.Имя = "Справочник.ФизическиеЛица" Тогда
			СтрокаФизическихЛиц = ОписаниеСтроки;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	ЮТест.ОжидаетЧто(СтрокаФизическихЛиц).НеРавно(Неопределено);
	ЮТест.ОжидаетЧто(СтрокаФизическихЛиц.ВидИсточника)
		.Равно("СтандартнаяТаблица");
	ЮТест.ОжидаетЧто(ТипЗнч(СтрокаФизическихЛиц.ТипЗначения))
		.Равно(Тип("ОписаниеТипов"));
	ЮТест.ОжидаетЧто(СтрокаФизическихЛиц.ТипЗначения.СодержитТип(
		Тип("ДоступнаяТаблицаСхемыЗапроса"))).ЭтоИстина();
	ЮТест.ОжидаетЧто(СтрокаФизическихЛиц.ЕстьДочерние).ЭтоИстина();
	ЮТест.ОжидаетЧто(СтрокаФизическихЛиц.Свойство("ДанныеПоставщика")).ЭтоЛожь();

КонецПроцедуры

// Проверяет, что описание таблицы преобразуется в строки полей только при раскрытии.
Процедура ФасадФормыЛенивоРаскрываетПоляТаблицы() Экспорт

	//@skip-check server-execution-safe-mode
	Фасад = Вычислить("КонструкторЗапросовФормы");
	Контекст = Фасад.НовыйКонтекстМетаданныхUI();

	ОписанияПолей = Фасад.ОписанияСтрокПолейТаблицы(
		Контекст,
		"Справочник.ФизическиеЛица");

	СтрокаСсылки = Неопределено;
	СтрокаКода = Неопределено;
	Для Каждого ОписаниеСтроки Из ОписанияПолей Цикл
		Если ОписаниеСтроки.Имя = "Ссылка" Тогда
			СтрокаСсылки = ОписаниеСтроки;
		ИначеЕсли ОписаниеСтроки.Имя = "Код" Тогда
			СтрокаКода = ОписаниеСтроки;
		КонецЕсли;
	КонецЦикла;

