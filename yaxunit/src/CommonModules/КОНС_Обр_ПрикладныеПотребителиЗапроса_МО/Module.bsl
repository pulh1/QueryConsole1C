#Область СлужебныеПроцедурыИФункции

Функция НовыйПостроитель()

	//@skip-check server-execution-safe-mode
	МодульУтилит = Вычислить("МодельЗапросаУтилиты");
	Модель = МодульУтилит.СоздатьПакетЗапросов();
	Возврат МодульУтилит.СоздатьПостроительМодели(Модель);

КонецФункции

Функция ОператорПостроителя(Построитель)

	Возврат Построитель.ПолучитьМодель().Элементы[0].Операторы[0];

КонецФункции

Функция СтрокаХраненияФизическихЛиц()

	СтруктураХранения = ПолучитьСтруктуруХраненияБазыДанных(, Истина);
	Для Каждого СтрокаХранения Из СтруктураХранения Цикл
		Если СтрокаХранения.ИмяТаблицы = "Справочник.ФизическиеЛица" Тогда
			Возврат СтрокаХранения;
		КонецЕсли;
	КонецЦикла;

	ВызватьИсключение "В структуре хранения не найден Справочник.ФизическиеЛица";

КонецФункции

Функция ПолеХраненияПоИмени(СтрокаХранения, ИмяПоля)

	Для Каждого ПолеХранения Из СтрокаХранения.Поля Цикл
		Если ПолеХранения.ИмяПоля = ИмяПоля Тогда
			Возврат ПолеХранения;
		КонецЕсли;
	КонецЦикла;

	ВызватьИсключение "В структуре хранения не найдено поле " + ИмяПоля;

КонецФункции

Функция ДеревоДоступныхТаблиц()

	Дерево = Новый ДеревоЗначений();
	Дерево.Колонки.Добавить("Type");
	Дерево.Колонки.Добавить("Presentation");
	Дерево.Колонки.Добавить("Name");
	Дерево.Колонки.Добавить("Index");
	Возврат Дерево;

КонецФункции

Функция ДеревоИсточников()

	Дерево = Новый ДеревоЗначений();
	Дерево.Колонки.Добавить("Type");
	Дерево.Колонки.Добавить("Index");
	Дерево.Колонки.Добавить("Presentation");
	Дерево.Колонки.Добавить("ValueType");
	Дерево.Колонки.Добавить("Name");
	Дерево.Колонки.Добавить("TableName");
	Возврат Дерево;

КонецФункции

Функция ИндексГруппыДоступнойТаблицы(ДоступныеТаблицы, ИмяТаблицы)

	Для Индекс = 0 По ДоступныеТаблицы.Количество() - 1 Цикл
		Элемент = ДоступныеТаблицы.Получить(Индекс);
		Если ТипЗнч(Элемент) = Тип("QuerySchemaAvailableTablesGroup")
			И Элемент.Content.Find(ИмяТаблицы) <> Неопределено Тогда
			Возврат Индекс;
		КонецЕсли;
	КонецЦикла;

	ВызватьИсключение "Не найдена группа доступной таблицы " + ИмяТаблицы;

КонецФункции

Функция НайтиСтрокуПоИмени(Строки, Имя)

	Для Каждого СтрокаДерева Из Строки Цикл
		Если СтрокаДерева.Name = Имя Тогда
			Возврат СтрокаДерева;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

