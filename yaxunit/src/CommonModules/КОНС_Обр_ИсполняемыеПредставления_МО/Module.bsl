#Область ПрограммныйИнтерфейс

// Регистрирует серверные контракты исполняемых представлений.
Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Исполняемые представления")
			.Тег("ИсполняемыеПредставления")
			.ДобавитьСерверныйТест("ИсполняемоеПредставлениеПреобразуетИДелегируетОтбор")
			.ДобавитьСерверныйТест("ИсполнительФормируетКодИТекстСКДДляПредставительнойМодели")
			.ДобавитьСерверныйТест("УниверсальныйОтчетЗаменяетИсполняемыеПредставленияВременнымиТаблицами")
			.ДобавитьСерверныйТест("УниверсальныйОтчетЗаменяетПрисоединенноеИсполняемоеПредставление")
			.ДобавитьСерверныйТест("УниверсальныйОтчетЗаменяетПредставлениеВоВложенномФильтре");

КонецПроцедуры

// Подтверждает преобразование source и независимость остаточного отбора.
Процедура ИсполняемоеПредставлениеПреобразуетИДелегируетОтбор() Экспорт

	ТекстЗапроса =
		"ВЫБРАТЬ НарастающиеИтоги.Период КАК Период "
		+ "ИЗ ИсполняемоеПредставление.РегистрНакопления.СведенияОДоходахНДФЛ.НарастающиеИтоги("
		+ "НачалоПериода = &НачалоПериода, "
		+ "КонецПериода = &КонецПериода, "
		+ "Периодичность = ""ДЕНЬ"", "
		+ "Отбор = (ГоловнаяОрганизация = &Организация)) КАК НарастающиеИтоги "
		+ "ГДЕ НарастающиеИтоги.Период >= &НачалоПериода";

	//@skip-check server-execution-safe-mode
	МодульКонструктора = Вычислить("КонструкторЗапросовПовтИсп");
	//@skip-check server-execution-safe-mode
	МодульОбработкиМодели = Вычислить("ОбработкаМоделиЗапроса");
	//@skip-check server-execution-safe-mode
	МодульОбработкиПредставлений = Вычислить("ОбработкаПредставлениеЗапросов");
	//@skip-check server-execution-safe-mode
	ПоставщикПредставлений = Вычислить("ПоставщикИсполняемыхПредставлений");

	Модель = МодульКонструктора.ПарсерЗапросов().Разобрать(ТекстЗапроса);
	Оператор = Модель.Элементы[0].Операторы[0];
	Источник = Оператор.Источники[0];

	ЮТест.ОжидаетЧто(Источник.Источник.Тип).Равно("ИсточникДанныхТаблица");
	ЮТест.ОжидаетЧто(Оператор.Отбор).НеРавно(Неопределено,
		"Секция ГДЕ должна существовать до преобразования источника");

	Контекст = МодульОбработкиМодели.КонтекстОбработкиЗапроса();
	МодульОбработкиПредставлений.ОбработатьИсточникЗапроса(Источник, Контекст);

	Описание = ПоставщикПредставлений.ОписаниеПредставленияПоИмениТаблицы(
		"ИсполняемоеПредставление.РегистрНакопления.СведенияОДоходахНДФЛ.НарастающиеИтоги");
	ОжидаемоеПредставление = МодульОбработкиПредставлений.ИсполняемоеПредставлениеПоОписанию(Описание);

	ЮТест.ОжидаетЧто(Источник.Источник.Тип).Равно("ИсполняемоеПредставление");
	ЮТест.ОжидаетЧто(ОжидаемоеПредставление.ИмяТаблицы).Равно(Описание.ИмяТаблицы);
	ЮТест.ОжидаетЧто(ОжидаемоеПредставление.ИмяОбработчика).Равно(Описание.ИмяОбработчика);
	ЮТест.ОжидаетЧто(Источник.Источник.ИмяТаблицы).Равно(Описание.ИмяТаблицы);
	ЮТест.ОжидаетЧто(Источник.Источник.ИмяОбработчика).Равно(Описание.ИмяОбработчика);
	ЮТест.ОжидаетЧто(Источник.Источник.Псевдоним).Равно("НарастающиеИтоги");
	ЮТест.ОжидаетЧто(Источник.Источник.Отбор).НеРавно(Неопределено,
		"Параметр Отбор должен быть делегирован в исполняемое представление");
	ДелегированныйОтбор = Источник.Источник.Отбор.Выражение.Значение;
	ЮТест.ОжидаетЧто(ДелегированныйОтбор.Тип).Равно("БинарнаяОперация");
	ЮТест.ОжидаетЧто(ДелегированныйОтбор.Операция).Равно("=");
	ЮТест.ОжидаетЧто(ДелегированныйОтбор.ЛеваяЧасть.Тип).Равно("Разыменование");
	ЮТест.ОжидаетЧто(ДелегированныйОтбор.ЛеваяЧасть.Элементы.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(ДелегированныйОтбор.ЛеваяЧасть.Элементы[0].Тип).Равно("ПолеИсточника");
	ЮТест.ОжидаетЧто(ДелегированныйОтбор.ЛеваяЧасть.Элементы[0].ИмяПоля).Равно("ГоловнаяОрганизация");
	ЮТест.ОжидаетЧто(ДелегированныйОтбор.ПраваяЧасть.Тип).Равно("ПараметрЗапроса");
	ЮТест.ОжидаетЧто(ДелегированныйОтбор.ПраваяЧасть.Имя).Равно("Организация");
	ЮТест.ОжидаетЧто(Оператор.Отбор).НеРавно(Неопределено,
		"Остаточная секция ГДЕ не должна исчезать при преобразовании источника");
	ОстаточныйОтбор = Оператор.Отбор.Значение;
	ЮТест.ОжидаетЧто(ОстаточныйОтбор.Операция).Равно(">=",
		"Остаточный отбор должен сохранять исходное условие периода");
	ЮТест.ОжидаетЧто(ОстаточныйОтбор.ЛеваяЧасть.Тип).Равно("Разыменование");
	ЮТест.ОжидаетЧто(ОстаточныйОтбор.ЛеваяЧасть.Элементы.Количество()).Равно(2);
	ЮТест.ОжидаетЧто(ОстаточныйОтбор.ЛеваяЧасть.Элементы[0]).Равно("НарастающиеИтоги");
	ЮТест.ОжидаетЧто(ОстаточныйОтбор.ЛеваяЧасть.Элементы[1]).Равно("Период");
	ЮТест.ОжидаетЧто(ОстаточныйОтбор.ПраваяЧасть.Тип).Равно("ПараметрЗапроса");
	ЮТест.ОжидаетЧто(ОстаточныйОтбор.ПраваяЧасть.Имя).Равно("НачалоПериода");

КонецПроцедуры

// Подтверждает предметные контракты generated BSL и текста запроса для СКД.
Процедура ИсполнительФормируетКодИТекстСКДДляПредставительнойМодели() Экспорт

	//@skip-check server-execution-safe-mode
	Исполнитель = Вычислить("ИсполнительПредставлений");
	ТекстЗапроса = ПредставительныйТекстЗапроса();
	ЗначенияПараметров = ЗначенияПараметровПредставительногоЗапроса();

	ИсполняемыйКод = Исполнитель.ПолучитьИсполняемыйКод(ТекстЗапроса, ЗначенияПараметров);
	ТекстЗапросаДляСКД = Исполнитель.ПолучитьТекстЗапросаДляСКД(ТекстЗапроса, ЗначенияПараметров);

	ЮТест.ОжидаетЧто(СтрНайти(ИсполняемыйКод,
		"ЗарплатаКадрыОбщиеНаборыДанных.СоздатьВТПериоды") > 0)
		.ЭтоИстина("Код должен вызывать предметный генератор временной таблицы периодов");
	ЮТест.ОжидаетЧто(СтрНайти(ИсполняемыйКод, """ВТПериоды""") > 0)
		.ЭтоИстина("Код должен сохранять стабильную идентичность формируемой временной таблицы");
	ЮТест.ОжидаетЧто(СтрНайти(ИсполняемыйКод, "Периодичность = ""ДЕНЬ""") > 0)
		.ЭтоИстина("Код должен переносить семантически значимое значение периодичности");

	ЮТест.ОжидаетЧто(СтрНайти(ТекстЗапросаДляСКД, "Представления_Периоды") > 0)
		.ЭтоИстина("СКД-текст должен использовать предназначенную для СКД временную таблицу");
	ЮТест.ОжидаетЧто(СтрНайти(ТекстЗапросаДляСКД, "&ДатаНачала") > 0)
		.ЭтоИстина("СКД-текст должен сохранять исходный параметр начала интервала");
	ЮТест.ОжидаетЧто(СтрНайти(ТекстЗапросаДляСКД, "&ДатаОкончания") > 0)
		.ЭтоИстина("СКД-текст должен сохранять исходный параметр окончания интервала");
	ЮТест.ОжидаетЧто(СтрНайти(ТекстЗапросаДляСКД, "ИсполняемоеПредставление.Периоды") = 0)
		.ЭтоИстина("СКД-текст не должен содержать исходный технический источник");

КонецПроцедуры

// Подтверждает адаптацию executable source к временной таблице отчёта.
Процедура УниверсальныйОтчетЗаменяетИсполняемыеПредставленияВременнымиТаблицами() Экспорт

	//@skip-check server-execution-safe-mode
	МодульОбработкиМодели = Вычислить("ОбработкаМоделиЗапроса");
	//@skip-check server-execution-safe-mode
	МодульУниверсальногоОтчета = Вычислить("УниверсальныйОтчетРасширенный");

	Модель = МодульОбработкиМодели.РазобратьЗапрос(ПредставительныйТекстЗапроса());
	ИсходныйЗапрос = Модель.Элементы[0];
	ИсходныйИсточник = ИсходныйЗапрос.Операторы[0].Источники[0].Источник;

	ЮТест.ОжидаетЧто(ИсходныйИсточник.Тип).Равно("ИсполняемоеПредставление");
	ЮТест.ОжидаетЧто(ИсходныйИсточник.ИмяТаблицы).Равно("ИсполняемоеПредставление.Периоды");
	ЮТест.ОжидаетЧто(ИсходныйЗапрос.Колонки[0].Имя).Равно("Период");

	МодульУниверсальногоОтчета.ЗаменитьИсполняемыеПредставленияВременнымиТаблицами(Модель);

	ЮТест.ОжидаетЧто(Модель.Элементы.Количество()).Равно(2,
		"Перед исходным запросом должна появиться декларация временной таблицы");
	ДекларацияВТ = Модель.Элементы[0];
	АдаптированныйЗапрос = Модель.Элементы[1];
	АдаптированныйИсточник = АдаптированныйЗапрос.Операторы[0].Источники[0].Источник;

	ЮТест.ОжидаетЧто(ДекларацияВТ.ТаблицаДляПомещения).Равно("Периоды");
	ЮТест.ОжидаетЧто(ДекларацияВТ.Колонки.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(ДекларацияВТ.Колонки[0].Имя).Равно("Период");
	ЮТест.ОжидаетЧто(АдаптированныйИсточник.Тип).Равно("ИсточникДанныхВременнаяТаблица");
	ЮТест.ОжидаетЧто(АдаптированныйИсточник.ИмяТаблицы).Равно("Периоды");
	ЮТест.ОжидаетЧто(АдаптированныйИсточник.Псевдоним).Равно("Периоды");
	ЮТест.ОжидаетЧто(АдаптированныйИсточник.ОписаниеВТ.Имя).Равно("Периоды");
	ЮТест.ОжидаетЧто(АдаптированныйЗапрос.Колонки[0].Имя).Равно("Период",
		"Предметная идентичность выбранной колонки должна сохраниться");

КонецПроцедуры

// Подтверждает замену исполняемого представления внутри дерева JOIN.
Процедура УниверсальныйОтчетЗаменяетПрисоединенноеИсполняемоеПредставление() Экспорт

	ТекстЗапроса =
		"ВЫБРАТЬ ФизическиеЛица.Ссылка КАК Ссылка, Периоды.Период КАК Период "
		+ "ИЗ Справочник.ФизическиеЛица КАК ФизическиеЛица "
		+ "ЛЕВОЕ СОЕДИНЕНИЕ ИсполняемоеПредставление.Периоды("
		+ "НачалоИнтервала = &ДатаНачала, "
		+ "ОкончаниеИнтервала = &ДатаОкончания, "
		+ "Периодичность = ""ДЕНЬ"") КАК Периоды ПО ИСТИНА";

	//@skip-check server-execution-safe-mode
	МодульОбработкиМодели = Вычислить("ОбработкаМоделиЗапроса");
	//@skip-check server-execution-safe-mode
	МодульУниверсальногоОтчета = Вычислить("УниверсальныйОтчетРасширенный");
	//@skip-check server-execution-safe-mode
	МодульГенерации = Вычислить("ГенерацияТекстовЗапросов");

	Модель = МодульОбработкиМодели.РазобратьЗапрос(ТекстЗапроса);
	МодульУниверсальногоОтчета.ЗаменитьИсполняемыеПредставленияВременнымиТаблицами(Модель);
	АдаптированныйЗапрос = Модель.Элементы[Модель.Элементы.ВГраница()];
	Источники = МодельЗапросаУтилиты.ВсеИсточникиОператора(АдаптированныйЗапрос.Операторы[0]);
	СгенерированныйТекст = МодульГенерации.ТекстПакетаЗапросов(Модель);

	ЮТест.ОжидаетЧто(Источники.Количество()).Равно(2);
	ЮТест.ОжидаетЧто(Источники[1].Источник.Тип).Равно("ИсточникДанныхВременнаяТаблица");
	ЮТест.ОжидаетЧто(СтрНайти(ВРег(СгенерированныйТекст), "ИСПОЛНЯЕМОЕПРЕДСТАВЛЕНИЕ"))
		.Равно(0, "В JOIN не должно оставаться исполняемое представление");

	ФиксированныеПараметры = Новый Структура("ТекстЗапросаИсточника", ТекстЗапроса);
	Схема = Отчеты.УниверсальныйОтчетРасширенный.СхемаКомпоновкиДанных(ФиксированныеПараметры);
	Для Каждого НаборДанных Из Схема.НаборыДанных Цикл
		Если ТипЗнч(НаборДанных) = Тип("НаборДанныхЗапросСхемыКомпоновкиДанных") Тогда
			ЮТест.ОжидаетЧто(СтрНайти(ВРег(НаборДанных.Запрос), "ИСПОЛНЯЕМОЕПРЕДСТАВЛЕНИЕ"))
				.Равно(0, "Схема СКД не должна получать исходное исполняемое представление");
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Подтверждает замену исполняемого представления внутри запроса-параметра другого представления.
Процедура УниверсальныйОтчетЗаменяетПредставлениеВоВложенномФильтре() Экспорт

	ТекстЗапроса =
		"ВЫБРАТЬ ФизическиеЛица.Ссылка КАК Сотрудник "
		+ "ПОМЕСТИТЬ ВТПериодыКадровойИстории "
		+ "ИЗ Справочник.ФизическиеЛица КАК ФизическиеЛица; "
		+ "ВЫБРАТЬ ПлановоеВремяСотрудников.Сотрудник КАК Сотрудник "
		+ "ИЗ ИсполняемоеПредставление.ПлановоеВремяСотрудников("
		+ "(Сотрудник, ДатаНачала, ДатаОкончания, ДатаАктуальности) В ("
		+ "ВЫБРАТЬ РАЗЛИЧНЫЕ ВТОтборСотрудников.Сотрудник КАК Сотрудник, "
		+ "&ДатаНачала КАК ДатаНачала, &ДатаОкончания КАК ДатаОкончания, "
		+ "&ДатаОкончания КАК ДатаАктуальности "
		+ "ИЗ ВТПериодыКадровойИстории КАК ВТОтборСотрудников "
		+ "ЛЕВОЕ СОЕДИНЕНИЕ ИсполняемоеПредставление.Периоды("
		+ "НачалоИнтервала = &ДатаНачала, ОкончаниеИнтервала = &ДатаОкончания, "
		+ "Периодичность = ""МЕСЯЦ"") КАК Периоды "
		+ "ПО Периоды.Период МЕЖДУ &ДатаНачала И &ДатаОкончания)) "
		+ "КАК ПлановоеВремяСотрудников";

	//@skip-check server-execution-safe-mode
	МодульОбработкиМодели = Вычислить("ОбработкаМоделиЗапроса");
	//@skip-check server-execution-safe-mode
	МодульУниверсальногоОтчета = Вычислить("УниверсальныйОтчетРасширенный");
	//@skip-check server-execution-safe-mode
	МодульГенерации = Вычислить("ГенерацияТекстовЗапросов");

	Модель = МодульОбработкиМодели.РазобратьЗапрос(ТекстЗапроса);
	МодульУниверсальногоОтчета.ЗаменитьИсполняемыеПредставленияВременнымиТаблицами(Модель);
	СгенерированныйТекст = МодульГенерации.ТекстПакетаЗапросов(Модель);

	ЮТест.ОжидаетЧто(СтрНайти(ВРег(СгенерированныйТекст), "ИСПОЛНЯЕМОЕПРЕДСТАВЛЕНИЕ"))
		.Равно(0, "Во вложенном фильтре не должно оставаться исполняемое представление");

	ФиксированныеПараметры = Новый Структура("ТекстЗапросаИсточника", ТекстЗапроса);
	Схема = Отчеты.УниверсальныйОтчетРасширенный.СхемаКомпоновкиДанных(ФиксированныеПараметры);
	Для Каждого НаборДанных Из Схема.НаборыДанных Цикл
		Если ТипЗнч(НаборДанных) = Тип("НаборДанныхЗапросСхемыКомпоновкиДанных") Тогда
			ЮТест.ОжидаетЧто(СтрНайти(ВРег(НаборДанных.Запрос), "ИСПОЛНЯЕМОЕПРЕДСТАВЛЕНИЕ"))
				.Равно(0, "Схема СКД не должна получать представление из вложенного фильтра");
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПредставительныйТекстЗапроса()

	Возврат
		"ВЫБРАТЬ Периоды.Период КАК Период "
		+ "ИЗ ИсполняемоеПредставление.Периоды("
		+ "НачалоИнтервала = &ДатаНачала, "
		+ "ОкончаниеИнтервала = &ДатаОкончания, "
		+ "Периодичность = ""ДЕНЬ"") КАК Периоды";

КонецФункции

Функция ЗначенияПараметровПредставительногоЗапроса()

	ЗначенияПараметров = Новый Структура();
	ЗначенияПараметров.Вставить("ДатаНачала", Дата(2025, 1, 1));
	ЗначенияПараметров.Вставить("ДатаОкончания", Дата(2025, 1, 31));
	Возврат ЗначенияПараметров;

КонецФункции

#КонецОбласти
