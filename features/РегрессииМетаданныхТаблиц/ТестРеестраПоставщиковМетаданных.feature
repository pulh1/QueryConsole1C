Функционал: Реестр поставщиков метаданных таблиц

Как разработчик консоли запросов я хочу
проверить разрешение источников через реестр поставщиков метаданных
чтобы стандартные таблицы и исполняемые представления обрабатывались единообразно

Контекст:
	И я закрыл все окна клиентского приложения
	И Я запускаю сценарий открытия TestClient или подключаю уже существующий
	И я закрыл все окна клиентского приложения

Сценарий: выбор поставщика по первому сегменту имени таблицы
	И я выполняю код встроенного языка на сервере без контекста
	"""bsl
		Реестр = Обработки.РеестрПоставщиковМетаданныхТаблиц.СоздатьДляОбработкиЗапроса();

		Если Реестр.ПервыйСегментИмениТаблицы("Справочник.ШтатноеРасписание") <> "Справочник" Тогда
			ВызватьИсключение "Неверно определен первый сегмент стандартной таблицы";
		КонецЕсли;

		Если Реестр.ПервыйСегментИмениТаблицы("ИсполняемоеПредставление.ДанныеСотрудников") <> "ИсполняемоеПредставление" Тогда
			ВызватьИсключение "Неверно определен первый сегмент исполняемого представления";
		КонецЕсли;

		ПоставщикСтандартныхТаблиц = Реестр.РазрешитьПоставщика("Справочник.ШтатноеРасписание");
		Если ПоставщикСтандартныхТаблиц = Неопределено Тогда
			ВызватьИсключение "Не найден поставщик стандартных таблиц";
		КонецЕсли;
		Если ПоставщикСтандартныхТаблиц.ИмяПоставщика() <> "СтандартныеТаблицы1С" Тогда
			ВызватьИсключение "Для стандартной таблицы выбран неверный поставщик";
		КонецЕсли;

		ПоставщикИсполняемыхПредставлений = Реестр.РазрешитьПоставщика("ИсполняемоеПредставление.ДанныеСотрудников");
		Если ПоставщикИсполняемыхПредставлений = Неопределено Тогда
			ВызватьИсключение "Не найден поставщик исполняемых представлений";
		КонецЕсли;
		Если ПоставщикИсполняемыхПредставлений.ИмяПоставщика() <> "ИсполняемыеПредставления" Тогда
			ВызватьИсключение "Для исполняемого представления выбран неверный поставщик";
		КонецЕсли;

		Если Реестр.РазрешитьПоставщика("НеизвестныйСегмент.Таблица") <> Неопределено Тогда
			ВызватьИсключение "Для неизвестного сегмента не должен выбираться поставщик";
		КонецЕсли;

		Если Реестр.ОписаниеТаблицы("Справочник.НеизвестнаяТаблица") <> Неопределено Тогда
			ВызватьИсключение "Неизвестная таблица известного сегмента не должна fallback-иться в поставщик временных таблиц";
		КонецЕсли;
	"""

Сценарий: корневая иерархия и стандартный сегмент строятся через контракт поставщика
	И я выполняю код встроенного языка на сервере без контекста
	"""bsl
		Реестр = Обработки.РеестрПоставщиковМетаданныхТаблиц.СоздатьДляОбработкиЗапроса();

		КорневыеЭлементы = Реестр.ДочерниеЭлементы();
		Если КорневыеЭлементы.Количество() = 0 Тогда
			ВызватьИсключение "Корневая иерархия реестра не содержит поставщиков";
		КонецЕсли;

		СегментыСтандартныхТаблиц = Реестр.ДочерниеЭлементы(Неопределено, "СтандартныеТаблицы1С");
		Если СегментыСтандартныхТаблиц.Количество() = 0 Тогда
			ВызватьИсключение "Поставщик стандартных таблиц не вернул сегменты";
		КонецЕсли;

		ТаблицыСправочников = Реестр.ДочерниеЭлементы("Справочник", "СтандартныеТаблицы1С");
		Если ТаблицыСправочников.Количество() = 0 Тогда
			ВызватьИсключение "Сегмент стандартных таблиц не раскрыл таблицы";
		КонецЕсли;
	"""

Сценарий: получение описания стандартной таблицы и исполняемого представления
	И я выполняю код встроенного языка на сервере без контекста
	"""bsl
		Реестр = Обработки.РеестрПоставщиковМетаданныхТаблиц.СоздатьДляОбработкиЗапроса();

		ОписаниеСтандартнойТаблицы = Реестр.ОписаниеТаблицы("Справочник.ШтатноеРасписание");
		Если ОписаниеСтандартнойТаблицы = Неопределено Тогда
			ВызватьИсключение "Описание стандартной таблицы не получено";
		КонецЕсли;
		Если ОписаниеСтандартнойТаблицы.ВидПоставщика <> "СтандартныеТаблицы1С" Тогда
			ВызватьИсключение "Описание стандартной таблицы получено не от стандартного поставщика";
		КонецЕсли;
		Если ОписаниеСтандартнойТаблицы.Поля.Количество() = 0 Тогда
			ВызватьИсключение "Описание стандартной таблицы не содержит поля";
		КонецЕсли;

		ОписаниеИсполняемогоПредставления = Реестр.ОписаниеТаблицы("ИсполняемоеПредставление.ДанныеСотрудников");
		Если ОписаниеИсполняемогоПредставления = Неопределено Тогда
			ВызватьИсключение "Описание исполняемого представления не получено";
		КонецЕсли;
		Если ОписаниеИсполняемогоПредставления.ВидПоставщика <> "ИсполняемыеПредставления" Тогда
			ВызватьИсключение "Описание исполняемого представления получено не от поставщика исполняемых представлений";
		КонецЕсли;
		Если ОписаниеИсполняемогоПредставления.ИсходноеОписание = Неопределено Тогда
			ВызватьИсключение "Описание исполняемого представления не содержит исходное описание";
		КонецЕсли;
		Если ОписаниеИсполняемогоПредставления.Поля.Количество() = 0 Тогда
			ВызватьИсключение "Описание исполняемого представления не содержит поля";
		КонецЕсли;

		Если Реестр.ОписаниеТаблицы("НеизвестныйСегмент.Таблица") <> Неопределено Тогда
			ВызватьИсключение "Для неизвестного сегмента не должно возвращаться описание таблицы";
		КонецЕсли;
	"""

Сценарий: обработка модели запроса со стандартной таблицей и исполняемым представлением
	И я выполняю код встроенного языка на сервере без контекста
	"""bsl
		ТекстЗапросаСтандартнойТаблицы =
		"ВЫБРАТЬ
		|    ШтатноеРасписание.Ссылка КАК Ссылка
		|ИЗ
		|    Справочник.ШтатноеРасписание КАК ШтатноеРасписание";

		МодельСтандартнойТаблицы = ОбработкаМоделиЗапроса.РазобратьЗапрос(ТекстЗапросаСтандартнойТаблицы);
		ИсточникСтандартнойТаблицы = МодельСтандартнойТаблицы.Элементы[0].Операторы[0].Источники.Элементы[0].Источник;
		Если ИсточникСтандартнойТаблицы.Тип <> "ИсточникДанныхТаблица" Тогда
			ВызватьИсключение "Стандартная таблица разобрана как неверный тип источника";
		КонецЕсли;
		Если ИсточникСтандартнойТаблицы.ИмяТаблицы <> "Справочник.ШтатноеРасписание" Тогда
			ВызватьИсключение "Имя стандартной таблицы в модели запроса отличается от ожидаемого";
		КонецЕсли;
		Если ИсточникСтандартнойТаблицы.Псевдоним <> "ШтатноеРасписание" Тогда
			ВызватьИсключение "Псевдоним стандартной таблицы в модели запроса отличается от ожидаемого";
		КонецЕсли;

		ТекстЗапросаИсполняемогоПредставления =
		"ВЫБРАТЬ
		|    ДанныеСотрудников.Сотрудник КАК Сотрудник
		|ИЗ
		|    ИсполняемоеПредставление.ДанныеСотрудников КАК ДанныеСотрудников";

		МодельИсполняемогоПредставления = ОбработкаМоделиЗапроса.РазобратьЗапрос(ТекстЗапросаИсполняемогоПредставления);
		ИсточникИсполняемогоПредставления = МодельИсполняемогоПредставления.Элементы[0].Операторы[0].Источники.Элементы[0].Источник;
		Если ИсточникИсполняемогоПредставления.Тип <> "ИсполняемоеПредставление" Тогда
			ВызватьИсключение "Исполняемое представление разобрано как неверный тип источника";
		КонецЕсли;
		Если ИсточникИсполняемогоПредставления.ИмяТаблицы <> "ИсполняемоеПредставление.ДанныеСотрудников" Тогда
			ВызватьИсключение "Имя исполняемого представления в модели запроса отличается от ожидаемого";
		КонецЕсли;
		Если ИсточникИсполняемогоПредставления.Псевдоним <> "ДанныеСотрудников" Тогда
			ВызватьИсключение "Псевдоним исполняемого представления в модели запроса отличается от ожидаемого";
		КонецЕсли;
		Если ИсточникИсполняемогоПредставления.Параметры = Неопределено Тогда
			ВызватьИсключение "Исполняемое представление не содержит параметры в модели запроса";
		КонецЕсли;
	"""
