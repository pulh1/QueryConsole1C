#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОписаниеПеременных

Перем ТекущийТокен;
Перем ЛексическийАнализатор;
Перем ТаблицаПервыхСимволовВариантов;
Перем ОпределенияИдентификаторов;
Перем БуферТокенов;
Перем КоличествоПросматриваемыхСимволов;
Перем ПоследняяПродукция;

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Функция Разобрать(Текст) Экспорт
	ЛексическийАнализатор.УстановитьОбрабатываемыйТекст(Текст);	
	УстановитьБуферТокенов();
	
	Возврат РезультатРазбора();
КонецФункции	

Функция РазобратьВыражение(Текст) Экспорт
	ЛексическийАнализатор.УстановитьОбрабатываемыйТекст(Текст);	
	УстановитьБуферТокенов();
	
	Возврат РезультатРазбораВыражения();
КонецФункции  

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Инициализировать()
	ЛексическийАнализатор = Обработки.ЛексическийАнализатор.Создать();
	ЛексическийАнализатор.Инициализировать();
	ТаблицаПервыхСимволовВариантов = ЗначениеИзСтрокиВнутр(ПолучитьМакет("ТаблицаПервыхСимволовВариантов").ПолучитьТекст());
	ОпределенияИдентификаторов = ЗначениеИзСтрокиВнутр(ПолучитьМакет("ОпределенияИдентификаторов").ПолучитьТекст());
	ОпределенияИдентификаторов.Индексы.Добавить("Тип, Идентификатор");
	
	ИндексируемыеПоля = Новый Массив;
	ИндексируемыеПоля.Добавить("Продукция");
	ИндексируемыеПоля.Добавить("КоличествоЭлементов");
	Для Сч = 1 По КоличествоПросматриваемыхСимволов Цикл
		ИндексируемыеПоля.Добавить("Элемент" + Сч);
		ТаблицаПервыхСимволовВариантов.Индексы.Добавить(СтрСоединить(ИндексируемыеПоля, ","));
	КонецЦикла;		
КонецПроцедуры	

Функция НовыйБуферТокенов()
	БуферТокенов = Новый Структура("ИндексТекущегоЭлемента, Токены");
	БуферТокенов.ИндексТекущегоЭлемента = -1;
	БуферТокенов.Токены = Новый Массив(КоличествоПросматриваемыхСимволов);
	
	Возврат БуферТокенов;
КонецФункции	

Процедура УстановитьБуферТокенов()
	БуферТокенов = НовыйБуферТокенов();	
КонецПроцедуры	

Процедура ЗаполнитьБуферТокенов()	
	МаксимальныйИндексБуфера = КоличествоПросматриваемыхСимволов - 1;
	Если БуферТокенов.ИндексТекущегоЭлемента > 0 Тогда
		Сдвиг = БуферТокенов.ИндексТекущегоЭлемента;
		Для ИндексТекущегоЭлемента = БуферТокенов.ИндексТекущегоЭлемента По МаксимальныйИндексБуфера Цикл
			БуферТокенов.Токены[ИндексТекущегоЭлемента - Сдвиг] = БуферТокенов.Токены[ИндексТекущегоЭлемента];
		КонецЦикла;
		БуферТокенов.ИндексТекущегоЭлемента = 0;
	ИначеЕсли БуферТокенов.ИндексТекущегоЭлемента <> -1 И БуферТокенов.Токены[БуферТокенов.ИндексТекущегоЭлемента] = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	КоличествоДочитываемыхЭлементов = МаксимальныйИндексБуфера - БуферТокенов.ИндексТекущегоЭлемента;
	
	Для Сч = 1 По КоличествоДочитываемыхЭлементов Цикл
		БуферТокенов.Токены[БуферТокенов.ИндексТекущегоЭлемента + Сч] = ЛексическийАнализатор.СледующийТокен();
	КонецЦикла;	
КонецПроцедуры	

Функция СледующийТокенИзБуфера()
	Если БуферТокенов.ИндексТекущегоЭлемента = - 1 Тогда
		ЗаполнитьБуферТокенов();
		БуферТокенов.ИндексТекущегоЭлемента = 0;
		
		Возврат БуферТокенов.Токены[БуферТокенов.ИндексТекущегоЭлемента];
	КонецЕсли;
	
	БуферТокенов.ИндексТекущегоЭлемента = БуферТокенов.ИндексТекущегоЭлемента + 1;
	Токен = БуферТокенов.Токены[БуферТокенов.ИндексТекущегоЭлемента];
		
	ЗаполнитьБуферТокенов();
	
	Возврат Токен;
КонецФункции	

Процедура УстановитьТекущийТокен()
	ТекущийТокен = СледующийТокенИзБуфера();	
КонецПроцедуры	

Функция НомерВариантаПродукции(Продукция)
	СтруктураПоиска = Новый Структура("Продукция, КоличествоЭлементов", Продукция, 0);
	
	Для Сч = 1 По КоличествоПросматриваемыхСимволов Цикл
		Токен = БуферТокенов.Токены[БуферТокенов.ИндексТекущегоЭлемента + Сч - 1];
		Если Токен <> Неопределено И Токен.Тип <> Неопределено  Тогда
			СтруктураПоиска.Вставить("Элемент" + Сч, Токен.Тип);
			СтруктураПоиска.КоличествоЭлементов = СтруктураПоиска.КоличествоЭлементов + 1;
		КонецЕсли;
	КонецЦикла;		

	Для Сч = 0 По Макс(СтруктураПоиска.КоличествоЭлементов - 1, 0) Цикл
		СтрокиПервыхСимволов = ТаблицаПервыхСимволовВариантов.НайтиСтроки(СтруктураПоиска);
		Если СтрокиПервыхСимволов.Количество() > 0 Тогда
			Возврат СтрокиПервыхСимволов[0].НомерВарианта;
		КонецЕсли;	
		
		СтруктураПоиска.Удалить("Элемент" + (СтруктураПоиска.КоличествоЭлементов - Сч));
		СтруктураПоиска.КоличествоЭлементов = СтруктураПоиска.КоличествоЭлементов - 1;
	КонецЦикла;
	
	Возврат Неопределено;
КонецФункции

Функция Терминал(ТипТерминала)
	Если ТекущийТокен.Тип <> ТипТерминала Тогда
		ШаблонОшибки = "{(%1, %2)}: Синтаксическая ошибка. Ожидается ""%3""";
		ТекстОшибки = СтрШаблон(ШаблонОшибки, ТекущийТокен.НомерСтроки, ТекущийТокен.НомерСимвола, ТипТерминала);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;	
	
	Тип = ТекущийТокен.Тип; 

	УстановитьТекущийТокен();
	
	Возврат Тип;
КонецФункции

Функция Лексема(ТипЛексемы)
	Если ТекущийТокен.Тип <> ТипЛексемы Тогда
		ШаблонОшибки = "{(%1, %2)}: Синтаксическая ошибка. Ожидается ""%3""";
		ТекстОшибки = СтрШаблон(ШаблонОшибки, ТекущийТокен.НомерСтроки, ТекущийТокен.НомерСимвола, ТипЛексемы);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;		
	
	Тип = ТекущийТокен.Тип; 

	УстановитьТекущийТокен();
	
	Возврат Тип;
КонецФункции

Функция Идентификатор(ТипИдентификатора)
	СтруктураПоиска = Новый Структура("Тип, Идентификатор", ТипИдентификатора, ТекущийТокен.Тип);
	
	Если ОпределенияИдентификаторов.НайтиСтроки(СтруктураПоиска).Количество() = 0 Тогда
		ШаблонОшибки = "{(%1, %2)}: Синтаксическая ошибка. Ожидается ""%3""";
		ТекстОшибки = СтрШаблон(ШаблонОшибки, ТекущийТокен.НомерСтроки, ТекущийТокен.НомерСимвола, ТипИдентификатора);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;		
	
	Лексема = ТекущийТокен.Лексема; 
	
	УстановитьТекущийТокен();
	
	Возврат Лексема;
КонецФункции

Функция Константа(ТипКонстанты)
	Если ТекущийТокен.Тип <> ТипКонстанты Тогда
		ШаблонОшибки = "{(%1, %2)}: Синтаксическая ошибка. Ожидается ""%3""";
		ТекстОшибки = СтрШаблон(ШаблонОшибки, ТекущийТокен.НомерСтроки, ТекущийТокен.НомерСимвола, ТипКонстанты);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;	
	
	Значение = ТекущийТокен.Значение; 
	
	УстановитьТекущийТокен();
	
	Возврат Значение;
КонецФункции

Функция РезультатРазбора()
	УстановитьТекущийТокен();

	Результат = НеТерминалПакетЗапросов();
		
	Если ТекущийТокен.Тип <> Неопределено Тогда
		ВызватьИсключениеНеУдалосьВыпполнитьРазбор(ПоследняяПродукция);
	КонецЕсли;
	
	Возврат Результат;	
КонецФункции   

Функция РезультатРазбораВыражения()
	УстановитьТекущийТокен();

	Результат = НеТерминалВыражение(Неопределено, Неопределено);
		
	Если ТекущийТокен.Тип <> Неопределено Тогда
		ВызватьИсключениеНеУдалосьВыпполнитьРазбор(ПоследняяПродукция);
	КонецЕсли;
	
	Возврат Результат;	
КонецФункции

Процедура ВызватьИсключениеНеУдалосьВыпполнитьРазбор(Продукция)
	Если ТекущийТокен.Тип <> Неопределено И Продукция <> Неопределено Тогда
		СтруктураПоиска = Новый Структура("Продукция", Продукция, 0);
		СтруктураПоиска.Вставить("Элемент1", ТекущийТокен.Тип);
		
		Если ТаблицаПервыхСимволовВариантов.НайтиСтроки(СтруктураПоиска).Количество() > 0 Тогда
			УстановитьТекущийТокен();
			ВызватьИсключениеСинтаксическаяОшибка();		
		Иначе
			ВызватьИсключениеСинтаксическаяОшибка();
		КонецЕсли;	
	Иначе
		ВызватьИсключениеСинтаксическаяОшибка();	
	КонецЕсли;
КонецПроцедуры

Процедура ВызватьИсключениеСинтаксическаяОшибка()
	Если ТекущийТокен.Тип = Неопределено Тогда
		ШаблонОшибки = "{(%1, %2)}: Синтаксическая ошибка. Ожидается следующий токен";
		ТекстОшибки = СтрШаблон(ШаблонОшибки, ТекущийТокен.НомерСтроки, ТекущийТокен.НомерСимвола);
		ВызватьИсключение ТекстОшибки;
	Иначе
		ШаблонОшибки = "{(%1, %2)}: Синтаксическая ошибка. Неожиданный токен ""%3""";
		ТекстОшибки = СтрШаблон(ШаблонОшибки, ТекущийТокен.НомерСтроки, ТекущийТокен.НомерСимвола, ТекущийТокен.Лексема);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;		
КонецПроцедуры

Функция ТипТокенаПросмотра(Смещение)
	Индекс = БуферТокенов.ИндексТекущегоЭлемента + Смещение;
	Если Индекс < 0 Или Индекс >= БуферТокенов.Токены.Количество() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Токен = БуферТокенов.Токены[Индекс];
	Если Токен = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Токен.Тип;
КонецФункции

Процедура ВызватьИсключениеCanonicalСинтаксическаяОшибка(Ожидаемое)
	Если ТекущийТокен = Неопределено Или ТипТокенаПросмотра(0) = Неопределено Тогда
		ВызватьИсключение "Синтаксическая ошибка. Ожидается " + Ожидаемое;
	Иначе
		ВызватьИсключение "Синтаксическая ошибка. Неожиданный токен " + ТекущийТокен.Лексема;
	КонецЕсли;
КонецПроцедуры

Функция НеТерминалПакетЗапросов(Родитель = Неопределено, ЛевыйЭлемент = Неопределено)
	РезультатПродукции = Неопределено;
	ЭтотУзел = ЭлементыМоделиЗапроса.НовыйПакетЗапросов(ТекущийТокен);
	Значение1 = НеТерминалЗапросПакета();
	ЭтотУзел.Элементы.Добавить(Значение1);
	Пока (ТипТокенаПросмотра(0) = ";" И (ТипТокенаПросмотра(1) = "ВЫБРАТЬ" Или ТипТокенаПросмотра(1) = "УНИЧТОЖИТЬ")) Цикл
		Лексема(";");
		Значение2 = НеТерминалЗапросПакета();
		ЭтотУзел.Элементы.Добавить(Значение2);
	КонецЦикла;
	Если Не ((ТипТокенаПросмотра(0) = ";" И (ТипТокенаПросмотра(1) = Неопределено)) Или ТипТокенаПросмотра(0) = Неопределено) Тогда
		ВызватьИсключениеCanonicalСинтаксическаяОшибка("ПакетЗапросов");
	КонецЕсли;
	Если (ТипТокенаПросмотра(0) = ";" И (ТипТокенаПросмотра(1) = Неопределено)) Тогда
		Лексема(";");
	ИначеЕсли (ТипТокенаПросмотра(0) = Неопределено) Тогда
	Иначе
		ВызватьИсключениеCanonicalСинтаксическаяОшибка("ПакетЗапросов");
	КонецЕсли;
	РезультатПродукции = ЭтотУзел;
	Возврат РезультатПродукции;
КонецФункции

Функция НеТерминалЗапросПакета(Родитель = Неопределено, ЛевыйЭлемент = Неопределено)
	РезультатПродукции = Неопределено;
	Если (ТипТокенаПросмотра(0) = "ВЫБРАТЬ" И (ТипТокенаПросмотра(1) = "&" Или ТипТокенаПросмотра(1) = "(" Или ТипТокенаПросмотра(1) = "*" Или ТипТокенаПросмотра(1) = "+" Или ТипТокенаПросмотра(1) = "-" Или ТипТокенаПросмотра(1) = "ID" Или ТипТокенаПросмотра(1) = "ВЫРАЗИТЬ" Или ТипТокенаПросмотра(1) = "ГОД" Или ТипТокенаПросмотра(1) = "ДАТА" Или ТипТокенаПросмотра(1) = "ДАТАВРЕМЯ" Или ТипТокенаПросмотра(1) = "ДЕНЬ" Или ТипТокенаПросмотра(1) = "ДЕНЬГОДА" Или ТипТокенаПросмотра(1) = "ДЕНЬНЕДЕЛИ" Или ТипТокенаПросмотра(1) = "ДОБАВИТЬКДАТЕ" Или ТипТокенаПросмотра(1) = "ЕСТЬNULL" Или ТипТокенаПросмотра(1) = "ЗНАЧЕНИЕ" Или ТипТокенаПросмотра(1) = "КВАРТАЛ" Или ТипТокенаПросмотра(1) = "КОЛИЧЕСТВО" Или ТипТокенаПросмотра(1) = "КОНЕЦПЕРИОДА" Или ТипТокенаПросмотра(1) = "МАКСИМУМ" Или ТипТокенаПросмотра(1) = "МЕСЯЦ" Или ТипТокенаПросмотра(1) = "МИНИМУМ" Или ТипТокенаПросмотра(1) = "МИНУТА" Или ТипТокенаПросмотра(1) = "НАЧАЛОПЕРИОДА" Или ТипТокенаПросмотра(1) = "НЕДЕЛЯ" Или ТипТокенаПросмотра(1) = "ПОДСТРОКА" Или ТипТокенаПросмотра(1) = "ПРЕДСТАВЛЕНИЕ" Или ТипТокенаПросмотра(1) = "ПРЕДСТАВЛЕНИЕССЫЛКИ" Или ТипТокенаПросмотра(1) = "РАЗНОСТЬДАТ" Или ТипТокенаПросмотра(1) = "СЕКУНДА" Или ТипТокенаПросмотра(1) = "СРЕДНЕЕ" Или ТипТокенаПросмотра(1) = "ССЫЛКА" Или ТипТокенаПросмотра(1) = "СУММА" Или ТипТокенаПросмотра(1) = "ТИП" Или ТипТокенаПросмотра(1) = "ТИПЗНАЧЕНИЯ" Или ТипТокенаПросмотра(1) = "ЧАС" Или ТипТокенаПросмотра(1) = "NULL" Или ТипТокенаПросмотра(1) = "{" Или ТипТокенаПросмотра(1) = "ВЫБОР" Или ТипТокенаПросмотра(1) = "ИСТИНА" Или ТипТокенаПросмотра(1) = "ЛОЖЬ" Или ТипТокенаПросмотра(1) = "НЕ" Или ТипТокенаПросмотра(1) = "НЕОПРЕДЕЛЕНО" Или ТипТокенаПросмотра(1) = "ПЕРВЫЕ" Или ТипТокенаПросмотра(1) = "РАЗЛИЧНЫЕ" Или ТипТокенаПросмотра(1) = "РАЗРЕШЕННЫЕ" Или ТипТокенаПросмотра(1) = "СтроковаяКонстанта" Или ТипТокенаПросмотра(1) = "ЧисловаяКонстанта")) Тогда
		Значение1 = НеТерминалЗапросВыбора();
		РезультатПродукции = Значение1;
