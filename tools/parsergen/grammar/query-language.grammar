// TODO нужно разделять ид для псевдонима с как и без как, во втором случае псевдонимом могут быть Итоги, упорядочить, Где и т.п.

// Пакет запросов

<ПакетЗапросов> ::= @НовыйПакетЗапросов Элементы += <ЗапросПакета> (';' Элементы += <ЗапросПакета>)* ';'?

<ЗапросПакета> ::= <ЗапросВыбора> | <ЗапросУничтожения>
<ЗапросУничтожения> ::= @НовыйЗапросУничтожения УНИЧТОЖИТЬ ИмяТаблицы = #ID_ИмяТаблицы

// Описание запроса

//  TODO нужен булев признак ОбщиеИтоги
<ЗапросВыбора> ::= {ЭтотУзел = НовыйЗапросВыбора} <ОбъединяемыйЗапрос> {ЭтотУзел.Операторы.Добавить(ТекущийЭлемент)} <БлокОбъединить> <БлокУпорядочить> {ЭтотУзел.Порядок = ТекущийЭлемент} 
				 <БлокИндексировать> {ЭтотУзел.Индекс = ТекущийЭлемент}  <БлокИтоги> <АвтоупорядочиваниеОпционально>

<ОбъединяемыйЗапрос> ::= {ЭтотУзел = НовыйОператорЗапроса} <БлокВыбрать> <ПоляВыборки> {ЭтотУзел.ВыбираемыеПоля = ТекущийЭлемент} <БлокПоместить> {ЭтотУзел.__ТаблицаДляПомещения = ТекущийЭлемент}
						<БлокИз> {ЭтотУзел.Источники  = ТекущийЭлемент} <БлокГде> {ЭтотУзел.Отбор  = ТекущийЭлемент} 
						<БлокСгруппировать> {ЭтотУзел.Группировка = ТекущийЭлемент} <БлокИмеющие> {ЭтотУзел.ОтборСгруппированных  = ТекущийЭлемент} 

<БлокОбъединить> ::= {ЭтотУзел = Родитель} ОБЪЕДИНИТЬ {ТипОбъединения = НовыйТипОбъединение} <ВсеОпционально> 
					{ТипОбъединения = ТекущийЭлемент} <ОбъединяемыйЗапрос> {ТекущийЭлемент.ТипОбъединения = ТипОбъединения; ЭтотУзел.Операторы.Добавить(ТекущийЭлемент)} <БлокОбъединить>
<БлокОбъединить> ::= ПУСТО 
<ВсеОпционально> ::= {ЭтотУзел = НовыйТипОбъединениеВсе} ВСЕ | ПУСТО

// Описание секции ВЫБРАТЬ

<БлокВыбрать> ::= {ЭтотУзел = Родитель} ВЫБРАТЬ <МодификаторыВыборки>	<РасширениеСКД> 
<МодификаторыВыборки> ::= {ЭтотУзел = Родитель} ПЕРВЫЕ &ЧисловаяКонстанта {ЭтотУзел.КоличествоПолучаемыхЗаписей = ТекущийЭлемент} <РазличныеРазрешенныеОпционально>
<РазличныеРазрешенныеОпционально> ::= {ЭтотУзел = Родитель} РАЗЛИЧНЫЕ {ЭтотУзел.ВыбиратьРазличные = Истина} <РазрешенныеОпционально> 
<РазличныеРазрешенныеОпционально> ::= {ЭтотУзел = Родитель} РАЗРЕШЕННЫЕ {ЭтотУзел.__ВыбиратьРазрешенные = Истина} <РазличныеОпционально>
<РазличныеРазрешенныеОпционально> ::= ПУСТО

<РазрешенныеОпционально> ::= {ЭтотУзел = Родитель} РАЗРЕШЕННЫЕ {Родитель.ВыбиратьРазрешенные = Истина}| ПУСТО

<МодификаторыВыборки> ::= {ЭтотУзел = Родитель} РАЗЛИЧНЫЕ {ЭтотУзел.ВыбиратьРазличные = Истина}<ПервыеРазрешенныеОпционально>
<ПервыеРазрешенныеОпционально> ::= {ЭтотУзел = Родитель} ПЕРВЫЕ &ЧисловаяКонстанта {ЭтотУзел.КоличествоПолучаемыхЗаписей = ТекущийЭлемент}  <РазрешенныеОпционально>
<ПервыеРазрешенныеОпционально> ::= {ЭтотУзел = Родитель} РАЗРЕШЕННЫЕ {ЭтотУзел.__ВыбиратьРазрешенные = Истина} <ПервыеОпционально>
<ПервыеРазрешенныеОпционально> ::= ПУСТО

<ПервыеОпционально> ::= ПЕРВЫЕ &ЧисловаяКонстанта {Родитель.КоличествоПолучаемыхЗаписей = ТекущийЭлемент} | ПУСТО 

<МодификаторыВыборки> ::= {ЭтотУзел = Родитель} РАЗРЕШЕННЫЕ {ЭтотУзел.__ВыбиратьРазрешенные = Истина} <ПервыеРазличныеОпционально>
<ПервыеРазличныеОпционально> ::= {ЭтотУзел = Родитель} ПЕРВЫЕ &ЧисловаяКонстанта {Родитель.КоличествоПолучаемыхЗаписей = ТекущийЭлемент} <РазличныеОпционально>
<ПервыеРазличныеОпционально> ::= {ЭтотУзел = Родитель} РАЗЛИЧНЫЕ {ЭтотУзел.ВыбиратьРазличные = Истина} <ПервыеОпционально>
<ПервыеРазличныеОпционально> ::= ПУСТО

<МодификаторыВыборки> ::= ПУСТО

// Описание полей выборки
				
<ПоляВыборки> ::= {ЭтотУзел = НовыйВыбираемыеПоля} <ПолеВыборки> {ЭтотУзел.Добавить(ТекущийЭлемент)} <РасширениеСКД>(Родитель) <СписокПолейОпционально>(Родитель)
<СписокПолейОпционально>(Оператор) ::= {ЭтотУзел = Родитель} ',' <ПолеВыборки> {ЭтотУзел.Добавить(ТекущийЭлемент)} <РасширениеСКД>(Оператор) <СписокПолейОпционально>(Оператор)  | ПУСТО

// TODO поддержать вложенную таблицу как поле

<ПолеВыборки> ::= {ЭтотУзел = НовыйПолеЗапроса} <ВыражениеМоделиЗапроса> {ЭтотУзел.Выражение = ТекущийЭлемент} <ПсевдонимОпционально> {ЭтотУзел.Псевдоним = ТекущийЭлемент}
<ПолеВыборки> ::= {ЭтотУзел = НовыйПолеЗапроса} '*' {ЭтотУзел.Выражение = НовыйВыражениеМоделиЗапроса; ЭтотУзел.Выражение.Значение = НовыйВыражениеВсеПоля}

<Псевдоним> ::= КАК #ID_ПсевдонимРасширенный | #ID_Псевдоним

<ПсевдонимОпционально> ::= <Псевдоним> {ЭтотУзел = ТекущийЭлемент} 
<ПсевдонимОпционально> ::= ПУСТО
// Описание блока поместить +

<БлокПоместить> ::= ПОМЕСТИТЬ #ID_ИмяТаблицы {ЭтотУзел = ТекущийЭлемент} <РасширениеСКД>(Родитель)| ПУСТО

// Описание блока ИЗ


<БлокИз> ::= {ЭтотУзел = НовыйИсточникиЗапроса} ИЗ <ИсточникДанныхЗапроса>(ЭтотУзел) <СписокТаблиц> <РасширениеСКД>(Родитель)| ПУСТО

<СписокТаблиц> ::= {ЭтотУзел = Родитель} ',' <ИсточникДанныхЗапроса>(ЭтотУзел) <СписокТаблиц> | ПУСТО

<ИсточникДанныхЗапроса>(Источники) ::= {ЭтотУзел = НовыйИсточник; Источники.Элементы.Добавить(ЭтотУзел)} <ИсточникДанных> {ЭтотУзел.Источник = ТекущийЭлемент;} <Соединение>(Источники)  
<Соединение>(Источники) ::= {ЭтотУзел = Родитель} <ПраваяЧастьСоединения>(Источники) {ЭтотУзел.Соединения.Добавить(ТекущийЭлемент)} <Соединение>(Источники) 
<Соединение>(Источники) ::= {ЭтотУзел = Родитель} '{' <ПраваяЧастьСоединения>(Источники) {ЭтотУзел.Соединения.Добавить(ТекущийЭлемент); ТекущийЭлемент.Опционально = Истина} '}'  <Соединение>(Источники) 
<Соединение> ::= ПУСТО
<ПраваяЧастьСоединения>(Источники) ::= {ЭтотУзел = НовыйСоединениеИсточника} <ТипСоединения> {ЭтотУзел.ТипСоединения = ТекущийЭлемент} СОЕДИНЕНИЕ <ИсточникДанныхСоединения>(Источники) {ЭтотУзел.Источник = ТекущийЭлемент.ИдентификаторИсточника;} ПО <ВыражениеМоделиЗапроса> {ЭтотУзел.Условие  = ТекущийЭлемент}

<ИсточникДанныхСоединения>(Источники)::= {ЭтотУзел = НовыйИсточник; Источники.Элементы.Добавить(ЭтотУзел)} <ПрисоединяемаяТаблица> {ЭтотУзел.Источник = ТекущийЭлемент;} <Соединение>(Источники) 

<ТипСоединения> ::= @НовыйТипСоединенияЛевое ЛЕВОЕ | @НовыйТипСоединенияПравое ПРАВОЕ | @НовыйТипСоединенияВнутреннее ВНУТРЕННЕЕ | @НовыйТипСоединенияПолное ПОЛНОЕ

<ИсточникДанных> ::= <ИсточникДанныхТаблицаЗначений> {ЭтотУзел = ТекущийЭлемент} 
<ИсточникДанных> ::= <ИсточникДанныхТаблица> {ЭтотУзел = ТекущийЭлемент}
<ИсточникДанных> ::= <ИсточникДанныхВложенныйЗапрос> {ЭтотУзел = ТекущийЭлемент}
<ИсточникДанных> ::= <ИсточникДанныхВременнаяТаблица> {ЭтотУзел = ТекущийЭлемент}

<ПрисоединяемаяТаблица> ::= <ИсточникДанныхТаблица> {ЭтотУзел = ТекущийЭлемент} | <ИсточникДанныхВложенныйЗапрос> {ЭтотУзел = ТекущийЭлемент} | <ИсточникДанныхВременнаяТаблица> {ЭтотУзел = ТекущийЭлемент}

<ИсточникДанныхТаблицаЗначений> ::= {ЭтотУзел = НовыйИсточникДанныхТаблицаЗначений} <Параметр> {ЭтотУзел.ИмяТаблицы = ТекущийЭлемент.Имя} <Псевдоним> {ЭтотУзел.Псевдоним = ТекущийЭлемент}
<ИсточникДанныхВременнаяТаблица> ::= {ЭтотУзел = НовыйИсточникДанныхВременнаяТаблица} #ID_ИмяТаблицы  {ЭтотУзел.ИмяТаблицы = ТекущийЭлемент} <ПсевдонимОпционально> {ЭтотУзел.Псевдоним = ТекущийЭлемент}

<ИсточникДанныхТаблица> ::= {ЭтотУзел = НовыйИсточникДанныхТаблица} #ID_ИмяТаблицы {ЭтотУзел.ИмяТаблицы = ТекущийЭлемент} <РазыменованиеТаблицы> 
							<ПараметрыТаблицыОпционально> {ЭтотУзел.Параметры = ТекущийЭлемент} <ПсевдонимОпционально> {ЭтотУзел.Псевдоним = ТекущийЭлемент}

<ИсточникДанныхВложенныйЗапрос> ::= {ЭтотУзел = НовыйИсточникДанныхВложенныйЗапрос} '(' <ЗапросВыбора> {ЭтотУзел.ЗапросВыбора = ТекущийЭлемент} ')' 
									<Псевдоним> {ЭтотУзел.Псевдоним = ТекущийЭлемент}

<КакОпционально> ::= КАК | ПУСТО
<РазыменованиеТаблицы> ::= {ЭтотУзел = Родитель} '.' #ID_Полный {ЭтотУзел.ИмяТаблицы = ЭтотУзел.ИмяТаблицы + "." + ТекущийЭлемент} <ПродолжениеРазыменованияТаблицы> 
<ПродолжениеРазыменованияТаблицы> ::= {ЭтотУзел = Родитель} '.' #ID_Полный {ЭтотУзел.ИмяТаблицы = ЭтотУзел.ИмяТаблицы + "." + ТекущийЭлемент} <ПродолжениеРазыменованияТаблицы> | ПУСТО

<ПараметрыТаблицыОпционально> ::= '(' <СписокПараметров> {ЭтотУзел = ТекущийЭлемент} ')'| ПУСТО
// TODO тут нужно что то придумать для уточнения парамерров представлений, например использовать ; когда список параметров
<СписокПараметров> ::= {ЭтотУзел = НовыйСписокПараметров; ЭтотУзел.Добавить(Неопределено)} <ПараметрТаблицы> {ЭтотУзел[ЭтотУзел.Количество() - 1] = ТекущийЭлемент} <ПродолжениеСпискаПараметров> 
<ПродолжениеСпискаПараметров> ::= {ЭтотУзел = Родитель; ЭтотУзел.Добавить(Неопределено)} ','  <ПараметрТаблицы> {ЭтотУзел[ЭтотУзел.Количество() - 1] = ТекущийЭлемент} <ПродолжениеСпискаПараметров> | ПУСТО
<ПараметрТаблицы> ::= <ВыражениеМоделиЗапроса> {ЭтотУзел = ТекущийЭлемент} | ПУСТО
<ВыражениеСКДПараметр> ::= '{' <Выражение> '}' <ВыражениеСКДПараметр> | ПУСТО
// TODO тут нужно что то придумать для уточнения парамерров представлений, например использовать ; когда список параметров


// Описание бока где

<БлокГде> ::= ГДЕ <ВыражениеМоделиЗапроса> {ЭтотУзел = ТекущийЭлемент} <РасширениеСКД>(Родитель) | ПУСТО

// Блок Cгруппировать

<БлокСгруппировать> ::= СГРУППИРОВАТЬ ПО <СписокВыраженийМодели> {ЭтотУзел = ТекущийЭлемент} <РасширениеСКД>(Родитель)
<БлокСгруппировать> ::= ПУСТО

// Блок Имеющие

<БлокИмеющие> ::= ИМЕЮЩИЕ <ВыражениеМоделиЗапроса> {ЭтотУзел = ТекущийЭлемент}  <РасширениеСКД>(Родитель)
<БлокИмеющие> ::= ПУСТО

// Блок Упорядочить

// TODO АВТОУПОРЯДОЧИВАНИЕ перед УПОРЯДОЧИТЬ ПО, после УПОРЯДОЧИТЬ ПО, перед ИТОГИ ПО, После ИТОГИ ПО
<БлокУпорядочить> ::= УПОРЯДОЧИТЬ ПО <СписокЭлементовУпорядочивания> {ЭтотУзел = ТекущийЭлемент} <РасширениеСКД>(Родитель.Операторы[0])
<БлокУпорядочить> ::= ПУСТО

<АвтоупорядочиваниеОпционально> ::= {Родитель.Автопорядок = Истина} АВТОУПОРЯДОЧИВАНИЕ
<АвтоупорядочиваниеОпционально> ::= ПУСТО

<СписокЭлементовУпорядочивания> ::= {ЭтотУзел = НовыйЭлементыПорядка} <ЭлементУпорядочивания> {ЭтотУзел.Добавить(ТекущийЭлемент)} <ПродолжениеСпискаЭлементовУпорядочивания>
<ПродолжениеСпискаЭлементовУпорядочивания> ::= {ЭтотУзел = Родитель}',' <ЭлементУпорядочивания> {ЭтотУзел.Добавить(ТекущийЭлемент)} <ПродолжениеСпискаЭлементовУпорядочивания>
<ПродолжениеСпискаЭлементовУпорядочивания> ::= ПУСТО 
<ЭлементУпорядочивания> ::= @НовыйЭлементПорядка Выражение = <ВыражениеМоделиЗапроса> (ИЕРАРХИЯ Иерархия := Истина)? (Направление = <НаправлениеУпорядочивания>)?
<НаправлениеУпорядочивания> ::= @НовыйНаправлениеВозрастание ВОЗР | @НовыйНаправлениеУбывание УБЫВ

// Болок итоги
//  не учтено ПЕРИОДАМИ(Месяц, ДАТАВРЕМЯ(2000, 07, 01), ДАТАВРЕМЯ(2000, 12, 01))
// Период ТОЛЬКО ИЕРАРХИЯ ПЕРИОДАМИ(ДЕНЬ, , ) КАК ааа,


<БлокИтоги> ::= {ЭтотУзел = Родитель} ИТОГИ <ПоляИтогов> {ЭтотУзел.ВыраженияИтогов = ТекущийЭлемент} ПО <КонтрольныеТочкиИтогов> {ЭтотУзел.КонтрольныеТочкиИтогов = ТекущийЭлемент}  <РасширениеСКД>(Родитель.Операторы[0])
<БлокИтоги> ::= ПУСТО

<ПоляИтогов> ::= {ЭтотУзел = НовыйВыраженияИтогов} <ПолеВыборки> {ЭтотУзел.Добавить(ТекущийЭлемент)} <СписокПолейОпционально> | ПУСТО

<КонтрольныеТочкиИтогов> ::= {ЭтотУзел = НовыйКонтрольныеТочкиИтогов} <КонтрольнаяТочкаИтогов> {ЭтотУзел.Добавить(ТекущийЭлемент)} <СписокКонтрольныхТочекОпциональное>
<СписокКонтрольныхТочекОпциональное> ::= {ЭтотУзел = Родитель} ',' <КонтрольнаяТочкаИтогов> {ЭтотУзел.Добавить(ТекущийЭлемент)} <СписокКонтрольныхТочекОпциональное>
<СписокКонтрольныхТочекОпциональное> ::= ПУСТО

// TODO устанавливать совйтсво общие итоги и не добавлять ее в массив точек
<КонтрольнаяТочкаИтогов> ::= {ЭтотУзел = НовыйКонтрольнаяТочкаИтогов} <ВыражениеМоделиЗапроса> {ЭтотУзел.Выражение = ТекущийЭлемент} <ПродолжениеКонтрольнойТочкиИтогов>
<КонтрольнаяТочкаИтогов> ::= {ЭтотУзел = НовыйОбщиеИтоги} ОБЩИЕ <ПсевдонимОпционально> 
<ПродолжениеКонтрольнойТочкиИтогов> ::= {ЭтотУзел = Родитель} <ТипКонтрольнойТочки> {ЭтотУзел.ТипКонтрольнойТочки = ТекущийЭлемент} <ДополнениеПериодамиИтогов> 
										<ПсевдонимКонтрольнойТочкиИтогов> {ЭтотУзел.ИмяКолонки = ТекущийЭлемент}

<ДополнениеПериодамиИтогов> ::= {ЭтотУзел = Родитель} ПЕРИОДАМИ'(' <ТипПериодаИтогов> {ЭтотУзел.ТипДополненияПериодами = ТекущийЭлемент} <ПериодДополненияИтогов>')'
<ДополнениеПериодамиИтогов> ::= ПУСТО

<ТипКонтрольнойТочки> ::= @НовыйТипКонтрольнойТочкиТолькоИерархия ТОЛЬКО ИЕРАРХИЯ | @НовыйТипКонтрольнойТочкиИерархия ИЕРАРХИЯ | ПУСТО

<ПсевдонимКонтрольнойТочкиИтогов> ::= КАК #ID_ПсевдонимРасширенный {ЭтотУзел = ТекущийЭлемент} 
<ПсевдонимКонтрольнойТочкиИтогов> ::= #ID_ПсевдонимКонтрольнойТочкиИтогов {ЭтотУзел = ТекущийЭлемент}
<ПсевдонимКонтрольнойТочкиИтогов> ::= ПУСТО

<ТипПериодаИтогов> ::= СЕКУНДА {ЭтотУзел = ТекущийЭлемент}
<ТипПериодаИтогов> ::= МИНУТА {ЭтотУзел = ТекущийЭлемент}
<ТипПериодаИтогов> ::= ЧАС {ЭтотУзел = ТекущийЭлемент}
<ТипПериодаИтогов> ::= ДЕНЬ {ЭтотУзел = ТекущийЭлемент}
<ТипПериодаИтогов> ::= НЕДЕЛЯ {ЭтотУзел = ТекущийЭлемент}
<ТипПериодаИтогов> ::= МЕСЯЦ {ЭтотУзел = ТекущийЭлемент}
<ТипПериодаИтогов> ::= ГОД {ЭтотУзел = ТекущийЭлемент}
<ТипПериодаИтогов> ::= ДЕКАДА {ЭтотУзел = ТекущийЭлемент}
<ТипПериодаИтогов> ::= ПОЛУГОДИЕ {ЭтотУзел = ТекущийЭлемент}

<ПериодДополненияИтогов> ::= {ЭтотУзел = Родитель} ',' <ПериодИтогов> {ЭтотУзел.НачалоПериодаДополнения  = ТекущийЭлемент} <ОкончаниеПериодаИтогов> {ЭтотУзел.КонецПериодаДополнения   = ТекущийЭлемент}
<ПериодДополненияИтогов> ::= ПУСТО

<ОкончаниеПериодаИтогов> ::= ',' <ПериодИтогов> {ЭтотУзел = ТекущийЭлемент}
<ОкончаниеПериодаИтогов> ::= ПУСТО

<ПериодИтогов> ::= <Выражение> {ЭтотУзел = ТекущийЭлемент}
<ПериодИтогов> ::= ПУСТО


// Болок Индексировать

<БлокИндексировать> ::=  ИНДЕКСИРОВАТЬ ПО <СписокВыражений> {ЭтотУзел = ТекущийЭлемент} <РасширениеСКД>(Родитель)| ПУСТО

// Расширение СКД

<РасширениеСКД>(Оператор) ::= '{' <ТелоБлокаСКД>(Оператор) '}'
<РасширениеСКД> ::= ПУСТО
<ТелоБлокаСКД>(Оператор) ::= {ЭтотУзел = НовыйВыбираемыеПоля} <ТипБлокаСКД> <ПолеВыборки> <СписокПолейОпционально>
<ТелоБлокаСКД>(Оператор) ::= {ЭтотУзел = Оператор.ОтборыСКД} ГДЕ <ПолеВыборки> {ЭтотУзел.Добавить(ТекущийЭлемент)} <СписокПолейОпционально>
<ТипБлокаСКД> ::= ВЫБРАТЬ
<ТипБлокаСКД> ::= УПОРЯДОЧИТЬ ПО
<ТипБлокаСКД> ::= ИТОГИ ПО

//<РасширениеСКДВыбрать> ::= '{' ВЫБРАТЬ  <ПолеВыборки> <СписокПолейОпционально> '}'
//<РасширениеСКДГде> ::= '{' ГДЕ '}'
//<РасширениеСКДУпорядочить> ::= '{' УПОРЯДОЧИТЬ ПО  <ПолеВыборки> <СписокПолейОпционально>'}'
//<РасширениеСКДИтоги> ::= '{' ИТОГИ ПО  <ПолеВыборки> <СписокПолейОпционально>'}'

// ЛОГИЧЕСКИЕ ВЫРАЖЕНИЯ

<Выражение> ::= @НовыйБинарнаяОперация ЛеваяЧасть = <Выражение> Операция = ИЛИ ПраваяЧасть = <ЛогическоеСлагаемое>
<Выражение> ::= <ЛогическоеСлагаемое>

<ЛогическоеСлагаемое> ::= @НовыйБинарнаяОперация ЛеваяЧасть = <ЛогическоеСлагаемое> Операция = И ПраваяЧасть = <ЛогическийМножитель>
<ЛогическоеСлагаемое> ::= <ЛогическийМножитель>


<ЛогическийМножитель> ::= <ЛогическаяОперация> {ЭтотУзел = ТекущийЭлемент} <ЛогическийОператор> {ЭтотУзел = ТекущийЭлемент}

// TODO SELECT 1 IS NULL BETWEEN TRUE AND FALSE AS Field1 не исполняется
// IS NULL, REFS, like, in и BETWEEN имеют одинаковый приоритет

<ЛогическийОператор> ::= {ЭтотУзел = НовыйОператорМежду; ЭтотУзел.Операнд = ЛевыйЭлемент} 
						<ОпциональноеНЕ> {ЭтотУзел.Инверсия = Истина} 
						МЕЖДУ <ОперандСравнения> {ЭтотУзел.НачалоИнтервала = ТекущийЭлемент} И <ОперандСравнения> {ЭтотУзел.КонецИнтервала = ТекущийЭлемент} 

<ЛогическийОператор> ::= {ЭтотУзел = НовыйОператорПроверкиТипа; ЭтотУзел.Операнд = ЛевыйЭлемент} ССЫЛКА <ТипСсылочногоПоля> {ЭтотУзел.ТипСсылочногоПоля = ТекущийЭлемент}
<ЛогическийОператор> ::= {ЭтотУзел = НовыйОператорПроверкиНаNULL; ЭтотУзел.Операнд = ЛевыйЭлемент} ЕСТЬ <ОпциональноеНЕ> {ЭтотУзел.Инверсия = Истина} NULL

<ТипСсылочногоПоля> ::= @НовыйТипСсылочногоПоля Группа = #ID_ГруппаТипаСсылки '.' Таблица = #ID_ИмяТипа
 
<ЛогическийОператор>  ::= {ЭтотУзел = НовыйОператорВ; ЭтотУзел.Операнд = ЛевыйЭлемент} <ОпциональноеНЕ> {ЭтотУзел.Инверсия = Истина} 
							В <ОпциональноеВИерархии> {ЭтотУзел.Иерархия = Истина} '('<ОперандВ>  {ЭтотУзел.Список = ТекущийЭлемент} ')'

<ЛогическийОператор>  ::= ПУСТО 
							
<ОперандВ> ::= <СписокВыражений> {ЭтотУзел = ТекущийЭлемент}
<ОперандВ> ::= <ЗапросВыбора> {ЭтотУзел = ТекущийЭлемент}

<ЛогическаяОперация> ::= <Отрицание> {ЭтотУзел = ТекущийЭлемент} <ОперандСравнения> {ЭтотУзел.Выражение = ТекущийЭлемент} <ОперацияСравнения> {ЭтотУзел.Выражение = ТекущийЭлемент}
<ЛогическаяОперация> ::= <ОперандСравнения> {ЭтотУзел = ТекущийЭлемент} <ОперацияСравнения> {ЭтотУзел = ТекущийЭлемент}
<ОперацияСравнения>   ::= {ЭтотУзел = НовыйБинарнаяОперация; ЭтотУзел.ЛеваяЧасть = ЛевыйЭлемент} 
						  <ОператорСравнения> {ЭтотУзел.Операция = ТекущийЭлемент} <ОперандСравнения> {ЭтотУзел.ПраваяЧасть = ТекущийЭлемент} <ОперацияСравнения> {ЭтотУзел.ПраваяЧасть = ТекущийЭлемент}

<ОперацияСравнения>   ::= ПУСТО

<ОператорСравнения> ::= '='  {ЭтотУзел = ТекущийЭлемент}
<ОператорСравнения> ::= '<>' {ЭтотУзел = ТекущийЭлемент}
<ОператорСравнения> ::= '>'  {ЭтотУзел = ТекущийЭлемент}
<ОператорСравнения> ::= '<'  {ЭтотУзел = ТекущийЭлемент}
<ОператорСравнения> ::= '>=' {ЭтотУзел = ТекущийЭлемент}
<ОператорСравнения> ::= '<=' {ЭтотУзел = ТекущийЭлемент}

<ОперандСравнения>  ::= <АрифметическоеВыражение> {ЭтотУзел = ТекущийЭлемент} <ОператорПодобно> {ЭтотУзел = ТекущийЭлемент}

// TODO возможно множественное отрицание НЕ НЕ НЕ 1
// TODO  новому элементу количество присваиваем = 1
<Отрицание> ::= {ЭтотУзел = НовыйЛогическоеОтрицание} НЕ <ОтрицаниеПродолжение> 
<ОтрицаниеПродолжение> ::= {ЭтотУзел = Родитель} {ЭтотУзел.Количество = ЭтотУзел.Количество + 1} НЕ <ОтрицаниеПродолжение> | ПУСТО

// todo описать правый <Операнд> операции подобно, пока поддержим только строковую константу, без шаблонов

<ОператорПодобно>     ::= {ЭтотУзел = НовыйОператорПодобно; ЭтотУзел.Операнд = ЛевыйЭлемент} <ОпциональноеНЕ> {ЭтотУзел.Инверсия = Истина} ПОДОБНО <ШаблонПодобия> {ЭтотУзел.Шаблон = ТекущийЭлемент}
<ОператорПодобно>     ::= ПУСТО

<ШаблонПодобия>     ::= {ЭтотУзел = НовыйКонстанта}&СтроковаяКонстанта {ЭтотУзел.Значение = ТекущийЭлемент}
<ШаблонПодобия>     ::= <Параметр> {ЭтотУзел = ТекущийЭлемент}

<ОпциональноеНЕ>  ::= НЕ {ЭтотУзел = ТекущийЭлемент} | ПУСТО
<ОпциональноеВИерархии>  ::= ИЕРАРХИИ {ЭтотУзел = ТекущийЭлемент} | ПУСТО

// Арифметические выражения

<АрифметическоеВыражение> ::= @НовыйБинарнаяОперация ЛеваяЧасть = <АрифметическоеВыражение> Операция = '+' ПраваяЧасть = <Слагаемое>
<АрифметическоеВыражение> ::= @НовыйБинарнаяОперация ЛеваяЧасть = <АрифметическоеВыражение> Операция = '-' ПраваяЧасть = <Слагаемое>
<АрифметическоеВыражение> ::= <Слагаемое>

<Слагаемое> ::= @НовыйБинарнаяОперация ЛеваяЧасть = <Слагаемое> Операция = '*' ПраваяЧасть = <Множитель>
<Слагаемое> ::= @НовыйБинарнаяОперация ЛеваяЧасть = <Слагаемое> Операция = '/' ПраваяЧасть = <Множитель>
<Слагаемое> ::= @НовыйБинарнаяОперация ЛеваяЧасть = <Слагаемое> Операция = '%' ПраваяЧасть = <Множитель>
<Слагаемое> ::= <Множитель>

<УнарнаяОперация> ::= @НовыйУнарнаяОперация Знаки += ('-' | '+')+ Выражение = <Операнд>


<Множитель> ::= <Операнд> {ЭтотУзел = ТекущийЭлемент}
<Множитель> ::= <УнарнаяОперация> {ЭтотУзел = ТекущийЭлемент}
<Операнд> ::= <Выбор>
<Операнд> ::= <Поле>
<Операнд> ::= <Константа>
<Операнд> ::= <Параметр>
<Операнд> ::= <АгрегатнаяФункция>
<Операнд> ::= <Функция>

//  TODO Нужно будет сделать еще нетерминал ПсевдонимТаблицы, в учесть что в псевдониме таблицы нельзя использовать некоторые слова, 
// например ВЫБРАТЬ

<Поле> ::= {ЭтотУзел = НовыйРазыменование} #ID_ПолеБезРазыменования {ЭтотУзел.Элементы.Добавить(ТекущийЭлемент)} <ОперацияРазыменования>(ЭтотУзел.Элементы)
<Поле> ::= {ЭтотУзел = НовыйРазыменование} <ПриведениеТипа> {ЭтотУзел.Элементы.Добавить(ТекущийЭлемент)}  <ОперацияРазыменования>(ЭтотУзел.Элементы) 

<Поле> ::= '('<СписокВыражений> {ЭтотУзел = ТекущийЭлемент; Разыменование = НовыйРазыменование; Разыменование.Элементы.Добавить(ТекущийЭлемент)} ')' <ОперацияРазыменования>(Разыменование.Элементы) {ЭтотУзел = Разыменование;}
//<Поле> ::= {ЭтотУзел = НовыйРазыменование} '('<СписокВыражений> {ЭтотУзел.Элементы.Добавить(ТекущийЭлемент)} ')' <ОперацияРазыменования>)()

<ОперацияРазыменования>(Элементы) ::= ПУСТО
<ОперацияРазыменования>(Элементы) ::= '.' #ID_Полный {Элементы.Добавить(ТекущийЭлемент)} <ОперацияРазыменования>(Элементы)
<ОперацияРазыменования>(Элементы) ::= '.' '*' {ТекущийЭлемент = НовыйВыражениеВсеПоляИсточника; Элементы.Добавить(ТекущийЭлемент)}
<ОперацияРазыменования>(Элементы) ::= {ЭтотУзел = НовыйПоляВложеннойТаблицы; Элементы.Добавить(ЭтотУзел)} '.' '(' <ПоляВыборки> {ЭтотУзел.Элементы = ТекущийЭлемент} ')'


<СписокВыражений> ::= @НовыйСписокВыражений Элементы += <Выражение> (',' Элементы += <Выражение>)*

<ВыражениеМоделиЗапроса> ::= {ЭтотУзел = НовыйВыражениеМоделиЗапроса} <Выражение>  {ЭтотУзел.Значение = ТекущийЭлемент}          
          
<СписокВыраженийМодели> ::= @НовыйСписокВыражений Элементы += <ВыражениеМоделиЗапроса> (',' Элементы += <ВыражениеМоделиЗапроса>)*


<ПриведениеТипа> ::= {ЭтотУзел = НовыйПриведениеТипа} ВЫРАЗИТЬ'('<Выражение> {ЭтотУзел.Выражение = ТекущийЭлемент} КАК <ОписаниеТипа> {ЭтотУзел.ОписаниеТипа = ТекущийЭлемент}')'
<ОписаниеТипа> ::= <ТипСсылочногоПоля> {ЭтотУзел = ТекущийЭлемент}
<ОписаниеТипа> ::= {ЭтотУзел = НовыйОписаниеТипаБулево} БУЛЕВО 
<ОписаниеТипа> ::= {ЭтотУзел = НовыйОписаниеТипаДата} ДАТА
<ОписаниеТипа> ::= {ЭтотУзел = НовыйОписаниеТипаЧисло} ЧИСЛО <ОписаниеЧисла>
<ОписаниеТипа> ::= {ЭтотУзел = НовыйОписаниеТипаСтрока} СТРОКА <ОписаниеСтроки>

<ОписаниеЧисла> ::= {ЭтотУзел = Родитель}'('&ЧисловаяКонстанта {ЭтотУзел.Длина = ТекущийЭлемент} <ТочностьЧисла>')'
<ОписаниеЧисла> ::= ПУСТО 
<ТочностьЧисла> ::= {ЭтотУзел = Родитель} ',' &ЧисловаяКонстанта {ЭтотУзел.Точность = ТекущийЭлемент}
<ТочностьЧисла> ::= {ЭтотУзел = Родитель} ',' {ЭтотУзел.Точность = 0}
<ТочностьЧисла> ::= ПУСТО
<ОписаниеСтроки> ::= {ЭтотУзел = Родитель} '('&ЧисловаяКонстанта {ЭтотУзел.Длина = ТекущийЭлемент}')'
<ОписаниеСтроки> ::= ПУСТО

<Выбор> ::= @НовыйВыбор ВЫБОР ВыражениеВыбора = <Выражение>? АльтернативыВыбора += <КогдаТогда>+ Иначе = (ИНАЧЕ <Выражение>)? КОНЕЦ
<КогдаТогда> ::= @НовыйАльтернативаВыбора КОГДА Условие = <Выражение> ТОГДА Действие = <Выражение>

<Константа> ::= @НовыйКонстанта Значение = &СтроковаяКонстанта
<Константа> ::= @НовыйКонстанта Значение = &ЧисловаяКонстанта
<Константа> ::= @НовыйКонстанта ИСТИНА Значение := Истина
<Константа> ::= @НовыйКонстанта ЛОЖЬ Значение := Ложь
<Константа> ::= @НовыйКонстанта NULL Значение := Null
<Константа> ::= @НовыйКонстанта НЕОПРЕДЕЛЕНО Значение := Неопределено

<Параметр> ::= @НовыйПараметрЗапроса '&' Имя = #ID_Полный

<АгрегатнаяФункция> ::= @НовыйАгрегатнаяФункция ИмяФункции = СУММА '(' Аргумент = <Выражение> ')'
<АгрегатнаяФункция> ::= @НовыйАгрегатнаяФункция ИмяФункции = МАКСИМУМ '(' Аргумент = <Выражение> ')'
<АгрегатнаяФункция> ::= @НовыйАгрегатнаяФункция ИмяФункции = МИНИМУМ '(' Аргумент = <Выражение> ')'
<АгрегатнаяФункция> ::= @НовыйАгрегатнаяФункция ИмяФункции = СРЕДНЕЕ '(' Аргумент = <Выражение> ')'
<АгрегатнаяФункция> ::= @НовыйАгрегатнаяФункцияКоличество КОЛИЧЕСТВО '(' (РАЗЛИЧНЫЕ Различные := Истина)? Аргумент = ('*' | <Выражение>) ')'
<РазличныеОпционально> ::= РАЗЛИЧНЫЕ {ЭтотУзел = ТекущийЭлемент} | ПУСТО 

<Функция> ::= @НовыйФункцияПодстрока ПОДСТРОКА '(' Строка = <Выражение> ',' НачальнаяПозиция = <Выражение> ',' КоличествоСимволов = <Выражение> ')'

<Функция> ::= @НовыйФункцияГод ГОД '(' Аргумент = <Выражение> ')'
<Функция> ::= @НовыйФункцияКвартал КВАРТАЛ '(' Аргумент = <Выражение> ')'
<Функция> ::= @НовыйФункцияМесяц МЕСЯЦ '(' Аргумент = <Выражение> ')'
<Функция> ::= @НовыйФункцияДеньГода ДЕНЬГОДА '(' Аргумент = <Выражение> ')'
<Функция> ::= @НовыйФункцияДень ДЕНЬ '(' Аргумент = <Выражение> ')'
<Функция> ::= @НовыйФункцияДеньМесяца НЕДЕЛЯ '(' Аргумент = <Выражение> ')'
<Функция> ::= @НовыйФункцияДеньНедели ДЕНЬНЕДЕЛИ '(' Аргумент = <Выражение> ')'
<Функция> ::= @НовыйФункцияЧас ЧАС '(' Аргумент = <Выражение> ')'
<Функция> ::= @НовыйФункцияМинута МИНУТА '(' Аргумент = <Выражение> ')'
<Функция> ::= @НовыйФункцияСекунда СЕКУНДА '(' Аргумент = <Выражение> ')'

<Функция> ::= @НовыйФункцияНачалоПериода НАЧАЛОПЕРИОДА '(' Дата = <Выражение> ',' ТипПериода = <ТипПериода> ')'
<Функция> ::= @НовыйФункцияКонецПериода КОНЕЦПЕРИОДА '(' Дата = <Выражение> ',' ТипПериода = <ТипПериода> ')'
<Функция> ::= @НовыйФункцияДобавитьКДате ДОБАВИТЬКДАТЕ '(' Дата = <Выражение> ',' ТипПериода = <ТипПериода> ',' Сдвиг = <Выражение> ')'
<Функция> ::= @НовыйФункцияРазностьДат РАЗНОСТЬДАТ '(' Дата1 = <Выражение> ',' Дата2 = <Выражение> ',' ТипПериода = <ТипПериода> ')'
<Функция> ::= @НовыйФункцияIsNull ЕСТЬNULL '(' ПроверяемоеЗначение = <Выражение> ',' Действие = <Выражение> ')'

<Функция> ::= @НовыйФункцияПредставление ПРЕДСТАВЛЕНИЕ '(' Аргумент = <Выражение> ')'
<Функция> ::= @НовыйФункцияПредставлениеСсылки ПРЕДСТАВЛЕНИЕССЫЛКИ '(' Аргумент = <Выражение> ')'
<Функция> ::= @НовыйФункцияТипЗначения ТИПЗНАЧЕНИЯ '(' Аргумент = <Выражение> ')'
<Функция> ::= @НовыйФункцияДатаВремя ДАТАВРЕМЯ '(' Аргументы += &ЧисловаяКонстанта (',' Аргументы += &ЧисловаяКонстанта)* ')'
<Функция> ::= @НовыйФункцияЗначение ЗНАЧЕНИЕ '(' ЧастиПути += #ID_Полный '.' ЧастиПути += #ID_Полный ('.' ЧастиПути += #ID_Полный)? ')'
<Функция> ::= @НовыйФункцияТип ТИП '(' Аргумент = <ОписаниеТипа> ')'

<ТипПериода> ::= #ID_Полный

