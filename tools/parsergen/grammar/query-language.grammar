// TODO нужно разделять ид для псевдонима с как и без как, во втором случае псевдонимом могут быть Итоги, упорядочить, Где и т.п.

// Пакет запросов

<ПакетЗапросов> ::= @НовыйПакетЗапросов Элементы += <ЗапросПакета> (';' Элементы += <ЗапросПакета>)* ';'?

<ЗапросПакета> ::= <ЗапросВыбора> | <ЗапросУничтожения>
<ЗапросУничтожения> ::= @НовыйЗапросУничтожения УНИЧТОЖИТЬ ИмяТаблицы = #ID_ИмяТаблицы

// Описание запроса

//  TODO нужен булев признак ОбщиеИтоги
<ЗапросВыбора> ::= @НовыйЗапросВыбора
	Операторы += <ОбъединяемыйЗапрос>
	(Операторы += <ОператорОбъединения>)*
	(УПОРЯДОЧИТЬ ПО Порядок = <СписокЭлементовУпорядочивания> <РасширениеСКД>(ЭтотУзел.Операторы[0]))?
	(ИНДЕКСИРОВАТЬ ПО Индекс = <СписокВыражений> <РасширениеСКД>(ЭтотУзел))?
	(ИТОГИ ВыраженияИтогов = <ПоляИтогов> ПО КонтрольныеТочкиИтогов = <КонтрольныеТочкиИтогов> <РасширениеСКД>(ЭтотУзел.Операторы[0]))?
	(АВТОУПОРЯДОЧИВАНИЕ Автопорядок := Истина)?

<ОбъединяемыйЗапрос> ::= @НовыйОператорЗапроса ВЫБРАТЬ
	(
		ПЕРВЫЕ КоличествоПолучаемыхЗаписей = &ЧисловаяКонстанта
		(
			РАЗЛИЧНЫЕ ВыбиратьРазличные := Истина (РАЗРЕШЕННЫЕ __ВыбиратьРазрешенные := Истина)?
		  | РАЗРЕШЕННЫЕ __ВыбиратьРазрешенные := Истина (РАЗЛИЧНЫЕ ВыбиратьРазличные := Истина)?
		)?
	  | РАЗЛИЧНЫЕ ВыбиратьРазличные := Истина
		(
			ПЕРВЫЕ КоличествоПолучаемыхЗаписей = &ЧисловаяКонстанта (РАЗРЕШЕННЫЕ __ВыбиратьРазрешенные := Истина)?
		  | РАЗРЕШЕННЫЕ __ВыбиратьРазрешенные := Истина (ПЕРВЫЕ КоличествоПолучаемыхЗаписей = &ЧисловаяКонстанта)?
		)?
	  | РАЗРЕШЕННЫЕ __ВыбиратьРазрешенные := Истина
		(
			ПЕРВЫЕ КоличествоПолучаемыхЗаписей = &ЧисловаяКонстанта (РАЗЛИЧНЫЕ ВыбиратьРазличные := Истина)?
		  | РАЗЛИЧНЫЕ ВыбиратьРазличные := Истина (ПЕРВЫЕ КоличествоПолучаемыхЗаписей = &ЧисловаяКонстанта)?
		)?
	)?
	<РасширениеСКД>(ЭтотУзел)
	ВыбираемыеПоля = <ПоляВыборки>(ЭтотУзел)
	(ПОМЕСТИТЬ __ТаблицаДляПомещения = #ID_ИмяТаблицы <РасширениеСКД>(ЭтотУзел))?
	(ИЗ Источники = <БлокИз> <РасширениеСКД>(ЭтотУзел))?
	(ГДЕ Отбор = <ВыражениеМоделиЗапроса> <РасширениеСКД>(ЭтотУзел))?
	(СГРУППИРОВАТЬ ПО Группировка = <СписокВыраженийМодели> <РасширениеСКД>(ЭтотУзел))?
	(ИМЕЮЩИЕ ОтборСгруппированных = <ВыражениеМоделиЗапроса> <РасширениеСКД>(ЭтотУзел))?

<ОператорОбъединения> ::= ОБЪЕДИНИТЬ
	<ТипОбъединенияЗапроса> {ТипОбъединения = ТекущийЭлемент}
	<ОбъединяемыйЗапрос> {ТекущийЭлемент.ТипОбъединения = ТипОбъединения; ЭтотУзел = ТекущийЭлемент}

<ТипОбъединенияЗапроса> ::= @НовыйТипОбъединениеВсе ВСЕ | @НовыйТипОбъединение

// Описание полей выборки
				
<ПоляВыборки>(Оператор) ::= @НовыйВыбираемыеПоля += <ПолеВыборки> <РасширениеСКД>(Оператор) (',' += <ПолеВыборки> <РасширениеСКД>(Оператор))*

// TODO поддержать вложенную таблицу как поле

<ПолеВыборки> ::= @НовыйПолеЗапроса Выражение = <ВыражениеМоделиЗапроса> (Псевдоним = <Псевдоним>)?
<ПолеВыборки> ::= @НовыйПолеЗапроса Выражение = <ВыражениеВсеПоляВыборки>
<ВыражениеВсеПоляВыборки> ::= @НовыйВыражениеМоделиЗапроса Значение = <ВыражениеВсеПоля>
<ВыражениеВсеПоля> ::= @НовыйВыражениеВсеПоля '*'

<Псевдоним> ::= КАК #ID_ПсевдонимРасширенный | #ID_Псевдоним

// Описание блока ИЗ

<БлокИз> ::= @НовыйИсточникиЗапроса += <ИсточникДанныхЗапроса> (',' += <ИсточникДанныхЗапроса>)*

<ИсточникДанныхЗапроса> ::= @НовыйИсточник Источник = <ИсточникДанных> Соединения = <СписокСоединений>

<СписокСоединений> ::= @НовыйСписокСоединений (+= <ПраваяЧастьСоединения>)*

<ПраваяЧастьСоединения> ::=
    @НовыйСоединениеИсточника
    ТипСоединения = <ТипСоединения>
    СОЕДИНЕНИЕ Источник = <ИсточникДанныхСоединения>
    ПО Условие = <ВыражениеМоделиЗапроса>
  | @НовыйСоединениеИсточника Опционально := Истина '{'
    ТипСоединения = <ТипСоединения>
    СОЕДИНЕНИЕ Источник = <ИсточникДанныхСоединения>
    ПО Условие = <ВыражениеМоделиЗапроса> '}'

<ИсточникДанныхСоединения> ::= @НовыйИсточник Источник = <ПрисоединяемаяТаблица> Соединения = <СписокСоединений>

<ТипСоединения> ::= @НовыйТипСоединенияЛевое ЛЕВОЕ | @НовыйТипСоединенияПравое ПРАВОЕ | @НовыйТипСоединенияВнутреннее ВНУТРЕННЕЕ | @НовыйТипСоединенияПолное ПОЛНОЕ

<ИсточникДанных> ::= <ИсточникДанныхТаблицаЗначений>
<ИсточникДанных> ::= <ИсточникДанныхТаблица>
<ИсточникДанных> ::= <ИсточникДанныхВложенныйЗапрос>
<ИсточникДанных> ::= <ИсточникДанныхВременнаяТаблица>

<ПрисоединяемаяТаблица> ::= <ИсточникДанныхТаблица> | <ИсточникДанныхВложенныйЗапрос> | <ИсточникДанныхВременнаяТаблица>

<ИсточникДанныхТаблицаЗначений> ::= @НовыйИсточникДанныхТаблицаЗначений '&' ИмяТаблицы = #ID_Полный Псевдоним = <Псевдоним>
<ИсточникДанныхВременнаяТаблица> ::= @НовыйИсточникДанныхВременнаяТаблица ИмяТаблицы = #ID_ИмяТаблицы (Псевдоним = <Псевдоним>)?

<ИсточникДанныхТаблица> ::= @НовыйИсточникДанныхТаблица ИмяТаблицы ~= #ID_ИмяТаблицы (ИмяТаблицы ~= '.' ИмяТаблицы ~= #ID_Полный)+ ('(' Параметры = <СписокПараметров> ')')? (Псевдоним = <Псевдоним>)?

<ИсточникДанныхВложенныйЗапрос> ::= @НовыйИсточникДанныхВложенныйЗапрос '(' ЗапросВыбора = <ЗапросВыбора> ')' Псевдоним = <Псевдоним>

// TODO тут нужно что то придумать для уточнения парамерров представлений, например использовать ; когда список параметров
<СписокПараметров> ::= @НовыйСписокПараметров += <ПараметрТаблицы> (',' += <ПараметрТаблицы>)*
<ПараметрТаблицы> ::= <ВыражениеМоделиЗапроса> | := Неопределено
// TODO тут нужно что то придумать для уточнения парамерров представлений, например использовать ; когда список параметров


// Блок Упорядочить

// TODO АВТОУПОРЯДОЧИВАНИЕ перед УПОРЯДОЧИТЬ ПО, после УПОРЯДОЧИТЬ ПО, перед ИТОГИ ПО, После ИТОГИ ПО

<СписокЭлементовУпорядочивания> ::= @НовыйЭлементыПорядка += <ЭлементУпорядочивания> (',' += <ЭлементУпорядочивания>)*
<ЭлементУпорядочивания> ::= @НовыйЭлементПорядка Выражение = <ВыражениеМоделиЗапроса> (ИЕРАРХИЯ Иерархия := Истина)? (Направление = <НаправлениеУпорядочивания>)?
<НаправлениеУпорядочивания> ::= @НовыйНаправлениеВозрастание ВОЗР | @НовыйНаправлениеУбывание УБЫВ

// Болок итоги
//  не учтено ПЕРИОДАМИ(Месяц, ДАТАВРЕМЯ(2000, 07, 01), ДАТАВРЕМЯ(2000, 12, 01))
// Период ТОЛЬКО ИЕРАРХИЯ ПЕРИОДАМИ(ДЕНЬ, , ) КАК ааа,


<ПоляИтогов> ::= @НовыйВыраженияИтогов (+= <ПолеВыборки> (',' += <ПолеВыборки> <РасширениеСКД>)*)?

<КонтрольныеТочкиИтогов> ::= @НовыйКонтрольныеТочкиИтогов += <КонтрольнаяТочкаИтогов> (',' += <КонтрольнаяТочкаИтогов>)*

// TODO устанавливать совйтсво общие итоги и не добавлять ее в массив точек
<КонтрольнаяТочкаИтогов> ::= @НовыйКонтрольнаяТочкаИтогов Выражение = <ВыражениеМоделиЗапроса> ТипКонтрольнойТочки = <ТипКонтрольнойТочки> (ПЕРИОДАМИ '(' ТипДополненияПериодами = <ТипПериодаИтогов> (',' НачалоПериодаДополнения = <Выражение>? (',' КонецПериодаДополнения = <Выражение>?)?)? ')')? ((КАК ИмяКолонки = #ID_ПсевдонимРасширенный) | ИмяКолонки = #ID_ПсевдонимКонтрольнойТочкиИтогов)?
<КонтрольнаяТочкаИтогов> ::= @НовыйОбщиеИтоги ОБЩИЕ КАК #ID_ПсевдонимРасширенный
<КонтрольнаяТочкаИтогов> ::= @НовыйОбщиеИтоги ОБЩИЕ #ID_Псевдоним
<КонтрольнаяТочкаИтогов> ::= @НовыйОбщиеИтоги ОБЩИЕ

<ТипКонтрольнойТочки> ::= @НовыйТипКонтрольнойТочкиТолькоИерархия ТОЛЬКО ИЕРАРХИЯ | @НовыйТипКонтрольнойТочкиИерархия ИЕРАРХИЯ | ПУСТО

<ТипПериодаИтогов> ::= СЕКУНДА | МИНУТА | ЧАС | ДЕНЬ | НЕДЕЛЯ | МЕСЯЦ | ГОД | ДЕКАДА | ПОЛУГОДИЕ


// Расширение СКД

<РасширениеСКД>(Оператор) ::= '{' (ВЫБРАТЬ | УПОРЯДОЧИТЬ ПО | ИТОГИ ПО) <СписокПолейСКД> '}'
<РасширениеСКД>(Оператор) ::= '{' <ОтборСКД>(Оператор.ОтборыСКД) '}'
<РасширениеСКД> ::= ПУСТО
<СписокПолейСКД> ::= @НовыйВыбираемыеПоля += <ПолеВыборки> (',' += <ПолеВыборки>)*
<ОтборСКД>(ОтборыСКД) ::= ГДЕ <СписокПолейСКД> {Для Каждого ЭлементСКД Из ТекущийЭлемент Цикл
	ОтборыСКД.Добавить(ЭлементСКД)
КонецЦикла}

// ЛОГИЧЕСКИЕ ВЫРАЖЕНИЯ

<Выражение> ::= @НовыйБинарнаяОперация ЛеваяЧасть = <Выражение> Операция = ИЛИ ПраваяЧасть = <ЛогическоеСлагаемое>
<Выражение> ::= <ЛогическоеСлагаемое>

<ЛогическоеСлагаемое> ::= @НовыйБинарнаяОперация ЛеваяЧасть = <ЛогическоеСлагаемое> Операция = И ПраваяЧасть = <ЛогическийМножитель>
<ЛогическоеСлагаемое> ::= <ЛогическийМножитель>


<ЛогическийМножитель> ::= <ЛогическаяОперация> Операнд => <ЛогическийОператор>?

// TODO SELECT 1 IS NULL BETWEEN TRUE AND FALSE AS Field1 не исполняется
// IS NULL, REFS, like, in и BETWEEN имеют одинаковый приоритет

<ЛогическийОператор> ::= @НовыйОператорМежду (НЕ Инверсия := Истина)? МЕЖДУ НачалоИнтервала = <ОперандСравнения> И КонецИнтервала = <ОперандСравнения>

<ЛогическийОператор> ::= @НовыйОператорПроверкиТипа ССЫЛКА ТипСсылочногоПоля = <ТипСсылочногоПоля>
<ЛогическийОператор> ::= @НовыйОператорПроверкиНаNULL ЕСТЬ (НЕ Инверсия := Истина)? NULL

<ТипСсылочногоПоля> ::= @НовыйТипСсылочногоПоля Группа = #ID_ГруппаТипаСсылки '.' Таблица = #ID_ИмяТипа
 
<ЛогическийОператор> ::= @НовыйОператорВ (НЕ Инверсия := Истина)? В (ИЕРАРХИИ Иерархия := Истина)? '(' Список = <ОперандВ> ')'
							
<ОперандВ> ::= <СписокВыражений>
<ОперандВ> ::= <ЗапросВыбора>

<ЛогическаяОперация> ::= @НовыйЛогическоеОтрицание НЕ (Количество ++= НЕ)* Выражение = <ЛогическаяОперацияБезОтрицания>
<ЛогическаяОперация> ::= <ЛогическаяОперацияБезОтрицания>

<ЛогическаяОперацияБезОтрицания> ::= @НовыйБинарнаяОперация ЛеваяЧасть = <ЛогическаяОперацияБезОтрицания> Операция = <ОператорСравнения> ПраваяЧасть = <ОперандСравнения>
<ЛогическаяОперацияБезОтрицания> ::= <ОперандСравнения>

<ОператорСравнения> ::= '='
<ОператорСравнения> ::= '<>'
<ОператорСравнения> ::= '>'
<ОператорСравнения> ::= '<'
<ОператорСравнения> ::= '>='
<ОператорСравнения> ::= '<='

<ОперандСравнения> ::= <АрифметическоеВыражение> Операнд => <ОператорПодобно>?

// todo описать правый <Операнд> операции подобно, пока поддержим только строковую константу, без шаблонов

<ОператорПодобно> ::= @НовыйОператорПодобно (НЕ Инверсия := Истина)? ПОДОБНО Шаблон = <ШаблонПодобия>

<ШаблонПодобия> ::= @НовыйКонстанта Значение = &СтроковаяКонстанта
<ШаблонПодобия> ::= <Параметр>

// Арифметические выражения

<АрифметическоеВыражение> ::= @НовыйБинарнаяОперация ЛеваяЧасть = <АрифметическоеВыражение> Операция = '+' ПраваяЧасть = <Слагаемое>
<АрифметическоеВыражение> ::= @НовыйБинарнаяОперация ЛеваяЧасть = <АрифметическоеВыражение> Операция = '-' ПраваяЧасть = <Слагаемое>
<АрифметическоеВыражение> ::= <Слагаемое>

<Слагаемое> ::= @НовыйБинарнаяОперация ЛеваяЧасть = <Слагаемое> Операция = '*' ПраваяЧасть = <Множитель>
<Слагаемое> ::= @НовыйБинарнаяОперация ЛеваяЧасть = <Слагаемое> Операция = '/' ПраваяЧасть = <Множитель>
<Слагаемое> ::= @НовыйБинарнаяОперация ЛеваяЧасть = <Слагаемое> Операция = '%' ПраваяЧасть = <Множитель>
<Слагаемое> ::= <Множитель>

<УнарнаяОперация> ::= @НовыйУнарнаяОперация Знаки += ('-' | '+')+ Выражение = <Операнд>


<Множитель> ::= <Операнд>
<Множитель> ::= <УнарнаяОперация>
<Операнд> ::= <Выбор>
<Операнд> ::= <Поле>
<Операнд> ::= <Константа>
<Операнд> ::= <Параметр>
<Операнд> ::= <АгрегатнаяФункция>
<Операнд> ::= <Функция>

//  TODO Нужно будет сделать еще нетерминал ПсевдонимТаблицы, в учесть что в псевдониме таблицы нельзя использовать некоторые слова, 
// например ВЫБРАТЬ

<Поле> ::= @НовыйРазыменование Элементы += (#ID_ПолеБезРазыменования | <ПриведениеТипа> | ('(' <СписокВыражений> ')')) ('.' Элементы += #ID_Полный)* ('.' Элементы += (<ВыражениеВсеПоляИсточника> | <ПоляВложеннойТаблицы>))?
<ВыражениеВсеПоляИсточника> ::= @НовыйВыражениеВсеПоляИсточника '*'
<ПоляВложеннойТаблицы> ::= @НовыйПоляВложеннойТаблицы '(' Элементы = <ПоляВыборки> ')'


<СписокВыражений> ::= @НовыйСписокВыражений Элементы += <Выражение> (',' Элементы += <Выражение>)*

<ВыражениеМоделиЗапроса> ::= @НовыйВыражениеМоделиЗапроса Значение = <Выражение>
          
<СписокВыраженийМодели> ::= @НовыйСписокВыражений Элементы += <ВыражениеМоделиЗапроса> (',' Элементы += <ВыражениеМоделиЗапроса>)*


<ПриведениеТипа> ::= @НовыйПриведениеТипа ВЫРАЗИТЬ '(' Выражение = <Выражение> КАК ОписаниеТипа = <ОписаниеТипа> ')'
<ОписаниеТипа> ::= <ТипСсылочногоПоля>
<ОписаниеТипа> ::= @НовыйОписаниеТипаБулево БУЛЕВО
<ОписаниеТипа> ::= @НовыйОписаниеТипаДата ДАТА
<ОписаниеТипа> ::= @НовыйОписаниеТипаЧисло ЧИСЛО ('(' Длина = &ЧисловаяКонстанта ((',' Точность = &ЧисловаяКонстанта) | ',')? ')')?
<ОписаниеТипа> ::= @НовыйОписаниеТипаСтрока СТРОКА ('(' Длина = &ЧисловаяКонстанта ')')?

<Выбор> ::= @НовыйВыбор ВЫБОР ВыражениеВыбора = <Выражение>? АльтернативыВыбора += <КогдаТогда>+ Иначе = (ИНАЧЕ <Выражение>)? КОНЕЦ
<КогдаТогда> ::= @НовыйАльтернативаВыбора КОГДА Условие = <Выражение> ТОГДА Действие = <Выражение>

<Константа> ::= @НовыйКонстанта Значение = &СтроковаяКонстанта
<Константа> ::= @НовыйКонстанта Значение = &ЧисловаяКонстанта
<Константа> ::= @НовыйКонстанта ИСТИНА Значение := Истина
<Константа> ::= @НовыйКонстанта ЛОЖЬ Значение := Ложь
<Константа> ::= @НовыйКонстанта NULL Значение := Null
<Константа> ::= @НовыйКонстанта НЕОПРЕДЕЛЕНО Значение := Неопределено

<Параметр> ::= @НовыйПараметрЗапроса '&' Имя = #ID_Полный

<АгрегатнаяФункция> ::= @НовыйАгрегатнаяФункция ИмяФункции = СУММА '(' Аргумент = <Выражение> ')'
<АгрегатнаяФункция> ::= @НовыйАгрегатнаяФункция ИмяФункции = МАКСИМУМ '(' Аргумент = <Выражение> ')'
<АгрегатнаяФункция> ::= @НовыйАгрегатнаяФункция ИмяФункции = МИНИМУМ '(' Аргумент = <Выражение> ')'
<АгрегатнаяФункция> ::= @НовыйАгрегатнаяФункция ИмяФункции = СРЕДНЕЕ '(' Аргумент = <Выражение> ')'
<АгрегатнаяФункция> ::= @НовыйАгрегатнаяФункцияКоличество КОЛИЧЕСТВО '(' (РАЗЛИЧНЫЕ Различные := Истина)? Аргумент = ('*' | <Выражение>) ')'

<Функция> ::= @НовыйФункцияПодстрока ПОДСТРОКА '(' Строка = <Выражение> ',' НачальнаяПозиция = <Выражение> ',' КоличествоСимволов = <Выражение> ')'

<Функция> ::= @НовыйФункцияГод ГОД '(' Аргумент = <Выражение> ')'
<Функция> ::= @НовыйФункцияКвартал КВАРТАЛ '(' Аргумент = <Выражение> ')'
<Функция> ::= @НовыйФункцияМесяц МЕСЯЦ '(' Аргумент = <Выражение> ')'
<Функция> ::= @НовыйФункцияДеньГода ДЕНЬГОДА '(' Аргумент = <Выражение> ')'
<Функция> ::= @НовыйФункцияДень ДЕНЬ '(' Аргумент = <Выражение> ')'
<Функция> ::= @НовыйФункцияДеньМесяца НЕДЕЛЯ '(' Аргумент = <Выражение> ')'
<Функция> ::= @НовыйФункцияДеньНедели ДЕНЬНЕДЕЛИ '(' Аргумент = <Выражение> ')'
<Функция> ::= @НовыйФункцияЧас ЧАС '(' Аргумент = <Выражение> ')'
<Функция> ::= @НовыйФункцияМинута МИНУТА '(' Аргумент = <Выражение> ')'
<Функция> ::= @НовыйФункцияСекунда СЕКУНДА '(' Аргумент = <Выражение> ')'

<Функция> ::= @НовыйФункцияНачалоПериода НАЧАЛОПЕРИОДА '(' Дата = <Выражение> ',' ТипПериода = <ТипПериода> ')'
<Функция> ::= @НовыйФункцияКонецПериода КОНЕЦПЕРИОДА '(' Дата = <Выражение> ',' ТипПериода = <ТипПериода> ')'
<Функция> ::= @НовыйФункцияДобавитьКДате ДОБАВИТЬКДАТЕ '(' Дата = <Выражение> ',' ТипПериода = <ТипПериода> ',' Сдвиг = <Выражение> ')'
<Функция> ::= @НовыйФункцияРазностьДат РАЗНОСТЬДАТ '(' Дата1 = <Выражение> ',' Дата2 = <Выражение> ',' ТипПериода = <ТипПериода> ')'
<Функция> ::= @НовыйФункцияIsNull ЕСТЬNULL '(' ПроверяемоеЗначение = <Выражение> ',' Действие = <Выражение> ')'

<Функция> ::= @НовыйФункцияПредставление ПРЕДСТАВЛЕНИЕ '(' Аргумент = <Выражение> ')'
<Функция> ::= @НовыйФункцияПредставлениеСсылки ПРЕДСТАВЛЕНИЕССЫЛКИ '(' Аргумент = <Выражение> ')'
<Функция> ::= @НовыйФункцияТипЗначения ТИПЗНАЧЕНИЯ '(' Аргумент = <Выражение> ')'
<Функция> ::= @НовыйФункцияДатаВремя ДАТАВРЕМЯ '(' Аргументы += &ЧисловаяКонстанта (',' Аргументы += &ЧисловаяКонстанта)* ')'
<Функция> ::= @НовыйФункцияЗначение ЗНАЧЕНИЕ '(' ЧастиПути += #ID_Полный '.' ЧастиПути += #ID_Полный ('.' ЧастиПути += #ID_Полный)? ')'
<Функция> ::= @НовыйФункцияТип ТИП '(' Аргумент = <ОписаниеТипа> ')'

<ТипПериода> ::= #ID_Полный

